{
  "key": "harvest",
  "name": "Harvest",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity",
    "accounting"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Harvest personal access token",
          "required": true,
          "secret": true
        },
        {
          "key": "accountId",
          "label": "Harvest account ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.harvestapp.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.harvestapp.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Harvest-Account-Id": "{{accountId}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "error.message",
        "message",
        "errors.0.message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the Harvest token and account ID by returning the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "user": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "GET",
        "path": "/v2/users/me",
        "success": [
          200
        ],
        "echo": {
          "status": "ok"
        },
        "result": {
          "status": "ok",
          "user": "{{response}}"
        }
      }
    },
    "users.me": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Current User",
      "description": "Get the authenticated Harvest user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "GET",
        "path": "/v2/users/me",
        "success": [
          200
        ],
        "result": {
          "user": "{{response}}"
        }
      }
    },
