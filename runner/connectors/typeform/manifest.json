        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "object",
            "description": "Normalized theme object."
          }
        }
      }
    },
    "images.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Images",
      "description": "Retrieve images in the Typeform account in reverse-chronological order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Typeform OAuth2 Bearer access token."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "description": "Array of normalized image objects."
          }
        }
      }
    },
    "webhooks.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 524288,
      "title": "Get Webhook",
      "description": "Retrieve a single Typeform webhook by form ID and tag.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Typeform OAuth2 Bearer access token."
          },
          "formId": {
            "type": "string",
            "description": "The unique identifier of the Typeform form."
          },
          "tag": {
            "type": "string",
            "description": "Unique webhook tag within the form."
          }
        },
        "required": [
          "accessToken",
          "formId",
