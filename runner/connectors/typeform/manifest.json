            "type": "string",
            "description": "Typeform OAuth2 Bearer access token."
          },
          "formId": {
            "type": "string",
            "description": "The unique identifier of the Typeform form."
          }
        },
        "required": [
          "accessToken",
          "formId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "object",
            "description": "Custom form messages map."
          },
          "formId": {
            "type": "string",
            "description": "Form ID the messages belong to."
          }
        }
      }
    },
    "forms.patch": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 524288,
      "maxResponseBytes": 65536,
      "title": "Patch Form",
      "description": "Partially update a Typeform using JSON Patch operations without replacing the entire form.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Typeform OAuth2 Bearer access token."
          },
          "formId": {
            "type": "string",
            "description": "The unique identifier of the Typeform form."
          },
          "operations": {
            "type": "array",
            "description": "JSON Patch operations (add, remove, replace) to apply to the form.",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "accessToken",
          "formId",
          "operations"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
