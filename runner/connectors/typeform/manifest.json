    },
    "webhooks.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Delete Webhook",
      "description": "Delete a Typeform webhook identified by form ID and tag.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Typeform OAuth2 Bearer access token."
          },
          "formId": {
