    "language-models.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 8388608,
      "title": "List language models",
      "description": "List language models with GET /language/models/free. Returns intelligence, coding, and agentic indices, capability indexes, median performance, and input/output pricing inside the free-tier envelope. cursor is sent as the documented page query (1-indexed). start and end are accepted and not sent: the public API has no slice parameters and this call does not trim the page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "description": "Page number from a previous pagination.page, sent as the page query. Omit for page 1."
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "description": "Accepted and not sent. The public API does not slice a page."
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "description": "Accepted and not sent. The public API does not slice a page."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tier",
              "data"
            ],
            "properties": {
              "tier": {
                "type": "string"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/language/models/free",
        "query": {
          "page": "{{cursor}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
