{
  "key": "artificial-analysis",
  "name": "Artificial Analysis",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Artificial Analysis API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "artificialanalysis.ai"
    ]
  },
  "models": [
    "language-model",
    "media-model"
  ],
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "http": {
    "baseUrl": "https://artificialanalysis.ai/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "retryAfterPaths": [
        "retryAfter"
      ],
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "error",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 8388608,
      "title": "Healthcheck",
      "description": "Validate the API key with GET /language/models/free. Artificial Analysis publishes no separate health route.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tier",
              "data"
            ],
            "properties": {
              "tier": {
                "type": "string"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/language/models/free",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "image-editing-models.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 8388608,
      "title": "List image-editing models",
      "description": "List image-editing models with GET /media/image-editing/models/free. Returns the free-tier JSON envelope for every ranked model. The free shape is model identity, Elo, and ci_95. limit is accepted and not sent: the documented route has no limit parameter and this declarative call does not slice the array.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Accepted for Composio compatibility and not sent. The public list is unpaginated and this operation does not trim it."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tier",
              "data"
            ],
            "properties": {
              "tier": {
                "type": "string"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/media/image-editing/models/free",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
