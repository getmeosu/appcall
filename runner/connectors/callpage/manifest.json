    "users.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create user",
      "description": "Create a CallPage user (admin or manager).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "User display name.",
            "minLength": 1
          },
          "tel": {
            "type": "string",
            "description": "Phone number in E.164 format.",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "description": "Optional email address."
          },
          "role": {
            "type": "string",
            "description": "User role.",
            "enum": [
              "admin",
              "manager"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "tel"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/external/users/create",
        "success": [
          200,
          201
        ],
        "body": {
          "name": "{{name}}",
          "tel": "{{tel}}",
          "email": "{{email}}",
          "role": "{{role}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
