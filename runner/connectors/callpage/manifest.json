{
  "key": "callpage",
  "name": "CallPage",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "CallPage API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "core.callpage.io"
    ]
  },
  "models": [
    "user",
    "widget",
    "call",
    "manager",
    "sms",
    "voice"
  ],
  "http": {
    "baseUrl": "https://core.callpage.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message"
      ],
      "bodyErrorPaths": [
        "hasError"
      ]
    }
  },
  "operations": {
