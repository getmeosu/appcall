          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Healthcheck",
      "description": "Validate the CallPage API token with GET /api/v1/external.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/external",
        "success": [
