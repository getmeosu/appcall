      "description": "List Botpress bots in the connected workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dev": {
            "type": "boolean"
          },
          "nextToken": {
            "type": "string",
            "minLength": 1
          },
          "sortField": {
            "type": "string",
            "enum": [
              "createdAt",
              "updatedAt"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/bots",
        "success": [
          200
        ],
        "query": {
          "dev": "{{dev}}",
          "nextToken": "{{nextToken}}",
          "sortField": "{{sortField}}",
          "sortDirection": "{{sortDirection}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
