{
  "key": "botpress",
  "name": "Botpress",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Botpress API token",
          "required": true,
          "secret": true
        },
        {
          "key": "workspaceId",
          "label": "Botpress workspace ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.botpress.cloud"
    ]
  },
  "models": [
    "workspace",
    "bot",
    "account",
    "member",
    "integration",
    "issue"
  ],
  "http": {
    "baseUrl": "https://api.botpress.cloud/v1/admin",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "x-workspace-id": "{{workspaceId}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors.0.message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Botpress token and workspace ID by listing bots.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/bots",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "workspaces.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "List workspaces",
      "description": "List Botpress workspaces accessible to the connected API token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nextToken": {
            "type": "string",
            "minLength": 1
          },
          "handle": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/workspaces",
        "success": [
          200
        ],
        "query": {
          "nextToken": "{{nextToken}}",
          "handle": "{{handle}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "bots.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
