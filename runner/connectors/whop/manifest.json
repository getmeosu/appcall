{
  "key": "whop",
  "name": "Whop",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "payments"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Whop API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.whop.com"
    ]
  },
  "models": [
    "account",
    "product",
    "membership",
    "payment",
    "member",
    "plan",
    "checkout-configuration",
    "promo-code",
    "refund"
  ],
  "http": {
    "baseUrl": "https://api.whop.com/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Api-Version-Date": "2026-07-01"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "error",
        "message",
        "detail"
      ]
    }
  },
  "operations": {
