{
  "key": "beehiiv",
  "name": "Beehiiv",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing",
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Beehiiv API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.beehiiv.com"
    ]
  },
  "models": [
    "publication",
    "post",
    "subscription",
    "custom-field",
    "segment",
    "automation",
    "tier",
    "webhook",
    "author"
  ],
  "http": {
    "baseUrl": "https://api.beehiiv.com/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
