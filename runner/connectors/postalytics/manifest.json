{
  "key": "postalytics",
  "name": "Postalytics",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Postalytics API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.postalytics.com"
    ]
  },
  "models": [
    "account",
    "campaign",
    "contact_list",
    "contact",
    "template",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.postalytics.com/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "error"
      ]
    }
  },
