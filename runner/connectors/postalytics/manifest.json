    "campaigns.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create campaign",
      "description": "Create a Postalytics direct-mail campaign from a proofed template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "creditTypeId": {
            "type": "integer",
            "description": "Media type id for the campaign."
          },
          "directMailName": {
            "type": "string",
            "description": "Campaign name.",
            "minLength": 1
          },
          "postageType": {
            "type": "integer",
            "description": "Postage type id."
          },
          "senderCity": {
            "type": "string",
            "description": "Sender city.",
            "minLength": 1
          },
          "senderState": {
            "type": "string",
            "description": "Sender state.",
            "minLength": 1
          },
          "senderZip": {
            "type": "string",
            "description": "Sender zip code.",
            "minLength": 1
          },
          "templateFrontId": {
            "type": "integer",
            "description": "Proofed template id."
          }
        },
        "additionalProperties": false,
        "required": [
          "creditTypeId",
          "directMailName",
          "postageType",
          "senderCity",
          "senderState",
          "senderZip",
          "templateFrontId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/campaigns",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "CreditTypeId": "{{creditTypeId}}",
          "DirectMailName": "{{directMailName}}",
          "PostageType": "{{postageType}}",
          "SenderCity": "{{senderCity}}",
          "SenderState": "{{senderState}}",
          "SenderZip": "{{senderZip}}",
          "TemplateFrontId": "{{templateFrontId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
