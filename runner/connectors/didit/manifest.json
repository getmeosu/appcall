        "path": "/v3/workflows/{{workflowVersionId}}/",
        "success": [
          200
        ]
      }
    },
    "businesses.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "List Businesses",
      "description": "List KYB business profiles for this application. Didit's list endpoint has no filter or search parameters.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum rows in this page. Didit defaults to 50 when omitted. At least 1."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based number of rows to skip. Didit returns next and previous URLs in the JSON body; this connector does not accept or follow those URLs."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v3/businesses/",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "success": [
          200
        ]
      }
    },
    "users.list": {
