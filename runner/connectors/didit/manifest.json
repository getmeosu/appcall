      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum rows in this page. Didit defaults to 50 when omitted. At least 1."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based number of rows to skip. Didit returns next and previous URLs in the JSON body; this connector does not accept or follow those URLs."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v3/users/",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "success": [
          200
        ]
      }
    },
    "sessions.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List Verification Sessions",
      "description": "List one page of KYC, KYB, or standalone verification sessions. session_kind all is a single Didit route with concatenated pagination; call user and business separately when a stable cursor matters.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionKind": {
            "type": "string",
            "enum": [
              "user",
              "business",
              "all"
            ],
            "description": "user lists KYC sessions, business lists KYB sessions, and all concatenates both on this same route."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum rows in this page. Didit defaults to 50 when omitted. At least 1."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based number of rows to skip. Didit returns next and previous URLs in the JSON body; this connector does not accept or follow those URLs."
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Comma-separated case-sensitive statuses, for example Approved,In Review."
          },
          "vendorData": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Exact vendor_data match."
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Smart search across session ids, numbers, names, contact data, document data, and vendor_data."
          },
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Comma-separated workflow UUIDs. Malformed UUIDs are ignored by Didit."
          },
          "dateFrom": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Earliest creation date, UTC YYYY-MM-DD."
          },
          "dateTo": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Latest creation date, UTC YYYY-MM-DD. KYB compares against midnight."
          },
          "country": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Comma-separated country codes. KYC uses alpha-3 document issuing states; KYB uses the registry country."
          },
          "apiService": {
            "type": "string",
            "enum": [
              "ID_VERIFICATION",
              "FACE_MATCH",
              "AGE_ESTIMATION",
              "FACE_SEARCH",
              "POA",
              "AML",
              "KYB_REGISTRY",
              "PASSIVE_LIVENESS",
              "DATABASE_VALIDATION",
              "PHONE_VERIFICATION",
              "EMAIL_VERIFICATION"
            ],
            "description": "Restrict standalone API sessions to one Didit service."
          },
          "warning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Comma-separated warning risk codes. A session matches if it raised any of them."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v3/sessions/",
        "query": {
          "session_kind": "{{sessionKind}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "status": "{{status}}",
          "vendor_data": "{{vendorData}}",
          "search": "{{search}}",
          "workflow_id": "{{workflowId}}",
          "date_from": "{{dateFrom}}",
          "date_to": "{{dateTo}}",
          "country": "{{country}}",
          "api_service": "{{apiService}}",
          "warning": "{{warning}}"
        },
        "success": [
          200
        ]
      }
    },
    "workflows.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 8192,
