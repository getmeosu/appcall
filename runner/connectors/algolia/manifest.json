{
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "key": "algolia",
  "name": "Algolia",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Algolia API key",
          "required": true,
          "secret": true
        },
        {
          "key": "applicationId",
          "label": "Algolia application ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.algolia.net"
    ]
  },
  "models": [
    "index",
    "record",
    "search"
  ],
  "http": {
    "baseUrl": "https://{{applicationId}}-dsn.algolia.net",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-algolia-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "x-algolia-application-id": "{{applicationId}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Healthcheck",
      "description": "Validate Algolia credentials by listing indices.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/1/indexes"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "indices.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List indices",
      "description": "List Algolia indices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "hitsPerPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/1/indexes",
        "query": {
          "page": "{{page}}",
          "hitsPerPage": "{{hitsPerPage}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "index.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search index",
      "description": "Search one Algolia index with a fixed POST request.",
      "inputSchema": {
        "type": "object",
        "required": [
          "indexName"
        ],
        "properties": {
          "indexName": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/1/indexes/{{indexName}}/query",
        "body": {
          "query": "{{query}}"
        },
        "query": {},
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "records.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get record",
      "description": "Retrieve one Algolia record.",
      "inputSchema": {
        "type": "object",
        "required": [
          "indexName",
          "objectID"
        ],
        "properties": {
          "indexName": {
            "type": "string",
            "minLength": 1
          },
          "objectID": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/1/indexes/{{indexName}}/{{objectID}}"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
