      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "List Stories",
      "description": "List currently live Stories for the bound professional account.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
