          "metric"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "insights": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{mediaId}}/insights",
        "success": [
          200
        ],
        "result": {
          "insights": "{{response.data}}"
        },
        "query": {
          "metric": "{{metric}}"
        }
      }
    },
    "tags.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "List Tagged Media",
      "description": "List media in which the bound professional account is tagged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "after": {
            "type": "string",
            "description": "Opaque after cursor from a prior response."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "media": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{instagramUserId}}/tags",
        "success": [
          200
        ],
        "result": {
          "media": "{{response.data}}",
          "nextCursor": "{{response.paging.cursors.after}}"
        },
        "query": {
          "fields": "id,caption,media_type,permalink,timestamp,username",
          "after": "{{after}}"
        }
      }
    },
