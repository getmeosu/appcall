    "products.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create product",
      "description": "Create a product in Zylvie.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Product title.",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "description": "Unique vanity URL slug.",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "description": "Lowercase ISO 4217 currency code.",
            "minLength": 3
          },
          "price": {
            "type": "number",
            "description": "Base product price.",
            "minimum": 0
          },
          "pricing_model": {
            "type": "string",
            "description": "Billing model.",
            "enum": [
              "one-time",
              "subscription",
              "delayed"
            ]
          },
          "display": {
            "type": "string",
            "description": "Storefront display.",
            "enum": [
              "featured",
              "listed",
              "unlisted",
              "unpublished"
            ]
          },
          "subtitle": {
            "type": "string",
            "description": "Product subtitle."
          },
          "interval": {
            "type": "string",
            "description": "Subscription interval.",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ]
          },
          "interval_count": {
            "type": "integer",
            "description": "Billing interval count.",
            "minimum": 1
          },
          "is_licensed": {
            "type": "boolean",
            "description": "Whether purchases receive license keys."
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "currency",
          "price",
          "pricing_model",
          "display"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/products/create",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "title": "{{title}}",
          "url": "{{url}}",
          "currency": "{{currency}}",
          "price": "{{price}}",
          "pricing_model": "{{pricing_model}}",
          "display": "{{display}}",
          "subtitle": "{{subtitle}}",
          "interval": "{{interval}}",
          "interval_count": "{{interval_count}}",
          "is_licensed": "{{is_licensed}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
