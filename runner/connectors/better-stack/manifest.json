          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "resolved": {
            "type": "boolean"
          },
          "acknowledged": {
            "type": "boolean"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "incidents"
        ],
        "properties": {
          "incidents": {
            "type": "array"
          },
          "pagination": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/incidents",
        "query": {
          "team_name": "{{teamName}}",
          "page": "{{page}}",
          "per_page": "{{perPage}}",
          "resolved": "{{resolved}}",
          "acknowledged": "{{acknowledged}}"
        },
        "success": [
          200
        ],
        "result": {
          "incidents": "{{response.data}}",
          "pagination": "{{response.pagination}}"
        }
      },
      "enforceOutputSchema": true
    },
