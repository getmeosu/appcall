{
  "key": "better-stack",
  "name": "Better Stack",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Better Stack API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    },
    "evidence": {
      "fixture": {
        "status": "supplied"
      },
      "live": {
        "status": "unverified"
      }
    }
  },
  "network": {
    "allowedHosts": [
      "uptime.betterstack.com"
    ]
  },
  "models": [
    "incident",
    "comment",
    "monitor",
    "heartbeat",
    "status-page",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://uptime.betterstack.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.detail",
        "message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify the Better Stack API token by listing one incident.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "incidents"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "incidents": {
            "type": "array"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/incidents",
        "query": {
          "per_page": "1"
        },
        "success": [
          200
        ],
        "result": {
          "status": "ok",
          "incidents": "{{response.data}}"
        }
      },
      "enforceOutputSchema": true
    },
    "incidents.list": {
      "kind": "action",
