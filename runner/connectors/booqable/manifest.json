{
  "key": "booqable",
  "name": "Booqable",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Booqable access token",
          "required": true,
          "secret": true
        },
        {
          "key": "companySlug",
          "label": "Booqable company slug",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.booqable.com"
    ]
  },
  "models": [
    "company",
    "customer",
    "order",
    "productGroup",
    "product",
    "document",
    "stockItem"
  ],
  "http": {
    "baseUrl": "https://{{companySlug}}.booqable.com/api/4",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors.0.detail",
        "errors.0.title"
      ]
    }
  },
