          "accept": "application/json",
          "content-type": "application/json"
        },
        "body": "{\"description\":\"south wall after rain\"}"
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json"
        },
        "bodyFile": "../responses/photo-described.json"
      }
