{
  "schemaVersion": 1,
  "id": "photos-description-set-success",
  "operation": "photos.description.set",
  "input": {
    "photoId": "photo-1",
    "description": "south wall after rain"
  },
  "credentials": {
    "apiKey": "fixture-cc-token"
  },
  "evidence": {
