{
  "schemaVersion": 1,
  "id": "projects-create-with-address-success",
  "operation": "projects.create",
  "input": {
    "name": "Psych Office",
    "userEmail": "shawn@psych.co",
    "address": {
      "street_address_1": "123 Main St",
      "city": "Santa Barbara",
      "state": "CA",
      "postal_code": "93101",
      "country": "US"
    }
  },
  "credentials": {
    "apiKey": "fixture-cc-token"
  },
  "evidence": {
    "documentationUrls": [
      "https://companycam.readme.io/reference/createproject"
    ],
    "basis": "Create Project accepts Address with street_address_1 and optional X-CompanyCam-User."
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.companycam.com/v2/projects",
        "headers": {
          "authorization": "Bearer fixture-cc-token",
          "accept": "application/json",
          "content-type": "application/json",
          "x-companycam-user": "shawn@psych.co"
        },
        "body": "{\"name\":\"Psych Office\",\"address\":{\"street_address_1\":\"123 Main St\",\"city\":\"Santa Barbara\",\"state\":\"CA\",\"postal_code\":\"93101\",\"country\":\"US\"}}"
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json"
        },
        "bodyFile": "../responses/created-project.json"
      }
    }
  ],
  "expected": {
    "kind": "success",
    "resultFile": "../expected/created-project.json"
  }
}
