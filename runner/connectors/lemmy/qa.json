{
  "connector": "lemmy",
  "scenarios": [
    {
      "name": "authenticate without changing content",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "status",
            "op": "eq",
            "value": "ok"
          },
          {
            "path": "counts.replies",
            "op": "type",
            "value": "number"
          }
        ]
      }
    },
    {
      "name": "read posts",
      "operation": "post.list",
      "input": {
        "limit": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "posts",
            "op": "type",
            "value": "array"
          }
        ]
      }
    },
    {
      "name": "read communities",
      "operation": "community.list",
      "input": {
        "limit": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "communities",
            "op": "type",
            "value": "array"
          }
        ]
      }
    }
  ]
}
