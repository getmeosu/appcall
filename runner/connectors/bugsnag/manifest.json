{
  "key": "bugsnag",
  "name": "Bugsnag",
  "version": "0.3.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Bugsnag personal auth token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.bugsnag.com"
    ]
  },
  "models": [
    "user",
    "organization",
    "project",
    "error",
    "event",
    "comment",
    "release",
    "collaborator"
  ],
  "http": {
    "baseUrl": "https://api.bugsnag.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "token {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Healthcheck",
      "description": "Validate the Bugsnag personal auth token.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "organizations.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Organizations",
      "description": "List organizations accessible to the Bugsnag token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "admin": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user/organizations",
        "query": {
          "admin": "{{admin}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "projects.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Projects",
      "description": "List Bugsnag projects for an organization, returning the provider Link header for the next page when present.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "description": "Bugsnag organization id."
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page; use the returned link to request the next page when present."
          }
        },
        "required": [
          "organization_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "link": {
            "type": "string",
            "description": "Provider Link header containing pagination URLs, including rel=next when another page exists."
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/organizations/{{organization_id}}/projects",
        "query": {
          "per_page": "{{per_page}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}",
          "link": "{{headers.link}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
