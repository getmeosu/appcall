{
  "key": "kommo",
  "name": "Kommo",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Kommo long-lived token",
          "required": true,
          "secret": true
        },
        {
          "key": "subdomain",
          "label": "Kommo account subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.kommo.com"
    ]
  },
  "models": [
    "account",
    "lead",
    "contact",
    "pipeline",
    "user",
    "company",
    "task",
    "note",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://{{subdomain}}.kommo.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "title",
        "message",
        "error",
        "error_description"
      ]
    }
  },
  "operations": {
