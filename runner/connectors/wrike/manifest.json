{
  "key": "wrike",
  "name": "Wrike",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Wrike permanent access token",
          "required": true,
          "secret": true
        }
      ],
      "docsUrl": "https://developers.wrike.com/api/v4/"
    }
  },
  "network": {
    "allowedHosts": [
      "www.wrike.com"
    ]
  },
  "models": [
    "contact",
    "folder",
    "task",
    "comment",
    "attachment",
    "workflow"
  ],
  "http": {
    "baseUrl": "https://www.wrike.com/api/v4",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errorDescription",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Wrike token by listing the authenticated contact.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "contacts"
        ],
        "properties": {
          "contacts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/contacts",
        "query": {
          "me": true
        },
        "success": [
          200
        ],
        "result": {
          "contacts": "{{response.data}}"
        }
      },
      "enforceOutputSchema": true
    },
    "contacts.list": {
      "kind": "action",
