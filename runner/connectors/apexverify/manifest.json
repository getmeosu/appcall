{
  "key": "apexverify",
  "name": "ApexVerify",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "ApexVerify API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.apexverify.com"
    ]
  },
  "models": [
    "account",
    "batch",
    "unit"
  ],
  "http": {
    "baseUrl": "https://api.apexverify.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "detail.0.msg"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the ApexVerify API key by reading account credit balances.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v1/account/credits",
        "success": [
          200
        ]
      }
    },
    "account.credits.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Account Credits",
      "description": "Return the account email and phone verification credit balances.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v1/account/credits",
        "success": [
          200
        ]
      }
    },
    "batches.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List Batches",
      "description": "List verification batches, optionally filtered by creation time, one offset page at a time.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum batches for this page. ApexVerify defaults to 100 and documents no maximum."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based number of batches to skip."
          },
          "fromDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Include batches created at or after this ISO 8601 timestamp."
          },
          "toDate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Include batches created at or before this ISO 8601 timestamp."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v1/batch",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "from_date": "{{fromDate}}",
          "to_date": "{{toDate}}"
        },
        "success": [
          200
        ]
      }
    },
    "batches.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Batch Details",
      "description": "Get one batch status, metadata, parameters, parsed-content counts, estimated cost, and final statistics.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batchUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Batch UUID returned by ApexVerify."
          }
        },
        "required": [
          "batchUuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v1/batch/{{batchUuid}}/details",
        "success": [
          200
        ]
      }
    },
    "batches.prepare": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Prepare Batch",
      "description": "Start or repeat asynchronous parsing, deduplication, and cost calculation for an uploaded batch. Does not launch paid verification.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batchUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Batch UUID returned by ApexVerify."
          }
        },
        "required": [
          "batchUuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "PATCH",
        "path": "/v1/batch/{{batchUuid}}",
        "success": [
          200
        ]
      }
    },
    "batches.launch": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Launch Batch Verification",
      "description": "Launch paid verification for a prepared batch. confirmCreditSpend must be true and is not sent to ApexVerify.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batchUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Batch UUID returned by ApexVerify."
          },
          "confirmCreditSpend": {
            "type": "boolean",
            "const": true,
            "description": "Must be true. Validated locally and never sent to ApexVerify."
          }
        },
        "required": [
          "batchUuid",
          "confirmCreditSpend"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/v1/batch/{{batchUuid}}",
        "success": [
          200
        ]
      }
    },
    "batches.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Delete Batch",
      "description": "Permanently delete one batch by UUID. confirmDeletion must be true and is not sent to ApexVerify. Deletion is refused while the batch is processing.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batchUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Batch UUID returned by ApexVerify."
          },
          "confirmDeletion": {
            "type": "boolean",
            "const": true,
            "description": "Must be true. Validated locally and never sent to ApexVerify."
          }
        },
        "required": [
          "batchUuid",
          "confirmDeletion"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "DELETE",
        "path": "/v1/batch/{{batchUuid}}",
        "success": [
          200
        ]
      }
    },
    "batches.export": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 60000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 26214400,
      "title": "Export Batch Results",
      "description": "Export a completed batch as JSON. format must be json. The XLSX workbook is a binary download and is not offered.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batchUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Batch UUID returned by ApexVerify."
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "json"
            ],
            "description": "JSON export only. XLSX is a binary workbook and is rejected."
          },
          "includeDetails": {
            "type": "boolean",
            "description": "Include per-value verification details in the JSON export."
          },
          "includeStatistics": {
            "type": "boolean",
            "description": "Include aggregate verification statistics in the JSON export."
          }
        },
        "required": [
          "batchUuid",
          "format"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/v1/batch/{{batchUuid}}/export",
        "query": {
          "format": "{{format}}",
          "include_details": "{{includeDetails}}",
          "include_statistics": "{{includeStatistics}}"
        },
        "success": [
          200
        ]
      }
    },
    "units.verify": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "title": "Verify Email or Phone",
      "description": "Verify one email address or phone number. This spends a prepaid credit. confirmCreditUsage must be true and is not sent to ApexVerify. Audience, industry, and objective use ApexVerify numeric codes, not display labels.",
