{
  "key": "datadog",
  "name": "Datadog",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Datadog API key",
          "required": true,
          "secret": true
        },
        {
          "key": "applicationKey",
          "label": "Datadog application key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.datadoghq.com"
    ]
  },
  "models": [
    "monitor",
    "metric",
    "dashboard",
    "event",
    "downtime",
    "host",
    "incident"
  ],
  "http": {
    "baseUrl": "https://api.datadoghq.com",
    "headers": {
      "DD-APPLICATION-KEY": "{{applicationKey}}"
    },
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "DD-API-KEY",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors",
        "error",
        "message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the configured Datadog API key against the US1 API.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "raw": {
            "type": "object"
          }
        },
        "required": [
          "valid"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/validate",
        "success": [
          200
        ],
        "result": {
          "valid": "{{response.valid}}",
          "raw": "{{response}}"
        }
      },
      "enforceOutputSchema": true
    },
    "monitors.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "List Monitors",
      "description": "List Datadog monitors with bounded optional filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "groupStates": {
            "type": "string",
            "minLength": 1
          },
          "withDowntimes": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "monitors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "monitors"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/monitor",
        "success": [
          200
        ],
        "query": {
          "name": "{{name}}",
          "group_states": "{{groupStates}}",
          "with_downtimes": "{{withDowntimes}}"
        },
        "result": {
          "monitors": "{{response}}"
        }
      },
      "enforceOutputSchema": true
    },
    "monitors.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Monitor",
      "description": "Retrieve one Datadog monitor by numeric ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer",
            "minimum": 1
          },
          "withDowntimes": {
            "type": "boolean"
          }
        },
        "required": [
          "monitorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/monitor/{{monitorId}}",
        "success": [
          200
        ],
        "query": {
          "with_downtimes": "{{withDowntimes}}"
        },
        "result": "{{response}}"
      },
      "enforceOutputSchema": true
    },
    "metrics.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "List Metrics",
      "description": "List Datadog metrics active since a Unix timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "tagFilter": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "metrics"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/metrics",
        "success": [
          200
        ],
        "query": {
          "from": "{{from}}",
          "host": "{{host}}",
          "tag_filter": "{{tagFilter}}"
        },
        "result": "{{response}}"
      },
      "enforceOutputSchema": true
    },
    "monitors.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Monitor",
      "description": "Create a Datadog monitor from a type, query, and optional name and message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Monitor type, for example metric alert."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Monitor query."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "message": {
            "type": "string",
            "description": "Notification message."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Monitor tags."
          }
        },
        "required": [
          "type",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/monitor",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "type": "{{type}}",
          "query": "{{query}}",
          "name": "{{name}}",
          "message": "{{message}}",
          "tags": "{{tags}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "monitors.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update Monitor",
      "description": "Update a Datadog monitor query, name, or message by numeric ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer",
            "minimum": 1,
            "description": "Monitor ID."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Updated monitor query."
          },
          "name": {
            "type": "string",
            "description": "Updated display name."
          },
          "message": {
            "type": "string",
            "description": "Updated notification message."
          }
        },
        "required": [
          "monitorId",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/api/v1/monitor/{{monitorId}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "query": "{{query}}",
          "name": "{{name}}",
          "message": "{{message}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "monitors.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete Monitor",
      "description": "Delete a Datadog monitor by numeric ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer",
            "minimum": 1,
            "description": "Monitor ID."
          }
        },
        "required": [
          "monitorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "monitorId": {
            "type": "integer"
          }
        },
        "required": [
          "deleted",
          "monitorId"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/api/v1/monitor/{{monitorId}}",
        "success": [
          200,
          204
        ],
        "result": {
          "deleted": true,
          "monitorId": "{{input.monitorId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "monitors.mute": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Mute Monitor",
      "description": "Mute a Datadog monitor, optionally until a Unix end timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer",
            "minimum": 1,
            "description": "Monitor ID."
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp when muting ends."
          }
        },
        "required": [
          "monitorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/monitor/{{monitorId}}/mute",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "end": "{{end}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "monitors.unmute": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Unmute Monitor",
      "description": "Unmute a previously muted Datadog monitor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer",
            "minimum": 1,
            "description": "Monitor ID."
          }
        },
        "required": [
          "monitorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/monitor/{{monitorId}}/unmute",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "metrics.query": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Query Metrics",
      "description": "Query Datadog timeseries points between two Unix timestamps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 0,
            "description": "Start Unix timestamp."
          },
          "to": {
            "type": "integer",
            "minimum": 0,
            "description": "End Unix timestamp."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Datadog metric query."
          }
        },
        "required": [
          "from",
          "to",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/query",
        "success": [
          200
        ],
        "query": {
          "from": "{{from}}",
          "to": "{{to}}",
          "query": "{{query}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "dashboards.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Dashboards",
