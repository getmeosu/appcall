      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Dashboard",
      "description": "Retrieve one Datadog dashboard by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dashboardId": {
            "type": "string",
