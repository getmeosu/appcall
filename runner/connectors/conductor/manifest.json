    "workspaces.list": {
      "description": "List cloud workspaces visible to the caller via GET /v0/workspaces. Maps to CONDUCTOR_LIST_WORKSPACES.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum rows to return.",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "description": "Number of rows to skip.",
            "minimum": 0
          },
          "channel": {
            "type": "string",
            "minLength": 1,
            "description": "Desktop-app channel the returned deepLink should open.",
            "enum": [
              "prod",
              "alpha",
              "alpha-chromium",
              "beta",
              "patch",
              "dev"
            ]
          },
          "creator": {
            "type": "string",
            "minLength": 1,
            "description": "Filter by creator user id."
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "description": "Filter by workspace state. Repeat or pass comma-separated values."
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "Repository URL substring or repository id."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Filter by workspace name substring."
          },
          "since": {
            "type": "string",
            "minLength": 1,
            "description": "ISO-8601 lower bound on lastActivityAt."
          },
          "includeArchived": {
            "type": "boolean",
            "description": "Include archived workspaces. Defaults to false."
          }
        }
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "type": "object",
