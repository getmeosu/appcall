    "workspaces.create": {
      "description": "Create a cloud workspace and its first session via POST /v0/workspaces. Pass projectId or repositoryUrl. Maps to CONDUCTOR_CREATE_WORKSPACE.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "description": "Project id from List projects. Required unless repositoryUrl is set."
          },
          "repositoryUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Git remote URL when creating from a repository instead of a project id."
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "description": "Git branch to check out."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace name. Also names the git branch when unset on the agent side."
          },
          "sessionName": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the first session."
          },
          "agent": {
            "type": "string",
            "minLength": 1,
            "description": "Coding agent that runs the session.",
            "enum": [
              "claude",
              "codex",
              "cursor",
              "acp"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Model id accepted by the chosen agent. Invalid agent/model pairs return 400."
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "description": "Thinking effort for claude and codex sessions.",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "fastMode": {
            "type": "boolean",
            "description": "Enable fast mode for models that support it."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Optional first prompt queued on the new session."
          },
          "channel": {
            "type": "string",
            "minLength": 1,
            "description": "Desktop-app channel the returned deepLink should open.",
            "enum": [
              "prod",
              "alpha",
              "alpha-chromium",
              "beta",
              "patch",
              "dev"
            ]
          }
        }
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "type": "object",
