{
  "key": "helpdesk",
  "name": "HelpDesk",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accountId",
          "label": "HelpDesk account ID",
          "required": true,
          "secret": false
        },
        {
          "key": "apiKey",
          "label": "HelpDesk personal access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.helpdesk.com"
    ]
  },
  "models": [
    "ticket",
    "agent",
    "team",
    "tag",
    "canned_response",
    "view",
    "macro",
    "webhook",
    "license",
    "custom_field"
  ],
  "http": {
    "baseUrl": "https://api.helpdesk.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{accountId}}",
        "password": "{{apiKey}}"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error.message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate HelpDesk.com credentials by listing agents.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/agents",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List tickets",
      "description": "List HelpDesk.com tickets with bounded status, silo, and cursor-sort filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "onhold",
              "solved",
              "closed"
            ]
          },
          "silo": {
            "type": "string",
            "enum": [
              "tickets",
              "archive",
              "trash",
              "spam"
            ]
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "createdAt",
              "updatedAt",
              "lastMessageAt"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/tickets",
        "query": {
          "status": "{{status}}",
          "silo": "{{silo}}",
          "pageSize": "{{pageSize}}",
          "order": "{{order}}",
          "sortBy": "{{sortBy}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get ticket",
      "description": "Get one HelpDesk.com ticket by UUID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ticketId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/tickets/{{ticketId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create ticket",
      "description": "Create a HelpDesk.com ticket with requester and an initial message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "Ticket subject."
          },
          "requesterEmail": {
            "type": "string",
            "minLength": 1,
            "description": "Requester email."
          },
          "requesterName": {
            "type": "string",
            "description": "Requester display name."
          },
          "messageText": {
            "type": "string",
            "minLength": 1,
            "description": "Initial plaintext message."
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "onhold",
              "solved",
              "closed"
            ],
            "description": "Ticket status."
          },
          "priority": {
            "type": "integer",
            "enum": [
              -10,
              0,
              10,
              20
            ],
            "description": "Ticket priority."
          }
        },
        "required": [
          "subject",
          "requesterEmail",
          "messageText"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/tickets",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "subject": "{{subject}}",
          "status": "{{status}}",
          "priority": "{{priority}}",
          "requester": {
            "email": "{{requesterEmail}}",
            "name": "{{requesterName}}"
          },
          "message": {
            "text": "{{messageText}}"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update ticket",
      "description": "Patch a HelpDesk.com ticket subject, status, priority, or follow-up message.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticketId": {
            "type": "string",
            "minLength": 1,
            "description": "Ticket UUID."
          },
          "subject": {
            "type": "string",
            "description": "Updated subject."
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "onhold",
              "solved",
              "closed"
            ],
            "description": "Updated status."
          },
          "priority": {
            "type": "integer",
            "enum": [
              -10,
              0,
              10,
              20
            ],
            "description": "Updated priority."
          },
          "messageText": {
            "type": "string",
            "description": "Follow-up plaintext message."
          }
        },
        "required": [
          "ticketId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "PATCH",
        "path": "/v1/tickets/{{ticketId}}",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "subject": "{{subject}}",
          "status": "{{status}}",
          "priority": "{{priority}}",
          "message": {
            "text": "{{messageText}}"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Delete ticket",
      "description": "Delete a HelpDesk.com ticket by UUID.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticketId": {
            "type": "string",
            "minLength": 1,
            "description": "Ticket UUID."
          }
        },
        "required": [
          "ticketId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleted",
          "ticketId"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "ticketId": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/v1/tickets/{{ticketId}}",
        "success": [
          200,
          204
        ],
        "result": {
          "deleted": true,
          "ticketId": "{{input.ticketId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
