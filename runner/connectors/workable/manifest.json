    "recruiter",
    "background_check"
  ],
  "http": {
    "baseUrl": "https://{{account}}.workable.com/spi/v3",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 10,
      "messagePaths": [
        "error",
        "message"
      ]
    }
  }
