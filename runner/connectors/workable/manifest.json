{
  "key": "workable",
  "name": "Workable",
  "version": "0.6.2",
  "runtime": "bun",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "bearer",
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accessToken",
          "label": "API token",
          "required": true,
          "secret": true
        },
        {
          "key": "account",
          "label": "Account subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.workable.com",
      "workable.com"
    ]
  },
  "operations": {
    "jobs.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List jobs",
      "description": "List account jobs via SPI GET /jobs. Optional state, limit, sinceId, maxId, createdAfter, updatedAfter, and includeFields filters.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "Job state: draft, published, closed, or archived."
          },
          "limit": {
            "type": "string",
            "description": "Page size, up to 100."
          },
          "sinceId": {
            "type": "string",
            "description": "Return jobs with an ID greater than or equal to this value."
          },
          "maxId": {
            "type": "string",
            "description": "Return jobs with an ID less than or equal to this value."
          },
          "createdAfter": {
            "type": "string",
            "description": "Return jobs created after this timestamp."
          },
          "updatedAfter": {
            "type": "string",
            "description": "Return jobs updated after this timestamp."
          },
          "includeFields": {
            "type": "string",
            "description": "Comma-separated extra job fields such as description or requirements."
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/jobs",
        "query": {
          "state": "{{state}}",
          "limit": "{{limit}}",
          "since_id": "{{sinceId}}",
          "max_id": "{{maxId}}",
          "created_after": "{{createdAfter}}",
          "updated_after": "{{updatedAfter}}",
          "include_fields": "{{includeFields}}"
        },
        "success": [
          200
        ]
      }
    },
    "jobs.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get job",
      "description": "Fetch a single job by shortcode via SPI GET /jobs/{shortcode}.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shortcode": {
            "type": "string",
            "description": "Job shortcode."
          }
        },
        "additionalProperties": false,
        "required": [
          "shortcode"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/jobs/{{shortcode}}",
        "success": [
          200
        ]
      }
    },
    "candidates.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List candidates",
      "description": "List candidates via SPI GET /candidates. Optional email, shortcode, stage, limit, sinceId, maxId, createdAfter, and updatedAfter filters.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Filter by candidate email."
          },
          "shortcode": {
            "type": "string",
            "description": "Filter by job shortcode."
          },
          "stage": {
            "type": "string",
            "description": "Filter by stage slug."
          },
          "limit": {
            "type": "string",
            "description": "Page size, up to 100."
          },
          "sinceId": {
            "type": "string",
            "description": "Return candidates with an ID greater than or equal to this value."
          },
          "maxId": {
            "type": "string",
            "description": "Return candidates with an ID less than or equal to this value."
          },
          "createdAfter": {
            "type": "string",
            "description": "Return candidates created after this timestamp."
          },
          "updatedAfter": {
            "type": "string",
            "description": "Return candidates updated after this timestamp."
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/candidates",
        "query": {
          "email": "{{email}}",
          "shortcode": "{{shortcode}}",
          "stage": "{{stage}}",
          "limit": "{{limit}}",
          "since_id": "{{sinceId}}",
          "max_id": "{{maxId}}",
          "created_after": "{{createdAfter}}",
          "updated_after": "{{updatedAfter}}"
        },
        "success": [
          200
        ]
      }
    },
    "candidates.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get candidate",
      "description": "Fetch a single candidate via SPI GET /candidates/{id}. Returns the full candidate profile.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Candidate ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/candidates/{{id}}",
        "success": [
          200
        ]
      }
    },
    "stages.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List stages",
      "description": "List recruitment pipeline stages via SPI GET /stages.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/stages",
        "success": [
          200
        ]
      }
    },
    "members.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List members",
      "description": "List account members via SPI GET /members. Optional limit, sinceId, maxId, role, shortcode, email, name, and status filters.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "string",
            "description": "Page size."
          },
          "sinceId": {
            "type": "string",
            "description": "Return members with an ID greater than or equal to this value."
          },
          "maxId": {
            "type": "string",
            "description": "Return members with an ID less than or equal to this value."
          },
          "role": {
            "type": "string",
            "description": "Recruiting role filter: admin, simple, reviewer, or no_access."
          },
          "shortcode": {
            "type": "string",
            "description": "Return collaborators on this job shortcode."
          },
          "email": {
            "type": "string",
            "description": "Exact member email."
          },
          "name": {
            "type": "string",
            "description": "Exact member full name."
          },
          "status": {
            "type": "string",
            "description": "Member status: active, inactive, or all."
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/members",
        "query": {
          "limit": "{{limit}}",
          "since_id": "{{sinceId}}",
          "max_id": "{{maxId}}",
          "role": "{{role}}",
          "shortcode": "{{shortcode}}",
          "email": "{{email}}",
          "name": "{{name}}",
          "status": "{{status}}"
        },
        "success": [
          200
        ]
      }
    },
    "events.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List events",
      "description": "List scheduled events (calls, interviews, meetings) via SPI GET /events. Optional type, limit, sinceId, maxId, startDate, endDate, candidateId, shortcode, memberId, context, and includeCancelled filters.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Event type: call, interview, or meeting."
          },
          "limit": {
            "type": "string",
            "description": "Page size."
          },
          "sinceId": {
            "type": "string",
            "description": "Return events with an ID greater than or equal to this value."
          },
          "maxId": {
            "type": "string",
            "description": "Return events with an ID less than or equal to this value."
          },
          "startDate": {
            "type": "string",
            "description": "Return events starting on or after this date."
          },
          "endDate": {
            "type": "string",
            "description": "Return events ending on or before this date."
          },
          "candidateId": {
            "type": "string",
            "description": "Filter by candidate ID."
          },
          "shortcode": {
            "type": "string",
            "description": "Filter by job shortcode."
          },
          "memberId": {
            "type": "string",
            "description": "Filter by participating member ID."
          },
          "context": {
            "type": "string",
            "description": "Event source context. user is the default for user tokens."
          },
          "includeCancelled": {
            "type": "boolean",
            "description": "Include cancelled events when true."
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/events",
        "query": {
          "type": "{{type}}",
          "limit": "{{limit}}",
          "since_id": "{{sinceId}}",
          "max_id": "{{maxId}}",
          "start_date": "{{startDate}}",
          "end_date": "{{endDate}}",
          "candidate_id": "{{candidateId}}",
          "shortcode": "{{shortcode}}",
          "member_id": "{{memberId}}",
          "context": "{{context}}",
          "include_cancelled": "{{includeCancelled}}"
        },
        "success": [
          200
        ]
      }
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify the API token with an authenticated SPI GET /stages on {account}.workable.com; source is \"provider\" only on a real provider success.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          },
          "source": {
            "type": "string",
            "enum": [
              "provider",
              "connector"
            ],
            "description": "\"provider\" only after an authenticated Workable call succeeded; \"connector\" on the no-credential setup path."
          }
        }
      },
      "sideEffect": "read",
      "request": {
        "method": "GET",
        "path": "/stages",
        "success": [
          200
        ],
        "result": {
          "status": "ok"
        },
        "echo": {
          "status": "ok"
        }
      }
    },
    "accounts.list": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 262144,
