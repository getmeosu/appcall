    "background_checks.update": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 5242880,
      "title": "Update background check",
      "description": "Publish background check status and results to Workable via PUT /checks/{id} on {account}.workable.com. Used by background check providers after a candidate consents, declines, or a report completes. When status is completed, resultsUrl is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "backgroundCheckId": {
            "type": "string",
            "description": "Workable background check identifier from the partner callback URL."
          },
          "status": {
            "type": "string",
            "description": "Background check status: pending, consented, completed, declined, or expired."
          },
          "resultsUrl": {
            "type": "string",
            "description": "Public URL of the full report on the provider site. Required when status is completed."
          },
          "check": {
            "type": "object",
            "description": "Structured results for a completed check, including overall_status and result entries.",
            "additionalProperties": true
          },
          "attachments": {
            "type": "array",
            "description": "Optional PDF attachments with description and publicly accessible URL.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "backgroundCheckId",
          "status"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "sideEffect": "write",
      "request": {
        "method": "PUT",
        "path": "/checks/{{backgroundCheckId}}",
        "baseUrl": "https://{{account}}.workable.com",
        "body": {
          "status": "{{status}}",
          "results_url": "{{resultsUrl}}",
          "check": "{{check}}",
          "attachments": "{{attachments}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "success": [
          200,
          201,
          204
        ]
      }
    }
