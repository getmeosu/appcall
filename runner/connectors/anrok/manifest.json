  "visibility": "public",
  "categories": [
    "accounting"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Anrok API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.anrok.com"
    ]
  },
  "models": [
    "customer",
    "product",
    "product-tax-category",
    "transaction",
    "certificate",
    "filing",
    "address",
    "tax-id"
  ],
  "http": {
    "baseUrl": "https://api.anrok.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail",
        "type"
      ]
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    }
  },
