  "operations": {
    "exchanges.list": {
      "description": "List known exchanges available through Massive.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "assetClass": {
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v3/reference/exchanges",
        "query": {
          "asset_class": "{{assetClass}}",
          "locale": "{{locale}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List exchanges",
      "validationMode": "strict-generated"
    },
