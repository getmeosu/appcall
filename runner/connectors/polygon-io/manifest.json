          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v3/reference/tickers",
        "query": {
          "ticker": "{{ticker}}",
          "type": "{{type}}",
          "market": "{{market}}",
          "exchange": "{{exchange}}",
          "active": "{{active}}",
          "order": "{{order}}",
          "limit": "{{limit}}",
          "sort": "{{sort}}",
          "cursor": "{{cursor}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
