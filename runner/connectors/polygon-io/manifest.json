{
  "key": "polygon-io",
  "name": "Massive (Polygon.io)",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "banking-data"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Massive (Polygon.io) API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.massive.com"
    ]
  },
  "models": [
    "ticker-type",
    "market-status",
    "exchange",
    "ticker",
    "aggregate",
    "snapshot",
    "trade",
    "quote",
    "news",
    "dividend",
    "split"
  ],
  "http": {
    "baseUrl": "https://api.massive.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "apiKey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ],
      "bodyErrorPaths": [
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Massive API key with GET /v3/reference/tickers/types.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v3/reference/tickers/types",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
