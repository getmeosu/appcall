            "minLength": 1,
            "type": "string"
          },
          "exchange": {
            "minLength": 1,
            "type": "string"
          },
          "limit": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "market": {
            "minLength": 1,
            "type": "string"
          },
          "order": {
            "enum": [
