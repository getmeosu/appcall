            "type": "string",
            "minLength": 1
          },
          "exchange": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "sort": {
            "type": "string",
            "minLength": 1
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
