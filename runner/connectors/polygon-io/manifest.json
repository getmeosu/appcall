        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "title": "Healthcheck",
      "validationMode": "strict-generated"
    },
    "market-status.get": {
      "description": "Get the current Massive market status for stocks, currencies, and indices.",
