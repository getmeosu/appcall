    "aggs.range": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Aggregate bars",
      "description": "Get aggregate OHLC bars for a ticker over a custom range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stocksTicker": {
            "type": "string",
            "minLength": 1,
            "description": "Ticker symbol such as AAPL."
          },
          "multiplier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Size of the timespan multiplier."
          },
          "timespan": {
            "type": "string",
            "minLength": 1,
            "description": "Timespan unit.",
            "enum": [
              "minute",
              "hour",
              "day",
              "week",
              "month",
              "quarter",
              "year"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive from date (YYYY-MM-DD) or millisecond timestamp."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive to date (YYYY-MM-DD) or millisecond timestamp."
          },
          "adjusted": {
            "type": "boolean",
            "description": "Whether results are split-adjusted."
          },
          "sort": {
            "type": "string",
            "minLength": 1,
            "description": "Sort order.",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000,
            "description": "Max results."
          }
        },
        "additionalProperties": false,
        "required": [
          "stocksTicker",
          "multiplier",
          "timespan",
          "from",
          "to"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/aggs/ticker/{{stocksTicker}}/range/{{multiplier}}/{{timespan}}/{{from}}/{{to}}",
        "success": [
          200
        ],
        "query": {
          "adjusted": "{{adjusted}}",
          "sort": "{{sort}}",
          "limit": "{{limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
