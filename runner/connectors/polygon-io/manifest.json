      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get market status",
      "validationMode": "strict-generated"
    },
    "ticker.get": {
      "description": "Get comprehensive details for a single Massive ticker.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "minLength": 1,
            "type": "string"
          },
