            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticker"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
