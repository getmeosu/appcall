            "type": "string"
          },
          "sort": {
            "minLength": 1,
            "type": "string"
          },
          "ticker": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v3/reference/tickers",
        "query": {
          "active": "{{active}}",
          "cursor": "{{cursor}}",
          "exchange": "{{exchange}}",
          "limit": "{{limit}}",
          "market": "{{market}}",
          "order": "{{order}}",
          "sort": "{{sort}}",
          "ticker": "{{ticker}}",
          "type": "{{type}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List tickers",
      "validationMode": "strict-generated"
