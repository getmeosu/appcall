  "unmapped_composio": [
    {
      "composio": "POLYGON_GET_CRYPTO_TICKER_BOOK",
      "reason": "Polygon removed the crypto L2 order-book endpoint; Composio marks the tool deprecated."
    },
    {
      "composio": "POLYGON_GET_FOREX_LOCALES",
      "reason": "GET /v2/reference/locales is absent from the current Massive OpenAPI."
    },
    {
      "composio": "POLYGON_GET_REFERENCE_MARKETS",
      "reason": "GET /v2/reference/markets is absent from the current Massive OpenAPI."
    }
  ],
  "notes": [
    "POLYGON_GET_SMA uses Composio field fx_ticker; native forex.sma.get takes forexTicker.",
    "POLYGON_GET_STOCKS_CUSTOM_BARS shares aggs.range with POLYGON_GET_AGGREGATES.",
    "POLYGON_GET_FUTURES_PRODUCT_SCHEDULES shares futures.schedules.list with POLYGON_GET_FUTURES_SCHEDULES.",
    "POLYGON_GET_TICKER_DETAILS_VX and POLYGON_GET_TICKER_COMPANY_DETAILS map to ticker.get (v3).",
    "POLYGON_GET_META_CONDITIONS_BY_TICKTYPE maps to conditions.list; pass dataType for the old ticktype filter.",
    "POLYGON_LAST_TRADE_FOR_A_CURRENCY_PAIR is the last forex quote endpoint.",
    "Financials v1 ticker filters are sent as the documented tickers query parameter.",
    "POLYGON_IO v1 dividend and split rows are additional tools; POLYGON_GET_DIVIDENDS and POLYGON_GET_SPLITS stay on the v3 routes."
  ]
}
