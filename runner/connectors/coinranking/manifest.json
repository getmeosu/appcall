    "coins.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get Coins",
      "description": "List coins with price, market cap, rank, and sparkline. GET /v2/coins returns a JSON data object. Tier, tag, UUID, and symbol filters use repeated [] query keys. Coinranking does not document a search query on this route.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "referenceCurrencyUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "UUID of the reference currency. Defaults to US Dollar (yhjMzLPhuIDl) when omitted."
          },
          "timePeriod": {
            "type": "string",
            "enum": [
              "1h",
              "3h",
              "12h",
              "24h",
              "7d",
              "30d",
              "3m",
              "1y",
              "3y",
              "5y"
            ],
            "description": "Window for change and sparkline."
          },
          "orderBy": {
            "type": "string",
            "enum": [
              "price",
              "marketCap",
              "24hVolume",
              "change",
              "listedAt"
            ],
            "description": "Sort field. Default on Coinranking is marketCap."
          },
          "orderDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Sort direction. Default is desc."
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Page size. Official range is 0-5000. Free plans cap lower."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "description": "Deprecated offset pagination. Maximum documented offset is 5000. Do not combine with cursor."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Cursor from a previous nextCursor or previousCursor. Do not combine with offset."
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            },
            "description": "Tier filter sent as repeated tiers[] parameters. 1 is the highest quality tier."
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Tag slug such as defi or stablecoin."
            },
            "description": "Tag filter sent as repeated tags[] parameters."
          },
          "uuids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Coin UUID."
            },
            "description": "UUID filter sent as repeated uuids[] parameters."
          },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "description": "Ticker symbol such as BTC. Symbols are not unique."
            },
            "description": "Symbol filter sent as repeated symbols[] parameters."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Coinranking status. success on a 200 response."
          },
          "data": {
            "type": "object",
            "description": "Coinranking data object. Nested lists stay inside this object so outputSchema.type remains object."
          },
          "pagination": {
            "type": "object",
            "description": "Cursor pagination when the endpoint returns it."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/coins",
        "success": [
          200
        ],
        "result": {
          "status": "{{response.status}}",
          "data": "{{response.data}}",
          "pagination": "{{response.pagination}}"
        },
        "query": {
          "referenceCurrencyUuid": "{{referenceCurrencyUuid}}",
          "timePeriod": "{{timePeriod}}",
          "orderBy": "{{orderBy}}",
          "orderDirection": "{{orderDirection}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "cursor": "{{cursor}}"
        },
        "parameters": [
          {
            "wireName": "tiers[]",
            "inputName": "tiers",
            "in": "query",
            "style": "form",
            "explode": true,
            "allowReserved": false
          },
          {
            "wireName": "tags[]",
            "inputName": "tags",
            "in": "query",
            "style": "form",
            "explode": true,
            "allowReserved": false
          },
          {
            "wireName": "uuids[]",
            "inputName": "uuids",
            "in": "query",
            "style": "form",
            "explode": true,
            "allowReserved": false
          },
          {
            "wireName": "symbols[]",
            "inputName": "symbols",
            "in": "query",
            "style": "form",
            "explode": true,
            "allowReserved": false
          }
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
