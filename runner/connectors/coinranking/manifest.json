      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get Global Crypto Market Stats",
      "description": "Retrieve global cryptocurrency market statistics. GET /v2/stats returns a JSON data object. referenceCurrencyUuid is the documented optional pricing currency.",
      "inputSchema": {
        "type": "object",
