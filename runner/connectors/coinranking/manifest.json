        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Coin UUID. Composio calls this id. Example: Qwsogvtv82FCd for Bitcoin."
          },
          "timePeriod": {
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d",
              "1y",
              "5y"
            ],
            "description": "History window accepted by this tool: 24h, 7d, 30d, 1y, or 5y."
          },
          "referenceCurrencyUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "UUID of the reference currency. Defaults to US Dollar (yhjMzLPhuIDl) when omitted."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Coinranking status. success on a 200 response."
          },
          "data": {
            "type": "object",
            "description": "Coinranking data object. Nested lists stay inside this object so outputSchema.type remains object."
          },
          "pagination": {
            "type": "object",
            "description": "Cursor pagination when the endpoint returns it."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/coin/{{id}}/price-history",
        "success": [
          200
        ],
        "result": {
          "status": "{{response.status}}",
          "data": "{{response.data}}",
          "pagination": "{{response.pagination}}"
        },
        "query": {
          "timePeriod": "{{timePeriod}}",
          "referenceCurrencyUuid": "{{referenceCurrencyUuid}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "coins.price": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get Coin Price",
      "description": "Retrieve the current price or the nearest historical price for one coin. GET /v2/coin/{uuid}/price returns JSON price and timestamp. timestamp is Unix seconds.",
