{
  "key": "coinranking",
  "name": "Coinranking",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "analytics"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Coinranking API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.coinranking.com"
    ]
  },
  "models": [
    "coin",
    "reference-currency",
    "tag",
    "stats",
    "search"
  ],
  "http": {
    "baseUrl": "https://api.coinranking.com/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-access-token",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "type"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "coins.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get Coin Details",
      "description": "Retrieve one coin from Coinranking. GET /v2/coin/{uuid} returns price, market cap, supply, links, sparkline, and description as JSON.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Coinranking coin UUID. Example: Qwsogvtv82FCd for Bitcoin."
          },
          "timePeriod": {
            "type": "string",
            "enum": [
              "1h",
              "3h",
              "12h",
              "24h",
              "7d",
              "30d",
              "3m",
              "1y",
              "3y",
              "5y"
            ],
            "description": "Window for change and sparkline. Official values: 1h, 3h, 12h, 24h, 7d, 30d, 3m, 1y, 3y, 5y."
          },
          "referenceCurrencyUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "UUID of the reference currency. Defaults to US Dollar (yhjMzLPhuIDl) when omitted."
          }
        },
        "required": [
          "uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Coinranking status. success on a 200 response."
          },
          "data": {
            "type": "object",
            "description": "Coinranking data object. Nested lists stay inside this object so outputSchema.type remains object."
          },
          "pagination": {
            "type": "object",
            "description": "Cursor pagination when the endpoint returns it."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/coin/{{uuid}}",
        "success": [
          200
        ],
        "result": {
          "status": "{{response.status}}",
          "data": "{{response.data}}",
          "pagination": "{{response.pagination}}"
        },
        "query": {
          "timePeriod": "{{timePeriod}}",
          "referenceCurrencyUuid": "{{referenceCurrencyUuid}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "coins.fiat-prices": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get Coin Fiat Prices",
      "description": "Retrieve one coin's price in every fiat reference currency. GET /v2/coin/{uuid}/fiat-prices returns a JSON prices list. Coinranking requires a Professional plan for this route.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Coinranking coin UUID. Example: Qwsogvtv82FCd for Bitcoin."
          }
        },
        "required": [
          "uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Coinranking status. success on a 200 response."
          },
          "data": {
            "type": "object",
            "description": "Coinranking data object. Nested lists stay inside this object so outputSchema.type remains object."
          },
          "pagination": {
            "type": "object",
            "description": "Cursor pagination when the endpoint returns it."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/coin/{{uuid}}/fiat-prices",
        "success": [
          200
        ],
        "result": {
          "status": "{{response.status}}",
          "data": "{{response.data}}",
          "pagination": "{{response.pagination}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "coins.history": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 10485760,
      "title": "Get Coin History",
      "description": "Retrieve historical prices for one coin. Composio names the UUID id. The current public history route is GET /v2/coin/{id}/price-history, which returns a JSON history list. There is no separate documented /history path.",
