            "minLength": 1,
            "description": "SmartRecruiters candidate id (raw id, e.g. from candidates.create or candidates.list)."
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters job id the candidate is assigned to."
          },
          "context": {
            "type": "string",
            "enum": [
              "PROFILE",
              "OFFER_FORM",
              "HIRE_FORM",
              "OFFER_APPROVAL_FORM"
            ],
            "description": "Optional form context."
          },
          "includeMultiSelect": {
            "type": "boolean",
            "description": "Include MULTI_SELECT properties (early access)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "properties"
        ],
        "properties": {
          "properties": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Properties (id, key, label, type, value, selectedValueLabels)."
          }
        }
      }
    },
    "applications.properties.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update application properties",
      "description": "Set candidate property values for a candidate's job via authenticated PUT /candidates/{id}/jobs/{jobId}/properties (204). Batch upsert, so effectPolicy is omitted. OAuth scope candidates_manage (declared per operation; not part of the default connect set). API keys need the matching SmartRecruiters user permission.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jobId",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters candidate id (raw id, e.g. from candidates.create or candidates.list)."
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters job id the candidate is assigned to."
          },
          "properties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Candidate property id or key."
                },
                "textValue": {
                  "type": "string",
                  "description": "TEXT, DATE (ISO 8601), COUNTRY (ISO 3166-1 alpha-2, lowercase), REGION (ISO 3166-2, lowercase), USER (user id) or SINGLE_SELECT (value id)."
                },
                "numberValue": {
                  "type": "number",
                  "description": "NUMBER or PERCENT."
                },
                "booleanValue": {
                  "type": "boolean",
                  "description": "BOOLEAN."
                },
                "currencyValue": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "value"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 3,
                      "description": "ISO 4217 currency code."
                    },
                    "value": {
                      "type": "number",
                      "description": "Amount."
                    }
                  },
                  "description": "CURRENCY."
                },
                "optionIds": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "MULTI_SELECT option ids; an empty array clears the field."
                }
              },
              "description": "One property value. Set at most one value field; none resets the value."
            },
            "description": "Property values to set (1-100)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "updated"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true,
            "description": "Always true on 204."
          },
          "updated": {
            "type": "integer",
            "description": "Number of property entries sent."
          }
        }
      }
    },
