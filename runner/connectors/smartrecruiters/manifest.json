    "candidates.update": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "candidates.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update candidate",
      "description": "Update candidate personal details via authenticated PATCH /candidates/{id}. Only firstName, lastName, email and phoneNumber are accepted, because candidates.get returns exactly those fields. EffectPolicy Reconcile observes via candidates.get [id]. OAuth scope candidates_manage (declared per operation; not part of the default connect set). API keys need the matching SmartRecruiters user permission.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters candidate id (raw id, e.g. from candidates.create or candidates.list)."
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "description": "First name."
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "description": "Last name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email address."
          },
          "phoneNumber": {
            "type": "string",
            "minLength": 1,
            "description": "Phone number."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate"
        ],
        "properties": {
          "candidate": {
            "description": "Normalized candidate after Reconcile via candidates.get; null when not found."
          }
        }
      }
    },
    "applications.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get application",
      "description": "Get a candidate's application to a job via authenticated GET /candidates/{id}/jobs/{jobId}: status, subStatus, startsOn, source, rejection/withdrawal reason and the application UUID (applicationId) used by interviews.list and job_applications.get. OAuth scope candidates_read (declared per operation; not part of the default connect set). API keys need the matching SmartRecruiters user permission.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jobId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters candidate id (raw id, e.g. from candidates.create or candidates.list)."
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters job id the candidate is assigned to."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "description": "Normalized application (candidateId, jobId, applicationId, status, subStatus, startsOn, source, reasonOfRejection, reasonOfWithdrawal, url); null when not found."
          }
        }
      }
    },
    "applications.update_status": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "applications.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update application status",
      "description": "Move a candidate's application to another status (stage) via authenticated PUT /candidates/{id}/jobs/{jobId}/status (204). reason is a rejection or withdrawal reason id and is only valid with status REJECTED or WITHDRAWN. EffectPolicy Reconcile observes via applications.get [id, jobId]. OAuth scope candidates_manage (declared per operation; not part of the default connect set). API keys need the matching SmartRecruiters user permission.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jobId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters candidate id (raw id, e.g. from candidates.create or candidates.list)."
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters job id the candidate is assigned to."
          },
          "status": {
            "type": "string",
            "enum": [
              "LEAD",
              "NEW",
              "IN_REVIEW",
              "INTERVIEW",
              "OFFERED",
              "HIRED",
              "REJECTED",
              "WITHDRAWN",
              "TRANSFERRED"
            ],
            "description": "Target application status."
          },
          "subStatus": {
            "type": "string",
            "minLength": 1,
            "description": "Optional sub-status label."
          },
          "startsOn": {
            "type": "string",
            "minLength": 1,
            "description": "Optional ISO 8601 date-time the status takes effect (e.g. hire start date)."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Rejection reason id (GET /configuration/rejection-reasons) or withdrawal reason id (GET /configuration/withdrawal-reasons)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "description": "Normalized application (candidateId, jobId, applicationId, status, subStatus, startsOn, source, reasonOfRejection, reasonOfWithdrawal, url); null when not found."
          }
        }
      }
    },
    "applications.status_history": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get application status history",
      "description": "List status changes for a candidate's application via authenticated GET /candidates/{id}/jobs/{jobId}/status/history. OAuth scope candidates_read and candidate_status_read (declared per operation; not part of the default connect set). API keys need the matching SmartRecruiters user permission.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jobId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters candidate id (raw id, e.g. from candidates.create or candidates.list)."
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "SmartRecruiters job id the candidate is assigned to."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "history",
          "total"
        ],
        "properties": {
          "history": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Status changes (changedOn, status, subStatus)."
          },
          "total": {
            "type": "integer",
            "description": "totalFound."
          }
        }
      }
    },
    "candidates.tags.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get candidate tags",
