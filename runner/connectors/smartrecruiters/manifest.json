{
  "key": "smartrecruiters",
  "name": "SmartRecruiters",
  "version": "0.4.0",
  "runtime": "bun",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "SmartRecruiters API key (X-SmartToken)",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.smartrecruiters.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.smartrecruiters.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-SmartToken",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "jobs.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List jobs",
      "description": "List public job postings via GET /v1/companies/{company}/postings. Optional limit and offset page through results (response total = totalFound)."
    },
    "jobs.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get job",
      "description": "Fetch a single job via authenticated GET /jobs/{id}. Distinct from public jobs.list/postings.list."
    },
    "postings.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List postings",
      "description": "List public job postings via GET /v1/companies/{company}/postings. Optional q, limit, offset, country, region, city, and department filters."
    },
    "candidates.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List candidates",
      "description": "Search candidates via authenticated GET /candidates. Optional limit, pageId, q, jobId, updatedAfter, and status filters."
    },
    "candidates.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get candidate",
      "description": "Fetch a single candidate via authenticated GET /candidates/{id}."
    },
    "users.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List users",
      "description": "List company users via authenticated GET /user-api/v201804/users. Optional limit, pageId (cursor from nextPageId), q, and updatedAfter filters. offset is deprecated and ignored (the Users API pages by pageId)."
    },
    "interviews.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List interviews",
      "description": "List interviews for an application via authenticated GET /interviews-api/v201904/interviews. Requires applicationId."
    },
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate SmartRecruiters credentials with GET /user-api/v201804/users?limit=1.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/user-api/v201804/users",
        "query": {
          "limit": 1
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "candidates.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create candidate",
      "description": "Create a candidate in the Talent Pool via authenticated POST /candidates (201 CandidateDetails). Returns the raw candidate id plus the normalized candidate. Creates omit effectPolicy. OAuth scope candidates_create (declared per operation; not part of the default connect set). API keys need the matching SmartRecruiters user permission.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "firstName",
          "lastName",
          "email"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "description": "First name."
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "description": "Last name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email address."
          },
          "phoneNumber": {
            "type": "string",
            "description": "Phone number."
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "country": {
                "type": "string",
                "minLength": 1,
                "description": "Country name."
              },
              "countryCode": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "ISO 3166-1 alpha-2 country code."
              },
              "regionCode": {
                "type": "string",
                "description": "Region code."
              },
              "region": {
                "type": "string",
                "description": "Region name."
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "description": "City."
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "description": "Latitude."
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "Longitude."
              }
            },
            "description": "Candidate location."
          },
          "web": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skype": {
                "type": "string",
                "description": "skype profile URL or handle."
              },
              "linkedin": {
                "type": "string",
                "description": "linkedin profile URL or handle."
              },
              "facebook": {
                "type": "string",
                "description": "facebook profile URL or handle."
              },
              "twitter": {
                "type": "string",
                "description": "twitter profile URL or handle."
              },
              "website": {
                "type": "string",
                "description": "website profile URL or handle."
              }
            },
            "description": "Web profiles."
          },
          "tags": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": "Candidate tags (max 100, each up to 150 characters)."
          },
          "education": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "institution": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Institution."
                },
                "degree": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Degree."
                },
                "major": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Major."
                },
                "current": {
                  "type": "boolean",
                  "description": "Currently studying."
                },
                "location": {
                  "type": "string",
                  "description": "Location."
                },
                "startDate": {
                  "type": "string",
                  "description": "Date as YYYY, YYYY-MM or YYYY-MM-DD."
                },
                "endDate": {
                  "type": "string",
                  "description": "Date as YYYY, YYYY-MM or YYYY-MM-DD."
                },
                "description": {
                  "type": "string",
                  "description": "Description."
                }
              }
            },
            "description": "Education entries."
          },
          "experience": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Job title."
                },
                "company": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Company."
                },
                "current": {
                  "type": "boolean",
                  "description": "Current position."
                },
                "startDate": {
                  "type": "string",
                  "description": "Date as YYYY, YYYY-MM or YYYY-MM-DD."
                },
                "endDate": {
                  "type": "string",
                  "description": "Date as YYYY, YYYY-MM or YYYY-MM-DD."
                },
                "location": {
                  "type": "string",
                  "description": "Location."
                },
                "description": {
                  "type": "string",
                  "description": "Description."
                }
              }
            },
            "description": "Experience entries."
          },
          "sourceDetails": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceTypeId",
              "sourceId"
            ],
            "properties": {
              "sourceTypeId": {
                "type": "string",
                "minLength": 1,
                "description": "Source type id (GET /configuration/sources)."
              },
              "sourceSubTypeId": {
                "type": "string",
                "description": "Optional source subtype id."
              },
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "description": "Source id (GET /configuration/sources/{sourceTypeId}/values)."
              }
            },
            "description": "Candidate source; omitted defaults to the API source."
          },
          "internal": {
            "type": "boolean",
            "description": "Mark the candidate as internal."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "candidate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Raw SmartRecruiters candidate id."
          },
          "candidate": {
            "type": "object",
            "description": "Normalized candidate (same shape as candidates.get)."
          }
        }
      }
    },
