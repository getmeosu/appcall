{
  "key": "cisco-meraki",
  "name": "Cisco Meraki",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Cisco Meraki Dashboard API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.meraki.com"
    ]
  },
  "models": [
    "organization",
    "network",
    "device",
    "client",
    "admin",
    "license",
    "ssid",
    "vlan",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.meraki.com/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Cisco-Meraki-API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0",
        "message",
        "error",
        "detail"
      ]
    }
  },
