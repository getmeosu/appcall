    "subscribers.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create or upsert subscriber",
      "description": "Create a MailerLite subscriber or update the existing record for the same email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Subscriber email address."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "unsubscribed",
              "unconfirmed",
              "bounced",
              "junk"
            ],
            "description": "Optional subscriber status."
          },
          "fields": {
            "type": "object",
            "additionalProperties": true,
            "description": "Custom and default field values keyed by field name."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional group ids to assign."
          }
        },
        "additionalProperties": false,
        "required": [
          "email"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/subscribers",
        "success": [
          200,
          201
        ],
        "body": {
          "email": "{{email}}",
          "status": "{{status}}",
          "fields": "{{fields}}",
          "groups": "{{groups}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
