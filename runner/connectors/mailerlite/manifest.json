        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "unsubscribed",
              "unconfirmed",
              "bounced",
              "junk"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          },
          "include_groups": {
            "type": "string",
            "enum": [
              "groups"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          },
          "links": {
            "type": "object"
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/subscribers",
        "query": {
          "filter[status]": "{{status}}",
          "limit": "{{limit}}",
          "cursor": "{{cursor}}",
          "include": "{{include_groups}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
