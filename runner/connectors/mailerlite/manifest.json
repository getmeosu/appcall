{
  "key": "mailerlite",
  "name": "MailerLite",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "MailerLite API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "connect.mailerlite.com"
    ]
  },
  "models": [
    "subscriber",
    "group",
    "field",
    "campaign",
    "automation"
  ],
  "http": {
    "baseUrl": "https://connect.mailerlite.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "errors"
      ]
    }
  },
  "operations": {
