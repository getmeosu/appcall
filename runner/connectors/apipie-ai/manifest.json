      "responseFormat": "json"
    },
    "models.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get model",
      "description": "Get a single APIpie AI model by ID via GET /v1/models/{modelId}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "Model ID.",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "modelId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/models/{{modelId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "chat.completions": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create chat completion",
      "description": "Create an OpenAI-compatible chat completion via POST /v1/chat/completions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Model ID.",
            "minLength": 1
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Chat messages.",
            "items": {
              "type": "object"
            }
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum completion tokens."
          }
        },
        "additionalProperties": false,
        "required": [
          "model",
          "messages"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "success": [
          200,
          201
        ],
        "body": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "temperature": "{{temperature}}",
          "max_tokens": "{{max_tokens}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
