    "contacts.bulk.create": {
      "description": "Create multiple contacts via POST /v3/contacts/bulk. Maps to SURVEY_MONKEY_CREATE_BULK_CONTACTS. Requires contacts_write.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contacts": {
            "type": "array",
            "minItems": 1,
            "description": "Contact objects to create. Each contact should include first_name, last_name, and either email or phone_number.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "description": "One SurveyMonkey contact. Official API requires first_name, last_name, and either email or phone_number.",
              "properties": {
                "first_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Contact first name."
                },
                "last_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Contact last name."
                },
                "email": {
