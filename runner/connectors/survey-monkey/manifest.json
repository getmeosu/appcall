    "collectors.list": {
      "description": "List collectors and distribution URLs for a SurveyMonkey survey via GET /v3/surveys/{surveyId}/collectors. Maps to SURVEY_MONKEY_GET_COLLECTORS.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "perPage": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "surveyId": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Partial match filter on collector name."
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "description": "Additional fields to include per collector: type, status, response_count, date_created, date_modified, url.",
            "items": {
              "type": "string",
              "enum": [
                "type",
                "status",
                "response_count",
                "date_created",
                "date_modified",
                "url"
              ]
            }
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "id",
              "date_modified",
              "type",
              "status",
              "name"
            ],
            "description": "Field to sort collectors by."
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "Sort order."
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "description": "Filter collectors created after this datetime (YYYY-MM-DDTHH:MM:SS)."
          },
          "endDate": {
            "type": "string",
            "minLength": 1,
            "description": "Filter collectors created before this datetime (YYYY-MM-DDTHH:MM:SS)."
          }
        },
        "required": [
          "surveyId"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v3/surveys/{{surveyId}}/collectors",
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}",
          "name": "{{name}}",
          "sort_by": "{{sortBy}}",
          "sort_order": "{{sortOrder}}",
          "start_date": "{{startDate}}",
          "end_date": "{{endDate}}"
        },
        "success": [
          200
        ],
        "parameters": [
          {
            "in": "query",
            "inputName": "include",
            "wireName": "include",
            "style": "form",
            "explode": false,
            "allowReserved": false
          }
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List collectors",
      "validationMode": "strict-generated"
    },
