                  "minLength": 1,
                  "description": "Contact email address."
                },
                "phone_number": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Contact phone number."
                },
                "custom_fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Custom field values keyed by field ID (for example '1', '2')."
                }
              }
            }
          },
          "update_existing": {
            "type": "boolean",
            "description": "Whether to update existing contacts with the same email or phone number. Defaults to false."
          }
        },
        "required": [
          "contacts"
        ]
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "type": "object",
