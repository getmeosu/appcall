{
  "key": "survey-monkey",
  "name": "SurveyMonkey",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "forms"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "SurveyMonkey access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.surveymonkey.com"
    ]
  },
  "models": [
    "user",
    "survey",
    "collector",
    "contact-list",
    "page",
    "question",
    "response",
    "webhook",
    "folder"
  ],
  "http": {
    "baseUrl": "https://api.surveymonkey.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "error.name",
        "errmsg",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the SurveyMonkey access token with GET /v3/users/me.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v3/users/me",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "surveys.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List surveys",
      "description": "List surveys available to the connected SurveyMonkey account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "folderId": {
            "type": "string",
            "minLength": 1
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "title",
              "date_modified",
              "num_responses"
            ]
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ]
          },
          "startModifiedAt": {
            "type": "string",
            "minLength": 1
          },
          "endModifiedAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v3/surveys",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}",
          "title": "{{title}}",
          "folder_id": "{{folderId}}",
          "sort_by": "{{sortBy}}",
          "sort_order": "{{sortOrder}}",
          "start_modified_at": "{{startModifiedAt}}",
          "end_modified_at": "{{endModifiedAt}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
