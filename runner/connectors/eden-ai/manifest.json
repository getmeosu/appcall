{
  "key": "eden-ai",
  "name": "Eden AI",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "artificial-intelligence"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Eden AI API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.edenai.run"
    ]
  },
  "models": [
    "anthropic-message",
    "chat-completion",
    "embedding",
    "moderation",
    "response",
    "universal-ai"
  ],
  "http": {
    "baseUrl": "https://api.edenai.run",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "detail",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "anthropic-tokens.count": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Count Anthropic Tokens",
      "description": "Count input tokens for an Anthropic-format message request without generating a reply.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Anthropic-compatible model ID whose tokenizer should be used."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered, non-empty Anthropic-format messages to measure.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant",
                    "system"
                  ],
                  "description": "Anthropic message role."
                },
                "content": {
                  "description": "Text or ordered Anthropic content blocks.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  ]
                }
              }
            }
          },
          "system": {
            "description": "System prompt as text or an ordered list of Anthropic content blocks.",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            ]
          },
          "tools": {
            "type": "array",
            "description": "Anthropic tool definitions included in the measured request.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "tool_choice": {
            "type": "object",
            "additionalProperties": true,
            "description": "Tool-selection configuration included in the measured request."
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/v1/messages/count_tokens",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "system": "{{system}}",
          "tools": "{{tools}}",
          "tool_choice": "{{tool_choice}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "anthropic-messages.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 180000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 16777216,
      "title": "Create Anthropic Message",
      "description": "Generate one non-streaming Anthropic-compatible message and return its content blocks, stop reason, and token usage.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Anthropic-compatible model ID in provider/model form."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered, non-empty Anthropic-format user and assistant messages.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant",
                    "system"
                  ],
                  "description": "Anthropic message role."
                },
                "content": {
                  "description": "Text or ordered Anthropic content blocks.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  ]
                }
              }
            }
          },
          "system": {
            "description": "System prompt as text or an ordered list of Anthropic content blocks.",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of tokens to generate; must be at least 1."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Sampling temperature from 0 through 2."
          },
          "top_p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Nucleus sampling probability from 0 through 1."
          },
          "fallbacks": {
            "type": "array",
            "maxItems": 3,
            "description": "Up to three fallback model IDs to try in order if the primary model fails.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stop_sequences": {
            "type": "array",
            "description": "Text sequences that stop generation when encountered.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/v1/messages",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "system": "{{system}}",
          "max_tokens": "{{max_tokens}}",
          "temperature": "{{temperature}}",
          "top_p": "{{top_p}}",
          "fallbacks": "{{fallbacks}}",
          "stop_sequences": "{{stop_sequences}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "chat-completions.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 180000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 16777216,
      "title": "Create Chat Completion",
      "description": "Generate one non-streaming OpenAI-compatible chat completion and return its choices, usage, and cost.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Model ID in provider/model form, or @edenai for dynamic routing."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered, non-empty text conversation sent to the model.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Message role, such as user or assistant."
                },
                "content": {
                  "description": "Text or an ordered list of content blocks.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  ]
                }
              }
            }
          },
          "fallbacks": {
            "type": "array",
            "maxItems": 3,
            "description": "Up to three model IDs to try in order if the primary model fails.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of tokens to generate; must be at least 1."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Sampling temperature from 0 through 2."
          },
          "response_format": {
            "type": "object",
            "additionalProperties": true,
            "description": "Provider-compatible response format configuration, including optional JSON Schema output."
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "minimal",
              "low",
              "medium",
              "high",
              "max",
              "xhigh",
              "disable",
              "none"
            ],
            "description": "Reasoning effort for models that support configurable reasoning."
          },
          "router_candidates": {
            "type": "array",
            "maxItems": 64,
            "description": "Candidate model IDs considered for dynamic routing. Valid only when model is @edenai.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "model",
          "messages"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/chat/completions",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "fallbacks": "{{fallbacks}}",
          "max_tokens": "{{max_tokens}}",
          "temperature": "{{temperature}}",
          "response_format": "{{response_format}}",
          "reasoning_effort": "{{reasoning_effort}}",
          "router_candidates": "{{router_candidates}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "embeddings.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 60000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 52428800,
      "title": "Create Embeddings",
      "description": "Create embeddings for one text or a batch of texts and return vectors with model, usage, and cost.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Embedding model ID in provider/model form."
          },
          "input": {
            "description": "One non-empty text or a non-empty batch of up to 2048 texts to embed.",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 2048,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "user": {
            "type": "string",
            "minLength": 1,
            "description": "Stable end-user identifier for provider abuse monitoring."
          },
          "dimensions": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Positive reduced vector size for models that support configurable dimensions."
          },
          "encoding_format": {
            "type": "string",
            "enum": [
              "float",
              "base64"
            ],
            "description": "Return each embedding as float values or a base64-encoded string."
          }
        },
        "required": [
          "model",
          "input"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/embeddings",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "input": "{{input}}",
          "user": "{{user}}",
          "dimensions": "{{dimensions}}",
          "encoding_format": "{{encoding_format}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "responses.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 180000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 16777216,
      "title": "Create Response",
      "description": "Create or continue one synchronous OpenAI Responses-compatible text response and return its ID, output, usage, and cost.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Model ID in provider/model form."
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "Text input for a new turn. Omit only when previous_response_id supplies conversation state."
          },
          "store": {
            "type": "boolean",
            "description": "Store the response so it can be retrieved later."
          },
          "fallbacks": {
            "type": "array",
            "maxItems": 3,
            "description": "Up to three fallback model IDs tried in order.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Sampling temperature from 0 through 2."
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "description": "System or developer instructions for this response. Not inherited from the previous response."
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Requested maximum output tokens."
          },
          "previous_response_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stored response ID to continue a server-managed conversation."
          }
        },
        "required": [
          "model"
        ],
        "anyOf": [
          {
            "required": [
              "input"
            ]
          },
          {
            "required": [
              "previous_response_id"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/responses",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "input": "{{input}}",
          "store": "{{store}}",
          "fallbacks": "{{fallbacks}}",
          "temperature": "{{temperature}}",
          "instructions": "{{instructions}}",
          "max_output_tokens": "{{max_output_tokens}}",
          "previous_response_id": "{{previous_response_id}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "responses.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 16777216,
      "title": "Get Response",
      "description": "Retrieve one previously stored Responses API object by ID.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "response_id": {
            "type": "string",
            "minLength": 1,
            "description": "Response ID returned by Create Response."
          }
        },
        "required": [
          "response_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v3/responses/{{response_id}}",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "text.moderate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 60000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 16777216,
      "title": "Moderate Text",
      "description": "Classify one text or a batch of texts for safety categories and return flags, scores, provider, and cost.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "description": "One text or a non-empty batch of texts to classify for safety.",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Moderation model ID in provider/model form."
          }
        },
        "required": [
          "input"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/moderations",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "input": "{{input}}",
          "model": "{{model}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "universal-ai.run": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 180000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 52428800,
      "title": "Run Universal AI",
      "description": "Run one synchronous Universal AI feature with a JSON input object and return normalized output, provider, and cost.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Full model ID in feature/subfeature/provider or feature/subfeature/provider/model form."
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "Non-empty feature-specific input object. File values are URLs or stored file IDs, not raw audio, image, or video bytes.",
            "minProperties": 1
          },
          "fallbacks": {
            "type": "array",
            "maxItems": 3,
            "description": "Up to three fallback provider names, provider/model identifiers, or full Universal AI model IDs, tried in order.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provider_params": {
            "type": "object",
            "additionalProperties": true,
            "description": "Provider-specific parameters documented for the selected feature."
          },
          "show_original_response": {
            "type": "boolean",
            "description": "Include the raw provider response in addition to the normalized output."
          }
        },
        "required": [
          "model",
          "input"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v3/universal-ai",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "input": "{{input}}",
          "fallbacks": "{{fallbacks}}",
          "provider_params": "{{provider_params}}",
          "show_original_response": "{{show_original_response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
