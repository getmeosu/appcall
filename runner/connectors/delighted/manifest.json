          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number. Default 1."
          },
          "since": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include bounces on or after this time."
          },
          "until": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include bounces on or before this time."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bounces.json",
        "query": {
          "per_page": "{{per_page}}",
          "page": "{{page}}",
          "since": "{{since}}",
          "until": "{{until}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "people.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List People",
      "description": "List people in creation order. GET /v1/people.json returns a JSON array. email and phone_number are mutually exclusive filters on this same route. page_info is the cursor from the Link rel=next header.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page. Default 20, maximum 100."
          },
          "since": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include people created on or after this time."
          },
          "until": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include people created on or before this time."
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "description": "Restrict results to this email address. Do not combine with phone_number."
          },
          "phone_number": {
            "type": "string",
            "minLength": 2,
            "description": "Restrict results to this E.164 phone number. Do not combine with email."
          },
          "page_info": {
            "type": "string",
            "minLength": 1,
            "description": "Cursor from the Link rel=next header."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/people.json",
        "query": {
          "per_page": "{{per_page}}",
          "since": "{{since}}",
          "until": "{{until}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}",
          "page_info": "{{page_info}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "survey-responses.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List Survey Responses",
      "description": "List survey responses, oldest first unless order says otherwise. GET /v1/survey_responses.json returns a JSON array. expand[] repeats for person and notes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page. Default 20, maximum 100."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number. Default 1."
          },
          "since": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include responses created on or after this time."
          },
          "until": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include responses created on or before this time."
          },
          "updated_since": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include responses updated on or after this time."
          },
          "updated_until": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp. Include responses updated on or before this time."
          },
          "trend": {
            "type": "string",
            "minLength": 1,
            "description": "Trend id. The id is the last path segment of the trend URL."
          },
          "person_id": {
            "type": "string",
            "minLength": 1,
            "description": "Restrict responses to this person id."
          },
          "person_email": {
            "type": "string",
            "minLength": 3,
            "description": "Restrict responses to this email address."
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc",
              "asc:updated_at",
              "desc:updated_at"
            ],
            "description": "Sort by creation time or updated_at. asc is the default."
          },
          "expand": {
            "type": "array",
            "maxItems": 2,
