        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "platform_id",
              "active",
              "frequency"
            ],
            "properties": {
              "platform_id": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              },
              "frequency": {
                "type": "integer"
              },
              "created_at": {
                "type": "integer"
              },
              "updated_at": {
                "type": "integer"
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/autopilot/email.json",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "autopilot.sms.configuration.get": {
