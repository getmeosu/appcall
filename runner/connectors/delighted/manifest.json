    },
    "autopilot.sms.memberships.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List Autopilot SMS Memberships",
      "description": "List SMS Autopilot memberships. GET /v1/autopilot/sms/memberships.json returns a JSON array. page_info is the cursor from the Link rel=next header.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page. Default 20, maximum 100."
          },
          "person_id": {
            "type": "string",
            "minLength": 1,
            "description": "Restrict results to this person id."
          },
          "person_email": {
            "type": "string",
            "minLength": 3,
            "description": "Restrict results to this email address."
          },
          "person_phone_number": {
            "type": "string",
            "minLength": 2,
            "description": "Restrict results to this E.164 phone number."
          },
          "page_info": {
            "type": "string",
            "minLength": 1,
            "description": "Cursor from the Link rel=next header."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/autopilot/sms/memberships.json",
        "query": {
          "per_page": "{{per_page}}",
          "person_id": "{{person_id}}",
          "person_email": "{{person_email}}",
          "person_phone_number": "{{person_phone_number}}",
          "page_info": "{{page_info}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "bounces.list": {
