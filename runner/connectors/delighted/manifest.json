{
  "key": "delighted",
  "name": "Delighted",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "surveys"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Delighted API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.delighted.com"
    ]
  },
  "models": [
    "person",
    "survey-response",
    "autopilot",
    "bounce",
    "unsubscribe"
  ],
  "http": {
    "baseUrl": "https://api.delighted.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "autopilot.email.memberships.add": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Add Person to Autopilot Email",
      "description": "Enroll a person in email Autopilot or update their properties. POST /v1/autopilot/email/memberships.json sends one JSON object. Autopilot must already be configured for email.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "person_email": {
            "type": "string",
            "minLength": 3,
            "description": "Email address to enroll or update. Required for email Autopilot."
          },
          "person_id": {
            "type": "string",
            "minLength": 1,
            "description": "Existing Delighted person id."
          },
          "person_name": {
            "type": "string",
            "minLength": 1,
            "description": "Person name."
          },
          "person_phone_number": {
            "type": "string",
            "minLength": 2,
            "description": "Phone number in E.164 format, for example +17132746524."
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom properties stored on the Autopilot membership. Special keys include question_product_name, delighted_email_subject, delighted_intro_message, locale, thank_you_message, thank_you_link_text, and thank_you_link_url."
          }
        },
        "required": [
          "person_email"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "person"
            ],
            "properties": {
              "person": {
                "type": "object"
              },
              "properties": {
                "type": "object"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/autopilot/email/memberships.json",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "person_email": "{{person_email}}",
          "person_id": "{{person_id}}",
          "person_name": "{{person_name}}",
          "person_phone_number": "{{person_phone_number}}",
          "properties": "{{properties}}"
        },
        "success": [
          201
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "autopilot.sms.memberships.add": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Add Person to Autopilot SMS",
      "description": "Enroll a person in SMS Autopilot or update their properties. POST /v1/autopilot/sms/memberships.json sends one JSON object. SMS Autopilot must already be configured.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "person_phone_number": {
            "type": "string",
            "minLength": 2,
            "description": "Phone number in E.164 format, for example +17132746524. Required for SMS Autopilot."
          },
          "person_id": {
            "type": "string",
            "minLength": 1,
            "description": "Existing Delighted person id."
          },
          "person_name": {
            "type": "string",
            "minLength": 1,
            "description": "Person name."
          },
          "person_email": {
            "type": "string",
            "minLength": 3,
            "description": "Email address of the person."
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom properties stored on the SMS Autopilot membership."
          }
        },
        "required": [
          "person_phone_number"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "person"
            ],
            "properties": {
              "person": {
                "type": "object"
              },
              "properties": {
                "type": "object"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/autopilot/sms/memberships.json",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "person_phone_number": "{{person_phone_number}}",
          "person_id": "{{person_id}}",
          "person_name": "{{person_name}}",
          "person_email": "{{person_email}}",
          "properties": "{{properties}}"
        },
        "success": [
          201
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "people.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create or Update Person",
      "description": "Create or update a person and optionally schedule a survey. POST /v1/people.json sends one JSON object. Email is required unless phone_number is set. send false skips scheduling.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "minLength": 3,
            "description": "Email address. Required when phone_number is omitted."
          },
          "phone_number": {
            "type": "string",
            "minLength": 2,
            "description": "Phone number in E.164 format. Required when email is omitted or channel is sms."
          },
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "sms"
            ],
            "description": "Survey channel. Defaults to email when omitted."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Person name."
          },
          "delay": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds to wait before sending the survey. 0 sends immediately."
          },
          "send": {
            "type": "boolean",
            "description": "Set false to save the person without scheduling a survey. Defaults to true when omitted."
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom properties for segmentation and survey text."
          },
          "last_sent_at": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp of the previous survey send."
          },
          "email_update": {
            "type": "string",
            "minLength": 3,
            "description": "Replacement email when updating an existing person."
          },
          "phone_number_update": {
            "type": "string",
            "minLength": 2,
            "description": "Replacement E.164 phone number when updating an existing person."
          }
        },
        "anyOf": [
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "phone_number"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "survey_scheduled_at": {
                "type": "integer"
              },
              "properties": {
                "type": "object"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/people.json",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "{{email}}",
          "phone_number": "{{phone_number}}",
          "channel": "{{channel}}",
          "name": "{{name}}",
          "delay": "{{delay}}",
          "send": "{{send}}",
          "properties": "{{properties}}",
          "last_sent_at": "{{last_sent_at}}",
          "email_update": "{{email_update}}",
          "phone_number_update": "{{phone_number_update}}"
        },
        "success": [
          201
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "survey-requests.pending.delete": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete Pending Survey Requests",
      "description": "Cancel every survey scheduled for one email but not yet sent. DELETE /v1/people/{person_email}/survey_requests/pending.json has no body and returns a JSON object.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "person_email": {
            "type": "string",
            "minLength": 3,
            "description": "Email whose pending survey requests should be deleted."
          }
        },
        "required": [
          "person_email"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok"
            ],
            "properties": {
              "ok": {
                "type": "boolean",
                "description": "True when Delighted accepted the request."
              }
            }
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/people/{{person_email}}/survey_requests/pending.json",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "people.delete": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete Person",
      "description": "Permanently delete a person and related survey data. DELETE /v1/people/{person_identifier} has no body. The identifier is an id, email:address, or phone_number:+E164. Success is HTTP 202 with a JSON object.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "person_identifier": {
            "type": "string",
            "minLength": 1,
            "description": "Person id, email:address, or phone_number:+E164. Examples: 24248363, email:jony@appleseed.com, phone_number:+17132746524."
          }
        },
        "required": [
          "person_identifier"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ok"
            ],
            "properties": {
              "ok": {
                "type": "boolean",
                "description": "True when Delighted accepted the request."
              }
            }
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/people/{{person_identifier}}",
        "success": [
          202
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "autopilot.email.configuration.get": {
