{
  "key": "imagekit",
  "name": "ImageKit",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "ImageKit private API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.imagekit.io"
    ]
  },
  "models": [
    "asset",
    "metadata",
    "folder",
    "cache",
    "custom_metadata_field"
  ],
  "http": {
    "baseUrl": "https://api.imagekit.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "help"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the ImageKit private API key with a one-file list.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/files",
        "success": [
          200
        ],
        "query": {
          "limit": "1"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "assets.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List assets",
      "description": "List or search ImageKit media library assets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "searchQuery": {
            "type": "string",
            "minLength": 1
          },
          "fileType": {
            "type": "string",
            "enum": [
              "all",
              "image",
              "non-image"
            ]
          },
          "sort": {
            "type": "string",
            "enum": [
              "ASC_NAME",
              "DESC_NAME",
              "ASC_CREATED",
              "DESC_CREATED",
              "ASC_UPDATED",
              "DESC_UPDATED",
              "ASC_HEIGHT",
              "DESC_HEIGHT",
              "ASC_WIDTH",
              "DESC_WIDTH",
              "ASC_SIZE",
              "DESC_SIZE",
              "ASC_RELEVANCE",
              "DESC_RELEVANCE"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "skip": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/files",
        "success": [
          200
        ],
        "query": {
          "path": "{{path}}",
          "searchQuery": "{{searchQuery}}",
          "fileType": "{{fileType}}",
          "sort": "{{sort}}",
          "limit": "{{limit}}",
          "skip": "{{skip}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get file details",
      "description": "Get details for the current version of an ImageKit file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "fileId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/files/{{fileId}}/details",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.metadata.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get uploaded file metadata",
      "description": "Get image or video metadata for an uploaded ImageKit file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "fileId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/files/{{fileId}}/metadata",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.update": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Update file details",
      "description": "Update tags or coordinates on an ImageKit file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1,
            "description": "ImageKit file ID."
          },
          "tags": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated tags."
          },
          "customCoordinates": {
            "type": "string",
            "minLength": 1,
            "description": "x,y,width,height region."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "File description."
          }
        },
        "additionalProperties": false,
        "required": [
          "fileId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/v1/files/{{fileId}}/details",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "tags": "{{tags}}",
          "customCoordinates": "{{customCoordinates}}",
          "description": "{{description}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.delete": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "destructive",
      "title": "Delete file",
      "description": "Permanently delete an ImageKit file and its versions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1,
            "description": "ImageKit file ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "fileId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/v1/files/{{fileId}}",
        "success": [
          204,
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.copy": {
      "timeoutMs": 15000,
