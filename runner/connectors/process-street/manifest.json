    "workflows.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create workflow",
      "description": "Create a Process Street workflow in a folder.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Workflow name."
          },
          "folderId": {
            "type": "string",
            "minLength": 1,
            "description": "Folder ID."
          },
          "description": {
            "type": "string",
            "description": "Optional description."
          },
          "shareLevel": {
            "type": "string",
            "minLength": 1,
            "description": "Workflow share level.",
            "enum": [
              "None",
              "Overview",
              "View",
              "Run"
            ]
          },
          "runLinkShareLevel": {
            "type": "string",
            "minLength": 1,
            "description": "Run-link share level.",
            "enum": [
              "Organization",
              "Public"
            ]
          },
          "allowComments": {
            "type": "boolean",
            "description": "Allow comments on runs."
          },
          "sharedRunsByDefault": {
            "type": "boolean",
            "description": "Share new runs by default."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "folderId",
          "shareLevel",
          "runLinkShareLevel",
          "allowComments",
          "sharedRunsByDefault"
        ]
