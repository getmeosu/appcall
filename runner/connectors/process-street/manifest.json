          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "folderId": "{{folderId}}",
          "description": "{{description}}",
          "shareLevel": "{{shareLevel}}",
          "runLinkShareLevel": "{{runLinkShareLevel}}",
          "allowComments": "{{allowComments}}",
          "sharedRunsByDefault": "{{sharedRunsByDefault}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
