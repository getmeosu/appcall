{
  "operation": "graphql.user_status.update",
  "input": {
    "message": "sample"
  },
  "request": {
    "method": "POST",
    "url": "https://api.github.com/graphql",
    "body": "{\"query\":\"mutation($input: ChangeUserStatusInput!) { changeUserStatus(input: $input) { clientMutationId } }\",\"variables\":{\"input\":{\"message\":\"sample\"}}}"
  },
  "response": {
    "status": 200,
    "body": {
      "ok": true
    }
  }
}
