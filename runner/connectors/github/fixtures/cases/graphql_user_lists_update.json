{
  "operation": "graphql.user_lists.update",
  "input": {
    "listId": "sample"
  },
  "request": {
    "method": "POST",
    "url": "https://api.github.com/graphql",
    "body": "{\"query\":\"mutation($input: UpdateUserListInput!) { updateUserList(input: $input) { clientMutationId } }\",\"variables\":{\"input\":{\"listId\":\"sample\"}}}"
  },
  "response": {
    "status": 200,
    "body": {
      "ok": true
    }
  }
}
