{
  "operation": "graphql.mutate",
  "input": {
    "body": {
      "query": "mutation AddStar($id: ID!) { addStar(input: { starrableId: $id }) { starrable { id viewerHasStarred } } }",
      "variables": {
        "id": "R_kgDOA"
      },
      "operationName": "AddStar"
    }
  },
  "request": {
    "method": "POST",
    "url": "https://api.github.com/graphql",
    "root": "addStar",
    "headers": {
      "X-Github-Next-Global-ID": "1"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "data": {
        "addStar": {
          "starrable": {
            "id": "R_kgDOA",
            "viewerHasStarred": true
          }
        }
      }
    }
  },
  "expected": {
    "data": {
      "addStar": {
        "starrable": {
          "id": "R_kgDOA",
          "viewerHasStarred": true
        }
      }
    }
  },
  "errorsOn200": {
    "response": {
      "status": 200,
      "body": {
        "data": {
          "addStar": null
        },
        "errors": [
          {
            "type": "NOT_FOUND",
            "path": [
              "addStar"
            ],
            "message": "Could not resolve to a node with the global id of 'R_kgDOA'"
          }
        ]
      }
    },
    "expectedError": {
      "code": "CONNECTOR_UPSTREAM_ERROR",
      "message": "Could not resolve to a node with the global id of 'R_kgDOA'"
    }
  },
  "insufficientScopes": {
    "response": {
      "status": 200,
      "body": {
        "data": null,
        "errors": [
          {
            "type": "INSUFFICIENT_SCOPES",
            "locations": [
              {
                "line": 1,
                "column": 30
              }
            ],
            "message": "Your token has not been granted the required scopes to execute this query. The 'addStar' field requires one of the following scopes: ['public_repo', 'repo'], but your token has only been granted the: ['read:org'] scopes. Please modify your token's scopes at: https://github.com/settings/tokens."
          }
        ]
      }
    },
    "expectedError": {
      "code": "CONNECTOR_CAPABILITY_MISSING",
      "reason": "permission_missing",
      "missingScopes": [
        "public_repo",
        "repo"
      ],
      "requiredScopes": [
        "public_repo",
        "repo"
      ],
      "reconsentRequired": true
    }
  }
}
