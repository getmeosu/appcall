{
  "operation": "graphql.query",
  "input": {
    "body": {
      "query": "query Me { viewer { login } }"
    }
  },
  "request": {
    "method": "POST",
    "url": "https://api.github.com/graphql",
    "root": "viewer",
    "headers": {
      "X-Github-Next-Global-ID": "1"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "data": {
        "viewer": {
          "login": "octocat"
        }
      }
    }
  },
  "expected": {
    "data": {
      "viewer": {
        "login": "octocat"
      }
    }
  },
  "errorsOn200": {
    "response": {
      "status": 200,
      "body": {
        "data": {
          "viewer": null
        },
        "errors": [
          {
            "type": "UNPROCESSABLE",
            "path": [
              "viewer"
            ],
            "message": "viewer rejected by GitHub"
          }
        ]
      }
    },
    "expectedError": {
      "code": "CONNECTOR_UPSTREAM_ERROR",
      "message": "viewer rejected by GitHub"
    }
  }
}
