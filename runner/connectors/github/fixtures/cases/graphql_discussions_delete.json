    "body": "{\"query\":\"mutation($input: DeleteDiscussionInput!) { deleteDiscussion(input: $input) { clientMutationId } }\",\"variables\":{\"input\":{\"id\":\"sample\"}}}"
  },
  "response": {
    "status": 200,
    "body": {
      "ok": true
    }
  }
}
