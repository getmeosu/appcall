{
  "operation": "graphql.user_lists.items.update",
  "input": {
    "itemId": "sample",
    "listIds": [
      "sample"
    ]
  },
  "request": {
    "method": "POST",
    "url": "https://api.github.com/graphql",
    "body": "{\"query\":\"mutation($input: UpdateUserListsForItemInput!) { updateUserListsForItem(input: $input) { clientMutationId } }\",\"variables\":{\"input\":{\"itemId\":\"sample\",\"listIds\":[\"sample\"]}}}"
  },
  "response": {
    "status": 200,
    "body": {
      "ok": true
    }
  }
}
