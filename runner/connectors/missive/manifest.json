{
  "key": "missive",
  "name": "Missive",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Missive API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "public.missiveapp.com"
    ]
  },
  "models": [
    "user",
    "organization",
    "team",
    "contact_book",
    "contact",
    "conversation",
    "draft",
    "post",
    "shared_label"
  ],
  "http": {
    "baseUrl": "https://public.missiveapp.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
