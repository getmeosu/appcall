{
  "key": "brex",
  "name": "Brex",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "banking-data"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Brex user token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.brex.com"
    ]
  },
  "models": [
    "user",
    "company",
    "cardAccount",
    "department",
    "location",
    "title",
    "card",
    "transaction",
    "cashAccount"
  ],
  "http": {
    "baseUrl": "https://api.brex.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "type",
        "code",
        "error"
      ]
    }
  },
