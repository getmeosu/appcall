    "orderBatches.create": {
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create order batch",
      "description": "Create a Goody order batch with a cart, recipients, and send method.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_name": {
            "type": "string",
            "minLength": 1
          },
          "send_method": {
            "type": "string",
            "enum": [
              "email_and_link",
              "link_multiple_custom_list",
              "direct_send"
            ]
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "first_name": {
                  "type": "string",
                  "minLength": 1
                },
                "last_name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                }
              },
              "required": [
                "first_name"
              ]
            }
          },
          "cart": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "product_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "product_id",
                    "quantity"
                  ]
                }
              }
            },
            "required": [
              "items"
            ]
          },
          "message": {
            "type": "string"
          },
          "card_id": {
            "type": "string"
          },
          "payment_method_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "from_name",
          "send_method",
          "recipients",
          "cart"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/order_batches",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "from_name": "{{from_name}}",
          "send_method": "{{send_method}}",
          "recipients": "{{recipients}}",
          "cart": "{{cart}}",
          "message": "{{message}}",
          "card_id": "{{card_id}}",
          "payment_method_id": "{{payment_method_id}}",
          "workspace_id": "{{workspace_id}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
