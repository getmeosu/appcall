        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/products",
        "query": {
          "page": "{{page}}",
          "per_page": "{{per_page}}",
          "country_code": "{{country_code}}",
          "use_custom_catalog": "{{use_custom_catalog}}"
        },
        "success": [
          200
