    "videos.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create video",
      "description": "Add a video to Amara via POST /videos/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "videoUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Primary video URL."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Video title."
          },
          "team": {
            "type": "string",
            "minLength": 1,
            "description": "Optional team slug."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Optional video description."
          }
        },
        "additionalProperties": false,
        "required": [
          "videoUrl"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/videos/",
        "success": [
          201
        ],
        "body": {
          "video_url": "{{videoUrl}}",
          "title": "{{title}}",
          "team": "{{team}}",
          "description": "{{description}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
