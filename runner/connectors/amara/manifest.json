          "subFormat": {
            "type": "string",
            "minLength": 1,
            "description": "Subtitle format such as vtt or srt."
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "Optional editor action such as publish."
          }
        },
        "additionalProperties": false,
        "required": [
          "videoId",
          "languageCode",
          "subtitles"
