{
  "key": "hashnode",
  "name": "Hashnode",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "social"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Personal access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "gql.hashnode.com"
    ]
  },
  "models": [
    "post",
    "publication",
    "user",
    "draft",
    "tag"
  ],
  "http": {
    "baseUrl": "https://gql.hashnode.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "errors.0.message"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Healthcheck",
      "description": "Verify credentials by reading the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query Me { me { id username name } }"
        },
        "result": {
          "user": "{{response.data.me}}"
        },
        "echo": {
          "status": "ok"
        }
      },
      "enforceOutputSchema": true
    },
    "users.me": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Users Me",
      "description": "Get the authenticated user profile.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query Me { me { id username name } }"
        },
        "result": {
          "user": "{{response.data.me}}"
        }
      },
      "enforceOutputSchema": true
    },
    "publications.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Publications List",
      "description": "List your publications using cursor pagination; stop when hasNextPage is false.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "first": {
            "type": "integer",
            "description": "Page size, 1 to 50. Provider validates range."
          },
          "after": {
            "type": "string",
            "description": "Previous nextCursor. Stop when hasNextPage is false."
          }
        },
        "required": [
          "first"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "edges": {
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          },
          "hasNextPage": {
            "type": "boolean"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query Publications($first: Int!, $after: String) { me { publications(first: $first, after: $after) { edges { node { id title url } cursor } pageInfo { endCursor hasNextPage } } } }",
          "variables": {
            "first": "{{first}}",
            "after": "{{after}}"
          }
        },
        "result": {
          "edges": "{{response.data.me.publications.edges}}",
          "nextCursor": "{{response.data.me.publications.pageInfo.endCursor}}",
          "hasNextPage": "{{response.data.me.publications.pageInfo.hasNextPage}}"
        }
      },
      "enforceOutputSchema": true
    },
    "publications.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Publications Get",
      "description": "Read publication metadata by hostname. Hashnode requires the target publication to be Pro.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "description": "Publication hostname. Requires a Pro publication."
          }
        },
        "required": [
          "host"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "publication": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query Publication($host: String!) { publication(host: $host) { id title url } }",
          "variables": {
            "host": "{{host}}"
          }
        },
        "result": {
          "publication": "{{response.data.publication}}"
        }
      },
      "enforceOutputSchema": true
    },
    "posts.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Posts Get",
      "description": "Get a post by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Post ID."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "post": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query Post($id: ID!) { post(id: $id) { id title slug url } }",
          "variables": {
            "id": "{{id}}"
          }
        },
        "result": {
          "post": "{{response.data.post}}"
        }
      },
      "enforceOutputSchema": true
    },
    "posts.publish": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Posts Publish",
      "description": "Publish a post to a Pro publication. Requires a role authorized to publish; contributors must use the review workflow outside this connector.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "publicationId": {
            "type": "string",
            "description": "Pro publication ID. Requires an authorized publishing role."
          },
          "title": {
            "type": "string",
            "description": "Post title."
          },
          "contentMarkdown": {
            "type": "string",
            "description": "Markdown content."
          },
          "subtitle": {
            "type": "string",
            "description": "Optional subtitle."
          },
          "slug": {
            "type": "string",
            "description": "Optional URL slug."
          },
          "originalArticleURL": {
            "type": "string",
            "description": "Canonical URL for a republished article."
          }
        },
        "required": [
          "publicationId",
          "title",
          "contentMarkdown"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "post": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "mutation PublishPost($input: PublishPostInput!) { publishPost(input: $input) { post { id title slug url } } }",
          "variables": {
            "input": {
              "publicationId": "{{publicationId}}",
              "title": "{{title}}",
              "contentMarkdown": "{{contentMarkdown}}",
              "subtitle": "{{subtitle}}",
              "slug": "{{slug}}",
              "originalArticleURL": "{{originalArticleURL}}"
            }
          }
        },
        "result": {
          "post": "{{response.data.publishPost.post}}"
        }
      },
      "enforceOutputSchema": true
    },
    "posts.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Posts Update",
      "description": "Update an existing Hashnode post. The target publication must be Pro.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Post ID."
          },
          "title": {
            "type": "string",
            "description": "Updated title."
          },
          "contentMarkdown": {
            "type": "string",
            "description": "Updated markdown content."
          },
          "subtitle": {
            "type": "string",
            "description": "Updated subtitle."
          },
          "slug": {
            "type": "string",
            "description": "Updated slug."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "post": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "mutation UpdatePost($input: UpdatePostInput!) { updatePost(input: $input) { post { id title slug url } } }",
          "variables": {
            "input": {
              "id": "{{id}}",
              "title": "{{title}}",
              "contentMarkdown": "{{contentMarkdown}}",
              "subtitle": "{{subtitle}}",
              "slug": "{{slug}}"
            }
          }
        },
        "result": {
          "post": "{{response.data.updatePost.post}}"
        }
      },
      "enforceOutputSchema": true
    },
    "posts.remove": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Posts Remove",
      "description": "Soft-delete a Hashnode post. Restricted to the post author or a publication admin.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Post ID."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "post": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "mutation RemovePost($input: RemovePostInput!) { removePost(input: $input) { post { id title slug url } } }",
          "variables": {
            "input": {
              "id": "{{id}}"
            }
          }
        },
        "result": {
          "post": "{{response.data.removePost.post}}"
        }
      },
      "enforceOutputSchema": true
    },
    "posts.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Posts List",
      "description": "List posts in a Pro publication using cursor pagination; stop when hasNextPage is false.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "description": "Publication hostname."
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Page size."
          },
          "after": {
            "type": "string",
            "description": "Cursor from a previous page."
          }
        },
        "required": [
          "host",
          "first"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "edges": {
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          },
          "hasNextPage": {
            "type": "boolean"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query PublicationPosts($host: String!, $first: Int!, $after: String) { publication(host: $host) { posts(first: $first, after: $after) { edges { node { id title slug url } cursor } pageInfo { endCursor hasNextPage } } } }",
          "variables": {
            "host": "{{host}}",
            "first": "{{first}}",
            "after": "{{after}}"
          }
        },
        "result": {
          "edges": "{{response.data.publication.posts.edges}}",
          "nextCursor": "{{response.data.publication.posts.pageInfo.endCursor}}",
          "hasNextPage": "{{response.data.publication.posts.pageInfo.hasNextPage}}"
        }
      },
      "enforceOutputSchema": true
    },
    "posts.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 2097152,
      "title": "Posts Search",
      "description": "Search posts in a Pro publication. filter.publicationId is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "publicationId": {
            "type": "string",
            "minLength": 1,
            "description": "Pro publication ID."
          },
          "query": {
            "type": "string",
            "description": "Search text."
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Page size."
          },
          "after": {
            "type": "string",
            "description": "Cursor from a previous page."
          }
        },
        "required": [
          "publicationId",
          "first"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "edges": {
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          },
          "hasNextPage": {
            "type": "boolean"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/",
        "success": [
          200
        ],
        "body": {
          "query": "query SearchPosts($first: Int!, $after: String, $filter: SearchPostsOfPublicationFilter!) { searchPostsOfPublication(first: $first, after: $after, filter: $filter) { edges { node { id title url } cursor } pageInfo { endCursor hasNextPage } } }",
          "variables": {
            "first": "{{first}}",
            "after": "{{after}}",
            "filter": {
              "publicationId": "{{publicationId}}",
              "query": "{{query}}"
            }
          }
        },
        "result": {
          "edges": "{{response.data.searchPostsOfPublication.edges}}",
          "nextCursor": "{{response.data.searchPostsOfPublication.pageInfo.endCursor}}",
          "hasNextPage": "{{response.data.searchPostsOfPublication.pageInfo.hasNextPage}}"
        }
      },
      "enforceOutputSchema": true
    },
    "drafts.create": {
