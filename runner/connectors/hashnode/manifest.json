      "inputSchema": {
        "type": "object",
        "properties": {
          "publicationId": {
            "type": "string",
            "minLength": 1,
            "description": "Pro publication ID."
          },
          "title": {
            "type": "string",
            "description": "Draft title."
          },
          "contentMarkdown": {
            "type": "string",
            "description": "Markdown content."
          },
          "subtitle": {
            "type": "string",
            "description": "Optional subtitle."
          },
          "slug": {
            "type": "string",
            "description": "Optional slug."
          }
        },
        "required": [
