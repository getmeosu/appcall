    "merchants.enroll": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "write",
      "title": "Enroll merchant",
      "description": "Enroll a Chargeblast merchant in an alert or refund program.",
      "inputSchema": {
        "type": "object",
        "required": [
          "program",
          "descriptor"
        ],
        "properties": {
          "program": {
            "type": "string",
            "minLength": 1,
            "description": "Program discriminator such as ethoca."
          },
          "descriptor": {
            "type": "string",
            "minLength": 1,
            "description": "Billing descriptor to enroll."
          },
          "merchantId": {
            "type": "string",
            "minLength": 1,
            "description": "Existing merchant id, if any."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/enroll_merchant",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "program": "{{program}}",
          "descriptors": [
            "{{descriptor}}"
          ],
          "merchant_id": "{{merchantId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
