    "calls.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Send call",
      "description": "Dispatch a Bland AI outbound phone call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "minLength": 1,
            "description": "Destination phone number in E.164 format."
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "description": "Prompt describing what the agent should do."
          },
          "voice": {
            "type": "string",
            "minLength": 1,
            "description": "Voice name or UUID."
          },
          "pathwayId": {
            "type": "string",
            "minLength": 1,
            "description": "Conversational pathway ID."
          },
          "webhook": {
            "type": "string",
            "minLength": 1,
            "description": "URL that receives post-call events."
          },
          "record": {
            "type": "boolean",
            "description": "Whether to record the call."
          },
          "maxDuration": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum call length in minutes."
          }
        },
        "additionalProperties": false,
        "required": [
          "phoneNumber"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/calls",
        "success": [
          200,
          201
        ],
        "body": {
          "phone_number": "{{phoneNumber}}",
          "task": "{{task}}",
          "voice": "{{voice}}",
          "pathway_id": "{{pathwayId}}",
          "webhook": "{{webhook}}",
          "record": "{{record}}",
          "max_duration": "{{maxDuration}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
