{
  "key": "bland-ai",
  "name": "Bland AI",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Bland AI API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.bland.ai"
    ]
  },
  "models": [
    "account",
    "call",
    "voice",
    "number",
    "agent",
    "pathway",
    "tool",
    "knowledge"
  ],
  "http": {
    "baseUrl": "https://api.bland.ai",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Bland AI API key by retrieving account details.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/me",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "calls.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List calls",
      "description": "List Bland AI calls with optional filters and result-window controls.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromNumber": {
            "type": "string",
            "minLength": 1
          },
          "toNumber": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "ascending": {
            "type": "boolean"
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "startDate": {
            "type": "string",
            "minLength": 1
          },
          "endDate": {
            "type": "string",
            "minLength": 1
          },
          "completed": {
            "type": "boolean"
          },
          "inbound": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/calls",
        "query": {
          "from_number": "{{fromNumber}}",
          "to_number": "{{toNumber}}",
          "from": "{{from}}",
          "to": "{{to}}",
          "limit": "{{limit}}",
          "ascending": "{{ascending}}",
          "sort_by": "{{sortBy}}",
          "start_date": "{{startDate}}",
          "end_date": "{{endDate}}",
          "completed": "{{completed}}",
          "inbound": "{{inbound}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "calls.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
