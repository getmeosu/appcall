          },
          "fromNumber": {
            "minLength": 1,
            "type": "string"
          },
          "inbound": {
            "type": "boolean"
          },
          "limit": {
            "minimum": 1,
            "type": "integer"
          },
          "sortBy": {
            "enum": [
              "created_at",
              "updated_at"
            ],
            "type": "string"
          },
          "startDate": {
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "minimum": 0,
            "type": "integer"
          },
          "toNumber": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v1/calls",
        "query": {
          "ascending": "{{ascending}}",
          "completed": "{{completed}}",
          "end_date": "{{endDate}}",
          "from": "{{from}}",
          "from_number": "{{fromNumber}}",
          "inbound": "{{inbound}}",
          "limit": "{{limit}}",
          "sort_by": "{{sortBy}}",
          "start_date": "{{startDate}}",
          "to": "{{to}}",
          "to_number": "{{toNumber}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List calls",
      "validationMode": "strict-generated"
    },
