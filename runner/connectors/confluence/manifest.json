      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create Blog Post",
      "description": "Create a blog post (v2 POST /api/v2/blogposts). spaceId is the NUMERIC-STRING space id, NOT the space key \u2014 resolve a key to its id first with space.list. title is required unless status is \"draft\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": {
            "type": "string",
            "description": "Numeric-string space id, NOT the space key. Resolve via space.list."
          },
          "title": {
            "type": "string",
            "description": "Blog post title. Required unless status is \"draft\"."
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "draft"
            ],
            "description": "Blog post status. Defaults to \"current\"."
          },
          "body": {
            "type": "object",
            "description": "{ representation: \"storage\" | \"atlas_doc_format\" | \"wiki\", value: \"<content string>\" }",
            "properties": {
              "representation": {
                "type": "string",
                "enum": [
                  "storage",
                  "atlas_doc_format",
                  "wiki"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "spaceId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "blogpost": {
            "type": "object"
          }
        }
      },
      "sample": {
        "spaceId": "98765",
        "title": "Ship notes",
        "body": {
          "representation": "storage",
          "value": "<p>We shipped.</p>"
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/v2/blogposts",
        "body": {
          "spaceId": "{{spaceId}}",
          "title": "{{title}}",
          "status": "{{status}}",
          "body": "{{body}}"
        },
        "success": [
          200
        ],
        "result": {
          "blogpost": "{{response}}"
        }
      }
    },
