            "type": "string"
          }
        },
        "required": [
          "macAddress"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v1/devices/{{macAddress}}",
        "query": {
          "endDate": "{{endDate}}",
          "limit": "{{limit}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Device history",
      "validationMode": "strict-generated"
    },
