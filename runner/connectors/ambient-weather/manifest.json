    "stations.nearby": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Nearby public stations",
      "description": "List public Ambient Weather stations inside a geographic bounding box via the dashboard devices API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "westLng": {
            "type": "number",
            "description": "Western longitude of the bounding box."
          },
          "southLat": {
            "type": "number",
            "description": "Southern latitude of the bounding box."
          },
          "eastLng": {
            "type": "number",
            "description": "Eastern longitude of the bounding box."
          },
          "northLat": {
            "type": "number",
            "description": "Northern latitude of the bounding box."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum stations to return.",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false,
        "required": [
          "westLng",
          "southLat",
          "eastLng",
          "northLat"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated",
      "request": {
        "method": "GET",
        "path": "/devices",
        "success": [
          200
        ],
        "baseUrl": "https://lightning.ambientweather.net",
        "query": {
          "$publicBox[0][0]": "{{westLng}}",
          "$publicBox[0][1]": "{{southLat}}",
          "$publicBox[1][0]": "{{eastLng}}",
          "$publicBox[1][1]": "{{northLat}}",
          "$limit": "{{limit}}"
        }
      }
    },
