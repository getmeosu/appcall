{
  "key": "ambient-weather",
  "name": "Ambient Weather",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Ambient Weather API key",
          "required": true,
          "secret": true
        },
        {
          "key": "applicationKey",
          "label": "Ambient Weather application key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "rt.ambientweather.net",
      "lightning.ambientweather.net"
    ]
  },
  "models": [
    "device",
    "observation",
    "station"
  ],
  "http": {
    "baseUrl": "https://rt.ambientweather.net",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "apiKey",
      "value": "{{apiKey}}"
    },
    "query": {
      "applicationKey": "{{applicationKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 1,
      "messagePaths": [
        "message",
        "error",
        "description"
      ]
    }
  },
