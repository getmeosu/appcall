    "devices.history": {
      "description": "Fetch historical observation records for one Ambient Weather device.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "endDate": {
            "minLength": 1,
            "type": "string"
          },
          "limit": {
            "maximum": 288,
            "minimum": 1,
            "type": "integer"
          },
          "macAddress": {
