{
  "key": "heyreach",
  "name": "HeyReach",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "HeyReach API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.heyreach.io"
    ]
  },
  "models": [
    "campaign",
    "list",
    "linkedin-account",
    "lead",
    "conversation",
    "webhook",
    "blacklist"
  ],
  "http": {
    "baseUrl": "https://api.heyreach.io/api/public",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-KEY",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "title",
        "detail",
        "errors.0"
      ]
    }
  },
