    "stores.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create store",
      "description": "Create a store under an Adyen merchant account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "merchantId": {
            "type": "string",
            "minLength": 1,
            "description": "Merchant account ID."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Store description."
          },
          "shopperStatement": {
            "type": "string",
            "minLength": 1,
            "description": "Name shown on shopper statements."
          },
          "phoneNumber": {
            "type": "string",
            "minLength": 1,
            "description": "Store phone number in E.164 format."
          },
          "country": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "description": "City."
          },
          "line1": {
            "type": "string",
            "minLength": 1,
            "description": "Street address."
          },
          "postalCode": {
            "type": "string",
            "minLength": 1,
            "description": "Postal code."
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Store reference / store code."
          }
        },
        "additionalProperties": false,
        "required": [
          "merchantId",
          "description",
          "shopperStatement",
          "phoneNumber",
          "country"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/merchants/{{merchantId}}/stores",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "description": "{{description}}",
          "shopperStatement": "{{shopperStatement}}",
          "phoneNumber": "{{phoneNumber}}",
          "reference": "{{reference}}",
          "address": {
            "country": "{{country}}",
            "city": "{{city}}",
            "line1": "{{line1}}",
            "postalCode": "{{postalCode}}"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
