        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/merchants/{{merchantId}}/webhooks",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "type": "{{type}}",
          "url": "{{url}}",
          "active": "{{active}}",
          "communicationFormat": "{{communicationFormat}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
