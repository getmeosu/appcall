{
  "key": "adyen",
  "name": "Adyen",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "payments"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Adyen Management API key",
          "required": true,
          "secret": true
        },
        {
          "key": "environment",
          "label": "Adyen environment (test or live)",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "management-test.adyen.com",
      "management-live.adyen.com"
    ]
  },
  "models": [
    "credential",
    "company",
    "merchant",
    "store",
    "webhook",
    "api-credential",
    "allowed-origin",
    "payment-method",
    "user"
  ],
  "http": {
    "baseUrl": "https://management-{{environment}}.adyen.com/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "title",
        "message",
        "errorCode"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Healthcheck",
      "description": "Validate the Adyen Management API key with GET /me.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/me",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
