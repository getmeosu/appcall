{
  "key": "neverbounce",
  "name": "NeverBounce",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "NeverBounce API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.neverbounce.com"
    ]
  },
  "models": [
    "account",
    "job",
    "job-result",
    "verification",
    "widget"
  ],
  "http": {
    "baseUrl": "https://api.neverbounce.com/v4.2",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "error_message",
        "reason"
      ],
      "bodyErrorPaths": [
        "message",
        "error",
        "error_message",
        "reason"
      ]
    }
  },
