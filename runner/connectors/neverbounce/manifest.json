            "description": "Email rows to verify."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "description": "Dashboard filename."
          },
          "auto_parse": {
            "type": "boolean",
            "description": "Parse immediately after create."
          },
          "auto_start": {
            "type": "boolean",
            "description": "Start immediately after parse."
