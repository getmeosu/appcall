{
  "key": "bigml",
  "name": "BigML",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "BigML API key",
          "required": true,
          "secret": true
        },
        {
          "key": "username",
          "label": "BigML username",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "bigml.io"
    ]
  },
  "models": [
    "model",
    "prediction",
    "source",
    "dataset",
    "project",
    "ensemble",
    "cluster",
    "evaluation"
  ],
  "http": {
    "baseUrl": "https://bigml.io/andromeda",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "query": {
      "username": "{{username}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "status.message"
      ]
    }
  },
