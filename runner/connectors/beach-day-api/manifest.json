{
  "key": "beach-day-api",
  "name": "Beach Day API",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "lifestyle"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Beach Day API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "beachdayapi.com"
    ]
  },
  "models": [
    "beach",
    "beach-condition",
    "beach-rule",
    "beach-amenity",
    "tide-prediction",
    "country"
  ],
  "http": {
    "baseUrl": "https://beachdayapi.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "error",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "beaches.amenities.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "Get Beach Amenities",
      "description": "Get facilities and accessibility amenities for one beach without the full profile. GET /beaches/{id}/amenities/ returns a JSON object. Composio documents a cost of 2 API credits; the public credit table does not list this route.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beachId": {
            "type": "integer",
            "minimum": 0,
            "description": "Beach ID returned by Search Beaches."
          }
        },
        "additionalProperties": false,
        "required": [
          "beachId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/beaches/{{beachId}}/amenities/",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "beaches.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "Get Beach Details",
      "description": "Get a full beach profile, including the current score, water quality, weather, ocean conditions, rules, and amenities. GET /beaches/{id}/ costs 5 API credits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beachId": {
            "type": "integer",
            "minimum": 0,
            "description": "Beach ID returned by Search Beaches."
          }
        },
        "additionalProperties": false,
        "required": [
          "beachId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/beaches/{{beachId}}/",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "beaches.rules.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "Get Beach Rules",
      "description": "Get activity rules for one beach without the full profile. GET /beaches/{id}/rules/ returns category, status, and notes. Composio documents a cost of 2 API credits; the public credit table does not list this route.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beachId": {
            "type": "integer",
            "minimum": 0,
            "description": "Beach ID returned by Search Beaches."
          }
        },
        "additionalProperties": false,
        "required": [
          "beachId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/beaches/{{beachId}}/rules/",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tides.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "Get Tide Predictions",
      "description": "Get up to seven days of stored tide-prediction groups for one beach. GET /tides/{beach_id}/ returns a JSON object. The provider does not publish this endpoint's credit cost.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beachId": {
            "type": "integer",
            "minimum": 0,
            "description": "Beach ID returned by Search Beaches."
          }
        },
        "additionalProperties": false,
        "required": [
          "beachId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/tides/{{beachId}}/",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "beaches.conditions.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "List Beach Conditions",
      "description": "Return current and recent condition snapshots for one beach, including score, water quality, weather, ocean conditions, and tides. GET /beaches/{id}/conditions/ costs 3 API credits per page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "beachId": {
            "type": "integer",
            "minimum": 0,
            "description": "Beach ID returned by Search Beaches."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based index of the first condition snapshot. Omit for the first page, then repeat beachId and limit with the next offset."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Maximum condition snapshots in this page (1-200). Default upstream is 30."
          }
        },
        "additionalProperties": false,
        "required": [
          "beachId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/beaches/{{beachId}}/conditions/",
        "success": [
          200
        ],
        "query": {
          "offset": "{{offset}}",
          "limit": "{{limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "beaches.scored.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "List Beaches by Score",
      "description": "Return beaches ranked by the current Beach Day Score from highest to lowest. GET /beaches/scored/ costs 10 API credits per page. Use it only when ranking is needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based index of the first ranked beach. Omit for the first page, then repeat limit with the next offset."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Maximum ranked beaches in this page (1-200). Default upstream is 50."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/beaches/scored/",
        "success": [
          200
        ],
        "query": {
          "offset": "{{offset}}",
          "limit": "{{limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "countries.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "List Countries",
      "description": "List countries covered by Beach Day API with beach counts, ordered from highest to lowest count. GET /countries/ costs 1 API credit.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/countries/",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "beaches.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "Search Beaches",
      "description": "Find beaches by name, country, or state or province code and return IDs for detail, conditions, rules, amenities, and tide lookups. GET /beaches/ costs 1 API credit per page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Case-insensitive beach-name search term, such as Malibu."
          },
          "state": {
            "type": "string",
            "description": "State or province code, such as CA, AU-NSW, ES-AN, or BR-RJ."
          },
          "country": {
            "type": "string",
            "description": "Case-insensitive country name, such as United States or New Zealand."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based index of the first beach. Omit for the first page, then repeat the same search, country, state, and limit with the next offset."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum beaches in this page (1-500). Default upstream is 100."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/beaches/",
        "success": [
          200
        ],
        "query": {
          "search": "{{search}}",
          "state": "{{state}}",
          "country": "{{country}}",
          "offset": "{{offset}}",
          "limit": "{{limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
