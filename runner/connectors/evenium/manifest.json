      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get Contact",
      "description": "Get one contact by Evenium id, id: prefix, or ext: prefix with GET /api/1/contacts/{contactId}.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contactId": {
            "type": "string",
            "description": "Evenium contact id, id:123456, or ext:externalId.",
            "minLength": 1
          }
        },
        "required": [
          "contactId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/contacts/{{contactId}}",
        "success": [
          200
        ],
        "result": "{{response}}"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
