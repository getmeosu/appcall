{
  "key": "evenium",
  "name": "Evenium",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "event-management"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Evenium API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "evenium.com"
    ]
  },
  "models": [
    "contact",
    "event"
  ],
  "http": {
    "baseUrl": "https://evenium.com/api/1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Evenium-Token",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "contacts.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create Contact",
      "description": "Create one contact in the Evenium address book with POST /api/1/contacts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customId": {
            "type": "string",
            "description": "External contact id from your CRM or database.",
            "minLength": 1
          },
          "firstName": {
            "type": "string",
            "description": "Contact first name."
          },
          "lastName": {
            "type": "string",
            "description": "Contact last name."
          },
          "gender": {
            "type": "string",
            "description": "Contact gender.",
            "enum": [
              "MALE",
              "FEMALE"
            ]
          },
          "email": {
            "type": "string",
            "description": "Contact email address."
          },
          "company": {
            "type": "string",
            "description": "Company name."
          },
          "fields": {
            "type": "array",
            "description": "Custom contact fields. Phone, region, country, and organization are field entries, not top-level properties.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Field name, such as FUNCTION, MOBILE_PHONE_NUMBER, ADDR_STATE, ADDR_COUNTRY, or COMPANY_DEPT.",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "description": "Field value."
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "contacts"
        ],
        "properties": {
          "contacts": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/contacts",
        "success": [
          200,
          201
        ],
        "result": "{{response}}",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "customId": "{{customId}}",
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "gender": "{{gender}}",
          "email": "{{email}}",
          "company": "{{company}}",
          "fields": "{{fields}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
