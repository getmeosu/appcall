          200
        ],
        "result": "{{response}}",
        "query": {
          "maxResults": "{{maxResults}}",
          "firstResult": "{{firstResult}}",
          "since": "{{since}}",
          "lastName": "{{lastName}}",
          "firstName": "{{firstName}}",
          "email": "{{email}}",
          "company": "{{company}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
