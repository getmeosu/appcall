    "contacts.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get Contacts",
      "description": "List organizer contacts with GET /api/1/contacts. Pagination is maxResults and firstResult. There is no search, order, page, or pageSize parameter.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxResults": {
            "type": "integer",
            "description": "Maximum number of rows to return. The organizer API defaults to 100.",
            "minimum": 1
          },
          "firstResult": {
            "type": "integer",
            "description": "Zero-based index of the first row. The organizer API defaults to 0.",
            "minimum": 0
          },
          "since": {
            "type": "string",
            "description": "RFC 3339 timestamp. Keep contacts updated after this instant.",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "description": "Last name filter. The organizer API matches lastName like this value.",
            "minLength": 1
          },
          "firstName": {
            "type": "string",
            "description": "First name filter. The organizer API matches firstName like this value.",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "description": "Email filter. The organizer API matches email equal to this value.",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "description": "Company filter. The organizer API matches company like this value.",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "contacts"
        ],
        "properties": {
