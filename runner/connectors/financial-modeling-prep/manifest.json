{
  "key": "financial-modeling-prep",
  "name": "Financial Modeling Prep",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "banking-data"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Financial Modeling Prep API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "financialmodelingprep.com"
    ]
  },
  "models": [
    "exchange",
    "quote",
    "profile",
    "income-statement",
    "balance-sheet",
    "cash-flow",
    "ratio",
    "key-metric",
    "historical-price",
    "dividend",
    "split",
    "earning",
    "news",
    "dcf",
    "market-cap"
  ],
  "http": {
    "baseUrl": "https://financialmodelingprep.com/stable",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "apikey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Error Message",
        "error",
        "message"
      ],
      "bodyErrorPaths": [
        "Error Message",
        "error",
        "message"
      ]
    }
  },
