    "metrics.occurrences": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get occurrence metrics",
      "description": "Get occurrence counts over a span of time with grouping, filtering, and aggregation. Maps to ROLLBAR_GET_OCCURRENCES_METRICS. POST /metrics/occurrences is a read query.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_time": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp of start time for the query."
          },
          "end_time": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp of end time for the query, inclusive."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Column name to filter."
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Match values."
                },
                "operator": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Filter operator such as eq or gt."
                }
              }
            },
            "description": "Filter conditions that narrow results by field values."
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Column names to group the results."
          },
          "aggregates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Column to aggregate on."
                },
                "function": {
                  "type": "string",
                  "enum": [
                    "count_all",
                    "count_distinct",
                    "max",
                    "min"
                  ],
                  "description": "Aggregate function."
                },
                "alias": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Alias name in the response."
                }
              }
            },
            "description": "Aggregate functions per group: count_all, count_distinct, max, min."
          },
          "sort": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "order": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ],
                "description": "Sort direction."
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "description": "Column to sort on."
              }
            },
            "description": "Sort configuration for query results."
          },
          "granularity": {
            "type": "string",
            "enum": [
              "second",
              "minute",
              "hour",
              "day",
              "week",
              "month",
              "year"
            ],
            "description": "Timepoint size of the returned results."
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "description": "Timezone for the query results. Default is US/Pacific."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Total rows or groups to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Offset for pagination."
          }
        },
        "required": [
          "start_time",
          "end_time"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": [
              "object",
              "array"
            ]
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/metrics/occurrences",
        "success": [
          200
        ],
        "result": {
          "data": "{{response.result}}"
        },
        "body": {
          "start_time": "{{start_time}}",
          "end_time": "{{end_time}}",
          "filters": "{{filters}}",
          "group_by": "{{group_by}}",
          "aggregates": "{{aggregates}}",
          "sort": "{{sort}}",
          "granularity": "{{granularity}}",
          "timezone": "{{timezone}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json"
    },
