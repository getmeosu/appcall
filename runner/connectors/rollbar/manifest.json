    "metrics.ttr": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "Get TTR metrics",
      "description": "Get time-to-resolution metrics for Rollbar projects. Maps to ROLLBAR_GET_TTR_METRICS. POST /metrics/ttr is a read query.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_time": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp of start time for the query."
          },
          "end_time": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp of end time, inclusive. Default is now."
          },
          "granularity": {
            "type": "string",
            "enum": [
              "second",
              "minute",
              "hour",
              "day",
              "week",
              "month",
              "year"
            ],
            "description": "Timepoint size of the returned results."
          },
          "function": {
            "type": "string",
            "enum": [
              "mean",
              "median",
              "min",
              "max"
            ],
            "description": "Aggregate function for time-to-resolution. Default is median."
          },
          "project_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Project IDs. Requires an account access token."
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Environment names to filter by."
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Level names such as error or warning."
          },
          "frameworks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Framework names to filter by."
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "description": "Timezone for the results. Default is US/Pacific."
          }
        },
        "required": [
          "start_time"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": [
              "object",
              "array"
            ]
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/metrics/ttr",
        "success": [
          200
        ],
        "result": {
          "data": "{{response.result}}"
        },
        "body": {
          "start_time": "{{start_time}}",
          "end_time": "{{end_time}}",
          "granularity": "{{granularity}}",
          "function": "{{function}}",
          "project_ids": "{{project_ids}}",
          "environments": "{{environments}}",
          "levels": "{{levels}}",
          "frameworks": "{{frameworks}}",
          "timezone": "{{timezone}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json"
    },
