      "description": "Validate the token with GET /contacts?page=1 using SendFox default per_page=100.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/contacts",
        "success": [
          200
        ],
        "query": {
          "page": "1"
