{
  "key": "sendfox",
  "name": "SendFox",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "SendFox personal access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.sendfox.com"
    ]
  },
  "models": [
    "contact",
    "contact_list",
    "campaign",
    "user"
  ],
  "http": {
    "baseUrl": "https://api.sendfox.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
