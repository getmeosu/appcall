        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "generations.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create generation",
      "description": "Start an asynchronous Gamma generation from text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "inputText": {
            "type": "string",
            "minLength": 1,
            "description": "Topic, outline, or full content."
          },
          "textMode": {
            "type": "string",
            "enum": [
              "generate",
              "condense",
              "preserve"
            ],
            "description": "How to interpret input text."
          },
          "format": {
            "type": "string",
            "enum": [
              "presentation",
              "document",
              "webpage",
              "social"
            ],
            "description": "Output format."
          },
          "themeId": {
            "type": "string",
            "description": "Theme ID from /themes."
          },
          "numCards": {
            "type": "integer",
            "minimum": 1,
            "description": "Target card count."
          },
          "title": {
            "type": "string",
            "description": "Explicit Gamma title."
          },
          "folderId": {
            "type": "string",
            "description": "Folder to store the Gamma."
          },
          "exportAs": {
            "type": "string",
            "enum": [
              "pdf",
              "png",
              "pptx"
            ],
            "description": "Automatic export format."
          },
          "additionalInstructions": {
            "type": "string",
            "description": "Extra generation instructions."
          }
        },
        "additionalProperties": false,
        "required": [
          "inputText"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/generations",
        "success": [
          200,
          201
        ],
        "body": {
          "inputText": "{{inputText}}",
          "textMode": "{{textMode}}",
          "format": "{{format}}",
          "themeId": "{{themeId}}",
          "numCards": "{{numCards}}",
          "title": "{{title}}",
          "folderId": "{{folderId}}",
          "exportAs": "{{exportAs}}",
          "additionalInstructions": "{{additionalInstructions}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
