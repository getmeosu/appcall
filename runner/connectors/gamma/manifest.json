    "generations.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get generation",
      "description": "Get the status and result URLs for a Gamma generation job.",
      "inputSchema": {
        "type": "object",
        "required": [
          "generationId"
        ],
        "properties": {
