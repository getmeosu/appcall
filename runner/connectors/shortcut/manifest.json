      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search Stories",
      "description": "Search Shortcut stories with the workspace search query language.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Shortcut search query, e.g. is:story.",
            "minLength": 1
          },
          "page_size": {
            "type": "integer",
            "description": "Results per page.",
            "minimum": 1,
            "maximum": 25
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "stories"
        ],
        "properties": {
          "stories": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/search/stories",
        "query": {
          "query": "{{query}}",
          "page_size": "{{page_size}}"
        },
        "success": [
          200
        ],
        "result": {
          "stories": "{{response.data}}",
          "next": "{{response.next}}",
          "total": "{{response.total}}"
        }
      },
      "enforceOutputSchema": true
    },
