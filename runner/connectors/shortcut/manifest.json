{
  "key": "shortcut",
  "name": "Shortcut",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity",
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Shortcut API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.app.shortcut.com"
    ]
  },
  "models": [
    "member",
    "workflow",
    "project",
    "story",
    "comment",
    "epic",
    "iteration"
  ],
  "http": {
    "baseUrl": "https://api.app.shortcut.com/api/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Shortcut-Token",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Shortcut token with GET /member.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "member"
        ],
        "properties": {
          "member": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/member",
        "success": [
          200
        ],
        "result": {
          "member": "{{response}}"
        }
      },
      "enforceOutputSchema": true
    },
