      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Story",
      "description": "Create a Shortcut story. Provide workflow_state_id or project_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Story name.",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Story description."
          },
          "story_type": {
            "type": "string",
            "description": "Story type.",
            "enum": [
              "feature",
              "bug",
              "chore"
            ]
          },
          "workflow_state_id": {
            "type": "integer",
            "description": "Workflow state ID.",
            "minimum": 1
          },
          "project_id": {
            "type": "integer",
            "description": "Project ID.",
            "minimum": 1
          },
          "epic_id": {
            "type": "integer",
            "description": "Epic ID.",
            "minimum": 1
          },
          "owner_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Member UUIDs that own the story."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "story"
