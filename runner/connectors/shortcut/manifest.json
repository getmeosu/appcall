          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "story_type": "{{story_type}}",
          "workflow_state_id": "{{workflow_state_id}}",
          "project_id": "{{project_id}}",
          "epic_id": "{{epic_id}}",
          "owner_ids": "{{owner_ids}}"
        },
        "success": [
          201
        ],
        "result": {
          "story": "{{response}}"
        }
      },
      "enforceOutputSchema": true
    },
