  "operations": {
    "campaigns.get": {
      "description": "Retrieve one saved Campaign Cleaner campaign analysis.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "campaignId": {
            "minLength": 1,
            "type": "string"
          },
          "minimizeHtml": {
            "type": "boolean"
          }
        },
        "required": [
          "campaignId"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "campaign": {
            "id": "{{campaignId}}",
            "minimize_html": "{{minimizeHtml}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/v1/get_campaign",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get campaign",
      "validationMode": "strict-generated"
    },
    "campaigns.list": {
