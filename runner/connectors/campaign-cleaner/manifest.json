{
  "key": "campaign-cleaner",
  "name": "Campaign Cleaner",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Campaign Cleaner API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.campaigncleaner.com"
    ]
  },
  "models": [
    "campaign",
    "credit",
    "inbox-test"
  ],
  "http": {
    "baseUrl": "https://api.campaigncleaner.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-CC-API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "error.message"
      ],
      "bodyErrorPaths": [
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Healthcheck",
      "description": "Validate the Campaign Cleaner API key with GET /v1/get_credits.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/get_credits",
        "success": [
          200
        ]
      }
    },
    "campaigns.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "List campaigns",
      "description": "List saved Campaign Cleaner campaigns and their processing status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/get_campaign_list",
        "success": [
          200
        ]
      }
    },
    "campaigns.status.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Get campaign status",
      "description": "Get the processing status of one Campaign Cleaner campaign.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "campaignId"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/get_campaign_status",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "campaign": {
            "id": "{{campaignId}}"
          }
        },
        "success": [
          200
        ]
      }
    },
    "campaigns.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Get campaign",
      "description": "Retrieve one saved Campaign Cleaner campaign analysis.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1
          },
          "minimizeHtml": {
            "type": "boolean"
          }
        },
        "required": [
          "campaignId"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/get_campaign",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "campaign": {
            "id": "{{campaignId}}",
            "minimize_html": "{{minimizeHtml}}"
          }
        },
        "success": [
          200
        ]
      }
    },
    "credits.get": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Get credits",
      "description": "Get remaining Campaign Cleaner API credits.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/get_credits",
        "success": [
          200
        ]
      }
    },
    "campaigns.send": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Send campaign",
      "description": "Submit HTML to Campaign Cleaner for processing and analysis.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignHtml": {
            "type": "string",
            "minLength": 1,
            "description": "Full HTML of the campaign."
          },
          "campaignName": {
            "type": "string",
            "minLength": 1,
            "description": "Campaign name."
          },
          "webhookUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Optional webhook URL for completed results."
          },
          "inlineCss": {
            "type": "boolean",
            "description": "Inline CSS into HTML elements."
          },
          "removeComments": {
            "type": "boolean",
            "description": "Strip CSS and HTML comments."
          },
          "adjustFontColors": {
            "type": "boolean",
            "description": "Adjust bright font colors that trigger spam filters."
          },
          "resizeAndHost": {
            "type": "boolean",
            "description": "Resize and host eligible images on the CDN."
          },
          "customInfo": {
            "type": "string",
            "minLength": 1,
            "description": "Optional metadata stored with the campaign."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaignHtml",
          "campaignName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/send_campaign",
        "success": [
          200
        ],
        "body": {
          "send_campaign": {
            "campaign_html": "{{campaignHtml}}",
            "campaign_name": "{{campaignName}}",
            "webhook_url": "{{webhookUrl}}",
            "inline_css": "{{inlineCss}}",
            "remove_comments": "{{removeComments}}",
            "adjust_font_colors": "{{adjustFontColors}}",
            "resize_and_host": "{{resizeAndHost}}",
            "custom_info": "{{customInfo}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "campaigns.delete": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "destructive",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Delete campaign",
      "description": "Delete a saved Campaign Cleaner campaign.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1,
            "description": "Campaign id."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaignId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/delete_campaign",
        "success": [
          200
        ],
        "body": {
          "campaign": {
            "id": "{{campaignId}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "inboxTests.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Create inbox test",
      "description": "Create a Campaign Cleaner inbox placement test and receive seed addresses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "testName": {
            "type": "string",
            "minLength": 1,
            "description": "Inbox test name."
          }
        },
        "additionalProperties": false,
        "required": [
          "testName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/create_inbox_test",
        "success": [
          200
        ],
        "body": {
          "test_name": "{{testName}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "inboxTests.results.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Get inbox test results",
      "description": "Get placement results for a Campaign Cleaner inbox test.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "Inbox test job id."
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/get_inbox_test_results",
        "success": [
          200
        ],
        "body": {
          "job_id": "{{jobId}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "campaigns.export": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Export campaign analysis",
      "description": "Retrieve a Campaign Cleaner campaign with HTML minimized for compact export.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1,
            "description": "Campaign id."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaignId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/get_campaign",
        "success": [
          200
        ],
        "body": {
          "campaign": {
            "id": "{{campaignId}}",
            "minimize_html": true
          }
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "webhook.campaign_completed": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Campaign completed",
      "description": "Campaign Cleaner webhook fired when send_campaign finishes processing and posts results to webhook_url.",
      "sideEffect": "read"
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  }
}
