        "success": [
          200
        ]
      }
    },
    "apps.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create app",
      "description": "Create an Ably application on an account.",
      "inputSchema": {
        "type": "object",
        "required": [
          "accountId",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1,
            "description": "Ably account identifier."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Application name."
          },
          "tlsOnly": {
            "type": "boolean",
            "description": "Require TLS for connections."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
