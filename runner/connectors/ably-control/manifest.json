        "method": "POST",
        "path": "/accounts/{{accountId}}/apps",
        "success": [
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "tlsOnly": "{{tlsOnly}}"
        }
      }
    },
    "apps.update": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Update app",
      "description": "Update an Ably application by application ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Application identifier."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Application name."
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ],
            "description": "Application status."
          },
          "tlsOnly": {
            "type": "boolean",
            "description": "Require TLS for connections."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "PATCH",
        "path": "/apps/{{id}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "status": "{{status}}",
          "tlsOnly": "{{tlsOnly}}"
        }
      }
    },
    "apps.delete": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "destructive",
      "title": "Delete app",
      "description": "Delete an Ably application by application ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Application identifier."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "DELETE",
        "path": "/apps/{{id}}",
        "success": [
          204
        ]
      }
    },
    "apps.stats": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get app statistics",
      "description": "Retrieve application-level Ably usage statistics.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Application identifier."
          },
          "start": {
            "type": "integer",
            "description": "Start time in milliseconds since epoch."
          },
          "end": {
            "type": "integer",
            "description": "End time in milliseconds since epoch."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum statistics records."
          },
          "direction": {
            "type": "string",
            "enum": [
              "backwards",
              "forwards"
            ],
            "description": "Result order."
          },
          "unit": {
            "type": "string",
            "enum": [
              "minute",
              "hour",
              "day",
              "month"
            ],
            "description": "Aggregation interval."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/apps/{{id}}/stats",
        "success": [
          200
        ],
        "query": {
          "start": "{{start}}",
          "end": "{{end}}",
          "limit": "{{limit}}",
          "direction": "{{direction}}",
          "unit": "{{unit}}"
        }
      }
    },
