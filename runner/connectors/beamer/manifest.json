{
  "key": "beamer",
  "name": "Beamer",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Beamer API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.getbeamer.com"
    ]
  },
  "models": [
    "product",
    "post",
    "feed",
    "comment",
    "reaction",
    "request",
    "nps",
    "user"
  ],
  "http": {
    "baseUrl": "https://api.getbeamer.com/v0",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Beamer-Api-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errorMessage"
      ]
    }
  },
  "operations": {
    "feed.url": {
      "description": "Get the standalone Beamer feed URL with optional language and segmentation filters.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "filter": {
            "minLength": 1,
            "type": "string"
          },
          "filterByUrl": {
            "type": "boolean"
          },
          "language": {
            "minLength": 2,
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/url",
        "query": {
          "filter": "{{filter}}",
          "filterByUrl": "{{filterByUrl}}",
          "language": "{{language}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get feed URL",
      "validationMode": "strict-generated"
    },
    "healthcheck": {
      "description": "Validate the Beamer API key with POST /ping.",
      "enforceOutputSchema": true,
