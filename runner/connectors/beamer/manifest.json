    "posts.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create post",
      "description": "Create a Beamer changelog post. Title and content are translation arrays.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Post titles, one per translation."
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Post bodies, one per translation."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Beamer category."
          },
          "language": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            },
            "description": "ISO-639 language codes."
          },
          "publish": {
            "type": "boolean",
            "description": "Publish immediately."
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "content"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/posts",
        "success": [
          201,
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "title": "{{title}}",
          "content": "{{content}}",
          "category": "{{category}}",
          "language": "{{language}}",
          "publish": "{{publish}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
