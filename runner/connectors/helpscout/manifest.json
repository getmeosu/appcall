    "conversations.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create Conversation",
      "description": "Create a Help Scout conversation in a mailbox with at least one thread.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Conversation subject."
          },
          "mailboxId": {
            "type": "integer",
            "minimum": 1,
            "description": "Inbox ID."
          },
          "type": {
            "type": "string",
            "enum": [
              "email",
              "chat",
              "phone"
            ],
            "description": "Conversation type."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "closed",
              "pending"
            ],
            "description": "Initial status."
          },
          "customerId": {
            "type": "integer",
            "minimum": 1,
            "description": "Existing customer ID."
          },
          "customerEmail": {
            "type": "string",
            "description": "Customer email. Creates the customer when no ID is given."
          },
          "customerFirstName": {
            "type": "string",
            "description": "Customer first name when creating by email."
          },
          "customerLastName": {
            "type": "string",
            "description": "Customer last name when creating by email."
          },
          "text": {
            "type": "string",
            "description": "First thread body."
          },
          "threadType": {
            "type": "string",
            "enum": [
              "customer",
              "reply",
              "phone",
              "chat"
            ],
            "description": "First thread type."
          },
          "assignTo": {
            "type": "integer",
            "minimum": 1,
            "description": "User or team ID to assign."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Conversation tags."
          }
        },
        "required": [
          "subject",
          "mailboxId",
          "type",
          "status",
          "text",
          "threadType"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Created conversation ID from Resource-ID."
          },
          "location": {
            "type": "string",
            "description": "Location header."
          }
        },
        "required": [
          "id"
