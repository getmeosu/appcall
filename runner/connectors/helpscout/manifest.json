      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string"
          },
          "mailbox": {
            "type": "integer",
            "minimum": 1
          },
          "sortField": {
            "type": "string"
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
