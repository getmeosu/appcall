{
  "key": "helpscout",
  "name": "Help Scout",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm",
    "productivity"
  ],
  "auth": {
    "type": "oauth2",
    "scopes": [],
    "setup": {
      "mode": "oauth2",
      "fields": [],
      "help": "Connect a Help Scout user account through OAuth2.",
      "docsUrl": "https://developer.helpscout.com/mailbox-api/overview/authentication/"
    },
    "oauth": {
      "authorizeUrl": "https://secure.helpscout.net/authentication/authorizeClientApplication",
      "tokenUrl": "https://api.helpscout.net/v2/oauth2/token",
      "pkce": false,
      "supportsRefresh": true,
      "clientAuth": "body"
    }
  },
  "network": {
    "allowedHosts": [
      "api.helpscout.net",
      "secure.helpscout.net"
    ]
  },
  "models": [
    "inbox",
    "user",
    "tag",
    "conversation",
    "thread",
    "customer",
    "mailbox"
  ],
  "http": {
    "baseUrl": "https://api.helpscout.net/v2",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 5,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the OAuth access token with GET /users and return the first page metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "users"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "users": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "page": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "GET",
        "path": "/users",
        "query": {
          "page": 1,
          "pageSize": 50
        },
        "success": [
          200
        ],
        "result": {
          "status": "ok",
          "users": "{{response._embedded.users}}",
          "page": "{{response.page}}"
        }
      }
    },
