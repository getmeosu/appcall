    "customers.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Customer",
      "description": "Create a Help Scout customer. Returns the new ID in the Resource-ID header.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "First name, 1-40 characters."
          },
          "lastName": {
            "type": "string",
            "description": "Last name, 1-40 characters."
          },
          "email": {
            "type": "string",
            "description": "Work email stored as the first emails[] entry."
          },
          "jobTitle": {
            "type": "string",
            "description": "Job title."
          },
          "organization": {
            "type": "string",
            "description": "Organization name."
          },
          "background": {
            "type": "string",
            "description": "Notes field."
          },
          "location": {
            "type": "string",
            "description": "Location."
          },
          "photoUrl": {
            "type": "string",
            "description": "Photo URL."
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Created customer ID from Resource-ID."
          },
          "location": {
            "type": "string",
            "description": "Location header."
          }
        },
        "required": [
          "id"
        ]
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "POST",
        "path": "/customers",
        "success": [
          201
        ],
        "result": {
          "id": "{{headers.resource-id}}",
          "location": "{{headers.location}}"
        },
        "body": {
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "jobTitle": "{{jobTitle}}",
          "organization": "{{organization}}",
          "background": "{{background}}",
          "location": "{{location}}",
          "photoUrl": "{{photoUrl}}",
          "emails": [
            {
              "type": "work",
              "value": "{{email}}"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
