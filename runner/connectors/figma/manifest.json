    "devResources.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "List Dev Resources",
      "description": "List development resources attached to nodes in a Figma file. Pass nodeIds as a comma-separated list to limit the response; omit it to return every resource in the file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileKey": {
            "type": "string",
            "description": "File key."
          },
          "nodeIds": {
            "type": "string",
            "description": "Comma-separated node ids to filter by."
          }
        },
        "required": [
          "fileKey"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "devResources": {
            "type": [
              "array",
              "object"
            ]
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/files/{{fileKey}}/dev_resources",
        "success": [
          200
        ],
        "result": {
          "devResources": "{{response.dev_resources}}"
        },
        "query": {
          "node_ids": "{{nodeIds}}"
        }
      },
      "sample": {
        "fileKey": "abcXYZ123",
        "nodeIds": "1:2"
      }
    },
    "devResources.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Create Dev Resource",
      "description": "Attach a uniquely-URLed development resource to a Figma node, such as a storybook or issue tracker link. Figma allows up to 10 resources per node.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileKey": {
            "type": "string",
            "description": "File key the node belongs to."
          },
          "nodeId": {
            "type": "string",
            "description": "Node id to attach the resource to."
          },
          "name": {
            "type": "string",
            "description": "Resource display name."
          },
          "url": {
            "type": "string",
            "description": "HTTPS URL of the development resource."
          }
        },
        "required": [
          "fileKey",
          "nodeId",
          "name",
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "linksCreated": {
            "type": [
              "array",
              "object"
            ]
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/dev_resources",
        "success": [
          200
        ],
        "result": {
          "linksCreated": "{{response.links_created}}"
        },
        "body": {
          "dev_resources": [
            {
              "file_key": "{{fileKey}}",
              "node_id": "{{nodeId}}",
              "name": "{{name}}",
              "url": "{{url}}"
            }
          ]
        }
      },
      "sample": {
        "fileKey": "abcXYZ123",
        "nodeId": "1:2",
        "name": "Storybook",
        "url": "https://storybook.example.com/button"
      }
    }
