{
  "key": "cratedb-cloud",
  "name": "CrateDB Cloud",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "key",
          "label": "CrateDB Cloud API key",
          "required": true,
          "secret": false
        },
        {
          "key": "apiKey",
          "label": "CrateDB Cloud API secret",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "console.cratedb.cloud"
    ]
  },
  "models": [
    "user",
    "organization",
    "project",
    "cluster",
    "region",
    "product",
    "subscription"
  ],
  "http": {
    "baseUrl": "https://console.cratedb.cloud",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{key}}",
        "password": "{{apiKey}}"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "message",
        "error"
      ]
    }
  },
  "operations": {
