{
  "key": "stormboard",
  "name": "Stormboard",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Stormboard API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.stormboard.com"
    ]
  },
  "models": [
    "profile",
    "storm",
    "template",
    "idea",
    "user",
    "tag",
    "connector"
  ],
  "http": {
    "baseUrl": "https://api.stormboard.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Stormboard API key with GET /users/profile.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/users/profile",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "storms.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List storms",
      "description": "List Stormboard Storms visible to the current account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "team": {
            "type": "integer",
            "minimum": 1
          },
          "folder": {
            "type": "integer",
            "minimum": 1
          },
          "needle": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "open",
              "closed"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "order": {
            "type": "string",
            "enum": [
              "activity",
              "alpha",
              "frequency",
              "starred"
            ]
          },
          "results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/storms/list",
        "success": [
          200
        ],
        "query": {
          "team": "{{team}}",
          "folder": "{{folder}}",
          "needle": "{{needle}}",
          "status": "{{status}}",
          "start": "{{start}}",
          "order": "{{order}}",
          "results": "{{results}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
