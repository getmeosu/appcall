    "storms.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create storm",
      "description": "Create a Stormboard Storm.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Storm title."
          },
          "plan": {
            "type": "string",
            "enum": [
              "personal",
              "student",
              "educator",
              "team"
            ],
            "description": "Storm type."
          },
          "goals": {
            "type": "string",
            "minLength": 1,
            "description": "Storm goals and description."
          },
          "teamId": {
            "type": "integer",
            "description": "Team id. Required when plan is team.",
            "minimum": 1
          },
          "ideacreator": {
            "type": "boolean",
            "description": "Show the idea creator avatar on sticky notes."
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "plan"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/storms",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "title": "{{title}}",
          "plan": "{{plan}}",
          "goals": "{{goals}}",
          "teamId": "{{teamId}}",
          "ideacreator": "{{ideacreator}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
