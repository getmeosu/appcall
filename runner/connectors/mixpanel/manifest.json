{
  "key": "mixpanel",
  "name": "Mixpanel",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity",
    "ads"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "serviceAccountSecret",
          "label": "Service account secret",
          "required": true,
          "secret": true
        },
        {
          "key": "serviceAccountUsername",
          "label": "Service account username",
          "required": true,
          "secret": false
        },
        {
          "key": "projectId",
          "label": "Project ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "mixpanel.com",
      "api.mixpanel.com"
    ]
  },
  "models": [
    "cohort",
    "funnel",
    "report",
    "service-account",
    "insight",
    "profile",
    "event",
    "annotation"
  ],
  "http": {
    "baseUrl": "https://mixpanel.com",
    "auth": {
      "field": "serviceAccountSecret",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{serviceAccountUsername}}",
        "password": "{{serviceAccountSecret}}"
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate Mixpanel service account access for the configured project.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "serviceAccounts"
        ],
        "properties": {
          "serviceAccounts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/api/app/projects/{{projectId}}/service-accounts",
        "success": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "result": {
          "serviceAccounts": "{{response}}"
        }
      }
    },
    "cohorts.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List Saved Cohorts",
      "description": "List saved cohorts for the configured Mixpanel project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": [
              "string",
              "integer"
            ],
            "minLength": 1,
            "description": "Mixpanel project id."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "cohorts",
          "raw"
        ],
        "properties": {
          "cohorts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "raw": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/api/query/cohorts/list",
        "query": {
          "project_id": "{{project_id}}"
        },
        "success": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "result": {
          "cohorts": "{{response}}",
          "raw": "{{response}}"
        }
      }
    },
