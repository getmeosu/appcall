            "type": [
              "string",
              "integer"
            ],
            "minLength": 1,
            "description": "Saved funnel id."
          },
          "from_date": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive start date (YYYY-MM-DD)."
          },
          "to_date": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive end date (YYYY-MM-DD)."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum property buckets.",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "additionalProperties": false,
        "required": [
          "funnel_id",
          "from_date",
          "to_date"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "raw"
        ],
        "properties": {
          "raw": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/api/query/funnels",
        "query": {
          "project_id": "{{project_id}}",
          "funnel_id": "{{funnel_id}}",
          "from_date": "{{from_date}}",
          "to_date": "{{to_date}}",
          "limit": "{{limit}}"
        },
        "success": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "result": {
          "raw": "{{response}}"
        }
      }
    },
