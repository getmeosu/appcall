          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "description": "Output file name. API2PDF assigns a random name when omitted."
          },
          "extraHTTPHeaders": {
            "type": "object",
            "description": "Headers API2PDF sends when it fetches a source URL.",
