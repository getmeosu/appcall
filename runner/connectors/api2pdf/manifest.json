        "path": "/pdfsharp/merge",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "urls": "{{urls}}",
          "inline": "{{inline}}",
          "fileName": "{{fileName}}",
          "extraHTTPHeaders": "{{extraHTTPHeaders}}",
          "useCustomStorage": "{{useCustomStorage}}",
          "storage": "{{storage}}"
        },
        "success": [
