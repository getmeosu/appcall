      "timeoutMs": 120000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Optimize PDF",
      "description": "Compress an existing PDF to reduce its size. Official route POST /pdfsharp/compress. Success is JSON with a FileUrl.",
      "inputSchema": {
        "type": "object",
