    "pdf.merge": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 120000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Merge PDFs",
      "description": "Merge public PDF URLs in order into one PDF. Success is JSON with a FileUrl for the merged file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "description": "Public PDF URLs merged in the given order.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inline": {
            "type": "boolean",
            "description": "When true, the FileUrl opens in the browser. When false, it downloads. The HTTP body stays JSON."
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "description": "Output PDF file name. API2PDF assigns a random name when omitted."
          },
          "extraHTTPHeaders": {
            "type": "object",
            "description": "Headers API2PDF sends when it fetches a source URL.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "useCustomStorage": {
            "type": "boolean",
            "description": "When true, upload the merged PDF with the storage settings."
          },
          "storage": {
            "type": "object",
