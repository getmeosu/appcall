{
  "key": "clerk",
  "name": "Clerk",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Clerk secret key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.clerk.com"
    ]
  },
  "models": [
    "instance",
    "user",
    "organization",
    "invitation",
    "session",
    "organizationMembership"
  ],
  "http": {
    "baseUrl": "https://api.clerk.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.long_message",
        "errors.0.message",
        "errors.0.code",
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
