{
  "key": "headout",
  "name": "Headout",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ecommerce"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Headout API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "www.headout.com"
    ]
  },
  "models": [
    "booking",
    "city",
    "category",
    "collection",
    "product",
    "inventory"
  ],
  "http": {
    "baseUrl": "https://www.headout.com/api/public/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Headout-Auth",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors.0"
      ]
    }
  },
