  "visibility": "public",
  "categories": [
    "accounting"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Baremetrics API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.baremetrics.com"
    ]
  },
  "models": [
    "source",
    "customer",
    "plan",
    "subscription",
    "charge",
    "annotation",
    "metric"
  ],
  "http": {
    "baseUrl": "https://api.baremetrics.com",
    "auth": {
      "field": "apiKey",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
