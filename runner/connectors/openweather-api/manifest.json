            "type": "number",
            "description": "Longitude.",
            "minimum": -180,
            "maximum": 180
          },
          "limit": {
            "type": "integer",
            "description": "Maximum locations to return.",
            "minimum": 1,
            "maximum": 5
          }
        },
        "additionalProperties": false,
