          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "units": {
            "type": "string",
            "enum": [
              "standard",
              "metric",
              "imperial"
            ]
          },
          "lang": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/data/2.5/forecast",
        "query": {
          "lat": "{{lat}}",
          "lon": "{{lon}}",
          "units": "{{units}}",
          "lang": "{{lang}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
