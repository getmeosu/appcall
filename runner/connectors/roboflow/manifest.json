{
  "key": "roboflow",
  "name": "Roboflow",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Roboflow private API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.roboflow.com"
    ]
  },
  "models": [
    "workspace",
    "project",
    "version",
    "job",
    "workflow",
    "group"
  ],
  "http": {
    "baseUrl": "https://api.roboflow.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "detail",
        "title"
      ]
    }
  },
