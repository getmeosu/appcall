{
  "key": "chatforma",
  "name": "Chatforma",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ai-chatbots"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Chatforma API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.pro.chatforma.com"
    ]
  },
  "models": [
    "bot",
    "segment",
    "message",
    "variable",
    "dialog",
    "user"
  ],
  "http": {
    "baseUrl": "https://api.pro.chatforma.com/public/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "bots.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Bots",
      "description": "List bots belonging to the connected Chatforma account.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bots",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "segments.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Segments",
      "description": "List user segments configured for one bot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot ID returned by List Bots."
          }
        },
        "required": [
          "botId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bots/{{botId}}/segments",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "messages.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Predefined Messages",
      "description": "List predefined messages configured in a bot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot ID returned by List Bots."
          }
        },
        "required": [
          "botId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bots/{{botId}}/messages",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "variables.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Variables",
      "description": "List variables configured for a bot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot ID returned by List Bots."
          }
        },
        "required": [
          "botId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bots/{{botId}}/variables",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "variables.get-user": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get User Variable",
      "description": "Get the current value of one bot variable for one bot user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot ID returned by List Bots."
          },
          "variableId": {
            "type": "integer",
            "minimum": 1,
            "description": "Variable ID returned by List Variables."
          },
          "botUserId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot user ID returned by the bot user list."
          }
        },
        "required": [
          "botId",
          "variableId",
          "botUserId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bots/{{botId}}/variables/{{variableId}}/user/{{botUserId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "dialogs.messages.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "List Dialog Messages",
      "description": "Return one page of messages in a user's bot dialog. Chatforma pages with page and per_page (documented default 30), not a cursor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot ID returned by List Bots."
          },
          "userId": {
            "type": "integer",
            "minimum": 1,
            "description": "Dialog user ID."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number. Omit for the first page."
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "description": "Messages per page. Chatforma documents a default of 30 and no maximum."
          }
        },
        "required": [
          "botId",
          "userId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/bots/{{botId}}/dialogs/{{userId}}/messages",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "dialogs.message.send": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Send Dialog Message",
      "description": "Immediately send a text message into a user's bot dialog. The API stores the client message id as uid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "botId": {
            "type": "integer",
            "minimum": 1,
            "description": "Bot ID returned by List Bots."
          },
          "userId": {
            "type": "integer",
            "minimum": 1,
            "description": "Dialog user ID."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Text to send to the user."
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Client-generated message id sent as uid so the sender can recognize the message."
          }
        },
        "required": [
          "botId",
          "userId",
          "message",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/bots/{{botId}}/dialogs/{{userId}}/message",
        "success": [
          200
        ],
        "body": {
          "message": "{{message}}",
          "uid": "{{idempotencyKey}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
