            "enum": [
              "running_first",
              "created_at"
            ]
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "commitMessage": {
            "type": "string",
            "minLength": 1
          },
          "triggerEventType": {
            "type": "string",
            "enum": [
              "push",
              "pull-request",
              "tag"
            ]
          },
          "pullRequestId": {
            "type": "integer",
            "minimum": 1
          },
          "buildNumber": {
            "type": "integer",
            "minimum": 1
          },
          "after": {
            "type": "integer"
          },
          "before": {
            "type": "integer"
          },
          "status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "isPipelineBuild": {
            "type": "boolean"
          },
          "next": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "appSlug"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/apps/{{appSlug}}/builds",
        "query": {
          "sort_by": "{{sortBy}}",
          "branch": "{{branch}}",
          "workflow": "{{workflow}}",
          "commit_message": "{{commitMessage}}",
          "trigger_event_type": "{{triggerEventType}}",
          "pull_request_id": "{{pullRequestId}}",
          "build_number": "{{buildNumber}}",
          "after": "{{after}}",
          "before": "{{before}}",
          "status": "{{status}}",
          "is_pipeline_build": "{{isPipelineBuild}}",
          "next": "{{next}}",
          "limit": "{{limit}}"
        },
        "success": [
          200
        ]
