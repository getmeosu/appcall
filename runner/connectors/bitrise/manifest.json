          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/apps",
        "query": {
          "sort_by": "{{sortBy}}",
          "next": "{{next}}",
          "limit": "{{limit}}",
          "title": "{{title}}",
          "project_type": "{{projectType}}"
