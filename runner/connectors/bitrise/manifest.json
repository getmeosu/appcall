{
  "auth": {
    "scopes": [],
    "setup": {
      "fields": [
        {
          "key": "apiKey",
          "label": "Bitrise API token",
          "required": true,
          "secret": true
        }
      ],
      "mode": "api_key"
    },
    "type": "api_key"
  },
  "categories": [
    "dev-tools"
  ],
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "http": {
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "baseUrl": "https://api.bitrise.io/v0.1",
    "errors": {
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error_msg",
        "error"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "key": "bitrise",
  "models": [
    "app",
    "build",
    "artifact",
    "webhook",
    "organization",
    "pipeline",
    "secret"
  ],
  "name": "Bitrise",
  "network": {
    "allowedHosts": [
      "api.bitrise.io"
    ]
  },
