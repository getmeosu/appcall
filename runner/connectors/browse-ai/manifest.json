    "robots.updateCookies": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update robot cookies",
      "description": "Replace a Browse AI robot's cookies used for authenticated sessions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "robotId": {
            "type": "string",
            "minLength": 1,
            "description": "Browse AI robot ID."
          },
          "cookies": {
            "type": "array",
            "minItems": 1,
            "description": "Cookie objects to store on the robot.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Cookie name."
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Cookie value."
                },
                "domain": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Cookie domain."
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "value"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "robotId",
          "cookies"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/robots/{{robotId}}/cookies",
        "success": [
          200,
          201,
          202,
          204
        ],
        "body": {
          "cookies": "{{cookies}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
