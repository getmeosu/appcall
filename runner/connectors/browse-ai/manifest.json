        "method": "GET",
        "path": "/robots/{{robotId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tasks.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List robot tasks",
      "description": "List Browse AI robot tasks with optional pagination and status filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "robotId": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "status": {
            "type": "string",
            "enum": [
              "failed",
              "successful",
              "in-progress"
            ]
          }
        },
        "required": [
          "robotId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/robots/{{robotId}}/tasks",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "pageSize": "{{pageSize}}",
          "status": "{{status}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
