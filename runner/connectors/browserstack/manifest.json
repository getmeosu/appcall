{
  "key": "browserstack",
  "name": "BrowserStack",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "username",
          "label": "BrowserStack username",
          "required": true,
          "secret": false
        },
        {
          "key": "apiKey",
          "label": "BrowserStack access key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.browserstack.com"
    ]
  },
  "models": [
    "build",
    "session",
    "project",
    "plan",
    "browser"
  ],
  "http": {
    "baseUrl": "https://api.browserstack.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{username}}",
        "password": "{{apiKey}}"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "error_message",
        "detail"
      ]
    }
  },
  "operations": {
