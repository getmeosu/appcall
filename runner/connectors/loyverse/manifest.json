{
  "key": "loyverse",
  "name": "Loyverse",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ecommerce"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Loyverse personal access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.loyverse.com"
    ]
  },
  "models": [
    "merchant",
    "store",
    "item",
    "category",
    "customer",
    "receipt",
    "employee",
    "inventory",
    "paymentType",
    "tax",
    "discount"
  ],
  "http": {
    "baseUrl": "https://api.loyverse.com/v1.0",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.details",
        "errors.0.code",
        "message",
        "error"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
