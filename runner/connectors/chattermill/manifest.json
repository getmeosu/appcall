      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create response",
      "description": "Create a Chattermill response in a project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "description": "Project key."
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Score from 1 to 10."
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "description": "Feedback comment."
          },
          "dataType": {
            "type": "string",
            "minLength": 1,
            "description": "Data type name."
          },
          "dataSource": {
            "type": "string",
            "minLength": 1,
            "description": "Data source name."
          }
        },
        "additionalProperties": false,
        "required": [
          "project",
          "score",
          "comment"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/{{project}}/responses",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "response": {
            "score": "{{score}}",
            "comment": "{{comment}}",
            "data_type": "{{dataType}}",
            "data_source": "{{dataSource}}"
          }
        }
      }
    },
