{
  "key": "chattermill",
  "name": "Chattermill",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Chattermill API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.chattermill.com"
    ]
  },
  "models": [
    "project",
    "response",
    "dataSource",
    "dataType",
    "theme",
    "category",
    "attribute",
    "tag",
    "customSegment",
    "metric"
  ],
  "http": {
    "baseUrl": "https://api.chattermill.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
