{
  "key": "anymail-finder",
  "name": "Anymail Finder",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Anymail Finder API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.anymailfinder.com"
    ]
  },
  "models": [
    "account",
    "email",
    "person",
    "company",
    "bulk",
    "geolead"
  ],
  "http": {
    "baseUrl": "https://api.anymailfinder.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Anymail Finder API key with the free GET /v5.1/account probe.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v5.1/account",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "account.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get account",
      "description": "Get the Anymail Finder account email and remaining credits.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v5.1/account",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "emails.verify": {
      "timeoutMs": 180000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Verify email",
      "description": "Verify whether one email address is deliverable. Consumes Anymail Finder credits and is not a healthcheck.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email address to verify."
          }
        },
        "additionalProperties": false,
        "required": [
          "email"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/verify-email",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "{{email}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "person.email.find": {
      "timeoutMs": 180000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Find person email",
      "description": "Find a person's work email from full name and company domain. Consumes credits when a valid email is found.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Company domain such as microsoft.com."
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "description": "Person's full name."
          }
        },
        "additionalProperties": false,
        "required": [
          "domain",
          "fullName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/find-email/person",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "domain": "{{domain}}",
          "full_name": "{{fullName}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "company.emails.find": {
      "timeoutMs": 180000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Find company emails",
      "description": "Find up to 20 email addresses for a company domain. Consumes credits when valid emails are found.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Company domain such as microsoft.com."
          }
        },
        "additionalProperties": false,
        "required": [
          "domain"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/find-email/company",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "domain": "{{domain}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "decision_maker.email.find": {
      "timeoutMs": 180000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Find decision maker email",
      "description": "Find a decision-maker email for a company domain and role category.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "decision_maker_category": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ceo",
                "engineering",
                "finance",
                "hr",
                "it",
                "logistics",
                "marketing",
                "operations",
                "buyer",
                "sales"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "domain",
          "decision_maker_category"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/find-email/decision-maker",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "domain": "{{domain}}",
          "decision_maker_category": "{{decision_maker_category}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "linkedin.email.find": {
      "timeoutMs": 180000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Find email by LinkedIn URL",
      "description": "Find a person's email from a LinkedIn profile URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "linkedin_url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "linkedin_url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/find-email/linkedin-url",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "linkedin_url": "{{linkedin_url}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "emails.report_bad": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Report bad email",
      "description": "Report an email address as bad or invalid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1
          },
          "additional_info": {
            "type": "string",
            "minLength": 1
          },
          "bounce_message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "email",
          "additional_info"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/report/bad-email",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "{{email}}",
          "additional_info": "{{additional_info}}",
          "bounce_message": "{{bounce_message}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "domain.emails.info": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Domain email count",
      "description": "Get how many emails Anymail Finder has for a domain and the credit cost to download them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "domain"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v5.1/domain/{{domain}}/email",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "domain.emails.order": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Order domain emails",
      "description": "Pay to prepare a domain email list for download. Credits are charged asynchronously.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "domain"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/domain/{{domain}}/email/order",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "bulk.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create bulk search",
      "description": "Create a bulk email search from a JSON table of rows.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "domain_field_index": {
            "type": "integer",
            "minimum": 0
          },
          "full_name_field_index": {
            "type": "integer",
            "minimum": 0
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "webhook_url": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "data"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/bulk/json",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "data": "{{data}}",
          "domain_field_index": "{{domain_field_index}}",
          "full_name_field_index": "{{full_name_field_index}}",
          "file_name": "{{file_name}}",
          "webhook_url": "{{webhook_url}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "bulk.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get bulk search",
      "description": "Retrieve status and counts for a bulk email search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "searchId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "searchId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v5.1/bulk/{{searchId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "bulk.download": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Download bulk search",
      "description": "Download bulk search results as JSON objects. Credits are charged on the first paid download.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "searchId": {
            "type": "string",
            "minLength": 1
          },
          "preview_only": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "searchId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v5.1/bulk/{{searchId}}/download",
        "success": [
          200
        ],
        "query": {
          "download_as": "json_obj",
          "preview_only": "{{preview_only}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "geolead.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create GeoLead search",
      "description": "Create a geographic lead search around a latitude and longitude.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "radius_km": {
            "type": "number",
            "minimum": 1,
            "maximum": 25
          },
          "find_company_emails": {
            "type": "boolean"
          },
          "find_decision_maker_categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ceo",
                "engineering",
                "finance",
                "hr",
                "it",
                "logistics",
                "marketing",
                "operations",
                "buyer",
                "sales"
              ]
            }
          },
          "file_name": {
            "type": "string",
            "minLength": 1
          },
          "result_limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "query",
          "latitude",
          "longitude",
          "radius_km",
          "find_company_emails",
          "find_decision_maker_categories"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v5.1/geo-lead",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "query": "{{query}}",
          "latitude": "{{latitude}}",
          "longitude": "{{longitude}}",
          "radius_km": "{{radius_km}}",
          "find_company_emails": "{{find_company_emails}}",
          "find_decision_maker_categories": "{{find_decision_maker_categories}}",
          "file_name": "{{file_name}}",
          "result_limit": "{{result_limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "geolead.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get GeoLead search",
      "description": "Retrieve status for a GeoLead search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "searchId": {
            "type": "string",
            "minLength": 1
