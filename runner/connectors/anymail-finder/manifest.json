      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Download GeoLead search",
      "description": "Download GeoLead results as JSON objects. Credits are charged on the first paid download.",
      "inputSchema": {
        "type": "object",
        "properties": {
