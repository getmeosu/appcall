    },
    "webhook.bulk.completed": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Bulk search completed",
      "description": "Anymail Finder webhook. Fires when a bulk email search finishes and x-webhook-url was supplied."
    },
    "webhook.find_email.completed": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Find-email completed",
      "description": "Anymail Finder webhook. Fires when an async person, company, decision-maker, or LinkedIn find finishes."
    },
    "webhook.domain_email.ready": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Domain email file ready",
      "description": "Anymail Finder webhook. Fires when an ordered domain email file is ready to download."
    },
    "webhook.geolead.completed": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "GeoLead search completed",
      "description": "Anymail Finder webhook. Fires when a GeoLead search finishes and x-webhook-url was supplied."
    }
  },
  "provenance": {
    "source": {
