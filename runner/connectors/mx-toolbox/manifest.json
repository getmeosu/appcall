{
  "key": "mx-toolbox",
  "name": "MxToolbox",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "MxToolbox API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.mxtoolbox.com",
      "mxtoolbox.com"
    ]
  },
  "models": [
    "usage",
    "monitor",
    "lookup",
    "monitor_tag"
  ],
  "http": {
    "baseUrl": "https://api.mxtoolbox.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "message",
        "Error",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
