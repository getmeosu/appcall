  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "domainAlias",
          "label": "Freshdesk domain alias",
          "description": "The Freshdesk subdomain only, for example acme in acme.freshdesk.com. Do not include a scheme, path, port, or another host.",
          "required": true,
          "secret": false
        },
        {
          "key": "apiKey",
          "label": "Freshdesk API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.freshdesk.com"
    ]
  },
  "http": {
    "baseUrl": "https://{{domainAlias}}.freshdesk.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": "X"
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "description",
        "message"
      ]
    }
  },
