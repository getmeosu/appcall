    "tickets.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create ticket",
      "description": "Create a Freshdesk ticket. Provide a requester email or requesterId plus subject and description.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Ticket subject."
          },
          "description": {
            "type": "string",
            "description": "HTML or text description."
          },
          "email": {
            "type": "string",
            "description": "Requester email when the contact is not identified by ID."
          },
          "name": {
            "type": "string",
            "description": "Requester name."
          },
          "requesterId": {
            "type": "integer",
            "minimum": 1,
            "description": "Existing contact ID of the requester."
          },
          "status": {
            "type": "integer",
            "minimum": 2,
            "maximum": 5,
            "description": "2 Open, 3 Pending, 4 Resolved, 5 Closed."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "1 Low, 2 Medium, 3 High, 4 Urgent."
          },
          "source": {
            "type": "integer",
            "minimum": 1,
            "description": "Channel the ticket arrived from, for example 1 Email or 2 Portal."
          },
          "type": {
            "type": "string",
            "description": "Ticket type."
          },
          "groupId": {
            "type": "integer",
            "minimum": 1,
            "description": "Group to assign."
          },
          "responderId": {
            "type": "integer",
            "minimum": 1,
            "description": "Agent ID to assign."
          },
          "companyId": {
            "type": "integer",
            "minimum": 1,
            "description": "Requester company ID."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ticket tags."
          }
        },
        "required": [
          "subject",
          "description"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "object",
            "description": "Created ticket."
          }
        },
        "required": [
          "ticket"
        ]
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "POST",
        "path": "/tickets",
        "success": [
          201
        ],
        "result": {
          "ticket": "{{response}}"
        },
        "body": {
          "subject": "{{subject}}",
          "description": "{{description}}",
          "email": "{{email}}",
          "name": "{{name}}",
          "requester_id": "{{requesterId}}",
          "status": "{{status}}",
          "priority": "{{priority}}",
          "source": "{{source}}",
          "type": "{{type}}",
          "group_id": "{{groupId}}",
          "responder_id": "{{responderId}}",
          "company_id": "{{companyId}}",
          "tags": "{{tags}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
