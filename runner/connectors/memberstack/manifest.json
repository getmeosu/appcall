        "body": {
          "email": "{{email}}",
          "password": "{{password}}",
          "loginRedirect": "{{loginRedirect}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "members.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update member",
      "description": "Partially update a Memberstack member by member ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Member ID starting with mem_."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Updated email address."
          },
          "loginRedirect": {
            "type": "string",
            "minLength": 1,
            "description": "Updated login redirect path."
          },
          "verified": {
            "type": "boolean",
            "description": "Email-verified status."
