          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Member password. Required unless passwordless auth is enabled."
          },
          "loginRedirect": {
            "type": "string",
            "minLength": 1,
            "description": "Path to redirect to after login."
          }
        },
        "additionalProperties": false,
