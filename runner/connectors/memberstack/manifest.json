      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get data record",
      "description": "Retrieve one Memberstack data table record by ID using findUnique.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableKey": {
            "type": "string",
            "minLength": 1,
            "description": "Table key or table ID."
