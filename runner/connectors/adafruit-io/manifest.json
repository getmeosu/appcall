            "minLength": 1,
            "type": "string"
          },
          "showHeader": {
            "description": "Whether to show the dashboard header.",
            "type": "boolean"
          },
          "username": {
            "description": "Adafruit IO username used in /api/v2/{username} paths.",
            "minLength": 1,
            "type": "string"
          },
