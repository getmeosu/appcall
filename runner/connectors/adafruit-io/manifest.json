{
  "key": "adafruit-io",
  "name": "Adafruit IO",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Adafruit IO key",
          "required": true,
          "secret": true
        }
      ]
    }
