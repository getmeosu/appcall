      "io.adafruit.com"
    ]
  },
  "models": [
    "user",
    "feed",
    "data-point",
    "group",
    "dashboard",
    "action",
    "activity"
  ],
  "http": {
    "baseUrl": "https://io.adafruit.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-AIO-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "errors"
      ]
