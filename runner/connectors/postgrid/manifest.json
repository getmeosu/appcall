{
  "key": "postgrid",
  "name": "PostGrid",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "PostGrid Print & Mail API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.postgrid.com"
    ]
  },
  "models": [
    "contact",
    "template",
    "letter",
    "postcard",
    "cheque"
  ],
  "http": {
    "baseUrl": "https://api.postgrid.com/print-mail/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "error",
        "error.type"
      ]
    }
  },
