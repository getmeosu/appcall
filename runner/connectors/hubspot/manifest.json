    "contacts.search": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Search Contacts",
      "description": "Search for contacts in HubSpot CRM using filters, sorts, and property projections.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Full-text search query string (searches indexed text properties)."
          },
          "filterGroups": {
            "type": "array",
            "description": "Array of filter groups (OR between groups, AND within a group). Each group has a 'filters' array of {propertyName, operator, value} objects.",
            "items": { "type": "object" }
          },
          "sorts": {
            "type": "array",
            "description": "Sort order. Each element is {propertyName: string, direction: 'ASCENDING'|'DESCENDING'}.",
            "items": { "type": "object" }
          },
          "properties": {
            "type": "array",
            "description": "List of property names to return for each result.",
            "items": { "type": "string" }
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of results to return (default 10, max 100)."
          },
          "after": {
            "type": "string",
            "description": "Pagination cursor from a previous search response."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "contacts": { "type": "array", "description": "Normalized contact records." },
          "total": { "type": "number" },
          "nextCursor": { "type": "string" }
        }
      }
    },
