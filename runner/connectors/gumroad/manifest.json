{
  "key": "gumroad",
  "name": "Gumroad",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Gumroad access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.gumroad.com"
    ]
  },
  "models": [
    "user",
    "product",
    "sale",
    "subscriber",
    "offerCode",
    "license",
    "resourceSubscription"
  ],
  "http": {
    "baseUrl": "https://api.gumroad.com/v2",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "access_token",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message"
      ],
      "bodyErrorPaths": [
        "message"
      ]
    }
  },
  "operations": {
