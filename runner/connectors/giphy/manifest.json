              "pg",
              "pg-13",
              "r"
            ],
            "description": "Content rating filter."
          },
          "random_id": {
            "type": "string",
            "minLength": 1,
            "description": "End-user identifier for personalization."
          },
          "bundle": {
            "type": "string",
            "minLength": 1,
            "description": "Named rendition bundle."
          },
          "country_code": {
            "type": "string",
            "minLength": 2,
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 3166-2 subdivision."
          },
          "remove_low_contrast": {
            "type": "boolean",
            "description": "Exclude low-contrast items."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
