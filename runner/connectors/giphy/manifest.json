          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "rating": "{{rating}}",
          "random_id": "{{random_id}}",
          "bundle": "{{bundle}}",
          "country_code": "{{country_code}}",
          "region": "{{region}}",
          "remove_low_contrast": "{{remove_low_contrast}}"
        },
        "success": [
