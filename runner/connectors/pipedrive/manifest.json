          "cursor": "{{cursor}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "deals.list": {
      "kind": "action",
      "sideEffect": "read",
