{
  "key": "tomba",
  "name": "Tomba",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Tomba API key",
          "required": true,
          "secret": true
        },
        {
          "key": "apiSecret",
          "label": "Tomba API secret",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.tomba.io"
    ]
  },
  "models": [
    "account",
    "email-count",
    "domain-search",
    "email-finder",
    "email-verifier",
    "lead",
    "lead-list",
    "company"
  ],
  "http": {
    "baseUrl": "https://api.tomba.io/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Tomba-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "X-Tomba-Secret": "{{apiSecret}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.message",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate Tomba credentials with GET /me.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/me",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
