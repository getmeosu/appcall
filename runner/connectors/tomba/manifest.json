    "emails.verify_bulk": {
      "description": "Create and launch a temporary Tomba bulk verifier job for up to 1000 emails via POST /bulk/verifier. Maps to TOMBA_VERIFY_EMAILS.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "emails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Email addresses to verify in one bulk job (up to 1000).",
            "minItems": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "description": "Optional polling window in seconds from Composio. Accepted for input compatibility; this operation creates and launches the job rather than polling locally.",
            "minimum": 1
          }
        },
        "required": [
          "emails"
        ]
      },
      "kind": "action",
      "maxInputBytes": 262144,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/bulk/verifier",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "AppCall email verify",
          "list": "{{emails}}",
          "launch": true
        }
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 180000,
      "title": "Verify emails",
      "validationMode": "strict-generated"
    },
