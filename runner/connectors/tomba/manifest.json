    "domain.search": {
      "description": "Search a domain or company for professional contacts via GET /domain-search. Maps to TOMBA_SEARCH_DOMAIN_CONTACTS.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Company domain to search, such as stripe.com. Required on this operation; official also accepts company."
          },
          "page": {
            "type": "integer",
            "description": "One-indexed result page.",
            "minimum": 1
          },
          "company": {
            "type": "string",
            "minLength": 1,
            "description": "Company name to search. Official uses this when Tomba knows the company."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum emails to return. Composio accepts 10, 20, or 50.",
            "minimum": 10,
            "maximum": 50,
            "enum": [
              10,
              20,
              50
            ]
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "description": "Two-letter ISO 3166-1 alpha-2 country code used to filter contacts."
          },
          "department": {
            "type": "string",
            "minLength": 1,
            "description": "Department used to filter contacts.",
            "enum": [
              "engineering",
              "sales",
              "finance",
              "hr",
              "it",
              "marketing",
              "operations",
              "management",
              "executive",
              "legal",
              "support",
              "communication",
              "software",
              "security",
              "pr",
              "warehouse",
              "diversity",
              "administrative",
              "facilities",
              "accounting"
            ]
          },
          "enrich_mobile": {
            "type": "boolean",
            "description": "Whether to include available mobile phone enrichment for returned contacts."
          }
        },
        "required": [
          "domain"
        ]
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/domain-search",
        "success": [
          200
        ],
        "query": {
          "domain": "{{domain}}",
          "page": "{{page}}",
          "company": "{{company}}",
          "limit": "{{limit}}",
          "country": "{{country}}",
          "department": "{{department}}",
          "enrich_mobile": "{{enrich_mobile}}"
        }
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 180000,
      "title": "Search domain emails",
      "validationMode": "strict-generated"
    },
