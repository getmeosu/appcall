{
  "key": "notion",
  "name": "Notion",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["productivity"],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "notionToken",
          "label": "Internal integration token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.notion.com"
    ]
  },
  "operations": {
    "credentials.validate": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Validate Credentials",
      "description": "Validate the configured Notion credentials against the provider. Takes no input and reports whether the credentials are accepted.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "description": "Whether the configured credentials are valid."
          }
        }
      }
    },
    "comments.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create Comment",
      "description": "Add a comment to a Notion page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the page to comment on."
          },
          "text": {
            "type": "string",
            "description": "Comment body text (max 2000 characters)."
          }
        },
        "required": [
          "pageId",
          "text"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string"
          },
          "limited": {
            "type": "boolean"
          }
        }
      }
    },
    "comments.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Comments",
      "description": "List comments on a Notion page or block.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "description": "ID of the page or block whose comments to list."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor returned by a prior call."
          },
          "pageSize": {
            "type": "integer",
            "description": "Number of comments to return, between 1 and 100."
          }
        },
        "required": [
          "blockId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "comments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "documents.blocks.append": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Append Text Block",
      "description": "Append a paragraph of text as a child block to a Notion page or block.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "description": "ID of the parent page or block to append to."
          },
          "text": {
            "type": "string",
            "description": "Paragraph text to append (max 2000 characters)."
          }
        },
        "required": [
          "blockId",
          "text"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "documents.blocks.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Blocks",
      "description": "List the child blocks of a Notion page or block, optionally recursing into nested blocks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "description": "ID of the page or block whose children to list."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor returned by a prior call."
          },
          "depth": {
            "type": "integer",
            "description": "How many levels of nested children to fetch, between 1 and 5 (default 1)."
          },
          "pageSize": {
            "type": "integer",
            "description": "Number of blocks to return per level, between 1 and 100."
          }
        },
        "required": [
          "blockId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "documents.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create Page",
      "description": "Create a new Notion page under a parent page, with an optional paragraph of body content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parentPageId": {
            "type": "string",
            "description": "ID of the parent page to create the new page under."
          },
          "title": {
            "type": "string",
            "description": "Title of the new page (max 2000 characters)."
          },
          "content": {
            "type": "string",
            "description": "Optional paragraph body text for the page (max 2000 characters)."
          }
        },
        "required": [
          "parentPageId",
          "title"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object"
          }
        }
      }
    },
    "documents.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Page",
      "description": "Retrieve a single Notion page by its ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the page to retrieve."
          }
        },
        "required": [
          "pageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object"
          }
        }
      }
    },
    "documents.restore": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Restore Page",
      "description": "Restore a trashed Notion page, removing it from the trash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the trashed page to restore."
          }
        },
        "required": [
          "pageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object"
          }
        }
      }
    },
    "documents.search": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search Pages",
      "description": "Search Notion pages by an optional text query, returning the most recently edited pages first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional text to match against page titles; omit to list all accessible pages."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor returned by a prior call."
          },
          "pageSize": {
            "type": "integer",
            "description": "Number of pages to return, between 1 and 100."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "documents.trash": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Trash Page",
      "description": "Move a Notion page to the trash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the page to move to the trash."
          }
        },
        "required": [
          "pageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object"
          }
        }
      }
    },
    "databases.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Database",
      "description": "Retrieve a Notion database's schema and property definitions by its ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "databaseId": {
            "type": "string",
            "description": "ID of the database to retrieve."
          }
        },
        "required": [
          "databaseId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "database": {
            "type": "object"
          },
          "summary": {
            "type": "object"
          }
        }
      }
    },
    "databases.items.query": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Query Database Items",
      "description": "Query the rows (pages) of a Notion database, with optional property filters combined with AND.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "databaseId": {
            "type": "string",
            "description": "ID of the database to query."
          },
          "filters": {
            "type": "array",
            "description": "Up to 20 property filters combined with AND. Each filter targets one property by name and matches with equals or contains.",
            "items": {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string",
                  "description": "Name of the database property to filter on."
                },
                "type": {
                  "type": "string",
                  "description": "Property type of the filter target.",
                  "enum": [
                    "checkbox",
                    "date",
                    "email",
                    "multi_select",
                    "number",
                    "people",
                    "phone_number",
                    "rich_text",
                    "select",
                    "status",
                    "title",
                    "url"
                  ]
                },
                "equals": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ],
                  "description": "Match the property exactly equal to this value."
                },
                "contains": {
                  "type": "string",
                  "description": "Match the property containing this substring (used for multi_select/people and text)."
                }
              },
              "required": [
                "property",
                "type"
              ]
            }
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor returned by a prior call."
          },
          "pageSize": {
            "type": "integer",
            "description": "Number of items to return, between 1 and 100."
          }
        },
        "required": [
          "databaseId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "databases.items.update": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update Database Item",
      "description": "Update the property values of an existing Notion database item (page).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the database item (page) to update."
          },
          "properties": {
            "type": "object",
            "description": "Map of property name to a typed value. At least one property is required.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Notion property type.",
                  "enum": [
                    "checkbox",
                    "date",
                    "email",
                    "multi_select",
                    "number",
                    "people",
                    "phone_number",
                    "rich_text",
                    "select",
                    "status",
                    "title",
                    "url"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ],
                  "description": "Property value; a string array is used for multi_select and people, a number for number, a boolean for checkbox, otherwise a string.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "value"
              ]
            }
          }
        },
        "required": [
          "pageId",
          "properties"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          }
        }
      }
    },
    "databases.items.restore": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Restore Database Item",
      "description": "Restore a trashed Notion database item (page), removing it from the trash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the trashed database item (page) to restore."
          }
        },
        "required": [
          "pageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object"
          }
        }
      }
    },
    "databases.items.trash": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Trash Database Item",
      "description": "Move a Notion database item (page) to the trash.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the database item (page) to move to the trash."
          }
        },
        "required": [
          "pageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object"
          }
        }
      }
    },
    "databases.items.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create Database Item",
      "description": "Create a new item (page) in a Notion database with typed property values and optional body content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "databaseId": {
            "type": "string",
            "description": "ID of the database to create the item in."
          },
          "properties": {
            "type": "object",
            "description": "Map of property name to a typed value. At least one property is required.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Notion property type.",
                  "enum": [
                    "checkbox",
                    "date",
                    "email",
                    "multi_select",
                    "number",
                    "people",
                    "phone_number",
                    "rich_text",
                    "select",
                    "status",
                    "title",
                    "url"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ],
                  "description": "Property value; a string array is used for multi_select and people, a number for number, a boolean for checkbox, otherwise a string.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "type",
                "value"
              ]
            }
          },
          "content": {
            "type": "string",
            "description": "Optional paragraph body text for the new item (max 2000 characters)."
          }
        },
        "required": [
          "databaseId",
          "properties"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          }
        }
      }
    },
    "databases.items.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Database Item",
      "description": "Retrieve a single Notion database item (page) by its ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "description": "ID of the database item (page) to retrieve."
          }
        },
        "required": [
          "pageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object"
          }
        }
      }
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Notion connector. Takes no input and returns the connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    },
    "users.list": {
      "kind": "sync",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    }
  },
  "models": [
    "document",
    "user"
  ]
}
