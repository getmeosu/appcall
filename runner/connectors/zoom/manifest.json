{
  "key": "zoom",
  "name": "Zoom",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["productivity"],
  "auth": {
    "type": "oauth2",
    "scopes": ["meeting:read", "meeting:write", "user:read"],
    "setup": {
      "mode": "oauth2",
      "fields": []
    }
  },
  "network": {
    "allowedHosts": ["api.zoom.us"]
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Zoom connector. Takes no input and returns the connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "status": { "type": "string", "description": "Connector health status, e.g. \"ok\" or \"error\"." },
          "source": { "type": "string" }
        }
      }
    },
    "users.me": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Current User",
      "description": "Retrieve the profile information for the authenticated Zoom user, including name, email, timezone, and account details.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "user": { "type": "object", "description": "The authenticated user's profile resource from Zoom." }
        }
      }
    },
    "users.list": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Users",
      "description": "List all users on the Zoom account. Supports pagination via next_page_token and filtering by status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page_size": {
            "type": "number",
            "description": "Optional. Number of records to return per page. Default 30, max 300."
          },
          "next_page_token": {
            "type": "string",
            "description": "Optional. Token for paginating to the next page of results."
          },
          "status": {
            "type": "string",
            "description": "Optional. Filter users by status: active, inactive, or pending.",
            "enum": ["active", "inactive", "pending"]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "users": { "type": "array", "description": "List of user resources." },
          "nextPageToken": { "type": "string", "description": "Token to fetch the next page." },
          "totalRecords": { "type": "number", "description": "Total number of records." }
        }
      }
    },
    "meetings.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Create Meeting",
      "description": "Create a new Zoom meeting for a user. Returns join_url, start_url, and meeting ID. Defaults to the authenticated user (userId = \"me\").",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Optional. The user ID or email address of the meeting host. Defaults to \"me\" (the authenticated user)."
          },
          "topic": {
            "type": "string",
            "description": "The topic / title of the meeting."
          },
          "type": {
            "type": "number",
            "description": "Meeting type: 1=Instant, 2=Scheduled, 3=Recurring with no fixed time, 8=Recurring with fixed time.",
            "enum": [1, 2, 3, 8]
          },
          "start_time": {
            "type": "string",
            "description": "Meeting start time in ISO 8601 format (e.g. 2025-07-15T10:00:00Z). Required for scheduled meetings (type 2 or 8)."
          },
          "duration": {
            "type": "number",
            "description": "Duration of the meeting in minutes."
          },
          "timezone": {
            "type": "string",
            "description": "Timezone for the meeting, e.g. America/New_York."
          },
          "password": {
            "type": "string",
            "description": "Optional. Meeting passcode (max 10 characters)."
          },
          "agenda": {
            "type": "string",
            "description": "Optional. Meeting agenda or description."
          },
          "settings": {
            "type": "object",
            "description": "Optional. Advanced meeting settings object.",
            "properties": {
              "host_video": { "type": "boolean", "description": "Start video when the host joins." },
              "participant_video": { "type": "boolean", "description": "Start video when participants join." },
              "join_before_host": { "type": "boolean", "description": "Allow participants to join before the host." },
              "waiting_room": { "type": "boolean", "description": "Enable the waiting room." },
              "mute_upon_entry": { "type": "boolean", "description": "Mute participants upon entry." }
            }
          }
        },
        "required": ["topic"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "meeting": { "type": "object", "description": "The created meeting resource including id, join_url, and start_url." }
        }
      }
    },
    "meetings.list": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Meetings",
      "description": "List all meetings for a Zoom user. Supports pagination and filtering by meeting type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Optional. The user ID or email address. Defaults to \"me\" (the authenticated user)."
          },
          "type": {
            "type": "string",
            "description": "Optional. Filter by meeting type: scheduled, live, upcoming, upcoming_meetings, previous_meetings.",
            "enum": ["scheduled", "live", "upcoming", "upcoming_meetings", "previous_meetings"]
          },
          "page_size": {
            "type": "number",
            "description": "Optional. Number of records to return per page. Default 30, max 300."
          },
          "next_page_token": {
            "type": "string",
            "description": "Optional. Token for paginating to the next page of results."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "meetings": { "type": "array", "description": "List of meeting resources." },
          "nextPageToken": { "type": "string", "description": "Token to fetch the next page." },
          "totalRecords": { "type": "number", "description": "Total number of records." }
        }
      }
    },
    "meetings.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Meeting",
      "description": "Retrieve detailed information about a specific Zoom meeting by its meeting ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The meeting ID to retrieve."
          }
        },
        "required": ["meetingId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "meeting": { "type": "object", "description": "The meeting resource." }
        }
      }
    },
    "meetings.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Update Meeting",
      "description": "Update an existing Zoom meeting's properties such as topic, start time, duration, and settings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The meeting ID to update."
          },
          "topic": {
            "type": "string",
            "description": "Optional. Updated meeting topic / title."
          },
          "start_time": {
            "type": "string",
            "description": "Optional. Updated meeting start time in ISO 8601 format."
          },
          "duration": {
            "type": "number",
            "description": "Optional. Updated duration in minutes."
          },
          "timezone": {
            "type": "string",
            "description": "Optional. Updated timezone for the meeting."
          },
          "password": {
            "type": "string",
            "description": "Optional. Updated meeting passcode."
          },
          "agenda": {
            "type": "string",
            "description": "Optional. Updated meeting agenda."
          },
          "settings": {
            "type": "object",
            "description": "Optional. Updated meeting settings.",
            "properties": {
              "host_video": { "type": "boolean", "description": "Start video when the host joins." },
              "participant_video": { "type": "boolean", "description": "Start video when participants join." },
              "join_before_host": { "type": "boolean", "description": "Allow participants to join before the host." },
              "waiting_room": { "type": "boolean", "description": "Enable the waiting room." },
              "mute_upon_entry": { "type": "boolean", "description": "Mute participants upon entry." }
            }
          }
        },
        "required": ["meetingId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "updated": { "type": "boolean", "description": "True if the meeting was successfully updated." }
        }
      }
    },
    "meetings.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Delete Meeting",
      "description": "Delete a Zoom meeting by its meeting ID. This action is irreversible.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The meeting ID to delete."
          }
        },
        "required": ["meetingId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "deleted": { "type": "boolean", "description": "True if the meeting was successfully deleted." }
        }
      }
    },
    "meetings.list_registrants": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Meeting Registrants",
      "description": "Retrieve the list of registrants for a specific Zoom meeting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The meeting ID whose registrants to list."
          },
          "page_size": {
            "type": "number",
            "description": "Optional. Number of records to return per page."
          },
          "next_page_token": {
            "type": "string",
            "description": "Optional. Token for paginating to the next page."
          }
        },
        "required": ["meetingId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "registrants": { "type": "array", "description": "List of registrant resources." },
          "nextPageToken": { "type": "string", "description": "Token to fetch the next page." }
        }
      }
    },
    "meetings.add_registrant": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Add Meeting Registrant",
      "description": "Register a participant for a Zoom meeting by providing their email and name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The meeting ID to register the participant for."
          },
          "email": {
            "type": "string",
            "description": "The registrant's email address."
          },
          "first_name": {
            "type": "string",
            "description": "The registrant's first name."
          },
          "last_name": {
            "type": "string",
            "description": "Optional. The registrant's last name."
          }
        },
        "required": ["meetingId", "email", "first_name"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "registrant": { "type": "object", "description": "The created registrant resource including join_url and registrant ID." }
        }
      }
    },
    "past_meetings.participants": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Past Meeting Participants",
      "description": "Retrieve the list of participants for a completed (past) Zoom meeting by its meeting UUID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingUUID": {
            "type": "string",
            "minLength": 1,
            "description": "Raw Zoom meeting UUID. Must be non-empty and contain no whitespace, ASCII control characters, backslashes, '?' or '#', or '..' path segments (including '../'). Values beginning with '/' or containing '//' are valid and are double-encoded."
          },
          "page_size": {
            "type": "number",
            "description": "Optional. Number of records to return per page."
          },
          "next_page_token": {
            "type": "string",
            "description": "Optional. Token for paginating to the next page."
          }
        },
        "required": ["meetingUUID"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "participants": { "type": "array", "description": "List of participant resources." },
          "nextPageToken": { "type": "string", "description": "Token to fetch the next page." }
        }
      }
    },
    "webinars.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Create Webinar",
      "description": "Create a new Zoom webinar for a user. Requires a webinar license. Defaults to the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Optional. The user ID or email address of the webinar host. Defaults to \"me\"."
          },
          "topic": {
            "type": "string",
            "description": "The topic / title of the webinar."
          },
          "type": {
            "type": "number",
            "description": "Webinar type: 5=Webinar, 6=Recurring webinar with no fixed time, 9=Recurring webinar with fixed time.",
            "enum": [5, 6, 9]
          },
          "start_time": {
            "type": "string",
            "description": "Webinar start time in ISO 8601 format."
          },
          "duration": {
            "type": "number",
            "description": "Duration of the webinar in minutes."
          },
          "timezone": {
            "type": "string",
            "description": "Timezone for the webinar."
          },
          "agenda": {
            "type": "string",
            "description": "Optional. Webinar agenda or description."
          },
          "password": {
            "type": "string",
            "description": "Optional. Webinar passcode."
          }
        },
        "required": ["topic"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "webinar": { "type": "object", "description": "The created webinar resource." }
        }
      }
    },
    "webinars.list": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Webinars",
      "description": "List all webinars for a Zoom user. Defaults to the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Optional. The user ID or email address. Defaults to \"me\"."
          },
          "page_size": {
            "type": "number",
            "description": "Optional. Number of records to return per page."
          },
          "next_page_token": {
            "type": "string",
            "description": "Optional. Token for paginating to the next page."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "webinars": { "type": "array", "description": "List of webinar resources." },
          "nextPageToken": { "type": "string", "description": "Token to fetch the next page." },
          "totalRecords": { "type": "number", "description": "Total number of records." }
        }
      }
    }
  },
  "models": ["meeting", "user", "webinar"]
}
