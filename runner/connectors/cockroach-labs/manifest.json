      "inputSchema": {
        "type": "object",
        "properties": {
          "clusterId": {
            "type": "string",
            "minLength": 1,
            "description": "Cluster ID."
          },
          "deleteProtection": {
            "type": "string",
            "minLength": 1,
            "description": "Delete protection setting.",
            "enum": [
              "ENABLED",
              "DISABLED"
            ]
          },
          "cockroachVersion": {
            "type": "string",
            "minLength": 1,
            "description": "Target CockroachDB version."
          }
        },
        "additionalProperties": false,
        "required": [
          "clusterId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/api/v1/clusters/{{clusterId}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "delete_protection": "{{deleteProtection}}",
          "cockroach_version": "{{cockroachVersion}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
