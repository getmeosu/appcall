{
  "key": "cockroach-labs",
  "name": "Cockroach Labs",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "CockroachDB Cloud API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "cockroachlabs.cloud"
    ]
  },
  "models": [
    "organization",
    "cluster",
    "region",
    "sqlUser",
    "allowlist",
    "database",
    "backup",
    "invoice",
    "folder",
    "serviceAccount"
  ],
  "http": {
    "baseUrl": "https://cockroachlabs.cloud",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Cc-Version": "2024-09-16"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Healthcheck",
      "description": "Validate the CockroachDB Cloud API key with GET /api/v1/organization.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/organization",
        "success": [
          200
        ]
      }
    },
    "clusters.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "List clusters",
      "description": "List CockroachDB Cloud clusters in the organization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "showInactive": {
            "type": "boolean"
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ]
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "NAME",
              "CREATED_AT",
              "DELETED_AT"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/clusters",
        "query": {
          "show_inactive": "{{showInactive}}",
          "pagination.page": "{{page}}",
          "pagination.limit": "{{limit}}",
          "pagination.sort_order": "{{sortOrder}}",
          "pagination.sort_by": "{{sortBy}}"
        },
        "success": [
          200
        ]
      }
    },
    "clusters.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
