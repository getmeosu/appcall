          "Content-Type": "application/json"
        },
        "body": {
          "cidr_ip": "{{cidrIp}}",
          "cidr_mask": "{{cidrMask}}",
          "sql": "{{sql}}",
          "ui": "{{ui}}",
          "name": "{{name}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
