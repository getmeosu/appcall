          200
        ]
      }
    },
    "clusters.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create cluster",
      "description": "Create a CockroachDB Cloud cluster.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Cluster name."
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "description": "Cloud provider.",
            "enum": [
              "AWS",
              "GCP",
              "AZURE"
            ]
          },
          "spec": {
            "type": "object",
            "description": "Cluster specification including serverless or dedicated fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "provider",
          "spec"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/clusters",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "provider": "{{provider}}",
          "spec": "{{spec}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
