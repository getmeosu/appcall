        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/users/{{id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "users.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Users",
      "description": "List PagerDuty users with optional pagination and text query.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/users",
        "success": [
          200
        ],
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "query": "{{query}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "incidents.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Incidents",
      "description": "List PagerDuty incidents with optional pagination, status, service, and time filters.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "triggered",
                "acknowledged",
                "resolved"
              ]
            },
            "minItems": 1
          },
          "serviceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "since": {
            "type": "string",
            "minLength": 1
          },
          "until": {
            "type": "string",
            "minLength": 1
          },
          "sortBy": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/incidents",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "statuses[]": "{{statuses}}",
          "service_ids[]": "{{serviceIds}}",
          "since": "{{since}}",
          "until": "{{until}}",
          "sort_by": "{{sortBy}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
