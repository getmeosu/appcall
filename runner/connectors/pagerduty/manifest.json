    "incidents.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create Incident",
      "description": "Create a PagerDuty incident on a service. The From header identifies the requesting user.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromEmail": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "serviceId": {
            "type": "string",
            "minLength": 1
          },
          "urgency": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1
          },
          "incidentKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "fromEmail",
          "title",
          "serviceId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/incidents",
        "headers": {
          "Content-Type": "application/json",
          "From": "{{fromEmail}}"
        },
        "body": {
          "incident": {
            "type": "incident",
            "title": "{{title}}",
            "service": {
              "id": "{{serviceId}}",
              "type": "service_reference"
            },
            "urgency": "{{urgency}}",
            "incident_key": "{{incidentKey}}",
            "body": {
              "type": "incident_body",
              "details": "{{details}}"
            }
          }
        },
        "success": [
          200,
          201
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
