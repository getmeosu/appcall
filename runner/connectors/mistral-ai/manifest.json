    "chat.complete": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 60000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Create chat completion",
      "description": "Create a Mistral chat completion for the given model and messages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Model ID such as mistral-small-latest."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Chat messages in role/content form.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature.",
            "minimum": 0,
            "maximum": 1.5
          },
          "topP": {
            "type": "number",
            "description": "Nucleus sampling threshold.",
            "minimum": 0,
            "maximum": 1
          },
          "maxTokens": {
            "type": "integer",
            "description": "Maximum generated tokens.",
            "minimum": 0
          },
          "stop": {
            "description": "Stop sequence or list of stop sequences.",
            "type": [
              "string",
              "array"
            ]
          },
          "randomSeed": {
            "type": "integer",
            "description": "Random seed.",
            "minimum": 0
          },
          "safePrompt": {
            "type": "boolean",
            "description": "Whether to inject the safety prompt."
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "temperature": "{{temperature}}",
          "top_p": "{{topP}}",
          "max_tokens": "{{maxTokens}}",
          "stop": "{{stop}}",
          "random_seed": "{{randomSeed}}",
          "safe_prompt": "{{safePrompt}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "embeddings.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Create embeddings",
      "description": "Generate Mistral embeddings for the given input text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Embedding model ID."
          },
          "input": {
            "type": [
              "string",
              "array"
            ],
            "description": "Text or list of texts to embed."
          },
          "outputDimension": {
            "type": "integer",
            "description": "Output vector dimensions.",
            "minimum": 1
          },
          "encodingFormat": {
            "type": "string",
            "minLength": 1,
            "description": "Vector encoding format.",
            "enum": [
              "float",
              "base64"
            ]
          }
        },
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/embeddings",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "{{model}}",
          "input": "{{input}}",
          "output_dimension": "{{outputDimension}}",
          "encoding_format": "{{encodingFormat}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
