{
  "key": "aftership",
  "name": "AfterShip",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ecommerce"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "AfterShip API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.aftership.com"
    ]
  },
  "models": [
    "courier",
    "tracking",
    "courierConnection",
    "estimatedDeliveryDate"
  ],
