      "field": "apiKey",
      "in": "header",
      "name": "as-api-key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "meta.message",
        "errors.0.info",
        "errors.0.message",
        "meta.type",
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
