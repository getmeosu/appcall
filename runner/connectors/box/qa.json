{
  "connector": "box",
  "scenarios": [
    {
      "name": "Authenticated identity",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "source",
            "op": "eq",
            "value": "provider"
          },
          {
            "path": "user",
            "op": "isObject"
          },
          {
            "path": "user.id",
            "op": "type",
            "value": "string"
          },
          {
            "path": "user.id",
            "op": "matches",
            "value": "\\S"
          }
        ]
      }
    },
    {
      "name": "Read-only root page",
      "operation": "folders.listItems",
      "input": {
        "folderId": "0",
        "limit": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "source",
            "op": "eq",
            "value": "provider"
          },
          {
            "path": "entries",
            "op": "type",
            "value": "array"
          }
        ]
      }
    }
  ]
}
