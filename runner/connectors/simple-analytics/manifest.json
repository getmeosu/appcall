      "request": {
        "method": "GET",
        "path": "/{{hostname}}.json",
        "success": [
          200
        ],
        "query": {
          "version": "6",
          "info": "false",
          "fields": "histogram",
          "start": "{{start}}",
          "end": "{{end}}",
          "timezone": "{{timezone}}",
          "limit": "{{limit}}"
        },
        "headers": {
