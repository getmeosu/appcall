{
  "key": "simple-analytics",
  "name": "Simple Analytics",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ads"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Simple Analytics API key",
          "required": true,
          "secret": true
        },
        {
          "key": "userId",
          "label": "Simple Analytics user ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "simpleanalytics.com",
      "queue.simpleanalyticscdn.com"
    ]
  },
  "http": {
    "baseUrl": "https://simpleanalytics.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Api-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error.message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the Simple Analytics API key and user ID by listing websites.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/websites",
        "headers": {
          "user-id": "{{userId}}"
        },
        "success": [
          200
        ],
        "echo": {
          "status": "ok"
        },
        "result": {
          "status": "ok",
          "websites": "{{response.websites}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "websites.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "List Websites",
      "description": "List websites available to the authenticated Simple Analytics account.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "websites": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "websites"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/websites",
        "headers": {
          "user-id": "{{userId}}"
        },
        "success": [
          200
        ],
        "result": {
          "websites": "{{response.websites}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "stats.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Aggregated Stats",
      "description": "Get aggregated statistics for a tracked website hostname.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "hostname"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "stats": {
            "type": "object"
          }
        },
        "required": [
          "stats"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/{{hostname}}.json",
        "query": {
          "version": "6",
          "info": "false",
          "start": "{{start}}",
          "end": "{{end}}"
        },
        "success": [
          200
        ],
        "result": {
          "stats": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "websites.add": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Add website",
      "description": "Add a website to the Simple Analytics account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1,
            "description": "Tracked website hostname."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone, defaults to UTC."
          },
          "public": {
            "type": "boolean",
            "description": "Whether stats are publicly readable."
          },
          "label": {
            "type": "string",
            "description": "Optional website label."
          }
        },
        "additionalProperties": false,
        "required": [
          "hostname"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/websites/add",
        "success": [
          200,
          201
        ],
        "body": {
          "hostname": "{{hostname}}",
          "timezone": "{{timezone}}",
          "public": "{{public}}",
          "label": "{{label}}"
        },
        "headers": {
          "user-id": "{{userId}}",
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
