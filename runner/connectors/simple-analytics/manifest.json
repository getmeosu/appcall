            "description": "Tracked website hostname."
          },
          "start": {
            "type": "string",
            "description": "Start date YYYY-MM-DD or today-30d."
          },
          "end": {
            "type": "string",
            "description": "End date YYYY-MM-DD or yesterday."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Field result limit."
          }
        },
        "additionalProperties": false,
        "required": [
          "hostname"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
