    "organizations.update": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Update organization",
      "description": "Update one Turso organization, including overages and restore settings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "description": "Turso organization or personal account slug."
          },
          "overages": {
            "type": "boolean",
            "description": "Enable or disable overages."
          },
          "requireMfa": {
            "type": "boolean",
            "description": "Require MFA for organization members."
          },
          "restoreEnabled": {
            "type": "boolean",
            "description": "Enable deleted database and group recovery."
          }
        },
        "additionalProperties": false,
        "required": [
          "organizationSlug"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated",
      "request": {
        "method": "PATCH",
        "path": "/v1/organizations/{{organizationSlug}}",
        "success": [
          200,
          201
        ],
        "body": {
          "overages": "{{overages}}",
          "require_mfa": "{{requireMfa}}",
          "restore_enabled": "{{restoreEnabled}}"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        }
      }
    },
