      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create database token",
      "description": "Generate an authorization token for one Turso database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "description": "Turso organization or personal account slug."
