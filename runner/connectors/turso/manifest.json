            "type": "string",
            "minLength": 1,
            "description": "Turso database name."
          },
          "expiration": {
            "type": "string",
            "minLength": 1,
            "description": "Token expiration, for example 2w."
          },
          "authorization": {
            "type": "string",
            "minLength": 1,
            "description": "Token authorization level.",
            "enum": [
              "full-access",
              "read-only"
            ]
