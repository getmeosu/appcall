      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated",
      "request": {
        "method": "POST",
        "path": "/v1/organizations/{{organizationSlug}}/databases/{{databaseName}}/auth/tokens",
        "success": [
          200,
          201
        ],
        "query": {
          "expiration": "{{expiration}}",
