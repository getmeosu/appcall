{
  "key": "workos",
  "name": "WorkOS",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "WorkOS secret API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.workos.com"
    ]
  },
  "models": [
    "organization",
    "user",
    "membership",
    "invitation",
    "directory",
    "connection"
  ],
  "http": {
    "baseUrl": "https://api.workos.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "error_description",
        "error"
      ]
    }
  },
