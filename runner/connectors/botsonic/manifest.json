{
  "key": "botsonic",
  "name": "Botsonic",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Botsonic bot API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.botsonic.ai"
    ]
  },
  "models": [
    "faq",
    "conversation",
    "bot_data",
    "starter_question",
    "starter_preset"
  ],
  "http": {
    "baseUrl": "https://api.botsonic.ai",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-BOT-KEY",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Botsonic bot API token by listing one page of FAQs.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/business/bot-faq/all",
        "query": {
          "page": "1",
          "size": "1"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
