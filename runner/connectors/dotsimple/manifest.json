{
  "key": "dotsimple",
  "name": "DotSimple",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "social-media"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "DotSimple access token",
          "required": true,
          "secret": true
        },
        {
          "key": "workspaceId",
          "label": "DotSimple workspace UUID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "app.dotsimple.io"
    ]
  },
  "models": [
    "account",
    "tag",
    "media-file",
    "post"
  ],
  "http": {
    "baseUrl": "https://app.dotsimple.io/app/api",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "accounts.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Accounts",
      "description": "List connected social accounts in a DotSimple workspace. GET /{workspaceId}/accounts returns a JSON object whose data array holds account records.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{workspaceId}}/accounts",
        "success": [
          200
        ],
        "result": {
          "data": "{{response.data}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tags.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Tags",
      "description": "List content tags in a DotSimple workspace. GET /{workspaceId}/tags returns a JSON object whose data array holds tag name and hex color records.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{workspaceId}}/tags",
        "success": [
          200
        ],
        "result": {
          "data": "{{response.data}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tags.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Tag",
      "description": "Get one DotSimple tag by UUID. GET /{workspaceId}/tags/{tagId} returns the tag JSON object.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tagId"
        ],
        "properties": {
          "tagId": {
            "type": "string",
            "minLength": 1,
            "description": "UUID of the tag."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{workspaceId}}/tags/{{tagId}}",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tags.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "title": "Create Tag",
      "description": "Create a DotSimple content tag. POST /{workspaceId}/tags sends a JSON body with name and hex_color and returns the tag JSON object.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hex_color"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Tag name used to categorize posts and media."
          },
          "hex_color": {
            "type": "string",
            "minLength": 7,
            "description": "Tag color as #RRGGBB, including the leading #."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/{{workspaceId}}/tags",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "hex_color": "{{hex_color}}"
        },
        "success": [
          200,
          201
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "media.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Media Files",
      "description": "List media-file metadata in a DotSimple workspace. GET /{workspaceId}/media returns a JSON page of file records and does not download image or video bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number. The documented query is page."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "links": {
            "type": "object"
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{workspaceId}}/media",
        "query": {
          "page": "{{page}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response.data}}",
          "links": "{{response.links}}",
          "meta": "{{response.meta}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "media.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Media File",
      "description": "Get metadata for one DotSimple media file. GET /{workspaceId}/media/{mediaFileId} returns the file JSON object and does not download image or video bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaFileId"
        ],
        "properties": {
          "mediaFileId": {
            "type": "string",
            "minLength": 1,
            "description": "UUID of the media file."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{workspaceId}}/media/{{mediaFileId}}",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "posts.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Posts",
      "description": "List posts in a DotSimple workspace. GET /{workspaceId}/posts returns a JSON page of post records. The documented query is page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number. The documented query is page."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "links": {
            "type": "object"
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/{{workspaceId}}/posts",
        "query": {
          "page": "{{page}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response.data}}",
          "links": "{{response.links}}",
          "meta": "{{response.meta}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
