{
  "key": "active-merge",
  "name": "ActiveMerge",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "docsUrl": "https://app.activemerge.com/api/documentation",
      "fields": [
        {
          "key": "apiKey",
          "label": "ActiveMerge API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "app.activemerge.com"
    ]
  },
  "models": [
    "document",
    "template",
    "workflow",
    "image",
    "file",
    "credit"
  ],
  "http": {
    "baseUrl": "https://app.activemerge.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "API-KEY",
      "value": "{{apiKey}}"
    },
    "errors": {
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "documents.generate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Generate Document",
      "description": "Start an asynchronous ActiveMerge document generation job from a template unique ID and placeholder data.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "description": "Template unique_id from List Document Templates."
          },
          "data": {
            "type": "object",
            "minProperties": 1,
            "description": "Case-sensitive template placeholder names mapped to replacement values."
          },
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "pptx"
            ],
            "description": "Output document format."
          }
        },
        "required": [
          "templateId",
          "data",
          "format"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "job_id",
              "status"
            ],
            "properties": {
              "job_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/document-generation/generate",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "template_id": "{{templateId}}",
          "data": "{{data}}",
          "format": "{{format}}"
        },
        "success": [
          202
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "images.generate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 8388608,
      "maxResponseBytes": 8388608,
      "title": "Generate Images",
      "description": "Start an asynchronous image-generation job from an image template, field mapping, and inline JSON records.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "templateId": {
            "type": "integer",
            "minimum": 1,
            "description": "Image template ID from the image templates API."
          },
          "fieldMapping": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map each case-sensitive template placeholder name to a key in every data record."
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "type": "object",
              "minProperties": 1
            },
            "description": "Inline JSON records. Each record creates one image."
          }
        },
        "required": [
          "templateId",
          "fieldMapping",
          "data"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "job_id",
              "success"
            ],
            "properties": {
              "job_id": {
                "type": "integer"
              },
              "success": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/image-generation/generate",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "template_id": "{{templateId}}",
          "field_mapping": "{{fieldMapping}}",
          "data": "{{data}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "workflows.generate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Generate Workflow Documents",
      "description": "Generate documents for every template in one ActiveMerge workflow and return the temporary output URL.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "description": "Workflow unique_id."
          },
          "data": {
            "type": "object",
            "minProperties": 1,
            "description": "Case-sensitive workflow placeholder names mapped to replacement values."
          },
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "original"
            ],
            "description": "pdf combines the workflow documents. original keeps each template format."
          }
        },
        "required": [
          "workflowId",
          "data",
          "format"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/workflows/generate",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "workflow_id": "{{workflowId}}",
          "data": "{{data}}",
          "format": "{{format}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "credits.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Credits",
      "description": "Get total, used, and remaining ActiveMerge credits for the authenticated account.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "total",
              "used",
              "left"
            ],
            "properties": {
              "total": {
                "type": "integer"
              },
              "used": {
                "type": "integer"
              },
              "left": {
                "type": "integer"
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/user/credits",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "templates.placeholders": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 262144,
      "title": "Get Document Template Placeholders",
      "description": "Return the case-sensitive placeholder names for one document template unique ID.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "description": "Template unique_id, not the numeric template id."
          }
        },
        "required": [
          "templateId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/templates/{{templateId}}/placeholders",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.download-url": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get File Download URL",
      "description": "Create a temporary download URL for one file in ActiveMerge cloud storage.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fileId": {
            "type": "integer",
            "minimum": 1,
            "description": "Stored file ID."
          }
        },
        "required": [
          "fileId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/files/download/{{fileId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "images.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Image Generation",
      "description": "Get one image-generation job, including progress, credit usage, errors, and the temporary ZIP URL when complete.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "integer",
            "minimum": 1,
            "description": "Image-generation job ID."
          }
        },
        "required": [
          "jobId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "job_id",
              "status"
            ],
            "properties": {
              "job_id": {
                "type": "integer"
              },
              "status": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/image-generation/jobs/{{jobId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "templates.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Document Templates",
      "description": "List document templates for the authenticated account, including each unique template ID.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/templates",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Stored Files",
      "description": "List the immediate files and folders at the storage root, or inside parentFolderId when it is set.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parentFolderId": {
            "type": "integer",
            "minimum": 1,
            "description": "Folder ID whose immediate contents to list. Omit for the storage root."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/api/files",
        "query": {
          "id": "{{parentFolderId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "files.save": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 262144,
      "title": "Save Generated Files",
      "description": "Save non-expired output from a completed document-generation job into ActiveMerge cloud storage.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "Completed document-generation job ID."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "description": "Custom filename for a single-file job. Omit to keep the generated name."
          },
          "folderId": {
            "type": "integer",
            "minimum": 1,
            "description": "Destination folder ID. Omit to save at the storage root."
          }
        },
        "required": [
          "jobId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "saved",
              "count"
            ],
            "properties": {
              "saved": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "count": {
                "type": "integer"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/api/files/save",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "job_id": "{{jobId}}",
          "folder_id": "{{folderId}}",
          "filename": "{{filename}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
