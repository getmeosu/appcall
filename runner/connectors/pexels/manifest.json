{
  "key": "pexels",
  "name": "Pexels",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Pexels API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.pexels.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.pexels.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "models": [
    "photo",
    "video",
    "collection"
  ],
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify the Pexels API key with a bounded curated photo request.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/curated",
        "success": [
          200
        ],
        "query": {
          "page": "1",
          "per_page": "1"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "search_photos": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search Photos",
      "description": "Search Pexels photos with bounded pagination and filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Search query."
          },
          "orientation": {
            "type": "string",
            "enum": [
              "landscape",
              "portrait",
              "square"
            ],
            "description": "Desired photo orientation."
          },
          "size": {
            "type": "string",
            "enum": [
              "large",
              "medium",
              "small"
            ],
            "description": "Minimum photo size."
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "description": "Named color or hex code."
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "description": "Search locale."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number."
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80,
            "description": "Results per page, max 80."
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/search",
        "success": [
          200
        ],
        "query": {
          "query": "{{query}}",
          "orientation": "{{orientation}}",
          "size": "{{size}}",
          "color": "{{color}}",
          "locale": "{{locale}}",
          "page": "{{page}}",
          "per_page": "{{perPage}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
