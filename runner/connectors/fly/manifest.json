        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/apps/{{app_name}}/machines",
        "query": {
          "include_deleted": "{{include_deleted}}",
          "region": "{{region}}",
          "state": "{{state}}",
          "summary": "{{summary}}"
