    "sms.send": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Send SMS",
      "description": "Send one or more SMS messages via POST /sms/send. Each message requires body and to (E.164).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "SMS messages to queue. At most 1000 recipients per call.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "body",
                "to"
              ],
              "properties": {
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Message body."
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Recipient phone number in E.164 format."
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Sender ID or number."
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Sending method label, for example php."
                },
                "schedule": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Unix timestamp; omit or 0 for immediate send."
                },
                "custom_string": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Caller reference returned on receipts and replies."
                }
              }
            }
          }
        },
        "required": [
          "messages"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/sms/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "messages": "{{messages}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
