              },
              "exclusionListIds": {
                "type": "array",
                "items": { "type": "number" },
                "description": "List IDs to exclude from the send."
              }
            },
            "description": "Recipient list configuration."
          }
        },
        "required": ["name", "subject", "sender"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
