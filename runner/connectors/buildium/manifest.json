{
  "key": "buildium",
  "name": "Buildium",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Buildium client secret",
          "required": true,
          "secret": true
        },
        {
          "key": "clientId",
          "label": "Buildium client ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.buildium.com"
    ]
  },
  "models": [
    "property",
    "unit",
    "owner",
    "tenant",
    "lease",
    "vendor",
    "bill",
    "bankaccount",
    "task"
  ],
  "http": {
    "baseUrl": "https://api.buildium.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-buildium-client-secret",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "x-buildium-client-id": "{{clientId}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "message",
        "Detail",
        "detail",
        "Error",
        "error"
      ]
    }
  },
