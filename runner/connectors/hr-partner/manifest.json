{
  "key": "hr-partner",
  "name": "HR Partner",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "HR Partner API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.hrpartner.io"
    ]
  },
  "models": [
    "company",
    "employee",
    "job",
    "applicant",
    "application",
    "position",
    "absence",
    "reminder",
    "timesheet",
    "leave_request",
    "goal",
    "project"
  ],
  "http": {
    "baseUrl": "https://api.hrpartner.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "error.message",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
