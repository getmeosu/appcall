        "type": "object",
        "properties": {
          "employee_code": {
            "type": "string",
            "minLength": 1,
            "description": "Employee code used as the path identifier."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Employee code stored on the record."
          },
          "first_names": {
            "type": "string",
            "minLength": 1,
            "description": "Given names."
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "description": "Surname."
