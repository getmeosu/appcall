{
  "key": "airparser",
  "name": "Airparser",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "document-processing",
    "ai"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Airparser API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.airparser.com"
    ]
  },
  "models": [
    "inbox",
    "document"
  ],
  "http": {
    "baseUrl": "https://api.airparser.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "inboxes.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List inboxes",
      "description": "List the Airparser inboxes available to the API key.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/inboxes",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "inboxes.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "Get inbox",
      "description": "Get one Airparser inbox, including its parsing configuration and current extraction schema.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inbox_id"
        ],
        "properties": {
          "inbox_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Inbox ID returned by create or list inboxes."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/inboxes/{{inbox_id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "inboxes.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "title": "Create inbox",
      "description": "Create an Airparser inbox for a document family. llm_engine is text or vision.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Human-readable name for the new inbox."
          },
          "llm_engine": {
            "type": "string",
            "enum": [
              "text",
              "vision"
            ],
            "description": "Parsing engine. text for dense or tabular text; vision for general documents."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/inboxes/create",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "llm_engine": "{{llm_engine}}"
        },
        "success": [
          200,
          201
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List documents",
      "description": "List and search documents in one inbox. Pagination is the documented page number, not a cursor.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inbox_id"
        ],
        "properties": {
          "inbox_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Inbox whose documents should be listed."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Search text sent as q, commonly matched against document names."
          },
          "from_date": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Inclusive lower date filter, YYYY-MM-DD, sent as from."
          },
          "to_date": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Upper date filter, YYYY-MM-DD, sent as to."
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Page size from 1 to 500. The provider default is 25."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page number. Omit for the first page."
          },
          "status": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "uniqueItems": true,
            "description": "Document statuses to include. Sent as repeated status query parameters.",
            "items": {
              "type": "string",
              "enum": [
                "importing",
                "new",
                "converting",
                "parsing",
                "parsed",
                "fail",
                "fail_pp",
                "skipped",
                "skipped_pp",
                "quota",
                "exception"
              ]
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/inboxes/{{inbox_id}}/docs",
        "query": {
          "page": "{{page}}",
          "per_page": "{{per_page}}",
          "from": "{{from_date}}",
          "to": "{{to_date}}",
          "q": "{{query}}",
          "status": "{{status}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
