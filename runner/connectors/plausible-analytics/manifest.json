  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Plausible Stats API key",
          "required": true,
          "secret": true
        },
        {
          "key": "siteId",
          "label": "Site ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "plausible.io"
    ]
  },
  "models": [
    "analytics",
    "timeseries",
    "breakdown",
    "site",
    "goal",
    "shared-link",
    "guest"
  ],
  "http": {
    "baseUrl": "https://plausible.io/api",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
