{
  "key": "intercom",
  "name": "Intercom",
  "version": "0.4.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accessToken",
          "label": "Intercom API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.intercom.io"
    ]
  },
  "models": [
    "administrator",
    "contact",
    "company",
    "conversation",
    "ticket",
    "tag"
  ],
  "http": {
    "baseUrl": "https://api.intercom.io",
    "headers": {
      "Accept": "application/json",
      "Intercom-Version": "2.13"
    },
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "success"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Healthcheck",
      "description": "Validate the Intercom token by listing one administrator.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/me",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "admins.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Admins",
      "description": "List accessible Intercom administrators, optionally including avatar data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "displayAvatar": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/admins",
        "success": [
          200
        ],
        "query": {
          "display_avatar": "{{displayAvatar}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Contacts",
      "description": "List accessible Intercom contacts with bounded pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "startingAfter": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/contacts",
        "query": {
          "per_page": "{{perPage}}",
          "starting_after": "{{startingAfter}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "companies.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Companies",
      "description": "List accessible Intercom companys with bounded pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "startingAfter": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/companies/list",
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}",
          "order": "{{order}}",
          "starting_after": "{{startingAfter}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "conversations.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Conversations",
      "description": "List Intercom conversations with bounded cursor pagination (per_page, starting_after).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "startingAfter": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/conversations",
        "query": {
          "per_page": "{{perPage}}",
          "starting_after": "{{startingAfter}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "conversations.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Conversation",
      "description": "Retrieve a single Intercom conversation by id (includes conversation_parts).",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom conversation id."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/conversations/{{id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "conversations.reply": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Reply to Conversation",
      "description": "Reply to an Intercom conversation as an admin (comment or note) via POST /conversations/{id}/reply. EffectPolicy Idempotent projects conversation id from the primary response and observes via conversations.get (handler returns raw Conversation).",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "messageType",
          "type",
          "adminId",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom conversation id, or the literal \"last\"."
          },
          "messageType": {
            "type": "string",
            "enum": [
              "comment",
              "note"
            ],
            "description": "comment posts to the customer; note is internal."
          },
          "type": {
            "type": "string",
            "enum": [
              "admin"
            ],
            "description": "Reply author type (P0: admin)."
          },
          "adminId": {
            "type": "string",
            "minLength": 1,
            "description": "Admin id authoring the reply."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Reply or note body."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/conversations/{{id}}/reply",
        "body": {
          "message_type": "{{messageType}}",
          "type": "{{type}}",
          "admin_id": "{{adminId}}",
          "body": "{{body}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "effectPolicy": "Idempotent",
      "reconcile": "conversations.get"
    },
    "conversations.close": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "conversations.get",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Close Conversation",
      "description": "Close an Intercom conversation via POST /conversations/{id}/parts (message_type close). EffectPolicy Reconcile observes via conversations.get.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "adminId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom conversation id."
          },
          "adminId": {
            "type": "string",
            "minLength": 1,
            "description": "Admin id performing the close."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Optional closing note."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/conversations/{{id}}/parts",
        "body": {
          "message_type": "close",
          "type": "admin",
          "admin_id": "{{adminId}}",
          "body": "{{body}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "conversations.assign": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "conversations.get",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Assign Conversation",
      "description": "Assign an Intercom conversation via POST /conversations/{id}/parts (message_type assignment). assigneeId may be admin or team id; \"0\" unassigns. EffectPolicy Reconcile observes via conversations.get.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "adminId",
          "assigneeId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom conversation id."
          },
          "adminId": {
            "type": "string",
            "minLength": 1,
            "description": "Admin id performing the assignment."
          },
          "assigneeId": {
            "type": "string",
            "minLength": 1,
            "description": "Admin or team id; \"0\" unassigns."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Optional note when assigning."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/conversations/{{id}}/parts",
        "body": {
          "message_type": "assignment",
          "type": "admin",
          "admin_id": "{{adminId}}",
          "assignee_id": "{{assigneeId}}",
          "body": "{{body}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "conversations.tag": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "conversations.get",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Tag Conversation",
      "description": "Add a tag via POST /conversations/{id}/tags (body id=tagId, admin_id). Upstream returns Tag; EffectPolicy Reconcile observes conversation via conversations.get.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "tagId",
          "adminId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Conversation id (path)."
          },
          "tagId": {
            "type": "string",
            "minLength": 1,
            "description": "Tag id (maps to body id)."
          },
          "adminId": {
            "type": "string",
            "minLength": 1,
            "description": "Admin applying the tag."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/conversations/{{id}}/tags",
        "body": {
          "id": "{{tagId}}",
          "admin_id": "{{adminId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Contact",
      "description": "Retrieve a single Intercom contact by id via GET /contacts/{id}.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom contact id."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/contacts/{{id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "conversations.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search Conversations",
      "description": "Search Intercom conversations via POST /conversations/search. Pass Intercom Search query object; optional perPage/startingAfter map to pagination.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "object",
            "description": "Intercom Search query (single filter {field,operator,value} or AND/OR tree)."
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150,
            "description": "Results per page (maps to pagination.per_page)."
          },
          "startingAfter": {
            "type": "string",
            "minLength": 1,
            "description": "Cursor (maps to pagination.starting_after)."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/conversations/search",
        "body": {
          "query": "{{query}}",
          "pagination": {
            "per_page": "{{perPage}}",
            "starting_after": "{{startingAfter}}"
          }
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Create Contact",
      "description": "Create an Intercom contact via POST /contacts. email is required. Optional role (user or lead), name, externalId, phone.",
      "inputSchema": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Contact email."
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "lead"
            ],
            "description": "Contact role. Defaults to user on the provider side if omitted."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Contact name."
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "description": "External id (maps to external_id)."
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "description": "Phone number."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/contacts",
        "body": {
          "email": "{{email}}",
          "role": "{{role}}",
          "name": "{{name}}",
          "external_id": "{{externalId}}",
          "phone": "{{phone}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Update Contact",
      "description": "Update an Intercom contact via PUT /contacts/{id}. id is required. Only the fields you pass are changed.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom contact id."
          },
          "email": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "lead"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "description": "External id (maps to external_id)."
          },
          "phone": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/contacts/{{id}}",
        "body": {
          "email": "{{email}}",
          "role": "{{role}}",
          "name": "{{name}}",
          "external_id": "{{externalId}}",
          "phone": "{{phone}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "destructive",
      "title": "Delete Contact",
      "description": "Permanently delete an Intercom contact via DELETE /contacts/{id}. This cannot be undone.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Intercom contact id."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/contacts/{{id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "companies.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Create Company",
      "description": "Create an Intercom company via POST /companies. companyId is the caller-defined company id (maps to company_id) and is required. Optional name, website, industry, plan.",
      "inputSchema": {
        "type": "object",
        "required": [
          "companyId"
        ],
        "properties": {
          "companyId": {
            "type": "string",
            "minLength": 1,
            "description": "Caller-defined company id (maps to company_id)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Company name."
          },
          "website": {
            "type": "string",
            "minLength": 1
          },
          "industry": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/companies",
        "body": {
