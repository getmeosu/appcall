{
  "key": "pinecone",
  "name": "Pinecone",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Pinecone API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.pinecone.io"
    ]
  },
  "models": [
    "index",
    "collection",
    "backup",
    "restoreJob"
  ],
  "http": {
    "baseUrl": "https://api.pinecone.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Api-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "X-Pinecone-Api-Version": "2026-04"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error.message",
        "error"
      ]
    }
  },
  "operations": {
