      "description": "Create a Pinecone index.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Index name."
          },
          "dimension": {
            "type": "integer",
            "description": "Vector dimension.",
            "minimum": 1
          },
          "metric": {
            "type": "string",
            "description": "Distance metric, for example cosine."
          },
          "spec": {
            "type": "object",
            "description": "Serverless or pod spec."
          },
          "deletion_protection": {
            "type": "string",
            "description": "enabled or disabled."
          },
          "vector_type": {
            "type": "string",
            "description": "dense or sparse."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "spec"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
