          "X-Pinecone-Api-Version": "2026-04"
        },
        "body": {
          "name": "{{name}}",
          "dimension": "{{dimension}}",
          "metric": "{{metric}}",
          "spec": "{{spec}}",
          "deletion_protection": "{{deletion_protection}}",
          "vector_type": "{{vector_type}}"
        }
      }
    },
