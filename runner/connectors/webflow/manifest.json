            "description": "Collection ID."
          },
          "itemIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Item IDs to publish."
          }
        },
        "required": [
          "collectionId",
          "itemIds"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
