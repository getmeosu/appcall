            "type": "string"
          }
        },
        "required": [
          "deleted",
          "itemId"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/collections/{{collectionId}}/items/{{itemId}}",
        "success": [
          200,
          204
        ],
        "result": {
          "deleted": true,
          "itemId": "{{input.itemId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "items.publish": {
