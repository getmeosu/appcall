        "type": "object",
        "properties": {
          "collectionId": {
            "type": "string",
            "minLength": 1,
            "description": "Collection ID."
          },
          "itemId": {
            "type": "string",
            "minLength": 1,
            "description": "Item ID."
          },
          "fieldData": {
            "type": "object",
            "description": "CMS field values to update."
          },
          "isArchived": {
            "type": "boolean",
            "description": "Archive or unarchive the item."
          },
          "isDraft": {
            "type": "boolean",
            "description": "Mark the item as a draft."
          }
        },
        "required": [
          "collectionId",
          "itemId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/collections/{{collectionId}}/items/{{itemId}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "fieldData": "{{fieldData}}",
          "isArchived": "{{isArchived}}",
          "isDraft": "{{isDraft}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "items.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete Collection Item",
      "description": "Delete an item from a Webflow CMS collection.",
