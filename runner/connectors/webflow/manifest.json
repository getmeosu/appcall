{
  "key": "webflow",
  "name": "Webflow",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [
      "sites:read",
      "cms:read"
    ],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Webflow API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.webflow.com"
    ]
  },
  "models": [
    "site",
    "collection",
    "collection_item",
    "page",
    "form",
    "asset",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.webflow.com/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "msg",
        "error",
        "detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify the Webflow token by listing accessible sites.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/sites",
        "success": [
          200
        ],
        "result": {
          "status": "ok"
        }
      },
      "enforceOutputSchema": true
    },
    "list_sites": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Sites",
      "description": "List Webflow sites available to the connected token.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sites": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "sites"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/sites",
        "success": [
          200
        ],
        "result": {
          "sites": "{{response.sites}}"
        }
      },
      "enforceOutputSchema": true
    },
    "list_collections": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Collections",
      "description": "List CMS collections for a Webflow site.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "siteId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "collections": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "collections"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/sites/{{siteId}}/collections",
        "success": [
          200
        ],
        "result": {
          "collections": "{{response.collections}}"
        }
      },
      "enforceOutputSchema": true
    },
    "list_collection_items": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Collection Items",
      "description": "List bounded items in a Webflow CMS collection; pagination links are returned by the provider and never followed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collectionId": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "collectionId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "limit": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "offset": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "required": [
          "items",
          "pagination"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/collections/{{collectionId}}/items",
        "success": [
          200
        ],
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "result": {
          "items": "{{response.items}}",
          "pagination": {
            "limit": "{{response.limit}}",
            "offset": "{{response.offset}}",
            "total": "{{response.total}}"
          }
        }
      },
      "enforceOutputSchema": true
    },
    "sites.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Site",
      "description": "Retrieve one Webflow site by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "Site ID."
          }
        },
        "required": [
          "siteId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/sites/{{siteId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "sites.publish": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Publish Site",
      "description": "Publish a Webflow site to custom domains and/or the webflow.io subdomain.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "Site ID."
          },
          "customDomains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Custom domains to publish."
          },
          "publishToWebflowSubdomain": {
            "type": "boolean",
            "description": "Publish to the webflow.io subdomain."
          }
        },
        "required": [
          "siteId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/sites/{{siteId}}/publish",
        "success": [
          200,
          202
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "customDomains": "{{customDomains}}",
          "publishToWebflowSubdomain": "{{publishToWebflowSubdomain}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "collections.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
