        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "items.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Collection Item",
      "description": "Create an item in a Webflow CMS collection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collectionId": {
            "type": "string",
            "minLength": 1,
            "description": "Collection ID."
          },
          "fieldData": {
            "type": "object",
            "description": "CMS field values, including name and slug."
          },
          "isArchived": {
            "type": "boolean",
            "description": "Archive the item on create."
          },
          "isDraft": {
            "type": "boolean",
            "description": "Create the item as a draft."
          }
        },
        "required": [
          "collectionId",
          "fieldData"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/collections/{{collectionId}}/items",
        "success": [
          200,
          201,
          202
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "fieldData": "{{fieldData}}",
          "isArchived": "{{isArchived}}",
          "isDraft": "{{isDraft}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "items.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
