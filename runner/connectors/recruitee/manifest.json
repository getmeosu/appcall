      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "PATCH",
        "path": "/candidates/{{id}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "candidate": {
            "name": "{{name}}",
            "emails": "{{emails}}",
            "phones": "{{phones}}",
            "social_links": "{{social_links}}",
            "links": "{{links}}",
            "cover_letter": "{{cover_letter}}",
            "remote_cv_url": "{{remote_cv_url}}"
          }
        }
      }
    },
    "candidates.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete candidate",
      "description": "Permanently delete a candidate via ATS API DELETE /c/{company}/candidates/{id}. Returns the deleted candidate object.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Candidate ID to delete."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "DELETE",
        "path": "/candidates/{{id}}",
        "success": [
          200
        ]
      }
    },
    "candidates.notes.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create candidate note",
      "description": "Create a note for a candidate via ATS API POST /c/{company}/candidates/{candidate_id}/notes.",
      "inputSchema": {
        "type": "object",
        "required": [
          "candidate_id",
          "body"
        ],
        "properties": {
          "candidate_id": {
            "type": "integer",
            "description": "Candidate ID to attach the note to."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Note text content."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/candidates/{{candidate_id}}/notes",
        "success": [
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "note": {
            "body": "{{body}}"
          }
        }
      }
    },
    "candidates.notes.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "List candidate notes",
      "description": "List notes for a candidate via ATS API GET /c/{company}/candidates/{candidate_id}/notes.",
      "inputSchema": {
        "type": "object",
        "required": [
          "candidate_id"
        ],
        "properties": {
          "candidate_id": {
            "type": "integer",
            "description": "Candidate ID."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of notes to return per page."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of notes to skip."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/candidates/{{candidate_id}}/notes",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "success": [
          200
        ]
      }
    },
    "departments.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List departments",
      "description": "List company departments via ATS API GET /c/{company}/departments.",
      "inputSchema": {
        "type": "object",
