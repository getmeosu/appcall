{
  "key": "recruitee",
  "name": "Recruitee",
  "version": "0.4.0",
  "runtime": "bun",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "bearer",
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "company",
          "label": "Company ID or subdomain",
          "required": true,
          "secret": false
        },
        {
          "key": "accessToken",
          "label": "API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.recruitee.com",
      "api.recruitee.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.recruitee.com/c/{{company}}",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "errors.0.message",
        "message",
        "detail"
      ]
    }
  },
  "operations": {
    "jobs.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List jobs (careers)",
      "description": "List published career-site job postings via Careers Site API GET /offers on {company}.recruitee.com. Returns NormalizedJob rows. Distinct from offers.list (ATS admin offers)."
    },
    "candidates.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List candidates",
      "description": "List candidates via ATS API GET /c/{company}/candidates. Optional limit, offset, offerId, and query filters."
    },
    "pipeline_stages.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List pipeline stages",
      "description": "List pipeline stages from an offer (offerId), a pipeline template (pipelineTemplateId), or all company pipeline templates via the ATS API."
    },
    "offers.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List offers (ATS)",
      "description": "List company offers (jobs/talent pools) via authenticated ATS API GET /c/{company}/offers. Richer admin listing than careers jobs.list."
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Recruitee connector. Takes no input and returns the connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    },
    "candidates.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get candidate",
      "description": "Fetch a single candidate via authenticated ATS API GET /c/{company}/candidates/{id}. Includes placements and profile fields."
    },
    "candidates.search": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search candidates",
      "description": "Search candidates via authenticated ATS API GET /c/{company}/search/new/candidates. Optional query (all-field filter), filtersJson, limit, page, and sortBy."
    },
    "interview_events.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List interview events",
      "description": "List scheduled interview events via authenticated ATS API GET /c/{company}/interview/events. Optional candidateId, date range, scope, status, adminIds, limit, and page filters."
    },
    "company.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get company identity",
      "description": "Get the authenticated admin and associated companies via ATS API GET /c/{company}/admin. The admin payload carries company_id for identity confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/admin",
        "success": [
          200
        ]
      }
    },
    "candidates.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create candidate",
      "description": "Manually add a candidate via ATS API POST /c/{company}/candidates. Optionally assigns the candidate to an offer with the default stage.",
      "inputSchema": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Candidate name."
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Candidate email addresses."
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Candidate phone numbers."
          },
          "social_links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Social profile links."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional links."
          },
          "cover_letter": {
            "type": "string",
            "description": "Candidate cover letter text."
          },
          "source": {
            "type": "string",
            "description": "Candidate source tag, e.g. manual."
          },
          "remote_cv_url": {
            "type": "string",
            "description": "Link to a CV file saved on an external website."
          },
          "offer_id": {
            "type": "string",
            "minLength": 1,
            "description": "Single offer ID to assign the candidate to."
          },
          "offers": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Offer IDs to assign the candidate to with the default stage."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/candidates",
        "success": [
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "candidate": {
            "name": "{{name}}",
            "emails": "{{emails}}",
            "phones": "{{phones}}",
            "social_links": "{{social_links}}",
            "links": "{{links}}",
            "cover_letter": "{{cover_letter}}",
            "source": "{{source}}",
            "remote_cv_url": "{{remote_cv_url}}"
          },
          "offer_id": "{{offer_id}}",
          "offers": "{{offers}}"
        }
      }
    },
    "candidates.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update candidate",
      "description": "Partially update a candidate via ATS API PATCH /c/{company}/candidates/{id}. Only the provided fields are changed.",
