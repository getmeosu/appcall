      }
    },
    "locations.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List locations",
      "description": "List company locations via ATS API GET /c/{company}/locations. Optional query, scope, view_mode, limit, and page filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search term for location name."
          },
          "scope": {
            "type": "string",
            "description": "Location scope filter."
          },
          "view_mode": {
            "type": "string",
            "description": "Response detail level."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of locations to return."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/locations",
        "query": {
          "query": "{{query}}",
          "scope": "{{scope}}",
          "view_mode": "{{view_mode}}",
          "limit": "{{limit}}",
          "page": "{{page}}"
        },
        "success": [
          200
        ]
      }
    },
    "offers.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create offer",
      "description": "Create a company offer (job or talent pool) via ATS API POST /c/{company}/offers. Current docs return 200 OK with the created offer.",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "location_ids",
          "description",
          "requirements"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Offer title."
          },
          "kind": {
            "type": "string",
            "enum": [
              "job",
              "talent_pool"
            ],
            "description": "Offer kind: job or talent_pool."
          },
          "location_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "description": "Offer location IDs from the /locations endpoint."
          },
          "description": {
            "type": "string",
            "description": "Offer description (HTML)."
          },
          "requirements": {
            "type": "string",
            "description": "Offer requirements (HTML)."
          },
          "department_id": {
            "type": "integer",
            "description": "Department ID to assign the offer to."
          },
          "on_site": {
            "type": "boolean",
            "description": "Show the offer location as on-site on the careers site."
          },
          "hybrid": {
            "type": "boolean",
            "description": "Show the offer location as hybrid on the careers site."
          },
          "remote": {
            "type": "boolean",
            "description": "Show the offer location as remote on the careers site."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "internal",
              "published",
              "closed",
              "archived"
            ],
            "description": "Offer status."
          },
          "visibility_options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Job visibility and feature options."
          },
          "locations_question": {
            "type": "string",
            "description": "Content of the location picker question."
          },
          "locations_question_type": {
            "type": "string",
            "enum": [
              "single_choice",
              "multiple_choice"
            ],
            "description": "Location picker selection mode."
          },
          "locations_question_required": {
            "type": "boolean",
            "description": "Whether the location picker answer is required."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/offers",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "offer": {
            "title": "{{title}}",
            "kind": "{{kind}}",
            "location_ids": "{{location_ids}}",
            "description": "{{description}}",
            "requirements": "{{requirements}}",
            "department_id": "{{department_id}}",
            "on_site": "{{on_site}}",
            "hybrid": "{{hybrid}}",
            "remote": "{{remote}}",
            "status": "{{status}}",
            "visibility_options": "{{visibility_options}}",
            "locations_question": "{{locations_question}}",
            "locations_question_type": "{{locations_question_type}}",
            "locations_question_required": "{{locations_question_required}}"
          }
        }
      }
    },
