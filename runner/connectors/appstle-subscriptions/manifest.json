          "customerId"
        ],
        "properties": {
          "customerId": {
            "type": "integer",
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/external/v2/subscription-customers/{{customerId}}",
