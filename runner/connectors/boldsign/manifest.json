{
  "key": "boldsign",
  "name": "BoldSign",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "BoldSign API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.boldsign.com"
    ]
  },
  "models": [
    "plan",
    "document",
    "template",
    "contact",
    "brand",
    "user",
    "team",
    "senderIdentity"
  ],
  "http": {
    "baseUrl": "https://api.boldsign.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-KEY",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
