    "documents.send": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Send document",
      "description": "Send a BoldSign document for signature via POST /v1/document/send.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Document title shown in email and the BoldSign UI."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Optional message for recipients."
          },
          "fileUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Public URL of the file to send."
          },
          "signerName": {
            "type": "string",
            "minLength": 1,
            "description": "Signer display name."
          },
          "signerEmail": {
            "type": "string",
            "minLength": 1,
            "description": "Signer email address."
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "fileUrl",
          "signerName",
          "signerEmail"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/document/send",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "Title": "{{title}}",
          "Message": "{{message}}",
          "FileUrls": [
            "{{fileUrl}}"
          ],
          "Signers": [
            {
              "Name": "{{signerName}}",
              "EmailAddress": "{{signerEmail}}",
              "SignerType": "Signer"
            }
          ]
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
