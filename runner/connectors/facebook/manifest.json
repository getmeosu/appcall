        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "photoId": {
            "type": "string",
            "description": "Photo ID."
          },
          "postId": {
            "type": "string",
            "description": "Page post ID."
          }
        },
        "required": [
          "photoId",
          "postId"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/{{pageId}}/photos",
        "success": [
          200
        ],
        "result": {
          "photoId": "{{response.id}}",
          "postId": "{{response.post_id}}"
        },
        "body": {
          "url": "{{url}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
