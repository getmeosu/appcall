{
  "connector": "facebook",
  "scenarios": [
    {
      "name": "Authenticated identity",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "source",
            "op": "eq",
            "value": "provider"
          },
          {
            "path": "page.id",
            "op": "type",
            "value": "string"
          },
          {
            "path": "page.id",
            "op": "matches",
            "value": "\\S"
          }
        ]
      }
    },
    {
      "name": "Read-only first post page",
      "operation": "posts.list",
      "input": {
        "limit": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "source",
            "op": "eq",
            "value": "provider"
          },
          {
            "path": "posts",
            "op": "type",
            "value": "array"
          }
        ]
      }
    }
  ]
}
