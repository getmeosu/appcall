          "organizations": { "type": "array", "description": "List of matching organizations." },
          "pagination": { "type": "object", "description": "Pagination metadata." }
        }
      }
    },
    "organizations.enrich": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Enrich Organization",
      "description": "Retrieve detailed company/organization information from Apollo by providing a company domain name. Returns firmographic data, technographics, and social profiles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "The company domain to enrich (e.g. \"apollo.io\", \"google.com\")."
          }
        },
        "additionalProperties": false,
        "required": ["domain"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "organization": { "type": "object", "description": "Enriched organization data." }
        }
      }
    },
    "organizations.bulk_enrich": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Bulk Enrich Organizations",
      "description": "Enrich multiple organizations at once by providing a list of company domains. Returns firmographic and enrichment data for each domain.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of company domains to enrich (e.g. [\"apollo.io\", \"google.com\"])."
          }
        },
        "additionalProperties": false,
        "required": ["domains"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "organizations": { "type": "array", "description": "List of enriched organization data." }
        }
      }
    },
    "organizations.job_postings": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Organization Job Postings",
      "description": "Retrieve open job postings for a specific organization in Apollo by its organization ID. Useful for understanding company growth signals.",
      "inputSchema": {
        "type": "object",
