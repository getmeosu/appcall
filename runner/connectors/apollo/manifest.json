            "description": "Optional. Contact's email address."
          },
          "title": {
            "type": "string",
            "description": "Optional. Contact's job title."
          },
          "organization_name": {
            "type": "string",
            "description": "Optional. Company name for the contact."
          },
          "website_url": {
            "type": "string",
            "description": "Optional. Company website URL."
          },
          "direct_phone": {
            "type": "string",
            "description": "Optional. Contact's direct phone number."
          },
          "mobile_phone": {
            "type": "string",
            "description": "Optional. Contact's mobile phone number."
          },
          "linkedin_url": {
            "type": "string",
            "description": "Optional. Contact's LinkedIn profile URL."
          },
          "label_names": {
            "type": "array",
