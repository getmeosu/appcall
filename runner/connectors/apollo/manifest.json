{
  "key": "apollo",
  "name": "Apollo",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["crm"],
  "auth": {
    "type": "api_key",
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "API Key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": ["api.apollo.io"]
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Apollo connector. Returns connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "Connector health status, e.g. \"ok\"." }
        }
      }
    },
    "webhook.phone_revealed": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576
    },
    "people.search": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search People",
      "description": "Search for people (prospects) in Apollo using keywords, titles, seniorities, locations, and organization criteria. Returns matching people with contact details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q_keywords": {
            "type": "string",
            "description": "Optional. Keywords to search for across all person fields."
          },
          "person_titles": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional. List of job titles to filter by (e.g. [\"VP of Sales\", \"Director of Marketing\"])."
          },
          "person_seniorities": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional. Seniority levels to filter by (e.g. [\"senior\", \"director\", \"vp\", \"c_suite\"])."
          },
          "person_locations": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional. Geographic locations to filter by (e.g. [\"United States\", \"New York, NY\"])."
          },
          "organization_domains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional. Company domains to filter by (e.g. [\"google.com\", \"salesforce.com\"])."
          },
          "organization_num_employees_ranges": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional. Employee count ranges to filter by (e.g. [\"1,10\", \"11,50\", \"51,200\"])."
          },
          "page": {
            "type": "number",
            "description": "Optional. Page number for pagination (default: 1)."
          },
          "per_page": {
            "type": "number",
            "description": "Optional. Number of results per page (default: 25, max: 100)."
          }
        },
        "additionalProperties": false,
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "people": { "type": "array", "description": "List of matching people." },
          "pagination": { "type": "object", "description": "Pagination metadata." }
        }
      }
    },
    "people.match": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 65536,
      "title": "Match Person",
      "description": "Find a specific person in Apollo by matching on name, email, domain, organization, or LinkedIn URL. Returns enriched person data including contact information.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Optional. Apollo person ID. The most reliable way to enrich a known prospect — supply this to bypass fuzzy matching entirely."
          },
          "first_name": {
            "type": "string",
            "description": "Optional. Person's first name."
          },
          "last_name": {
            "type": "string",
            "description": "Optional. Person's last name."
          },
          "email": {
            "type": "string",
            "description": "Optional. Person's email address."
          },
          "domain": {
            "type": "string",
            "description": "Optional. Company domain to narrow the match (e.g. \"google.com\")."
          },
          "organization_name": {
            "type": "string",
            "description": "Optional. Company name to narrow the match."
          },
          "linkedin_url": {
            "type": "string",
            "description": "Optional. LinkedIn profile URL of the person."
          },
          "reveal_personal_emails": {
            "type": "boolean",
            "description": "Optional. Whether to attempt to reveal personal email addresses (uses credits)."
          },
          "reveal_phone_number": {
            "type": "boolean",
            "description": "Optional. Whether to attempt to reveal phone numbers (uses credits). The revealed number is delivered asynchronously to a server-managed webhook; set this flag and read the result from the apollo webhook-events feed."
          },
          "webhook_url": {
            "type": "string",
            "description": "Reserved. The async phone-reveal callback URL is injected server-side and must not be supplied by the caller; any provided value is overridden."
          }
        },
        "additionalProperties": false,
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "person": { "type": "object", "description": "Matched and enriched person data." }
        }
      }
    },
    "people.bulk_match": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 131072,
      "maxResponseBytes": 5242880,
      "title": "Bulk Match People",
      "description": "Match multiple people at once by providing a list of person detail objects. Each object can include first_name, last_name, email, domain, organization_name, or linkedin_url.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "first_name": { "type": "string", "description": "Person's first name." },
                "last_name": { "type": "string", "description": "Person's last name." },
                "email": { "type": "string", "description": "Person's email address." },
                "domain": { "type": "string", "description": "Company domain." },
                "organization_name": { "type": "string", "description": "Company name." },
                "linkedin_url": { "type": "string", "description": "LinkedIn profile URL." }
              }
            },
            "description": "Array of person detail objects to match against Apollo database."
          }
        },
        "additionalProperties": false,
        "required": ["details"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "matches": { "type": "array", "description": "List of matched person results." }
        }
      }
    },
    "organizations.search": {
