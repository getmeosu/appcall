    "prints.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create print job",
      "description": "Create an Intelliprint letter or postcard print job from content, a template, or a mailing list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "letter",
              "postcard"
            ],
            "description": "Print job type."
          },
          "testmode": {
            "type": "boolean",
            "description": "Create the job in test mode without charging or posting."
          },
          "confirmed": {
            "type": "boolean",
            "description": "Confirm the job for printing. Confirmed jobs cannot be updated."
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Plain text or HTML content for the mail piece."
          },
          "template": {
            "type": "string",
            "minLength": 1,
            "description": "Pre-designed template ID."
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Dashboard-visible description for the print job."
          },
          "mailingList": {
            "type": "string",
            "minLength": 1,
            "description": "Mailing list ID to send one copy to each recipient."
          },
          "recipients": {
            "type": "array",
            "description": "Recipients to send this print job to.",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/prints",
        "success": [
          200,
          201
        ],
        "body": {
          "type": "{{type}}",
          "testmode": "{{testmode}}",
          "confirmed": "{{confirmed}}",
          "content": "{{content}}",
          "template": "{{template}}",
          "reference": "{{reference}}",
          "mailing_list": "{{mailingList}}",
          "recipients": "{{recipients}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
