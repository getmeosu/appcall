        ],
        "body": {
          "confirmed": "{{confirmed}}",
          "reference": "{{reference}}",
          "content": "{{content}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
