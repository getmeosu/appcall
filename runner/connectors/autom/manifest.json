{
  "key": "autom",
  "name": "Autom",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Autom API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.autom.dev"
    ]
  },
  "models": [
    "usage",
    "google-country",
    "google-language",
    "google-location",
    "search",
    "stats"
  ],
  "http": {
    "baseUrl": "https://api.autom.dev",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    }
  },
  "operations": {
