    "allowedHosts": [
      "api.float.com"
    ]
  },
  "models": [
    "account",
    "person",
    "client",
    "project",
    "allocation",
    "timeoff",
    "department",
    "milestone"
  ],
  "http": {
    "baseUrl": "https://api.float.com/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
