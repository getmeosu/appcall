{
  "key": "float",
  "name": "Float",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "provenance": { "source": { "url": "https://github.com/oomol-lab/open-connector", "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a" } },
  "evidence": { "fixture": { "status": "supplied" }, "live": { "status": "unverified" } },
  "categories": ["scheduling"],
  "auth": { "type": "api_key", "scopes": [], "setup": { "mode": "api_key", "fields": [{ "key": "apiKey", "label": "Float API token", "required": true, "secret": true }] } },
  "network": { "allowedHosts": ["api.float.com"] },
  "http": { "baseUrl": "https://api.float.com/v3", "auth": { "field": "apiKey", "in": "header", "name": "Authorization", "value": "Bearer {{apiKey}}" }, "headers": { "Accept": "application/json" }, "errors": { "rateLimitStatuses": [429], "retryAfterHeader": "Retry-After", "retryAfterKind": "seconds", "defaultRetryAfterSeconds": 60, "messagePaths": ["message", "error"] } },
  "operations": {
    "healthcheck": { "kind": "action", "timeoutMs": 10000, "maxInputBytes": 4096, "maxResponseBytes": 1048576, "sideEffect": "read", "enforceOutputSchema": true, "title": "Healthcheck", "description": "Verify the Float API token by listing accounts.", "inputSchema": { "type": "object", "properties": {} }, "outputSchema": { "type": "object", "properties": { "status": { "type": "string" }, "accounts": { "type": "array", "items": { "type": "object" } } }, "required": ["status", "accounts"] }, "request": { "method": "GET", "path": "/accounts", "query": { "per-page": "1" }, "success": [200], "echo": { "status": "ok" }, "result": { "status": "ok", "accounts": "{{response}}" } } },
    "accounts.list": { "kind": "action", "timeoutMs": 15000, "maxInputBytes": 65536, "maxResponseBytes": 5242880, "sideEffect": "read", "enforceOutputSchema": true, "title": "List Accounts", "description": "List Float accounts.", "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 }, "perPage": { "type": "integer", "minimum": 1, "maximum": 200 }, "expand": { "type": "string", "enum": ["people_id"] } } }, "outputSchema": { "type": "object", "properties": { "accounts": { "type": "array", "items": { "type": "object" } }, "pagination": { "type": "object" } }, "required": ["accounts", "pagination"] }, "request": { "method": "GET", "path": "/accounts", "query": { "page": "{{page}}", "per-page": "{{perPage}}", "expand": "{{expand}}" }, "success": [200], "result": { "accounts": "{{response}}", "pagination": { "totalCount": "{{response.headers.x-total-count}}", "pageCount": "{{response.headers.x-page-count}}", "currentPage": "{{response.headers.x-page}}", "perPage": "{{response.headers.x-per-page}}" } } } },
    "people.list": { "kind": "action", "timeoutMs": 15000, "maxInputBytes": 65536, "maxResponseBytes": 5242880, "sideEffect": "read", "enforceOutputSchema": true, "title": "List People", "description": "List people on the Float schedule.", "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 }, "perPage": { "type": "integer", "minimum": 1, "maximum": 200 }, "active": { "type": "integer", "enum": [0, 1] }, "departmentId": { "type": "integer", "minimum": 1 }, "email": { "type": "string", "minLength": 1 } } }, "outputSchema": { "type": "object", "properties": { "people": { "type": "array", "items": { "type": "object" } }, "pagination": { "type": "object" } }, "required": ["people", "pagination"] }, "request": { "method": "GET", "path": "/people", "query": { "page": "{{page}}", "per-page": "{{perPage}}", "active": "{{active}}", "department_id": "{{departmentId}}", "email": "{{email}}" }, "success": [200], "result": { "people": "{{response}}", "pagination": { "totalCount": "{{response.headers.x-total-count}}", "pageCount": "{{response.headers.x-page-count}}", "currentPage": "{{response.headers.x-page}}", "perPage": "{{response.headers.x-per-page}}" } } } },
    "clients.list": { "kind": "action", "timeoutMs": 15000, "maxInputBytes": 65536, "maxResponseBytes": 5242880, "sideEffect": "read", "enforceOutputSchema": true, "title": "List Clients", "description": "List Float clients.", "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 }, "perPage": { "type": "integer", "minimum": 1, "maximum": 200 } } }, "outputSchema": { "type": "object", "properties": { "clients": { "type": "array", "items": { "type": "object" } }, "pagination": { "type": "object" } }, "required": ["clients", "pagination"] }, "request": { "method": "GET", "path": "/clients", "query": { "page": "{{page}}", "per-page": "{{perPage}}" }, "success": [200], "result": { "clients": "{{response}}", "pagination": { "totalCount": "{{response.headers.x-total-count}}", "pageCount": "{{response.headers.x-page-count}}", "currentPage": "{{response.headers.x-page}}", "perPage": "{{response.headers.x-per-page}}" } } } },
    "projects.list": { "kind": "action", "timeoutMs": 15000, "maxInputBytes": 65536, "maxResponseBytes": 5242880, "sideEffect": "read", "enforceOutputSchema": true, "title": "List Projects", "description": "List Float projects.", "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 }, "perPage": { "type": "integer", "minimum": 1, "maximum": 200 }, "active": { "type": "integer", "enum": [0, 1] }, "clientId": { "type": "integer", "minimum": 1 } } }, "outputSchema": { "type": "object", "properties": { "projects": { "type": "array", "items": { "type": "object" } }, "pagination": { "type": "object" } }, "required": ["projects", "pagination"] }, "request": { "method": "GET", "path": "/projects", "query": { "page": "{{page}}", "per-page": "{{perPage}}", "active": "{{active}}", "client_id": "{{clientId}}" }, "success": [200], "result": { "projects": "{{response}}", "pagination": { "totalCount": "{{response.headers.x-total-count}}", "pageCount": "{{response.headers.x-page-count}}", "currentPage": "{{response.headers.x-page}}", "perPage": "{{response.headers.x-per-page}}" } } } },
    "allocations.list": { "kind": "action", "timeoutMs": 15000, "maxInputBytes": 65536, "maxResponseBytes": 5242880, "sideEffect": "read", "enforceOutputSchema": true, "title": "List Allocations", "description": "List Float allocations (tasks).", "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 }, "perPage": { "type": "integer", "minimum": 1, "maximum": 200 }, "projectId": { "type": "integer", "minimum": 1 }, "peopleId": { "type": "integer", "minimum": 1 }, "startDate": { "type": "string", "minLength": 1 }, "endDate": { "type": "string", "minLength": 1 } } }, "outputSchema": { "type": "object", "properties": { "allocations": { "type": "array", "items": { "type": "object" } }, "pagination": { "type": "object" } }, "required": ["allocations", "pagination"] }, "request": { "method": "GET", "path": "/tasks", "query": { "page": "{{page}}", "per-page": "{{perPage}}", "project_id": "{{projectId}}", "people_id": "{{peopleId}}", "start_date": "{{startDate}}", "end_date": "{{endDate}}" }, "success": [200], "result": { "allocations": "{{response}}", "pagination": { "totalCount": "{{response.headers.x-total-count}}", "pageCount": "{{response.headers.x-page-count}}", "currentPage": "{{response.headers.x-page}}", "perPage": "{{response.headers.x-per-page}}" } } } }
  },
  "models": ["account", "person", "client", "project", "allocation"]
