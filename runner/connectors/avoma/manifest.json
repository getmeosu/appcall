      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "http": {
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "baseUrl": "https://api.avoma.com",
    "errors": {
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "message",
        "error"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "key": "avoma",
  "models": [
    "user",
    "meeting",
    "call",
    "recording",
    "note",
    "transcription",
    "snippet",
    "scorecard",
    "engagement",
    "webhook",
    "configuration"
  ],
  "name": "Avoma",
  "network": {
    "allowedHosts": [
      "api.avoma.com"
    ]
  },
