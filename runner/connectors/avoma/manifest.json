          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v1/meetings/{{meetingUuid}}/",
        "query": {
          "include_crm_associations": "{{includeCrmAssociations}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get meeting",
      "validationMode": "strict-generated"
    },
    "meetings.list": {
      "description": "Find meetings visible to the connected Avoma user within a required UTC date range, with optional attendee, CRM, call-type, privacy-context, duration, and ordering filters.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fromDate": {
            "minLength": 1,
            "type": "string"
          },
          "order": {
            "enum": [
              "start_at",
              "-start_at"
            ],
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "toDate": {
            "minLength": 1,
            "type": "string"
          },
          "attendee_emails": {
            "type": "string",
            "description": "Comma-separated attendee emails. Meetings matching any attendee are returned."
          },
          "crm_account_ids": {
            "type": "string",
            "description": "Comma-separated CRM account external IDs."
          },
          "crm_opportunity_ids": {
            "type": "string",
            "description": "Comma-separated CRM opportunity external IDs."
          },
          "crm_contact_ids": {
            "type": "string",
            "description": "Comma-separated CRM contact external IDs."
          },
          "crm_lead_ids": {
            "type": "string",
            "description": "Comma-separated CRM lead external IDs."
          },
          "include_crm_associations": {
            "type": "boolean",
            "description": "When true, include CRM associations in each meeting."
          },
          "is_call": {
            "type": "boolean",
            "description": "true for voice-call meetings, false for video meetings."
          },
          "is_internal": {
            "type": "boolean",
            "description": "true for internal-only meetings, false for meetings with external attendees."
          },
          "recording_duration__gte": {
            "type": "number",
            "description": "Minimum recording duration in seconds. Excludes meetings without recordings.",
            "minimum": 0
          }
        },
        "required": [
          "fromDate",
          "toDate"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v1/meetings/",
        "query": {
          "from_date": "{{fromDate}}",
          "o": "{{order}}",
          "page": "{{page}}",
          "page_size": "{{pageSize}}",
          "to_date": "{{toDate}}",
          "attendee_emails": "{{attendee_emails}}",
          "crm_account_ids": "{{crm_account_ids}}",
          "crm_opportunity_ids": "{{crm_opportunity_ids}}",
          "crm_contact_ids": "{{crm_contact_ids}}",
          "crm_lead_ids": "{{crm_lead_ids}}",
          "include_crm_associations": "{{include_crm_associations}}",
          "is_call": "{{is_call}}",
          "is_internal": "{{is_internal}}",
          "recording_duration__gte": "{{recording_duration__gte}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List meetings",
      "validationMode": "strict-generated"
    },
