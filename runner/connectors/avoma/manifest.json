    "meetings.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List meetings",
      "description": "List Avoma meetings in a UTC date range with optional pagination and order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromDate": {
            "type": "string",
            "minLength": 1
          },
          "toDate": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "order": {
            "type": "string",
            "enum": [
              "start_at",
              "-start_at"
            ]
          }
        },
        "required": [
          "fromDate",
          "toDate"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/meetings/",
        "query": {
          "from_date": "{{fromDate}}",
          "to_date": "{{toDate}}",
          "page": "{{page}}",
          "page_size": "{{pageSize}}",
          "o": "{{order}}"
        },
        "success": [
          200
