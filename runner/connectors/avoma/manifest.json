        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "title": "Healthcheck",
      "validationMode": "strict-generated"
    },
    "meetings.get": {
      "description": "Retrieve one Avoma meeting by UUID.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "includeCrmAssociations": {
            "type": "boolean"
          },
          "meetingUuid": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "meetingUuid"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
