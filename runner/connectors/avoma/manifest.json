    "calls.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create call",
      "description": "Submit an externally hosted call recording to Avoma for asynchronous processing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "external_id": {
            "type": "string",
            "description": "Unique id of the call from the dialer system.",
            "minLength": 1
          },
          "user_email": {
            "type": "string",
            "description": "Avoma user email whose license processes the call.",
            "minLength": 1
          },
          "frm": {
            "type": "string",
            "description": "Phone number the call was made from.",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "description": "Phone number the call was made to.",
            "minLength": 1
          },
          "start_at": {
            "type": "string",
            "description": "Call start time in UTC RFC3339.",
            "minLength": 1
          },
          "recording_url": {
            "type": "string",
            "description": "Public URL Avoma can download the recording from.",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "description": "Call direction, for example Inbound or Outbound.",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Lowercase dialer source such as zoomphone, twilio, or ringcentral.",
            "minLength": 1
          },
          "participants": {
            "type": "array",
            "description": "Call participants. First entry should be the prospect or lead.",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "Participant email. The first entry should be the prospect or lead."
                },
                "name": {
                  "type": "string",
                  "description": "Participant display name."
                },
                "crm_association": {
                  "type": "array",
                  "description": "CRM objects associated with this participant.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "crm_obj_id": {
                        "type": "string",
                        "description": "CRM object identifier."
                      },
                      "crm_obj_type": {
                        "type": "string",
                        "description": "CRM object type such as contact, account, or oppo."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "email"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "end_at": {
            "type": "string",
            "description": "Call end time in UTC RFC3339."
          },
          "frm_name": {
            "type": "string",
            "description": "Caller display name."
          },
          "to_name": {
            "type": "string",
            "description": "Callee display name."
          },
          "answered": {
            "type": "boolean",
            "description": "Whether the call was answered."
          },
          "is_voicemail": {
            "type": "boolean",
            "description": "Whether the call is a voicemail."
          },
          "additional_details": {
            "type": "string",
            "description": "Additional call details as a JSON string."
          },
          "crm_association": {
            "type": "array",
            "description": "CRM objects associated with the call.",
            "items": {
              "type": "object",
              "properties": {
                "crm_obj_id": {
                  "type": "string",
                  "description": "CRM object identifier."
                },
                "crm_obj_type": {
                  "type": "string",
                  "description": "CRM object type such as contact, account, or oppo."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "external_id",
          "user_email",
          "frm",
          "to",
          "start_at",
          "recording_url",
          "direction",
          "source",
          "participants"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/v1/calls/",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "external_id": "{{external_id}}",
          "user_email": "{{user_email}}",
          "frm": "{{frm}}",
          "to": "{{to}}",
          "start_at": "{{start_at}}",
          "recording_url": "{{recording_url}}",
          "direction": "{{direction}}",
          "source": "{{source}}",
          "participants": "{{participants}}",
          "end_at": "{{end_at}}",
          "frm_name": "{{frm_name}}",
          "to_name": "{{to_name}}",
          "answered": "{{answered}}",
          "is_voicemail": "{{is_voicemail}}",
          "additional_details": "{{additional_details}}",
          "crm_association": "{{crm_association}}"
        },
        "success": [
          200,
          201
        ]
      }
    },
