        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/signals/{{signalId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
