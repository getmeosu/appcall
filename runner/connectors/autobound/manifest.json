        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "signal-types.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List signal types",
      "description": "List Autobound signal types, optionally including live counts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includeCounts": {
            "type": "boolean"
          },
          "association": {
            "type": "string",
            "enum": [
              "company",
              "contact"
            ]
          },
          "since": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/signals/types",
        "query": {
          "include_counts": "{{includeCounts}}",
          "association": "{{association}}",
          "since": "{{since}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "signals.get": {
      "kind": "action",
      "sideEffect": "read",
