{
  "key": "donately",
  "name": "Donately",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "payments"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiToken",
          "label": "Donately API token",
          "required": true,
          "secret": true
        },
        {
          "key": "accountId",
          "label": "Donately account ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.donately.com"
    ]
  },
  "models": [
    "account",
    "campaign",
    "donation",
    "form",
    "fundraiser",
    "person",
    "subscription",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.donately.com/v2",
    "auth": {
      "field": "apiToken",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiToken}}",
        "password": ""
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json",
      "Donately-Version": "2022-12-15"
    }
  },
  "operations": {
    "accounts.current": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Current Account",
      "description": "Return the Donately account associated with the API token via GET /accounts/mine. The token identifies the account, so this call does not send Donately-Account.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/accounts/mine",
        "success": [
          200
        ],
        "result": {
          "account": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "campaigns.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List Campaigns",
      "description": "List campaigns for the connected account via GET /campaigns. Filters are publication status, campaign type, keyword, and whether the campaign has fundraisers.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "description": "Publication state."
          },
          "campaignType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Campaign type. The API reference examples are peer_to_peer and donation."
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Search by title or content."
          },
          "hasFundraisers": {
            "type": "boolean",
            "description": "When true, only campaigns that have fundraisers."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page. Donately's maximum is 100."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of results to skip."
          },
          "sort": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "Sort direction."
          },
          "orderBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Sort field, for example created_at."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object"
          },
          "params": {
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/campaigns",
        "headers": {
          "Donately-Account": "{{accountId}}"
        },
        "query": {
          "status": "{{status}}",
          "type": "{{campaignType}}",
          "keyword": "{{keyword}}",
          "has_fundraisers": "{{hasFundraisers}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "sort": "{{sort}}",
          "order_by": "{{orderBy}}"
        },
        "success": [
          200
        ],
        "result": {
          "object": "{{response.object}}",
          "data": "{{response.data}}",
          "summary": "{{response.summary}}",
          "params": "{{response.params}}",
          "request_id": "{{response.request_id}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "donations.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 32768,
      "maxResponseBytes": 5242880,
      "title": "List Donations",
      "description": "List donations for the connected account via GET /donations. Filters cover status, donor, campaign, fundraiser, payment type, recurring and anonymous flags, currency, keyword, amount, and created or updated timestamp bounds.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "pending",
              "refunded",
              "rejected"
            ],
            "description": "Donation status."
          },
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Donor person ID."
          },
          "campaignId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Campaign ID."
          },
          "fundraiserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Fundraiser ID."
          },
          "donationType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Payment type. The list filter documents cc and cash_or_check."
          },
          "recurring": {
            "type": "boolean",
            "description": "Filter by recurring donations."
          },
          "anonymous": {
            "type": "boolean",
            "description": "Filter by anonymous donations."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "ISO currency code, for example usd or cad."
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Text search."
          },
          "amountInCents": {
            "type": "integer",
            "minimum": 0,
            "description": "Filter by amount in cents."
          },
          "created": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "description": "Created timestamp range. Donately documents gt and lt bounds.",
            "properties": {
              "gt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Lower created timestamp."
              },
              "lt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Upper created timestamp."
              }
            }
          },
          "updated": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "description": "Updated timestamp range. Donately documents gt and lt bounds.",
            "properties": {
              "gt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Lower updated timestamp."
              },
              "lt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Upper updated timestamp."
              }
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page. Donately's maximum is 100."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of results to skip."
          },
          "sort": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "Sort direction."
          },
          "orderBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Sort field, for example created_at or amount_in_cents."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "object"
          },
          "params": {
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/donations",
        "headers": {
          "Donately-Account": "{{accountId}}"
        },
        "query": {
          "status": "{{status}}",
          "person_id": "{{personId}}",
          "campaign_id": "{{campaignId}}",
          "fundraiser_id": "{{fundraiserId}}",
          "donation_type": "{{donationType}}",
          "recurring": "{{recurring}}",
          "anonymous": "{{anonymous}}",
          "currency": "{{currency}}",
          "keyword": "{{keyword}}",
          "amount_in_cents": "{{amountInCents}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "sort": "{{sort}}",
          "order_by": "{{orderBy}}"
        },
        "parameters": [
          {
            "wireName": "created",
            "inputName": "created",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "allowReserved": false
          },
          {
            "wireName": "updated",
            "inputName": "updated",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "allowReserved": false
          }
        ],
        "success": [
          200
        ],
        "result": {
          "object": "{{response.object}}",
          "data": "{{response.data}}",
          "summary": "{{response.summary}}",
          "params": "{{response.params}}",
          "request_id": "{{response.request_id}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
