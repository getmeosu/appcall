      "title": "List news",
      "description": "List Benzinga news items with optional ticker, date, and page filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Ticker filter, sent as tickers."
          },
          "dateFrom": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive start date YYYY-MM-DD."
          },
          "dateTo": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive end date YYYY-MM-DD."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "description": "Page offset, 0-100000."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "pageSize, max 100."
          },
          "displayOutput": {
            "type": "string",
            "enum": [
              "full",
              "abstract",
              "headline"
            ],
            "description": "How much article text to return."
          }
        },
        "additionalProperties": false
