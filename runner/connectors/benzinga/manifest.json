        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/v2/news",
        "success": [
          200
        ],
        "query": {
          "tickers": "{{symbol}}",
          "dateFrom": "{{dateFrom}}",
          "dateTo": "{{dateTo}}",
          "page": "{{page}}",
          "pageSize": "{{limit}}",
          "displayOutput": "{{displayOutput}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
