    "baseUrl": "https://api.benzinga.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "token",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors",
        "message",
