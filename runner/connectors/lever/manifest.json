    "notes.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create note",
      "description": "Create a note on an opportunity via authenticated POST /v1/opportunities/{opportunityId}/notes. Optional noteId (query note_id) adds a threaded comment to an existing note. Lever returns only data.noteId (no id), so no EffectPolicy is declared.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunityId",
          "value"
        ],
        "properties": {
          "opportunityId": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "Note body; @username mentions notify users."
          },
          "secret": {
            "type": "boolean",
            "description": "Restrict visibility to SIP users and mentioned users."
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Score 1 (strong no) to 4 (strong yes)."
          },
          "notifyFollowers": {
            "type": "boolean",
            "description": "Notify all users following the candidate."
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "description": "Historical create time (ms epoch); cannot be in the future."
          },
          "noteId": {
            "type": "string",
            "minLength": 1,
            "description": "Existing note UID to add a threaded comment to (query note_id)."
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user UID to perform_as (query)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/opportunities/{{opportunityId}}/notes",
        "query": {
          "perform_as": "{{performAs}}",
          "note_id": "{{noteId}}"
        },
        "body": {
          "value": "{{value}}",
          "secret": "{{secret}}",
          "score": "{{score}}",
          "notifyFollowers": "{{notifyFollowers}}",
          "createdAt": "{{createdAt}}"
        },
        "success": [
          200,
          201
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
