    "notes.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update note",
      "description": "Replace an API-created note via authenticated PUT /v1/opportunities/{opportunityId}/notes/{noteId}. Atomic: values replaces every comment in the note thread. No EffectPolicy (no observe GET for notes on tip).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunityId",
          "noteId",
          "values"
        ],
        "properties": {
          "opportunityId": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "noteId": {
            "type": "string",
            "minLength": 1,
            "description": "Lever note UID."
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "description": "Comments that replace the note thread (note field type only).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Comment body."
                },
                "user": {
                  "type": "string",
                  "minLength": 1,
                  "description": "User UID who wrote the comment."
                },
                "secret": {
                  "type": "boolean",
                  "description": "Whether the note is secret."
                },
                "score": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "description": "Score 1-4 (applies to the whole thread)."
                },
                "createdAt": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Comment create time (ms epoch)."
                },
                "completedAt": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Comment completion time (ms epoch)."
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "PUT",
        "path": "/opportunities/{{opportunityId}}/notes/{{noteId}}",
        "body": {
          "values": "{{values}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
