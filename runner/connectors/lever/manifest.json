{
  "key": "lever",
  "name": "Lever",
  "version": "0.6.0",
  "runtime": "bun",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Lever API key",
          "required": true,
          "secret": true
        },
        {
          "key": "region",
          "label": "Region (co or eu)",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.lever.co",
      "api.eu.lever.co"
    ]
  },
  "http": {
    "baseUrl": "https://api.lever.co/v1",
    "auth": {
      "in": "header",
      "name": "Authorization",
      "field": "apiKey",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "jobs.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List jobs",
      "description": "List public job postings via GET /v0/postings/{site}."
    },
    "opportunities.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List opportunities",
      "description": "List candidate opportunities via authenticated GET /v1/opportunities. Optional limit, offset, email, tag, stageId, postingId, and archived filters."
    },
    "opportunities.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get opportunity",
      "description": "Fetch a single opportunity via authenticated GET /v1/opportunities/{id}."
    },
    "opportunities.interviews.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List opportunity interviews",
      "description": "List interviews for an opportunity via authenticated GET /v1/opportunities/{id}/interviews. Optional limit and offset."
    },
    "opportunities.feedback.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List opportunity feedback",
      "description": "List feedback forms for an opportunity via authenticated GET /v1/opportunities/{id}/feedback. Optional limit and offset."
    },
    "stages.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List stages",
      "description": "List pipeline stages via authenticated GET /v1/stages. Optional limit and offset."
    },
    "users.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List users",
      "description": "List account users via authenticated GET /v1/users. Optional limit, offset, email, and accessRole filters."
    },
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate Lever credentials with GET /opportunities?limit=1.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/opportunities",
        "query": {
          "limit": 1
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "opportunities.update_stage": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "opportunities.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update opportunity stage",
      "description": "Move an opportunity to another pipeline stage via authenticated PUT /v1/opportunities/{id}/stage. Connector input stageId maps to Lever body field stage (Stage UID per official docs). EffectPolicy Reconcile observes via opportunities.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stageId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "stageId": {
            "type": "string",
            "minLength": 1,
            "description": "Destination stage UID; sent as Lever request body field stage."
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user UID to perform_as (query)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "PUT",
        "path": "/opportunities/{{id}}/stage",
        "query": {
          "perform_as": "{{performAs}}"
        },
        "body": {
          "stage": "{{stageId}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "opportunities.archive": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "opportunities.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Archive opportunity",
      "description": "Archive (or unarchive) an opportunity via authenticated PUT /v1/opportunities/{id}/archived. Body field reason is the archive reason UID; null unarchives. EffectPolicy Reconcile observes via opportunities.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Archive reason UID; null unarchives an already-archived opportunity."
          },
          "cleanInterviews": {
            "type": "boolean",
            "description": "Remove pending interviews when archiving (Lever default false)."
          },
          "requisitionId": {
            "type": "string",
            "minLength": 1,
            "description": "Optional requisition UID when archiving as Hired."
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user UID to perform_as (query)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "PUT",
        "path": "/opportunities/{{id}}/archived",
        "query": {
          "perform_as": "{{performAs}}"
        },
        "body": {
          "reason": "{{reason}}",
          "cleanInterviews": "{{cleanInterviews}}",
          "requisitionId": "{{requisitionId}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "archive_reasons.list": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List archive reasons",
      "description": "List account archive reasons via authenticated GET /v1/archive_reasons. Optional type filter (hired | non-hired), limit, and offset.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "hired",
              "non-hired"
            ],
            "description": "Optional filter for archive reason type."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Page size (1-100)."
          },
          "offset": {
            "type": "string",
            "description": "Opaque pagination offset token from a prior next field."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/archive_reasons",
        "query": {
          "type": "{{type}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "sideEffect": "read"
    },
    "opportunities.update": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "opportunities.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update opportunity",
      "description": "Update an opportunity contact via authenticated PUT /v1/contacts/{contactId} (contact resolved from GET /v1/opportunities/{id}); tags go through POST /v1/opportunities/{id}/addTags. There is no generic PUT /opportunities/{id}. EffectPolicy Reconcile observes via opportunities.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "name": {
            "type": "string",
            "description": "Candidate full name."
          },
          "headline": {
            "type": "string",
            "description": "Opportunity headline."
          },
          "location": {
            "type": "string",
            "description": "Location string."
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Email addresses to set on the contact."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags to add on the opportunity via addTags (additive; not a full replace)."
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user UID to perform_as (query)."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity"
        ],
        "properties": {
          "opportunity": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized opportunity after EffectPolicy Reconcile via opportunities.get."
          }
        }
      }
    },
    "candidates.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get candidate",
      "description": "Fetch a Lever opportunity as a candidate via authenticated GET /v1/opportunities/{id}. Distinct from opportunities.get: returns a candidate-shaped record."
    },
    "interviews.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List interviews",
      "description": "List interviews for an opportunity via authenticated GET /v1/opportunities/{id}/interviews. Requires opportunityId. Optional limit and offset."
    },
    "interviews.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get interview",
      "description": "Fetch a single interview via authenticated GET /v1/opportunities/{id}/interviews/{interviewId}."
    },
    "offers.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List offers",
      "description": "List offers for an opportunity via authenticated GET /v1/opportunities/{id}/offers. Requires opportunityId."
    },
    "offers.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get offer",
      "description": "Fetch a single offer by listing GET /v1/opportunities/{id}/offers and filtering on offerId client-side. Lever has no single-offer GET in the Offers reference."
    },
    "postings.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List postings",
      "description": "List authenticated job postings via GET /v1/postings. Distinct from public jobs.list. Optional state, limit, and offset filters."
    },
    "postings.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get posting",
      "description": "Fetch a single authenticated posting via GET /v1/postings/{id}. Distinct from public jobs.list."
    },
    "notes.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List notes",
      "description": "List notes for an opportunity via authenticated GET /v1/opportunities/{id}/notes. Requires opportunityId."
    },
    "users.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get user",
      "description": "Fetch a single user via authenticated GET /v1/users/{id}."
    },
    "requisitions.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List requisitions",
      "description": "List requisitions via authenticated GET /v1/requisitions. Optional limit and offset."
    },
    "feedback.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get feedback",
      "description": "Fetch a single feedback form via authenticated GET /v1/opportunities/{id}/feedback/{feedbackId}."
    },
    "opportunities.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create opportunity",
      "description": "Create a candidate opportunity via authenticated POST /v1/opportunities?perform_as={performAs} (JSON only; resume multipart is out of scope). Lever dedupes by email or contactId onto an existing contact. Result surfaces the created opportunity UID (data.id) as top-level id. No EffectPolicy: a retried POST would create a duplicate opportunity.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "performAs"
        ],
        "properties": {
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "User UID to perform_as (query; required by Lever). Defaults the creator and owner."
          },
          "name": {
            "type": "string",
            "description": "Contact full name."
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Contact email addresses (used for dedupe)."
          },
          "headline": {
            "type": "string",
            "description": "Contact headline (prior companies or schools)."
          },
          "location": {
            "type": "string",
            "description": "Contact current location."
          },
          "phones": {
            "type": "array",
            "description": "Contact phone numbers.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Phone number."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "mobile",
                    "home",
                    "work",
                    "skype",
                    "other"
                  ],
                  "description": "Optional number type."
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Contact links (personal site, LinkedIn, ...)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Tags to apply; unknown tags are created."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Sources to apply; unknown sources are created."
          },
          "origin": {
            "type": "string",
            "enum": [
              "agency",
              "applied",
              "internal",
              "referred",
              "sourced",
              "university"
            ],
            "description": "How the opportunity was added."
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "Owner user UID; defaults to the perform_as user."
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "description": "Stage UID; Lever defaults to New Lead when omitted."
          },
          "postings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Posting UIDs. Lever rejects more than one posting per request."
          },
          "contactId": {
            "type": "string",
            "minLength": 1,
            "description": "Existing contact UID to attach this opportunity to; sent as Lever body field contact."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Created Lever opportunity UID (from data.id)."
          },
          "data": {
            "type": "object",
            "description": "Created opportunity object."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/opportunities",
        "query": {
          "perform_as": "{{performAs}}"
        },
        "body": {
          "name": "{{name}}",
          "headline": "{{headline}}",
          "stage": "{{stage}}",
          "location": "{{location}}",
          "phones": "{{phones}}",
          "emails": "{{emails}}",
          "links": "{{links}}",
          "tags": "{{tags}}",
          "sources": "{{sources}}",
          "origin": "{{origin}}",
          "owner": "{{owner}}",
          "postings": "{{postings}}",
          "contact": "{{contactId}}"
        },
        "success": [
          200,
          201
        ],
        "result": {
          "id": "{{response.data.id}}",
          "data": "{{response.data}}"
        }
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "opportunities.add_tags": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "opportunities.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Add opportunity tags",
      "description": "Add tags to an opportunity via authenticated POST /v1/opportunities/{id}/addTags. EffectPolicy Reconcile observes via opportunities.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Tags to add.",
            "minItems": 1
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user UID to perform_as (query)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/opportunities/{{id}}/addTags",
        "query": {
          "perform_as": "{{performAs}}"
        },
        "body": {
          "tags": "{{tags}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "opportunities.remove_tags": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "opportunities.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Remove opportunity tags",
      "description": "Remove tags from an opportunity via authenticated POST /v1/opportunities/{id}/removeTags. EffectPolicy Reconcile observes via opportunities.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Tags to remove.",
            "minItems": 1
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user UID to perform_as (query)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/opportunities/{{id}}/removeTags",
        "query": {
          "perform_as": "{{performAs}}"
        },
        "body": {
          "tags": "{{tags}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "opportunities.add_links": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "opportunities.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Add contact links by opportunity",
      "description": "Add links to the opportunity contact via authenticated POST /v1/opportunities/{id}/addLinks. Links live on the contact; the opportunity object has no links field, so the observe confirms the opportunity still resolves (durability only). EffectPolicy Reconcile observes via opportunities.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Lever opportunity UID."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Links to add.",
            "minItems": 1
          },
          "performAs": {
            "type": "string",
            "minLength": 1,
