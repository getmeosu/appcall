    "webhook.page_changed": {
      "kind": "webhook",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Page changed",
      "description": "Fluxguard change-detection callback when a monitored page changes (`page.changed`).",
      "sideEffect": "read"
    },
    "webhook.alarm": {
