        "path": "/add-page",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "url": "{{url}}",
          "siteId": "{{siteId}}",
          "sessionId": "{{sessionId}}",
          "categories": "{{categories}}",
          "categoryId": "{{categoryId}}",
          "categoryName": "{{categoryName}}",
          "siteNickname": "{{siteNickname}}"
        }
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "title": "Add page",
      "validationMode": "strict-generated"
