    "pages.create": {
      "description": "Add a URL for Fluxguard monitoring. Omit siteId and sessionId to create a new site and session; provide both to add a page to an existing site.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Absolute URL Fluxguard should monitor.",
            "minLength": 1,
            "type": "string"
          },
          "siteId": {
            "description": "Existing Fluxguard site ID. Must be sent together with sessionId.",
            "minLength": 1,
            "type": "string"
          },
          "sessionId": {
            "description": "Existing Fluxguard session ID. Must be sent together with siteId.",
            "minLength": 1,
            "type": "string"
          },
          "categories": {
            "description": "Category IDs to assign when creating a new site.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "categoryId": {
            "description": "Single category ID to assign when creating a new site. Do not send with categories.",
            "minLength": 1,
            "type": "string"
          },
          "categoryName": {
            "description": "Existing category name to assign when creating a new site.",
            "minLength": 1,
            "type": "string"
          },
          "siteNickname": {
            "description": "Nickname for a newly created site.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
