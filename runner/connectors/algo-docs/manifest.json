{
  "key": "algo-docs",
  "name": "AlgoDocs",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "AlgoDocs secret API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.algodocs.com"
    ]
  },
  "models": [
    "account",
    "extractor",
    "folder",
    "extracted-record",
    "document"
  ],
  "http": {
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "baseUrl": "https://api.algodocs.com",
    "errors": {
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "Message"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the AlgoDocs API key with GET /v1/me.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/me",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "extractors.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List extractors",
      "description": "List document extractors in the connected AlgoDocs account.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/extractors",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "folders.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List folders",
      "description": "List folders in the connected AlgoDocs file manager.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/folders",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "extracted-data.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get extracted data by document",
      "description": "Get extracted data records for one AlgoDocs document ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "documentId"
        ],
        "properties": {
          "documentId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/extracted_data/{{documentId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "extracted-data.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List extracted data",
      "description": "List extracted data records for an extractor, optionally filtered by folder, limit, and upload date.",
      "inputSchema": {
        "type": "object",
        "required": [
          "extractorId"
        ],
        "properties": {
          "extractorId": {
            "type": "string",
            "minLength": 1
          },
          "folderId": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "date": {
            "type": "string",
            "minLength": 19
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/extracted_data/{{extractorId}}",
        "query": {
          "folderId": "{{folderId}}",
          "limit": "{{limit}}",
          "date": "{{date}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.upload_url": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Upload document from URL",
      "description": "Tell AlgoDocs to fetch and process a document from a publicly accessible URL.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extractorId": {
            "type": "string",
            "minLength": 1,
            "description": "Extractor ID from GET /v1/extractors."
          },
          "folderId": {
            "type": "string",
            "minLength": 1,
            "description": "Folder ID from GET /v1/folders."
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Public URL of the document to fetch."
          }
        },
        "required": [
          "extractorId",
          "folderId",
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/document/upload_url/{{extractorId}}/{{folderId}}",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "url": "{{url}}"
        },
        "bodyEncoding": "form"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.upload_base64": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Upload document from base64",
      "description": "Upload a base64-encoded document to AlgoDocs for extraction.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extractorId": {
            "type": "string",
            "minLength": 1,
            "description": "Extractor ID from GET /v1/extractors."
          },
          "folderId": {
            "type": "string",
            "minLength": 1,
            "description": "Folder ID from GET /v1/folders."
          },
          "fileBase64": {
            "type": "string",
            "minLength": 1,
            "description": "Base64-encoded file content."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "description": "Name to store the document under."
          }
        },
        "required": [
          "extractorId",
          "folderId",
          "fileBase64",
          "filename"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/document/upload_base64/{{extractorId}}/{{folderId}}",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "file_base64": "{{fileBase64}}",
          "filename": "{{filename}}"
        },
        "bodyEncoding": "form"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "media.json": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get extracted JSON media",
      "description": "Download the JSON export for an extracted AlgoDocs document page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "Media token from an extracted-data record."
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page number."
          }
        },
        "required": [
          "token",
          "pageNumber"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/media/{{token}}/{{pageNumber}}/json",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "webhook.extracted_data": {
      "kind": "webhook",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Extracted data",
      "description": "AlgoDocs webhook fired when document extraction completes and extracted data is sent to the configured URL."
    }
  },
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  }
}
