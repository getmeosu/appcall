{
  "key": "clockify",
  "name": "Clockify",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Clockify API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.clockify.me"
    ]
  },
  "models": [
    "user",
    "workspace",
    "project",
    "task",
    "time_entry",
    "client",
    "tag"
  ],
  "http": {
    "baseUrl": "https://api.clockify.me/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Api-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
