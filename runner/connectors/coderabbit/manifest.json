{
  "key": "coderabbit",
  "name": "CodeRabbit",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "CodeRabbit API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.coderabbit.ai"
    ]
  },
  "models": [
    "user",
    "role",
    "audit-log",
    "organization",
    "repository",
    "learning",
    "metric",
    "finding"
  ],
  "http": {
    "baseUrl": "https://api.coderabbit.ai",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-coderabbitai-api-key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "errors.0.message",
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the CodeRabbit API key with GET /v1/users.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/users",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "users.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List users",
      "description": "List CodeRabbit organization users with optional seat, role, and cursor filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seat_filter": {
            "type": "string",
            "enum": [
              "all",
              "assigned",
              "unassigned"
            ]
          },
          "role_filter": {
            "type": "string",
            "enum": [
              "all",
              "member",
              "admin"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/users",
        "query": {
          "seat_filter": "{{seat_filter}}",
          "role_filter": "{{role_filter}}",
          "limit": "{{limit}}",
          "cursor": "{{cursor}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "roles.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List roles",
      "description": "List CodeRabbit built-in and Enterprise custom roles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "org_id": {
            "type": "string",
            "minLength": 1
          },
          "role_type": {
            "type": "string",
            "enum": [
              "all",
              "system",
              "custom"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/roles",
        "query": {
          "org_id": "{{org_id}}",
          "role_type": "{{role_type}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "roles.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get role",
      "description": "Retrieve one CodeRabbit built-in or Enterprise custom role.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "minLength": 1
          },
          "org_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "roleId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
