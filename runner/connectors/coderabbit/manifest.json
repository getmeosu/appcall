          },
          "user_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Provider user ids."
          },
          "org_id": {
            "type": "string",
            "minLength": 1,
            "description": "Organization id."
          }
