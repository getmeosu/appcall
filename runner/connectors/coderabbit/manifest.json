    "users.manageSeats": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Manage seats",
      "description": "Bulk assign or unassign CodeRabbit seats for provider user ids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "assign",
              "unassign"
            ],
            "description": "Seat action."
          },
          "user_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Provider user ids."
          }
        },
        "additionalProperties": false,
        "required": [
          "action",
          "user_ids"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/users/seats",
        "success": [
          200,
          201
        ],
        "body": {
          "action": "{{action}}",
          "user_ids": "{{user_ids}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
