            "minimum": 1,
            "description": "Schedule id. Omit to use the default schedule."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "Sequence steps. At least one step is required.",
            "items": {
              "type": "object"
            }
          }
