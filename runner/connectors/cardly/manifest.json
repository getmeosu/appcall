{
  "key": "cardly",
  "name": "Cardly",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ads"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Cardly API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.card.ly"
    ]
  },
  "models": [
    "account",
    "media",
    "font",
    "writing-style",
    "artwork",
    "contact-list",
    "contact",
    "order",
    "template",
    "doodle"
  ],
  "http": {
    "baseUrl": "https://api.card.ly/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "state.messages.0",
        "state.message",
        "message",
        "error"
      ]
    }
  },
