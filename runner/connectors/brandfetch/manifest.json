{
  "key": "brandfetch",
  "name": "Brandfetch",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Brandfetch API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.brandfetch.io",
      "graphql.brandfetch.io"
    ]
  },
  "models": [
    "brand",
    "viewer",
    "transaction",
    "context",
    "search",
    "agent"
  ],
  "http": {
    "baseUrl": "https://api.brandfetch.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "details"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
