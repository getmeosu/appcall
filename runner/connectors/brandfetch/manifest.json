        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/brands/{{identifier}}",
        "success": [
          200
        ],
        "query": {
          "allowNsfw": "{{allowNsfw}}",
          "cachedOnly": "{{cachedOnly}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
