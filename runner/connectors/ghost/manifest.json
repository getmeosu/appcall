    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Accept-Version": "v6.0"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
