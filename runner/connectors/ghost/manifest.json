        {
          "key": "siteSlug",
          "label": "Ghost(Pro) admin subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.ghost.io"
    ]
  },
  "models": [
    "settings",
    "post",
    "page",
    "tag",
    "author",
    "tier"
  ],
  "http": {
