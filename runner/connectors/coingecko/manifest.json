    "simple.price": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get coin prices",
      "description": "Get current prices for one or more coin IDs in one or more quote currencies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated CoinGecko coin IDs."
          },
          "vs_currencies": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated quote currencies."
          },
          "include_market_cap": {
            "type": "boolean",
            "description": "Include market capitalization."
          },
          "include_24hr_vol": {
            "type": "boolean",
            "description": "Include 24-hour volume."
          },
          "include_24hr_change": {
            "type": "boolean",
            "description": "Include 24-hour price change."
          },
          "include_last_updated_at": {
            "type": "boolean",
            "description": "Include last-updated Unix timestamp."
          }
        },
        "additionalProperties": false,
        "required": [
          "ids",
          "vs_currencies"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/simple/price",
        "success": [
          200
        ],
        "query": {
          "ids": "{{ids}}",
          "vs_currencies": "{{vs_currencies}}",
          "include_market_cap": "{{include_market_cap}}",
          "include_24hr_vol": "{{include_24hr_vol}}",
          "include_24hr_change": "{{include_24hr_change}}",
          "include_last_updated_at": "{{include_last_updated_at}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
