            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/coins/markets",
        "success": [
          200
        ],
        "query": {
          "vs_currency": "{{vs_currency}}",
          "ids": "{{ids}}",
          "category": "{{category}}",
          "order": "{{order}}",
          "per_page": "{{per_page}}",
          "page": "{{page}}",
          "sparkline": "{{sparkline}}",
          "price_change_percentage": "{{price_change_percentage}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
