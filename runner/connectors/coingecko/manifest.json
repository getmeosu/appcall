        "type": "object",
        "properties": {
          "vs_currency": {
            "type": "string",
            "minLength": 1,
            "description": "Quote currency, for example usd."
          },
          "ids": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated coin IDs to filter."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Category id from /coins/categories/list."
          },
          "order": {
            "type": "string",
            "minLength": 1,
            "description": "Sort order such as market_cap_desc."
          },
          "per_page": {
            "type": "integer",
            "description": "Results per page.",
            "minimum": 1,
            "maximum": 250
          },
          "page": {
            "type": "integer",
            "description": "1-based page number.",
            "minimum": 1
          },
          "sparkline": {
            "type": "boolean",
            "description": "Include 7-day sparkline data."
          },
          "price_change_percentage": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated windows such as 1h,24h,7d."
          }
        },
        "additionalProperties": false,
        "required": [
          "vs_currency"
        ]
