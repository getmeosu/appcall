{
  "key": "coingecko",
  "name": "CoinGecko",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "CoinGecko Pro API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "pro-api.coingecko.com"
    ]
  },
  "models": [
    "currency",
    "coin",
    "market",
    "trending",
    "exchange",
    "nft",
    "category",
    "search"
  ],
  "http": {
    "baseUrl": "https://pro-api.coingecko.com/api/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-cg-pro-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "status.error_message",
        "error",
        "message"
      ],
      "bodyErrorPaths": [
        "status.error_message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the CoinGecko Pro API key with GET /simple/supported_vs_currencies.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/simple/supported_vs_currencies",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "currencies.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
