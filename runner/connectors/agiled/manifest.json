{
  "auth": {
    "scopes": [],
    "setup": {
      "fields": [
        {
          "key": "apiKey",
          "label": "Agiled API token",
          "required": true,
          "secret": true
        },
        {
          "key": "brand",
          "label": "Agiled account URL",
          "required": true,
          "secret": false
        }
      ],
      "mode": "api_key"
    },
    "type": "api_key"
  },
  "categories": [
    "crm",
    "productivity"
  ],
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "http": {
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_token",
      "value": "{{apiKey}}"
    },
    "baseUrl": "https://my.agiled.app/api/v1",
    "errors": {
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json",
      "Brand": "{{brand}}"
    }
  },
  "key": "agiled",
  "models": [
    "user",
    "contact",
    "project",
    "task",
    "expense",
    "ticket",
    "deal",
    "employee",
    "estimate",
    "invoice",
    "product",
    "currency",
    "timesheet",
    "projectCategory"
  ],
  "name": "Agiled",
  "network": {
    "allowedHosts": [
      "my.agiled.app"
    ]
  },
