    "expenses.create": {
      "description": "Create an expense via POST /expenses. Maps to AGILED_CREATE_EXPENSE.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "currency_id": {
            "description": "Currency ID used for the expense.",
            "minimum": 1,
            "type": "integer"
          },
          "distance_category": {
            "description": "Category or purpose of the distance expense.",
            "type": "string"
          },
          "distance_cost": {
            "description": "Calculated distance cost (distance_value x distance_unit_rate).",
            "minimum": 0,
            "type": "integer"
          },
          "distance_description": {
            "description": "Additional notes about the distance traveled.",
            "type": "string"
          },
          "distance_unit": {
            "description": "Unit for distance (e.g. kilometer or mile).",
            "type": "string"
          },
          "distance_unit_rate": {
            "description": "Rate per distance unit (must be non-negative).",
            "minimum": 0,
            "type": "integer"
          },
          "distance_value": {
            "description": "Distance traveled, numeric value (must be non-negative).",
            "minimum": 0,
            "type": "integer"
          },
          "how_often": {
            "description": "Recurring frequency (e.g. daily, weekly, monthly).",
            "type": "string"
          },
          "include_distance": {
            "description": "Include distance cost (yes/no).",
            "enum": [
              "yes",
              "no"
            ],
            "type": "string"
          },
          "is_infinite": {
            "description": "Whether the recurrence is infinite (yes/no).",
            "enum": [
              "yes",
              "no"
            ],
            "type": "string"
          },
          "item_name": {
            "description": "Name of the expense item.",
            "type": "string"
          },
          "make_recurring": {
            "description": "Mark this expense as recurring (yes/no).",
            "enum": [
              "yes",
              "no"
            ],
            "type": "string"
          },
          "next_purchase_date": {
            "description": "Next scheduled date for recurring expense (YYYY-MM-DD).",
            "type": "string"
          },
          "often_terms": {
            "description": "Number of intervals between recurrences.",
            "minimum": 1,
            "type": "integer"
          },
          "price": {
            "description": "Price of the expense (must be non-negative).",
            "minimum": 0,
            "type": "number"
          },
          "project_id": {
            "description": "Associated project ID, if applicable.",
            "minimum": 1,
            "type": "integer"
          },
          "purchase_date": {
            "description": "Date when the expense was made (YYYY-MM-DD).",
            "type": "string"
          },
          "purchased_from": {
            "description": "Vendor or source of the expense.",
            "type": "string"
          },
          "remaining_cycles": {
            "description": "Remaining number of recurrence cycles.",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "Status of the expense (e.g. approved).",
            "type": "string"
          },
          "term_duration": {
            "description": "Unit for recurrence intervals (e.g. day, week, month).",
            "type": "string"
          },
          "user_id": {
            "description": "User ID of the expense owner.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "price",
          "user_id",
          "item_name",
          "currency_id",
          "purchase_date",
          "distance_value",
          "distance_category"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "currency_id": "{{currency_id}}",
          "distance_category": "{{distance_category}}",
          "distance_cost": "{{distance_cost}}",
          "distance_description": "{{distance_description}}",
          "distance_unit": "{{distance_unit}}",
          "distance_unit_rate": "{{distance_unit_rate}}",
          "distance_value": "{{distance_value}}",
          "how_often": "{{how_often}}",
          "include_distance": "{{include_distance}}",
          "is_infinite": "{{is_infinite}}",
          "item_name": "{{item_name}}",
          "make_recurring": "{{make_recurring}}",
          "next_purchase_date": "{{next_purchase_date}}",
          "often_terms": "{{often_terms}}",
          "price": "{{price}}",
          "project_id": "{{project_id}}",
          "purchase_date": "{{purchase_date}}",
          "purchased_from": "{{purchased_from}}",
          "remaining_cycles": "{{remaining_cycles}}",
          "status": "{{status}}",
          "term_duration": "{{term_duration}}",
          "user_id": "{{user_id}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/expenses",
        "success": [
          200,
          201
        ]
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "title": "Create expense",
      "validationMode": "strict-generated"
    },
