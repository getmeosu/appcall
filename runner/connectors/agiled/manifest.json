{
  "key": "agiled",
  "name": "Agiled",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm",
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Agiled API token",
          "required": true,
          "secret": true
        },
        {
          "key": "brand",
          "label": "Agiled account URL",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "my.agiled.app"
    ]
  },
  "models": [
    "user",
    "contact",
    "project",
    "task",
    "invoice",
    "deal"
  ],
  "http": {
    "baseUrl": "https://my.agiled.app/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_token",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Brand": "{{brand}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
