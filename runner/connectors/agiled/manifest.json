    "tasks.create": {
      "description": "Create a task via POST /tasks. Maps AGILED_CREATE_TASK title to official heading and assigned_to to user_id.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "assigned_to": {
            "description": "User ID to assign this task to (official user_id).",
            "minimum": 1,
            "type": "integer"
          },
          "billable": {
            "description": "Whether the task is billable (1 or 0).",
            "enum": [
              0,
              1
            ],
            "type": "integer"
          },
          "category_id": {
            "description": "Task category ID.",
            "minimum": 1,
            "type": "integer"
          },
          "completed_on": {
            "description": "Completion date in YYYY-MM-DD format.",
            "type": "string"
          },
          "description": {
            "description": "Detailed description of the task.",
            "type": "string"
          },
          "due_date": {
            "description": "Due date of the task in YYYY-MM-DD format.",
            "type": "string"
          },
          "followers": {
            "description": "List of user IDs who will follow the task.",
            "items": {
              "minimum": 1,
              "type": "integer"
            },
            "type": "array"
          },
          "list_id": {
            "description": "ID of the task list/column (e.g. backlog, in_progress).",
            "minimum": 1,
            "type": "integer"
          },
          "milestone_id": {
            "description": "Milestone ID.",
            "minimum": 1,
