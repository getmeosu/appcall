    "items.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create item",
      "description": "Create a BoxHero inventory item via POST /v1/items.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Item display name.",
            "minLength": 1
          },
          "sku": {
            "type": "string",
            "description": "Stock keeping unit."
          },
          "barcode": {
            "type": "string",
            "description": "Primary barcode."
          },
          "cost": {
            "type": "string",
            "description": "Unit cost as a decimal string."
          },
          "price": {
            "type": "string",
            "description": "Selling price as a decimal string."
          },
          "quantity": {
            "type": "number",
            "description": "Optional initial on-hand quantity."
          },
          "location_id": {
            "type": "integer",
            "description": "Location used to seed initial stock.",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "object",
              "array"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/items",
        "success": [
          201,
          200
        ],
        "query": {
          "location_id": "{{location_id}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "sku": "{{sku}}",
          "barcode": "{{barcode}}",
          "cost": "{{cost}}",
          "price": "{{price}}",
          "quantity": "{{quantity}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
