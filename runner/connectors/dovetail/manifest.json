{
  "key": "dovetail",
  "name": "Dovetail",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Dovetail personal API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "dovetail.com"
    ]
  },
  "models": [
    "token",
    "project",
    "data",
    "doc",
    "insight",
    "folder",
    "tag",
    "highlight",
    "channel",
    "contact"
  ],
  "http": {
    "baseUrl": "https://dovetail.com/api",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.message",
        "errors.0.title",
        "message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate a Dovetail personal API key by reading token metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated",
      "request": {
        "method": "GET",
        "path": "/v1/token/info",
        "success": [
          200
        ]
      }
    },
