{
  "connector": "discord",
  "scenarios": [
    {
      "name": "healthcheck against the bot token",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "status",
            "op": "eq",
            "value": "ok"
          },
          {
            "path": "botUserId",
            "op": "exists"
          }
        ]
      }
    },
    {
      "name": "read the test server",
      "operation": "guild.get",
      "input": {
        "guildId": "1100000000000000001"
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "guild.id",
            "op": "exists"
          },
          {
            "path": "guild.name",
            "op": "type",
            "value": "string"
          }
        ]
      }
    },
    {
      "name": "list channels",
      "operation": "channels.list",
      "input": {
        "guildId": "1100000000000000001"
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "channels",
            "op": "isArray"
          }
        ]
      }
    },
    {
      "name": "list roles",
      "operation": "roles.list",
      "input": {
        "guildId": "1100000000000000001"
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "roles",
            "op": "isArray"
          }
        ]
      }
    },
    {
      "name": "list members (needs the Server Members intent)",
      "operation": "members.list",
      "input": {
        "guildId": "1100000000000000001",
        "limit": 10
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "members",
            "op": "isArray"
          }
        ]
      }
    },
    {
      "name": "read recent messages (needs the Message Content intent)",
      "operation": "messages.list",
      "input": {
        "channelId": "1300000000000000001",
        "limit": 10
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "messages",
            "op": "isArray"
          }
        ]
      }
    },
    {
      "name": "verify authenticated identity",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "botUserId",
            "op": "type",
            "value": "string"
          },
          {
            "path": "botUserId",
            "op": "matches",
            "value": "^[0-9]+$"
          }
        ]
      }
    },
    {
      "name": "read accessible collection",
      "operation": "guilds.list",
      "input": {
        "limit": 2
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "guilds",
            "op": "isArray"
          }
        ]
      }
    }
  ]
}
