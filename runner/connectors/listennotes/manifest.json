{
  "key": "listennotes",
  "name": "Listen Notes",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Listen Notes API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "listen-api.listennotes.com"
    ]
  },
  "models": [
    "language",
    "genre",
    "region",
    "podcast",
    "episode",
    "playlist",
    "curated_podcast",
    "search"
  ],
  "http": {
    "baseUrl": "https://listen-api.listennotes.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-ListenAPI-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "detail",
        "error",
        "error.message",
        "error.detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "description": "Validate the Listen Notes API key by listing supported languages.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/languages",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "title": "Healthcheck",
      "validationMode": "strict-generated"
    },
    "languages.list": {
      "description": "List supported Listen Notes podcast languages.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/languages",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List languages",
      "validationMode": "strict-generated"
    },
    "genres.list": {
      "description": "List supported Listen Notes podcast genres.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "topLevelOnly": {
            "type": "integer",
            "description": "If 1, return only top-level genres. If 0, return all genres.",
            "enum": [
              0,
              1
            ]
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/genres",
        "success": [
          200
        ],
        "query": {
          "top_level_only": "{{topLevelOnly}}"
        }
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List genres",
      "validationMode": "strict-generated"
    },
    "regions.list": {
      "description": "List supported Listen Notes regions used by best podcasts.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/regions",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List regions",
      "validationMode": "strict-generated"
    },
    "podcasts.get": {
      "description": "Get Listen Notes podcast details and one page of episodes by podcast ID.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "nextEpisodePubDate": {
            "minimum": 1,
            "type": "integer"
          },
          "sort": {
            "enum": [
              "oldest_first",
              "recent_first"
            ],
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/podcasts/{{id}}",
        "query": {
          "next_episode_pub_date": "{{nextEpisodePubDate}}",
          "sort": "{{sort}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get podcast",
      "validationMode": "strict-generated"
    },
    "search": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Search podcasts and episodes",
      "description": "Full-text search Listen Notes episodes, podcasts, or curated lists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Search term, e.g. person, place, or topic.",
            "minLength": 1
          },
          "ncid": {
            "type": "string",
            "description": "Comma-delimited podcast ids to exclude (episode search).",
            "minLength": 1
          },
          "ocid": {
            "type": "string",
            "description": "Comma-delimited podcast ids to include (episode search).",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "Content type to search.",
            "enum": [
              "curated",
              "episode",
              "podcast"
            ]
          },
          "offset": {
            "type": "integer",
            "description": "Pagination offset from next_offset.",
            "minimum": 0
          },
          "region": {
            "type": "string",
            "description": "Region code from GET /regions.",
            "minLength": 1
          },
          "lenMax": {
            "type": "integer",
            "description": "Maximum audio length in minutes.",
            "minimum": 0
          },
          "lenMin": {
            "type": "integer",
            "description": "Minimum audio length in minutes.",
            "minimum": 0
          },
          "onlyIn": {
            "type": "string",
            "description": "Comma-delimited fields: title, description, author, audio.",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "description": "Language label from GET /languages.",
            "minLength": 1
          },
          "genreIds": {
            "type": "string",
            "description": "Comma-delimited genre ids from GET /genres.",
            "minLength": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "Results per page, 1-10.",
            "minimum": 1,
            "maximum": 10
          },
          "safeMode": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "sortByDate": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "sponsoredOnly": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "interviewsOnly": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "publishedAfter": {
            "type": "integer",
            "description": "Only results published after this unix ms timestamp."
          },
          "uniquePodcasts": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "updateFreqMax": {
            "type": "integer",
            "description": "Maximum podcast update frequency in hours.",
            "minimum": 0
          },
          "updateFreqMin": {
            "type": "integer",
            "description": "Minimum podcast update frequency in hours.",
            "minimum": 0
          },
          "publishedBefore": {
            "type": "integer",
            "description": "Only results published before this unix ms timestamp."
          },
          "episodeCountMax": {
            "type": "integer",
            "description": "Maximum episode count (podcast search).",
            "minimum": 0
          },
          "episodeCountMin": {
            "type": "integer",
            "description": "Minimum episode count (podcast search).",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "q"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/search",
        "success": [
          200
        ],
        "query": {
          "q": "{{q}}",
          "ncid": "{{ncid}}",
          "ocid": "{{ocid}}",
          "type": "{{type}}",
          "offset": "{{offset}}",
          "region": "{{region}}",
          "len_max": "{{lenMax}}",
          "len_min": "{{lenMin}}",
          "only_in": "{{onlyIn}}",
          "language": "{{language}}",
          "genre_ids": "{{genreIds}}",
          "page_size": "{{pageSize}}",
          "safe_mode": "{{safeMode}}",
          "sort_by_date": "{{sortByDate}}",
          "sponsored_only": "{{sponsoredOnly}}",
          "interviews_only": "{{interviewsOnly}}",
          "published_after": "{{publishedAfter}}",
          "unique_podcasts": "{{uniquePodcasts}}",
          "update_freq_max": "{{updateFreqMax}}",
          "update_freq_min": "{{updateFreqMin}}",
          "published_before": "{{publishedBefore}}",
          "episode_count_max": "{{episodeCountMax}}",
          "episode_count_min": "{{episodeCountMin}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "typeahead": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
