    "podcasts.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get podcast",
      "description": "Get Listen Notes podcast details and one page of episodes by podcast ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sort": {
            "type": "string",
            "enum": [
              "oldest_first",
              "recent_first"
            ]
          },
          "nextEpisodePubDate": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/podcasts/{{id}}",
        "query": {
          "sort": "{{sort}}",
          "next_episode_pub_date": "{{nextEpisodePubDate}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "search": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Search podcasts and episodes",
      "description": "Full-text search Listen Notes podcasts, episodes, or curated lists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "Search term, e.g. person, place, or topic."
          },
          "type": {
            "type": "string",
            "enum": [
              "episode",
              "podcast",
              "curated"
            ],
            "description": "Content type to search."
          },
          "offset": {
            "type": "integer",
            "description": "Pagination offset.",
            "minimum": 0
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "ISO country code to limit results."
          }
        },
        "additionalProperties": false,
        "required": [
          "q"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/search",
        "success": [
          200
        ],
        "query": {
          "q": "{{q}}",
          "type": "{{type}}",
          "offset": "{{offset}}",
          "region": "{{region}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "typeahead": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
