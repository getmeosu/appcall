    "podcasts.batch": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Batch get podcasts",
      "description": "Fetch basic metadata for multiple podcasts by Listen Notes ids, RSS URLs, Apple ids, or Spotify ids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "string",
            "description": "Comma-separated Listen Notes podcast ids.",
            "minLength": 1
          },
          "rsses": {
            "type": "string",
            "description": "Comma-separated podcast RSS URLs.",
            "minLength": 1
          },
          "itunesIds": {
            "type": "string",
            "description": "Comma-separated Apple Podcasts (iTunes) ids.",
            "minLength": 1
          },
          "spotifyIds": {
            "type": "string",
            "description": "Comma-separated Spotify show ids.",
            "minLength": 1
          },
          "showLatestEpisodes": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "nextEpisodePubDate": {
            "type": "integer",
            "description": "Latest-episode pagination cursor in unix milliseconds."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/podcasts",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "ids": "{{ids}}",
          "rsses": "{{rsses}}",
          "itunes_ids": "{{itunesIds}}",
          "spotify_ids": "{{spotifyIds}}",
          "show_latest_episodes": "{{showLatestEpisodes}}",
          "next_episode_pub_date": "{{nextEpisodePubDate}}"
        },
        "bodyEncoding": "form"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
