        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/typeahead",
        "success": [
          200
        ],
        "query": {
          "q": "{{q}}",
          "safe_mode": "{{safeMode}}",
          "show_genres": "{{showGenres}}",
          "show_podcasts": "{{showPodcasts}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "best_podcasts.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List best podcasts",
      "description": "Fetch ranked best podcasts by genre, region, language, and publisher region.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number of podcasts in this genre.",
            "minimum": 1
          },
          "sort": {
            "type": "string",
            "description": "How to sort these podcasts.",
            "enum": [
              "listen_score",
              "oldest_added_first",
              "oldest_published_first",
              "recent_added_first",
              "recent_published_first"
            ]
          },
          "region": {
            "type": "string",
            "description": "Country/region code from GET /regions.",
            "minLength": 1
          },
          "genreId": {
            "type": "string",
            "description": "Genre id from GET /genres.",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "description": "Language label from GET /languages.",
            "minLength": 1
          },
          "safeMode": {
            "type": "integer",
            "description": "0 is no, 1 is yes.",
            "enum": [
              0,
              1
            ]
          },
          "publisherRegion": {
            "type": "string",
            "description": "Publisher country/region code from GET /regions.",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/best_podcasts",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "sort": "{{sort}}",
          "region": "{{region}}",
          "genre_id": "{{genreId}}",
          "language": "{{language}}",
          "safe_mode": "{{safeMode}}",
          "publisher_region": "{{publisherRegion}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
