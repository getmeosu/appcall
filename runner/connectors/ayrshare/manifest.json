          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/post",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{id}}",
          "post": "{{post}}",
          "approved": "{{approved}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
