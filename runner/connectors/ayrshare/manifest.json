          "post": {
            "type": "string",
            "minLength": 1,
            "description": "Replacement post text."
          },
          "approved": {
            "type": "boolean",
            "description": "Set true to approve a post awaiting approval."
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
