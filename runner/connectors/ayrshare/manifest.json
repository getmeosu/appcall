{
  "key": "ayrshare",
  "name": "Ayrshare",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Ayrshare API key",
          "required": true,
          "secret": true
        },
        {
          "key": "profileKey",
          "label": "Ayrshare Profile Key",
          "required": false,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.ayrshare.com"
    ]
  },
  "models": [
    "user",
    "post",
    "comment",
    "profile",
    "media",
    "webhook",
    "link",
    "message"
  ],
  "http": {
    "baseUrl": "https://api.ayrshare.com/api",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Profile-Key": "{{profileKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "error.message",
        "details"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Ayrshare API key with GET /user.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "user.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get user profile",
      "description": "Get Ayrshare account or user profile details, including linked social accounts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instagramDetails": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "query": {
          "instagramDetails": "{{instagramDetails}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "posts.history": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List post history",
      "description": "List Ayrshare post history with optional date, status, type, and platform filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "platforms": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "minLength": 1
          },
          "endDate": {
            "type": "string",
            "minLength": 1
          },
          "lastDays": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error",
              "processing",
              "pending",
              "paused",
              "deleted",
              "awaiting approval"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "immediate",
              "scheduled"
            ]
          },
          "autoRepostId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/history",
        "query": {
          "limit": "{{limit}}",
          "platforms": "{{platforms}}",
          "startDate": "{{startDate}}",
          "endDate": "{{endDate}}",
          "lastDays": "{{lastDays}}",
          "status": "{{status}}",
          "type": "{{type}}",
          "autoRepostId": "{{autoRepostId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
