    "posts.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create post",
      "description": "Publish or schedule an Ayrshare post to one or more social networks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "post": {
            "type": "string",
            "minLength": 1,
            "description": "Post text."
          },
          "platforms": {
            "type": "array",
            "description": "Social networks to publish to, for example twitter or linkedin.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mediaUrls": {
            "type": "array",
            "description": "Optional media URLs to attach.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scheduleDate": {
            "type": "string",
            "minLength": 1,
            "description": "Optional ISO-8601 schedule time."
          }
        },
        "additionalProperties": false,
        "required": [
          "post",
          "platforms"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/post",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "post": "{{post}}",
          "platforms": "{{platforms}}",
          "mediaUrls": "{{mediaUrls}}",
          "scheduleDate": "{{scheduleDate}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
