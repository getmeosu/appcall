      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get form",
      "description": "Retrieve one Formstack form, optionally including fields.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "formId": {
            "type": "integer",
            "minimum": 1
          },
          "includeFields": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "formId"
