{
  "key": "arcgis-online",
  "name": "ArcGIS Online",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "ArcGIS API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "geocode-api.arcgis.com",
      "www.arcgis.com"
    ]
  },
  "models": [
    "suggestion",
    "address-candidate",
    "reverse-geocode",
    "portal",
    "item",
    "group",
    "user"
  ],
  "http": {
    "baseUrl": "https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "token",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "query": {
      "f": "json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "error"
      ],
      "bodyErrorPaths": [
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the ArcGIS API key with a zero-credit suggest request.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/suggest",
        "query": {
          "text": "Berlin",
          "maxSuggestions": "1"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "geocode.suggest": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Suggest addresses",
      "description": "Return ArcGIS address and place autocomplete suggestions.",
      "inputSchema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "searchExtent": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "sourceCountry": {
            "type": "string",
            "minLength": 1
          },
          "preferredLabelValues": {
            "type": "string",
            "minLength": 1
          },
          "countryCode": {
            "type": "string",
            "minLength": 1
          },
          "maxSuggestions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "returnCollections": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/suggest",
        "query": {
          "text": "{{text}}",
          "searchExtent": "{{searchExtent}}",
          "category": "{{category}}",
          "sourceCountry": "{{sourceCountry}}",
          "preferredLabelValues": "{{preferredLabelValues}}",
          "countryCode": "{{countryCode}}",
          "maxSuggestions": "{{maxSuggestions}}",
          "returnCollections": "{{returnCollections}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "geocode.find-address-candidates": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Find address candidates",
      "description": "Convert an address or place query into ArcGIS geocoding candidates.",
      "inputSchema": {
        "type": "object",
        "required": [
          "singleLine"
        ],
        "properties": {
          "singleLine": {
            "type": "string",
            "minLength": 1
          },
          "searchExtent": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "sourceCountry": {
            "type": "string",
            "minLength": 1
          },
          "preferredLabelValues": {
            "type": "string",
            "minLength": 1
          },
          "magicKey": {
            "type": "string",
            "minLength": 1
          },
          "outFields": {
            "type": "string",
            "minLength": 1
          },
          "outSr": {
            "type": "integer"
          },
          "maxLocations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "forStorage": {
            "type": "boolean"
          },
          "locationType": {
            "type": "string",
            "enum": [
              "rooftop",
              "street"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/findAddressCandidates",
        "query": {
          "SingleLine": "{{singleLine}}",
          "searchExtent": "{{searchExtent}}",
          "category": "{{category}}",
          "sourceCountry": "{{sourceCountry}}",
          "preferredLabelValues": "{{preferredLabelValues}}",
          "magicKey": "{{magicKey}}",
          "outFields": "{{outFields}}",
          "outSR": "{{outSr}}",
          "maxLocations": "{{maxLocations}}",
          "forStorage": "{{forStorage}}",
          "locationType": "{{locationType}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "geocode.reverse": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Reverse geocode",
      "description": "Convert longitude and latitude into an ArcGIS address result.",
      "inputSchema": {
        "type": "object",
        "required": [
          "longitude",
          "latitude"
        ],
        "properties": {
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "outSr": {
            "type": "integer"
          },
          "langCode": {
            "type": "string",
            "minLength": 1
          },
          "forStorage": {
            "type": "boolean"
          },
          "featureTypes": {
            "type": "string",
            "minLength": 1
          },
          "locationType": {
            "type": "string",
            "enum": [
              "rooftop",
              "street"
            ]
          },
          "preferredLabelValues": {
            "type": "string",
            "minLength": 1
          },
          "outFields": {
            "type": "string",
            "minLength": 1
          },
          "returnInputLocation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/reverseGeocode",
        "query": {
          "location": "{{longitude}},{{latitude}}",
          "outSR": "{{outSr}}",
          "langCode": "{{langCode}}",
          "forStorage": "{{forStorage}}",
          "featureTypes": "{{featureTypes}}",
          "locationType": "{{locationType}}",
          "preferredLabelValues": "{{preferredLabelValues}}",
          "outFields": "{{outFields}}",
          "returnInputLocation": "{{returnInputLocation}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "geocode.geocode-addresses": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Geocode addresses",
      "description": "Batch-geocode a JSON addresses payload against the ArcGIS World GeocodeServer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "string",
            "description": "JSON string of the addresses records payload.",
            "minLength": 1
          },
          "sourceCountry": {
            "type": "string",
            "description": "ISO country code to limit results.",
            "minLength": 1
          },
          "forStorage": {
            "type": "boolean",
            "description": "Whether results may be stored."
          }
        },
        "additionalProperties": false,
        "required": [
          "addresses"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {}
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/geocodeAddresses",
        "success": [
          200,
          201
        ],
        "body": {
          "addresses": "{{addresses}}",
          "sourceCountry": "{{sourceCountry}}",
          "forStorage": "{{forStorage}}"
        },
        "bodyEncoding": "form",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
