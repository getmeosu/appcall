  "operations": {
    "geocode.find-address-candidates": {
      "description": "Convert an address or place query into ArcGIS geocoding candidates.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "minLength": 1,
            "type": "string"
          },
          "forStorage": {
            "type": "boolean"
          },
          "locationType": {
            "enum": [
              "rooftop",
              "street"
            ],
            "type": "string"
          },
          "magicKey": {
            "minLength": 1,
            "type": "string"
          },
          "maxLocations": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "outFields": {
            "minLength": 1,
            "type": "string"
          },
          "outSr": {
            "type": "integer"
          },
          "preferredLabelValues": {
            "minLength": 1,
            "type": "string"
          },
          "searchExtent": {
            "minLength": 1,
            "type": "string"
          },
          "singleLine": {
            "minLength": 1,
            "type": "string"
          },
          "sourceCountry": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "singleLine"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/findAddressCandidates",
        "query": {
          "SingleLine": "{{singleLine}}",
          "category": "{{category}}",
          "forStorage": "{{forStorage}}",
          "locationType": "{{locationType}}",
          "magicKey": "{{magicKey}}",
          "maxLocations": "{{maxLocations}}",
          "outFields": "{{outFields}}",
          "outSR": "{{outSr}}",
          "preferredLabelValues": "{{preferredLabelValues}}",
          "searchExtent": "{{searchExtent}}",
          "sourceCountry": "{{sourceCountry}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Find address candidates",
      "validationMode": "strict-generated"
    },
    "geocode.reverse": {
      "description": "Convert longitude and latitude into an ArcGIS address result.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "featureTypes": {
            "minLength": 1,
            "type": "string"
          },
          "forStorage": {
            "type": "boolean"
          },
          "langCode": {
            "minLength": 1,
            "type": "string"
          },
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "locationType": {
            "enum": [
              "rooftop",
              "street"
            ],
            "type": "string"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          "outFields": {
            "minLength": 1,
            "type": "string"
          },
          "outSr": {
            "type": "integer"
          },
          "preferredLabelValues": {
            "minLength": 1,
            "type": "string"
          },
          "returnInputLocation": {
            "type": "boolean"
          }
        },
        "required": [
          "longitude",
          "latitude"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {}
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/reverseGeocode",
        "query": {
          "featureTypes": "{{featureTypes}}",
          "forStorage": "{{forStorage}}",
          "langCode": "{{langCode}}",
          "location": "{{longitude}},{{latitude}}",
          "locationType": "{{locationType}}",
          "outFields": "{{outFields}}",
          "outSR": "{{outSr}}",
          "preferredLabelValues": "{{preferredLabelValues}}",
          "returnInputLocation": "{{returnInputLocation}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Reverse geocode",
      "validationMode": "strict-generated"
    },
