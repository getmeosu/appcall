{
  "key": "extracta-ai",
  "name": "Extracta.ai",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Extracta.ai API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.extracta.ai"
    ]
  },
  "models": [
    "extraction",
    "classification",
    "batch",
    "credit"
  ],
  "http": {
    "baseUrl": "https://api.extracta.ai/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "classifications.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create classification",
      "description": "Create a document classification and its document types. Returns classificationId.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "classificationDetails": {
            "type": "object",
            "additionalProperties": false,
            "description": "Classification configuration sent as classificationDetails.",
            "required": [
              "name",
              "documentTypes"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Name of the classification."
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "description": "Description of the classification."
              },
              "documentTypes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "description": "Document types the classifier can return.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "description",
                    "uniqueWords"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "Document type label, such as Invoice."
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "description": "What this document type represents."
                    },
                    "uniqueWords": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 50,
                      "description": "Phrases that identify this document type.",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "extractionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "description": "Optional linked extraction template id. Not a URL."
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "classificationDetails"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Extracta.ai."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/documentClassification/createClassification",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "classificationDetails": "{{classificationDetails}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
