    "extractions.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create extraction",
      "description": "Define an extraction template. Returns extractionId. This call does not upload document bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extractionDetails": {
            "type": "object",
            "additionalProperties": false,
            "description": "Extraction configuration sent as extractionDetails.",
            "required": [
              "name",
              "language",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Name of the extraction."
              },
              "description": {
                "type": "string",
                "maxLength": 4000,
                "description": "Description of the extraction."
              },
              "language": {
                "type": "string",
                "enum": [
                  "Arabic",
                  "Bangla",
                  "Bulgarian",
                  "Croatian",
                  "Czech",
                  "English",
                  "Filipino",
                  "French",
                  "German",
                  "Hindi",
                  "Hungarian",
                  "Italian",
                  "Nepali",
                  "Polish",
                  "Portuguese",
                  "Romanian",
                  "Russian",
                  "Serbian",
                  "Spanish",
                  "Turkish",
                  "Ukrainian",
                  "Urdu",
                  "Vietnamese",
                  "Multi-Lingual"
                ],
                "description": "Document language from the supported-languages list, including Multi-Lingual."
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "description": "Processing options from the extraction details page.",
                "properties": {
                  "hasTable": {
                    "type": "boolean",
                    "description": "Analyze tables."
                  },
                  "hasVisuals": {
                    "type": "boolean",
                    "description": "Analyze charts and diagrams."
                  },
                  "handwrittenTextRecognition": {
                    "type": "boolean",
                    "description": "Recognize handwriting."
                  },
                  "checkboxRecognition": {
                    "type": "boolean",
                    "description": "Read checkbox state."
                  },
                  "longDocument": {
                    "type": "boolean",
                    "description": "Use the long-document processing path."
                  },
                  "splitPdfPages": {
                    "type": "boolean",
                    "description": "Process each PDF page separately."
                  },
                  "specificPageProcessing": {
                    "type": "boolean",
                    "description": "Limit processing to a page range."
                  },
                  "specificPageProcessingOptions": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Page range used when specificPageProcessing is true.",
                    "properties": {
                      "from": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000,
                        "description": "First page to process."
                      },
                      "to": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000,
                        "description": "Last page to process."
                      }
                    }
                  }
                }
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "description": "Fields to extract.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key"
                  ],
                  "description": "One extraction field. Nested properties and items keep the documented object and array shapes.",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "Field key returned in the extraction result."
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 2000,
                      "description": "What the model should extract for this key."
                    },
                    "example": {
                      "type": "string",
                      "maxLength": 2000,
                      "description": "Example value for this field."
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "object",
                        "array"
                      ],
                      "description": "Field type. Omitted string fields are still accepted."
                    },
                    "properties": {
                      "type": "array",
                      "maxItems": 50,
                      "description": "Nested fields when type is object.",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "description": "Item schema when type is array."
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "extractionDetails"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Extracta.ai."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/createExtraction",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "extractionDetails": "{{extractionDetails}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
