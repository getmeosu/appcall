{
  "key": "commpeak",
  "name": "CommPeak",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "TextPeak API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "gw.commpeak.com"
    ]
  },
  "models": [
    "stream",
    "sender",
    "domain",
    "template",
    "webhook",
    "message"
  ],
  "http": {
    "baseUrl": "https://gw.commpeak.com/textpeak",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail",
        "title"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the TextPeak API key with GET /streams?itemsPerPage=1.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/streams",
        "query": {
          "itemsPerPage": 1
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
