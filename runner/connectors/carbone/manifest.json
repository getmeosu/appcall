            ],
            "properties": {
              "success": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/render/template",
        "headers": {
          "Content-Type": "application/json",
          "carbone-version": "{{carboneVersion}}"
        },
        "body": {
          "template": "{{template}}",
          "data": "{{data}}",
          "enum": "{{enum}}",
          "lang": "{{lang}}",
          "timezone": "{{timezone}}",
          "convertTo": "{{convertTo}}",
          "complement": "{{complement}}",
          "reportName": "{{reportName}}",
          "batchOutput": "{{batchOutput}}",
          "hardRefresh": "{{hardRefresh}}",
          "variableStr": "{{variableStr}}",
          "batchSplitBy": "{{batchSplitBy}}",
          "translations": "{{translations}}",
          "currencySource": "{{currencySource}}",
          "currencyTarget": "{{currencyTarget}}",
          "currencyRates": "{{currencyRates}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
