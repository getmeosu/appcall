{
  "key": "supportbee",
  "name": "SupportBee",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "SupportBee API token",
          "required": true,
          "secret": true
        },
        {
          "key": "company",
          "label": "SupportBee company subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.supportbee.com"
    ]
  },
  "models": [
    "user",
    "ticket",
    "label",
    "team",
    "reply",
    "comment",
    "snippet"
  ],
  "http": {
    "baseUrl": "https://{{company}}.supportbee.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the SupportBee API token with GET /users.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/users",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List tickets",
      "description": "List SupportBee tickets with optional official ticket filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "any"
            ]
          },
          "spam": {
            "type": "boolean"
          },
          "trash": {
            "type": "boolean"
          },
          "replies": {
            "type": "boolean"
          },
          "max_replies": {
            "type": "integer",
            "minimum": 0
          },
          "assigned_user": {
            "type": "string",
            "minLength": 1
          },
          "assigned_team": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "since": {
            "type": "string",
            "minLength": 1
          },
          "until": {
            "type": "string",
            "minLength": 1
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "last_activity",
              "creation_time"
            ]
          },
          "total_only": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/tickets",
        "success": [
          200
        ],
        "query": {
          "per_page": "{{per_page}}",
          "page": "{{page}}",
          "archived": "{{archived}}",
          "spam": "{{spam}}",
          "trash": "{{trash}}",
          "replies": "{{replies}}",
          "max_replies": "{{max_replies}}",
          "assigned_user": "{{assigned_user}}",
          "assigned_team": "{{assigned_team}}",
          "label": "{{label}}",
          "since": "{{since}}",
          "until": "{{until}}",
          "sort_by": "{{sort_by}}",
          "total_only": "{{total_only}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get ticket",
      "description": "Retrieve a SupportBee ticket by ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/tickets/{{id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
