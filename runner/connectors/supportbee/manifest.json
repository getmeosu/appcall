        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/labels",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "teams.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List teams",
      "description": "List SupportBee teams with optional user expansion filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "with_users": {
