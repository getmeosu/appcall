        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tickets.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create ticket",
      "description": "Create a SupportBee ticket.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "Ticket subject."
          },
          "requester_name": {
            "type": "string",
            "minLength": 1,
            "description": "Requester display name."
          },
          "requester_email": {
            "type": "string",
            "minLength": 1,
            "description": "Requester email address."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Plain-text ticket body."
          },
          "html": {
            "type": "string",
            "minLength": 1,
            "description": "HTML ticket body."
          },
          "notify_requester": {
            "type": "boolean",
            "description": "Email the requester when the ticket is created."
          }
        },
        "additionalProperties": false,
        "required": [
          "subject",
          "requester_name",
          "requester_email",
          "text"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/tickets",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "ticket": {
            "subject": "{{subject}}",
            "requester_name": "{{requester_name}}",
            "requester_email": "{{requester_email}}",
            "notify_requester": "{{notify_requester}}",
            "content": {
              "text": "{{text}}",
              "html": "{{html}}"
            }
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
