{
  "key": "better-proposals",
  "name": "Better Proposals",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Better Proposals API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.betterproposals.io"
    ]
  },
  "models": [
    "settings",
    "proposal",
    "template",
    "document-type",
    "company",
    "quote",
    "currency"
  ],
  "http": {
    "baseUrl": "https://api.betterproposals.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Bptoken",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "data.message",
        "data.error"
      ],
      "bodyErrorPaths": [
        "message"
      ]
    }
  },
