    "proposals.covers.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create proposal cover",
      "description": "Create a Better Proposals proposal cover design via POST /proposal/cover/create.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "BrandID": {
            "type": "integer",
            "description": "ID of the brand to use; if omitted, default brand settings are applied."
          },
          "BGColour": {
            "type": "string",
            "description": "Background colour as 6-digit hex code, e.g. 'ffffff'."
          },
          "Headline": {
            "type": "string",
            "description": "Main headline text on the cover."
          },
          "CoverName": {
            "type": "string",
            "description": "Name for the cover; default is 'Untitled'."
          },
          "Subheader": {
            "type": "string",
            "description": "Subheader text on the cover."
          },
          "TextAlign": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "description": "Text alignment on the cover."
          },
          "ButtonText": {
            "type": "string",
            "description": "Label text for the start button."
          },
          "TextColour": {
            "type": "string",
            "description": "Text colour as 6-digit hex code, e.g. 'ffffff'."
          },
          "ButtonStyle": {
            "type": "string",
            "enum": [
              "round",
              "square"
            ],
            "description": "Style of the start button; 'round' or 'square'."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/proposal/cover/create",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "form",
        "body": {
          "BrandID": "{{BrandID}}",
          "BGColour": "{{BGColour}}",
          "Headline": "{{Headline}}",
          "CoverName": "{{CoverName}}",
          "Subheader": "{{Subheader}}",
          "TextAlign": "{{TextAlign}}",
          "ButtonText": "{{ButtonText}}",
          "TextColour": "{{TextColour}}",
          "ButtonStyle": "{{ButtonStyle}}"
        }
