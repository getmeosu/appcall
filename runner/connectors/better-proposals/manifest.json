    "proposals.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create proposal",
      "description": "Create a Better Proposals proposal from a company and optional template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "Company": {
            "type": "string",
            "minLength": 1,
            "description": "Company ID or company name."
          },
          "Cover": {
            "type": "string",
            "minLength": 1,
            "description": "Cover ID."
          },
          "Template": {
            "type": "string",
            "minLength": 1,
            "description": "Template ID to copy into the proposal."
          },
          "DocumentType": {
            "type": "string",
            "minLength": 1,
            "description": "Document type ID or name."
          },
          "Brand": {
            "type": "string",
            "minLength": 1,
            "description": "Brand ID."
          },
          "Currency": {
            "type": "string",
            "minLength": 1,
            "description": "Currency code such as usd."
          }
        },
        "additionalProperties": false,
        "required": [
          "Company"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/proposal/create",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "Company": "{{Company}}",
          "Cover": "{{Cover}}",
          "Template": "{{Template}}",
          "DocumentType": "{{DocumentType}}",
          "Brand": "{{Brand}}",
          "Currency": "{{Currency}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
