            "type": "integer",
            "description": "Page number, starting at 1.",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "description": "Page size, 1 to 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "tag": {
            "type": "string",
            "description": "Filter by tag."
          }
        },
        "additionalProperties": false
