    "articles.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create article",
      "description": "Create a DEV Community article; drafts unless published is true.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Article title.",
            "minLength": 1
          },
          "bodyMarkdown": {
            "type": "string",
            "description": "Markdown content.",
            "minLength": 1
          },
          "published": {
            "type": "boolean",
            "description": "Whether to publish immediately."
          },
          "canonicalUrl": {
            "type": "string",
            "description": "Original article URL."
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tags."
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "bodyMarkdown"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/articles",
        "success": [
          200,
          201
        ],
        "body": {
          "article": {
            "title": "{{title}}",
            "body_markdown": "{{bodyMarkdown}}",
            "published": "{{published}}",
            "canonical_url": "{{canonicalUrl}}",
            "tags": "{{tags}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
