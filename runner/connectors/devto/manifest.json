          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/articles",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}",
          "tag": "{{tag}}"
        },
        "result": {
          "data": {
            "items": "{{response}}"
          }
