{
  "connector": "devto",
  "scenarios": [
    {
      "name": "Authenticated user identity",
      "operation": "users.me",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "data",
            "op": "isObject"
          },
          {
            "path": "data.id",
            "op": "exists"
          },
          {
            "path": "data.username",
            "op": "type",
            "value": "string"
          }
        ]
      }
    },
    {
      "name": "Read first page",
      "operation": "articles.mine",
      "input": {
        "perPage": 1,
        "page": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "data.items",
            "op": "type",
            "value": "array"
          }
        ]
      }
    }
  ]
}
