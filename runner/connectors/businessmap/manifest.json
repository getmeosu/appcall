{
  "key": "businessmap",
  "name": "Businessmap",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Businessmap API key",
          "required": true,
          "secret": true
        },
        {
          "key": "account",
          "label": "Businessmap account subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "*.kanbanize.com"
    ]
  },
  "models": [
    "workspace",
    "board",
    "card",
    "comment",
    "user",
    "column",
    "lane",
    "tag"
  ],
  "http": {
    "baseUrl": "https://{{account}}.kanbanize.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "apikey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "error",
        "detail"
      ]
    }
  },
