{
  "key": "alpaca",
  "name": "Alpaca",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "banking-data"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Alpaca API secret key",
          "required": true,
          "secret": true
        },
        {
          "key": "apiKeyId",
          "label": "Alpaca API key ID",
          "required": true,
          "secret": false
        },
        {
          "key": "tradingHost",
          "label": "Alpaca trading host prefix (paper-api or api)",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "paper-api.alpaca.markets",
      "api.alpaca.markets"
    ]
  },
  "models": [
    "account",
    "asset",
    "position",
    "clock",
    "watchlist",
    "order",
    "calendar",
    "activity",
    "configuration",
    "portfolio",
    "option-contract"
  ],
  "http": {
    "baseUrl": "https://{{tradingHost}}.alpaca.markets",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "APCA-API-SECRET-KEY",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "APCA-API-KEY-ID": "{{apiKeyId}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "code"
      ]
    }
  },
  "operations": {
