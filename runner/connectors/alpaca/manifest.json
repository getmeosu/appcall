      "responseFormat": "json"
    },
    "orders.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Create order",
      "description": "Place an Alpaca order for the connected paper or live account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Symbol, asset ID, or currency pair to trade."
          },
          "qty": {
            "type": "string",
            "minLength": 1,
            "description": "Number of shares or contracts to trade."
          },
          "notional": {
            "type": "string",
            "minLength": 1,
            "description": "Dollar amount to trade. Cannot be combined with qty."
          },
          "side": {
            "type": "string",
            "minLength": 1,
            "description": "Buy or sell.",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Order type.",
            "enum": [
              "market",
              "limit",
              "stop",
              "stop_limit",
              "trailing_stop"
            ]
          },
          "timeInForce": {
            "type": "string",
            "minLength": 1,
            "description": "Time in force.",
            "enum": [
              "day",
              "gtc",
              "opg",
              "cls",
              "ioc",
              "fok"
            ]
          },
          "limitPrice": {
            "type": "string",
            "minLength": 1,
            "description": "Limit price. Required for limit and stop_limit orders."
          },
          "stopPrice": {
            "type": "string",
            "minLength": 1,
            "description": "Stop price. Required for stop and stop_limit orders."
          },
          "clientOrderId": {
            "type": "string",
            "minLength": 1,
            "description": "Optional client-assigned order ID."
          },
          "extendedHours": {
            "type": "boolean",
            "description": "Whether the order is eligible for extended hours."
          }
        },
        "required": [
          "symbol",
          "side",
          "type",
          "timeInForce"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v2/orders",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "symbol": "{{symbol}}",
          "qty": "{{qty}}",
          "notional": "{{notional}}",
          "side": "{{side}}",
          "type": "{{type}}",
          "time_in_force": "{{timeInForce}}",
          "limit_price": "{{limitPrice}}",
          "stop_price": "{{stopPrice}}",
          "client_order_id": "{{clientOrderId}}",
          "extended_hours": "{{extendedHours}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
