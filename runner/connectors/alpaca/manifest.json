  "operations": {
    "assets.list": {
      "description": "List Alpaca assets with optional status and asset-class filters.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "assetClass": {
            "enum": [
              "us_equity",
              "us_option",
              "crypto",
              "ipo"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v2/assets",
        "query": {
          "asset_class": "{{assetClass}}",
          "status": "{{status}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List assets",
      "validationMode": "strict-generated"
    },
