    "account.activities.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List account activities",
      "description": "List Alpaca account activities with optional type, date, and pagination filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "activityTypes": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated activity type codes such as FILL, DIV, or FEE."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Activity category filter.",
            "enum": [
              "trade_activity",
              "non_trade_activity"
            ]
          },
          "date": {
            "type": "string",
            "minLength": 1,
            "description": "Restrict results to this date."
          },
          "until": {
            "type": "string",
            "minLength": 1,
            "description": "Return activities until this timestamp."
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "description": "Return activities after this timestamp."
          },
          "direction": {
            "type": "string",
            "minLength": 1,
            "description": "Sort direction.",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "pageSize": {
            "type": "integer",
            "description": "Maximum number of activities to return.",
            "minimum": 1,
            "maximum": 100
          },
          "pageToken": {
            "type": "string",
            "minLength": 1,
            "description": "Pagination token from a previous response."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
