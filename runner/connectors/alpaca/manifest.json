    "orders.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List orders",
      "description": "List Alpaca orders for the connected account with optional filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "Order status filter.",
            "enum": [
              "open",
              "closed",
              "all"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of orders to return.",
            "minimum": 1,
            "maximum": 500
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "description": "Return orders submitted after this timestamp."
          },
          "until": {
            "type": "string",
            "minLength": 1,
            "description": "Return orders submitted until this timestamp."
          },
          "direction": {
            "type": "string",
            "minLength": 1,
            "description": "Sort direction.",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "nested": {
            "type": "boolean",
            "description": "Whether nested multi-leg orders should be rolled up."
          },
          "symbols": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated list of symbols to filter."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/orders",
        "success": [
          200
        ],
        "query": {
          "status": "{{status}}",
          "limit": "{{limit}}",
          "after": "{{after}}",
          "until": "{{until}}",
          "direction": "{{direction}}",
          "nested": "{{nested}}",
          "symbols": "{{symbols}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
