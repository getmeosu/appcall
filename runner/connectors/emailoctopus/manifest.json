{
  "key": "emailoctopus",
  "name": "emailoctopus",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "EmailOctopus API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.emailoctopus.com"
    ]
  },
  "models": [
    "campaign",
    "contact",
    "field",
    "list",
    "tag"
  ],
  "http": {
    "baseUrl": "https://api.emailoctopus.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "title",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate an EmailOctopus API key by reading the first page of lists on API v2.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/lists",
        "success": [
          200
        ],
        "query": {
          "limit": "1"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "lists.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get all lists",
      "description": "Retrieve every mailing list in the EmailOctopus account with cursor pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "starting_after": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/lists",
        "success": [
          200
        ],
        "query": {
          "limit": "{{limit}}",
          "starting_after": "{{starting_after}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "lists.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get list",
      "description": "Retrieve one mailing list by ID, including fields, tags, counts, and opt-in settings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/lists/{{list_id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "lists.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create list",
      "description": "Create a mailing list with the default Email, First name, and Last name fields.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/lists",
        "success": [
          201
        ],
        "body": {
          "name": "{{name}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "lists.update": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Update list",
      "description": "Rename an existing EmailOctopus mailing list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id",
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/lists/{{list_id}}",
        "success": [
          200
        ],
        "body": {
          "name": "{{name}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "lists.delete": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "destructive",
      "title": "Delete list",
      "description": "Permanently delete a mailing list and its contacts. Lists emailed in the last 7 days cannot be deleted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deleted"
            ],
            "properties": {
              "deleted": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/lists/{{list_id}}",
        "success": [
          204
        ],
        "result": {
          "data": {
            "deleted": true
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List contacts",
      "description": "Retrieve paginated contacts from a list, optionally filtered by tag, status, and date range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "subscribed",
              "unsubscribed"
            ]
          },
          "created_at_gte": {
            "type": "string",
            "minLength": 1
          },
          "created_at_lte": {
            "type": "string",
            "minLength": 1
          },
          "starting_after": {
            "type": "string",
            "minLength": 1
          },
          "last_updated_at_gte": {
            "type": "string",
            "minLength": 1
          },
          "last_updated_at_lte": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/lists/{{list_id}}/contacts",
        "success": [
          200
        ],
        "query": {
          "limit": "{{limit}}",
          "starting_after": "{{starting_after}}",
          "tag": "{{tag}}",
          "status": "{{status}}",
          "created_at.gte": "{{created_at_gte}}",
          "created_at.lte": "{{created_at_lte}}",
          "last_updated_at.gte": "{{last_updated_at_gte}}",
          "last_updated_at.lte": "{{last_updated_at_lte}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get contact",
      "description": "Retrieve one contact by UUID or MD5 of the lowercase email address.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "contact_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id",
          "contact_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/lists/{{list_id}}/contacts/{{contact_id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create contact",
      "description": "Create a contact on a mailing list with email, optional fields, tags, and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "email_address": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "subscribed",
              "unsubscribed"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id",
          "email_address"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/lists/{{list_id}}/contacts",
        "success": [
          201
        ],
        "body": {
          "email_address": "{{email_address}}",
          "fields": "{{fields}}",
          "tags": "{{tags}}",
          "status": "{{status}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.upsert": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create or update contact",
      "description": "Create a contact if missing, otherwise update email, fields, tags, or status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "email_address": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "object"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "subscribed",
              "unsubscribed"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id",
          "email_address"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/lists/{{list_id}}/contacts",
        "success": [
          200,
          201
        ],
        "body": {
          "email_address": "{{email_address}}",
          "fields": "{{fields}}",
          "tags": "{{tags}}",
          "status": "{{status}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
