    "contacts.unsubscribe": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Unsubscribe contact",
      "description": "Set a contact's status to unsubscribed while keeping the contact record.",
