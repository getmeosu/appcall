            "deleted": true
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.batch": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Batch update contacts",
      "description": "Update many contacts on a list in one request. Each contact must include an id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "contacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "email_address": {
                  "type": "string",
                  "minLength": 1
                },
                "fields": {
                  "type": "object"
                },
                "tags": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "subscribed",
                    "unsubscribed"
                  ]
                }
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "list_id",
          "contacts"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/lists/{{list_id}}/contacts/batch",
        "success": [
          200
        ],
        "body": {
          "contacts": "{{contacts}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
