      "fields": [
        {
          "key": "apiKey",
          "label": "EmailOctopus API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "emailoctopus.com"
    ]
  },
  "models": [
    "list",
    "contact",
    "campaign",
    "automation"
  ],
  "http": {
    "baseUrl": "https://emailoctopus.com/api/1.6",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
