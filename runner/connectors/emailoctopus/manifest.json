      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/lists/{{list_id}}/contacts/{{contact_id}}",
        "success": [
          200
        ],
        "body": {
          "status": "unsubscribed"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "contacts.delete": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "destructive",
      "title": "Delete contact",
      "description": "Permanently delete a contact from a list by UUID or MD5 of the lowercase email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "minLength": 1
          },
          "contact_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
