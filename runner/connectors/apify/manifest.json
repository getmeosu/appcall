{
  "key": "apify",
  "name": "Apify",
  "version": "0.2.0",
  "runtime": "bun",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "API Token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.apify.com"
    ]
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Apify connector. Returns connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    },
    "actors.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Actors",
      "description": "List all Apify actors owned by the authenticated user. Supports pagination via limit and offset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Optional. Maximum number of actors to return (default 20, max 100)."
          },
          "offset": {
            "type": "number",
            "description": "Optional. Number of actors to skip for pagination."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "description": "List of actor objects."
          },
          "total": {
            "type": "number",
            "description": "Total number of actors."
          },
          "count": {
            "type": "number",
            "description": "Number of actors returned."
          },
          "offset": {
            "type": "number",
            "description": "Offset used."
          }
        }
      }
    },
    "actors.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Actor",
      "description": "Retrieve detailed information about a specific Apify actor by its ID (e.g. username~actorName).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "The actor ID in the format username~actorName (tilde-separated) or the actor's unique ID string."
          }
        },
        "required": [
          "actorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "actor": {
            "type": "object",
            "description": "The actor resource."
          }
        }
      }
    },
    "actors.options": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Actor Options",
      "description": "List selectable actors for a picker: the account's own actors and saved tasks, plus Apify store results when a search term is supplied. Returns flat {id,label,source} options where id is the runnable actorId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Optional. Store search term; when empty only account actors and tasks are returned."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "description": "Flat list of {id,label,source} option objects."
          }
        }
      }
    },
    "actors.input_schema": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Actor Input Schema",
      "description": "Fetch a specific actor's input schema (from its default build) so a UI can render the actor's runInput fields. Returns { schema } where schema is a JSON-Schema-style object.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "The actor ID in the format username~actorName (tilde-separated) or the actor's unique ID."
          }
        },
        "required": [
          "actorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "schema": {
            "type": "object",
            "description": "The actor's input schema."
          }
        }
      }
    },
    "actor.run": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 60000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Run Actor",
      "description": "Start a new run of a specific Apify actor asynchronously. Returns the run object immediately without waiting for completion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "The actor ID in the format username~actorName (tilde-separated) or the actor's unique ID.",
            "x-dynamic-options": {
              "source": "actors.options",
              "valueField": "id",
              "labelField": "label",
              "searchParam": "search",
              "detailSource": "actors.input_schema"
            }
          },
          "runInput": {
            "type": "object",
            "description": "Optional. The input JSON object to pass to the actor run.",
            "additionalProperties": true
          },
          "memory": {
            "type": "number",
            "description": "Optional. Memory limit for the run in megabytes (e.g. 256, 512, 1024)."
          },
          "timeout": {
            "type": "number",
            "description": "Optional. Timeout for the run in seconds."
          },
          "build": {
            "type": "string",
            "description": "Optional. Tag or number of the actor build to run (e.g. 'latest')."
          },
          "maxItems": {
            "type": "number",
            "description": "Optional. Maximum number of items the actor run should return."
          }
        },
        "required": [
          "actorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "run": {
            "type": "object",
            "description": "The actor run object."
          }
        }
      }
    },
    "actor.run_sync_get_dataset_items": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 300000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 52428800,
      "title": "Run Actor and Get Dataset Items",
      "description": "Run an Apify actor synchronously and immediately return the resulting dataset items. This is the primary 'scrape and get results' operation \u2014 it blocks until the actor finishes and returns all scraped data in one call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "The actor ID in the format username~actorName (tilde-separated) or the actor's unique ID.",
            "x-dynamic-options": {
              "source": "actors.options",
              "valueField": "id",
              "labelField": "label",
              "searchParam": "search",
              "detailSource": "actors.input_schema"
            }
          },
          "runInput": {
            "type": "object",
            "description": "Optional. The input JSON object to pass to the actor (e.g. {\"startUrls\": [{\"url\": \"https://example.com\"}]}).",
            "additionalProperties": true
          },
          "memory": {
            "type": "number",
            "description": "Optional. Memory limit for the run in megabytes."
          },
          "timeout": {
            "type": "number",
            "description": "Optional. Timeout in seconds. Maximum 300 for synchronous runs."
          },
          "build": {
            "type": "string",
            "description": "Optional. Tag or number of the actor build to run."
          },
          "maxItems": {
            "type": "number",
            "description": "Optional. Maximum number of dataset items to return."
          }
        },
        "required": [
          "actorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "description": "Array of scraped dataset items returned by the actor."
          },
          "count": {
            "type": "number",
            "description": "Number of items returned."
          }
        }
      }
    },
    "runs.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Run",
      "description": "Retrieve details and current status of a specific Apify actor run by its run ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "description": "The unique ID of the actor run to retrieve."
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "run": {
            "type": "object",
            "description": "The actor run resource including status, timing, and dataset info."
          }
        }
      }
    },
    "runs.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Actor Runs",
      "description": "List all runs for a specific Apify actor, ordered by most recent first. Supports pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "description": "The actor ID in the format username~actorName (tilde-separated) or the actor's unique ID.",
            "x-dynamic-options": {
              "source": "actors.options",
              "valueField": "id",
              "labelField": "label",
              "searchParam": "search",
              "detailSource": "actors.input_schema"
            }
          },
          "limit": {
            "type": "number",
            "description": "Optional. Maximum number of runs to return."
          },
          "offset": {
            "type": "number",
            "description": "Optional. Number of runs to skip for pagination."
          }
        },
        "required": [
          "actorId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "runs": {
            "type": "array",
            "description": "List of actor run objects."
          },
          "total": {
            "type": "number"
          },
          "count": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        }
      }
    },
    "runs.abort": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Abort Run",
      "description": "Abort a running Apify actor run. The run will be stopped and its status set to ABORTED.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "description": "The unique ID of the actor run to abort."
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "run": {
            "type": "object",
            "description": "The updated actor run resource with ABORTED status."
          }
        }
      }
    },
    "datasets.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Dataset",
      "description": "Retrieve metadata and statistics for a specific Apify dataset by its ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "description": "The unique ID of the dataset to retrieve."
          }
        },
        "required": [
          "datasetId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "dataset": {
            "type": "object",
            "description": "The dataset metadata resource."
          }
        }
      }
    },
    "datasets.items": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 60000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 52428800,
      "title": "Get Dataset Items",
      "description": "Retrieve items stored in a specific Apify dataset. Returns cleaned data in JSON format. Supports pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "description": "The unique ID of the dataset from which to retrieve items."
          },
          "limit": {
            "type": "number",
            "description": "Optional. Maximum number of items to return."
          },
          "offset": {
            "type": "number",
            "description": "Optional. Number of items to skip for pagination."
          }
        },
        "required": [
          "datasetId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "description": "Array of dataset item objects."
          },
          "count": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        }
      }
    },
    "tasks.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Tasks",
      "description": "List all Apify actor tasks owned by the authenticated user. Tasks are saved configurations for running actors with specific inputs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Optional. Maximum number of tasks to return."
          },
          "offset": {
            "type": "number",
            "description": "Optional. Number of tasks to skip for pagination."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "description": "List of task objects."
          },
          "total": {
            "type": "number"
          },
          "count": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        }
      }
    },
    "task.run": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 60000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Run Task",
      "description": "Start a new run of a specific Apify actor task asynchronously. Returns the run object immediately.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "The unique ID or username~taskName of the actor task to run."
          },
          "runInput": {
            "type": "object",
            "description": "Optional. Override input for this run. If omitted, the task's saved input is used.",
            "additionalProperties": true
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "run": {
            "type": "object",
            "description": "The actor run object."
          }
        }
      }
    },
    "task.run_sync_get_dataset_items": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 300000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 52428800,
      "title": "Run Task and Get Dataset Items",
      "description": "Run an Apify actor task synchronously and immediately return the resulting dataset items. Blocks until the task run completes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "The unique ID or username~taskName of the actor task to run."
          },
          "runInput": {
            "type": "object",
            "description": "Optional. Override input for this run.",
            "additionalProperties": true
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "description": "Array of dataset items returned by the task run."
          },
          "count": {
            "type": "number"
          }
        }
      }
    },
    "key_value_store.get_record": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "Get Key-Value Store Record",
      "description": "Retrieve a single record (value) from an Apify key-value store by its store ID and record key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "description": "The unique ID of the key-value store."
          },
          "recordKey": {
            "type": "string",
            "description": "The key of the record to retrieve (e.g. 'OUTPUT', 'INPUT')."
          }
        },
        "required": [
          "storeId",
          "recordKey"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "value": {
            "description": "The value stored at the given key. May be any JSON type or string."
          }
        }
      }
    },
    "datasets.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Datasets",
      "description": "List Apify datasets owned by the authenticated user. Supports pagination via limit and offset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Optional. Maximum number of datasets to return."
          },
          "offset": {
            "type": "number",
            "description": "Optional. Number of datasets to skip for pagination."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "datasets": {
            "type": "array",
            "description": "List of dataset objects."
          },
          "total": {
            "type": "number"
          },
          "count": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        }
      }
    },
    "datasets.create": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Create Dataset",
      "description": "Create a new Apify dataset. Optionally assign a unique name; unnamed datasets are also allowed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional. Unique name for the dataset."
          }
        },
        "required": [],
