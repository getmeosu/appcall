      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Delete Dataset",
      "description": "Permanently delete an Apify dataset and all of its items by dataset ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "description": "The unique ID of the dataset to delete."
          }
        },
        "required": [
          "datasetId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "datasetId": {
            "type": "string",
            "description": "The ID of the deleted dataset."
          }
        }
      }
    },
    "datasets.push_items": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 65536,
      "title": "Push Dataset Items",
      "description": "Append one or more JSON items to an Apify dataset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "description": "The unique ID of the dataset to append items to."
          },
          "items": {
            "type": "array",
            "description": "Non-empty array of JSON objects to store in the dataset."
          }
        },
        "required": [
          "datasetId",
          "items"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "datasetId": {
            "type": "string"
          },
