          },
          "invoice": {
            "type": "object"
          }
        }
      }
    },
    "invoices.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create Invoice",
      "description": "Create a Xero sales invoice (ACCREC) or purchase bill (ACCPAY) with a contact and line items.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Invoice type: ACCREC (sales) or ACCPAY (bills)."
          },
          "contactId": {
            "type": "string",
            "description": "Existing Xero ContactID. Provide this or contactName."
          },
          "contactName": {
            "type": "string",
            "description": "Contact name used when contactId is omitted."
          },
          "lineItems": {
            "type": "array",
            "description": "Invoice line items. At least one Description is required.",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "description": "Line item description."
                },
                "quantity": {
                  "type": "number",
                  "description": "Quantity."
                },
                "unitAmount": {
                  "type": "number",
                  "description": "Unit price."
                },
                "accountCode": {
                  "type": "string",
                  "description": "Chart of accounts code for the line."
                }
              }
            }
          },
          "date": {
            "type": "string",
            "description": "Invoice date (YYYY-MM-DD)."
          },
          "dueDate": {
            "type": "string",
            "description": "Due date (YYYY-MM-DD)."
          },
          "invoiceNumber": {
            "type": "string",
            "description": "Optional invoice number."
          },
          "reference": {
            "type": "string",
            "description": "Optional reference."
          },
          "status": {
            "type": "string",
            "description": "DRAFT, SUBMITTED, or AUTHORISED."
          },
          "currencyCode": {
            "type": "string",
            "description": "ISO currency code."
          }
        },
        "required": [
          "type",
          "lineItems"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "invoice": {
            "type": "object"
          }
        }
      }
    },
    "invoices.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Update Invoice",
      "description": "Update a draft or submitted Xero invoice. Paid invoices have restricted fields.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "description": "Xero InvoiceID GUID to update."
          },
          "type": {
            "type": "string",
            "description": "Invoice type: ACCREC or ACCPAY."
          },
          "contactId": {
            "type": "string",
            "description": "Replacement ContactID."
          },
          "contactName": {
            "type": "string",
            "description": "Replacement contact name."
          },
          "lineItems": {
            "type": "array",
            "description": "Replacement line items.",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitAmount": {
                  "type": "number"
                },
                "accountCode": {
                  "type": "string"
                }
              }
            }
          },
          "date": {
            "type": "string",
            "description": "Invoice date (YYYY-MM-DD)."
          },
          "dueDate": {
            "type": "string",
            "description": "Due date (YYYY-MM-DD)."
          },
          "invoiceNumber": {
            "type": "string",
            "description": "Invoice number."
          },
          "reference": {
            "type": "string",
            "description": "Reference."
          },
          "status": {
            "type": "string",
            "description": "DRAFT, SUBMITTED, AUTHORISED, VOIDED, or DELETED."
          },
          "currencyCode": {
            "type": "string",
            "description": "ISO currency code."
          }
        },
        "required": [
          "invoiceId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "invoice": {
            "type": "object"
          }
        }
      }
    },
