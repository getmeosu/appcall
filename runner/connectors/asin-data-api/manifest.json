  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.asindataapi.com"
    ]
  },
  "models": [
    "account",
    "destination",
    "collection",
    "product"
  ],
  "http": {
    "baseUrl": "https://api.asindataapi.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "request_info.message",
        "message",
        "error"
      ],
      "bodyErrorPaths": [
        "request_info.message"
      ]
    }
