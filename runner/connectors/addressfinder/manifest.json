    "addresses.au.verify": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Verify Australian address",
      "description": "Verify an Australian address against PAF and/or GNAF and return matched metadata.",
