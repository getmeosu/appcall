{
  "auth": {
    "scopes": [],
    "setup": {
      "fields": [
        {
          "key": "apiKey",
          "label": "Addressfinder API key",
          "required": true,
          "secret": true
        },
        {
          "key": "apiSecret",
          "label": "Addressfinder API secret",
          "required": true,
          "secret": true
        }
      ],
      "mode": "api_key"
    },
    "type": "api_key"
  },
  "categories": [
    "utility"
  ],
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "http": {
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "key",
      "value": "{{apiKey}}"
    },
    "baseUrl": "https://api.addressfinder.io/api",
    "errors": {
      "bodyErrorPaths": [
        "message"
      ],
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "error_message"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "{{apiSecret}}"
    },
    "query": {
      "format": "json"
    }
  },
  "key": "addressfinder",
  "models": [
    "address"
  ],
  "name": "Addressfinder",
  "network": {
    "allowedHosts": [
      "api.addressfinder.io"
    ]
  },
  "operations": {
    "addresses.au.find": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Find Australian addresses",
      "description": "Search Australian addresses with Addressfinder autocomplete.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Partial Australian address to autocomplete."
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum number of completions to return (1-100)."
          },
          "source": {
            "type": "string",
            "enum": [
              "GNAF",
              "PAF",
              "GNAF,PAF"
            ],
            "description": "Address dataset: GNAF, PAF, or GNAF,PAF."
          },
          "post_box": {
            "type": "string",
            "enum": [
              "0",
              "1"
            ],
            "description": "0 excludes PO Box addresses; 1 returns only PO Box addresses."
          },
          "canonical": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to return canonical addresses only."
          },
          "state_codes": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated AU state/territory codes: ACT, NSW, NT, QLD, SA, TAS, VIC, WA, OT."
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Registered domain used for Portal activity monitoring."
          },
          "highlight": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to wrap matching terms in highlight spans."
          },
          "ascii": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to convert macrons and accents to ASCII."
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/au/address/autocomplete",
        "query": {
          "q": "{{query}}",
          "max": "{{max}}",
          "source": "{{source}}",
          "post_box": "{{post_box}}",
          "canonical": "{{canonical}}",
          "state_codes": "{{state_codes}}",
          "domain": "{{domain}}",
          "highlight": "{{highlight}}",
          "ascii": "{{ascii}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
