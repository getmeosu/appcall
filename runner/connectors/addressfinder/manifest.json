          },
          "gnaf": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to query the GNAF physical-address dataset."
          },
          "paf": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to query the PAF postal-address dataset."
          },
          "post_box": {
            "type": "string",
            "enum": [
              "0"
            ],
            "description": "Set to 0 to exclude PO Box-type addresses."
          },
          "gps": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to include latitude and longitude."
          },
          "extended": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to return additional GNAF fields."
          },
          "census": {
            "type": "integer",
            "enum": [
              2016,
              2021
            ],
            "description": "Census year for statistical area identifiers."
          },
          "state_codes": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated AU state/territory codes: ACT, NSW, NT, QLD, SA, TAS, VIC, WA, OT."
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Registered domain used for Portal activity monitoring."
          },
          "ascii": {
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Set to 1 to convert macrons and accents to ASCII."
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/au/address/v2/verification",
        "query": {
          "q": "{{query}}",
          "gnaf": "{{gnaf}}",
          "paf": "{{paf}}",
          "post_box": "{{post_box}}",
          "gps": "{{gps}}",
          "extended": "{{extended}}",
          "census": "{{census}}",
          "state_codes": "{{state_codes}}",
          "domain": "{{domain}}",
          "ascii": "{{ascii}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
