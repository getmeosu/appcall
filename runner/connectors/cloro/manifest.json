    "async.task.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 60000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 10485760,
      "title": "Get Async Task",
      "description": "Read one async task with GET /v1/async/task/{taskId}. This is a single request. Call it again to wait; it does not poll.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "description": "Task UUID returned by async submit or a successful batch item."
          }
        },
        "required": [
          "taskId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/async/task/{{taskId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
