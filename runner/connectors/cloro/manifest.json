{
  "key": "cloro",
  "name": "Cloro",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Cloro API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.cloro.dev"
    ]
  },
  "models": [
    "chatgpt-response",
    "copilot-response",
    "aimode-answer",
    "grok-response",
    "async-task",
    "credit-balance",
    "country",
    "us-state",
    "google-redirect"
  ],
  "http": {
    "baseUrl": "https://api.cloro.dev",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429,
        503
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message"
      ]
    }
  },
  "operations": {
    "chatgpt.extract": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Extract ChatGPT Response",
      "description": "Synchronously extract a geo-targeted ChatGPT response with POST /v1/monitor/chatgpt. This spends credits. The client timeout is 300 seconds because Cloro can keep a sync attempt running that long.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Prompt sent to ChatGPT, from 1 to 10,000 characters."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Uppercase ISO 3166-1 alpha-2 country code."
          },
          "include": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional JSON flags. An HTML flag returns a URL in the JSON result and does not download a page.",
            "properties": {
              "html": {
                "type": "boolean",
                "description": "Include an expiring URL of the response HTML."
              },
              "markdown": {
                "type": "boolean",
                "description": "Include the answer as markdown."
              },
              "rawResponse": {
                "type": "boolean",
                "description": "Include ChatGPT raw response events."
              },
              "searchQueries": {
                "type": "boolean",
                "description": "Include ChatGPT search fan-out queries."
              },
              "ads": {
                "type": "boolean",
                "description": "Include ads served with the response."
              },
              "shopping": {
                "type": "boolean",
                "description": "Include shopping cards and inline products."
              }
            }
          },
          "legacy": {
            "type": "boolean",
            "description": "Request ChatGPT's legacy desktop interface on a best-effort basis."
          },
          "disableWebSearch": {
            "type": "boolean",
            "description": "Do not force web search. ChatGPT may still search on its own."
          },
          "state": {
            "type": "string",
            "enum": [
              "AL",
              "AK",
              "AZ",
              "AR",
              "CA",
              "CO",
              "CT",
              "DE",
              "DC",
              "FL",
              "GA",
              "HI",
              "ID",
              "IL",
              "IN",
              "IA",
              "KS",
              "KY",
              "LA",
              "ME",
              "MD",
              "MA",
              "MI",
              "MN",
              "MS",
              "MO",
              "MT",
              "NE",
              "NV",
              "NH",
              "NJ",
              "NM",
              "NY",
              "NC",
              "ND",
              "OH",
              "OK",
              "OR",
              "PA",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VT",
              "VA",
              "WA",
              "WV",
              "WI",
              "WY"
            ],
            "description": "Optional USPS state or DC code. Valid only when country is US."
          }
        },
        "required": [
          "prompt",
          "country"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/monitor/chatgpt",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "prompt": "{{prompt}}",
          "country": "{{country}}",
          "include": "{{include}}",
          "legacy": "{{legacy}}",
          "disableWebSearch": "{{disableWebSearch}}",
          "state": "{{state}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "copilot.extract": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 65536,
