    },
    "countries.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Supported Countries",
      "description": "List supported ISO country codes with GET /v1/countries. The JSON array is returned as data. model filters one provider and does not change the route.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "aimode",
              "aioverview",
              "chatgpt",
              "copilot",
              "gemini",
              "google",
              "grok",
              "perplexity"
            ],
            "description": "Optional provider filter. Omit for the aggregate country list."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/countries",
        "success": [
          200
        ],
        "query": {
          "model": "{{model}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "states.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List US States",
      "description": "List US state and DC codes with GET /v1/states?country=US. The JSON array is returned as data. Only US returns states.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v1/states",
        "success": [
          200
        ],
        "query": {
          "country": "US"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "google.redirect.resolve": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 65536,
      "title": "Resolve Google Redirect",
      "description": "Resolve one Google redirectLink with POST /v1/monitor/google/goto. url is a JSON field on api.cloro.dev and is not the request URL.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 4096,
            "description": "Absolute https://google.com or https://www.google.com redirectLink whose path is /goto or /url."
          }
        },
        "required": [
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/monitor/google/goto",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "url": "{{url}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "async.task.submit": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 60000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 1048576,
      "title": "Submit Async Task",
      "description": "Queue one non-cancelable monitor task with POST /v1/async/task and return its id without waiting. Credits are spent when the task completes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskType": {
            "type": "string",
            "enum": [
              "AIMODE",
              "GOOGLE",
              "GOOGLE_NEWS",
              "GOOGLE_PRODUCT",
              "GEMINI",
              "CHATGPT",
              "COPILOT",
              "PERPLEXITY",
              "GROK"
            ],
            "description": "Provider task type accepted by the async task endpoint, including GROK and GOOGLE_PRODUCT."
          },
          "payload": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true,
            "description": "Provider body validated like that provider's synchronous monitor request."
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Queue priority from 1 (lowest) to 10 (highest). Omitted uses the provider default of 1."
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Account-unique key. Reuse returns 409 and does not create a second task."
          },
          "webhook": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "description": "Optional completion webhook. This connector does not call that URL.",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 8,
                "maxLength": 2048,
                "description": "HTTPS URL Cloro POSTs when the task finishes. Not used as this request's URL."
              }
            }
          }
        },
        "required": [
          "taskType",
          "payload"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/async/task",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "taskType": "{{taskType}}",
          "payload": "{{payload}}",
          "priority": "{{priority}}",
          "idempotencyKey": "{{idempotencyKey}}",
          "webhook": "{{webhook}}"
        }
      },
      "enforceOutputSchema": true,
