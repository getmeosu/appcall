    },
    "aimode.extract": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Extract Google AI Mode Answer",
      "description": "Extract a Google AI Mode answer with POST /v1/monitor/aimode. Send country or gl on this same route. This spends at least 6 credits.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Prompt sent to Google AI Mode, from 1 to 10,000 characters."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Uppercase ISO 3166-1 alpha-2 country code. Provide country or gl."
          },
          "gl": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Google gl country code, either case. Provide country or gl. Different values together return 400."
          },
          "hl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35,
            "description": "Google hl interface language, such as en or pt-BR."
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Canonical Google City,Region,Country location. Mutually exclusive with uule."
          },
          "uule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Pre-encoded Google UULE. Mutually exclusive with location."
          },
          "device": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ],
            "description": "Device profile used for the extraction."
          },
          "include": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional JSON flags. An HTML flag returns a URL in the JSON result and does not download a page.",
            "properties": {
              "html": {
                "type": "boolean",
                "description": "Include an expiring URL of the response HTML."
              },
              "markdown": {
                "type": "boolean",
                "description": "Include the answer as markdown."
              }
            }
          }
        },
        "required": [
          "prompt"
        ],
        "anyOf": [
          {
            "required": [
              "country"
            ]
          },
          {
            "required": [
              "gl"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v1/monitor/aimode",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "prompt": "{{prompt}}",
          "country": "{{country}}",
          "gl": "{{gl}}",
          "hl": "{{hl}}",
          "location": "{{location}}",
          "uule": "{{uule}}",
          "device": "{{device}}",
          "include": "{{include}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
