      "app.mailsoftly.com"
    ]
  },
  "models": [
    "contact",
    "contact-list",
    "tag",
    "campaign",
    "custom-field"
  ],
  "http": {
    "baseUrl": "https://app.mailsoftly.com/api/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
