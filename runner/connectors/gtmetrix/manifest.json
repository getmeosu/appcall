            "description": "Fuzzy URL filter for monitored pages.",
            "minLength": 1,
            "type": "string"
          },
          "page_number": {
            "description": "Results page number.",
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "description": "Page size for paginated results (1-500).",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "sort": {
            "description": "Sort by created or latest_report_time. Prepend - for reverse.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
