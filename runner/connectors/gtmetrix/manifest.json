{
  "key": "gtmetrix",
  "name": "GTmetrix",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "GTmetrix API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "gtmetrix.com"
    ]
  },
  "models": [
    "account",
    "location",
    "browser",
    "test",
    "report",
    "page",
    "device"
  ],
  "http": {
    "baseUrl": "https://gtmetrix.com/api/2.0",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "headers": {
      "Accept": "application/vnd.api+json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.detail",
        "errors.0.title",
        "errors.0.code"
      ]
    }
  },
