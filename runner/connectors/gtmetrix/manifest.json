    "tests.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Start test",
      "description": "Start a GTmetrix page test for a URL with optional location, browser, and report type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Page URL to test."
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "description": "Location ID."
          },
          "browser": {
            "type": "string",
            "minLength": 1,
            "description": "Browser ID."
          },
          "report": {
            "type": "string",
            "description": "Report type such as lighthouse."
          }
        },
        "additionalProperties": false,
        "required": [
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/tests",
        "success": [
          200,
          201,
          202
        ],
        "headers": {
          "Content-Type": "application/vnd.api+json"
        },
        "body": {
          "data": {
            "type": "test",
            "attributes": {
              "url": "{{url}}",
              "location": "{{location}}",
              "browser": "{{browser}}",
              "report": "{{report}}"
            }
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
