{
  "key": "acuity-scheduling",
  "name": "Acuity Scheduling",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "scheduling"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "userId",
          "label": "Acuity numeric User ID",
          "required": true,
          "secret": false
        },
        {
          "key": "apiKey",
          "label": "Acuity API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "acuityscheduling.com"
    ]
  },
  "models": [
    "account",
    "calendar",
    "appointment-type",
    "form",
    "appointment",
    "client",
    "block",
    "label",
    "product"
  ],
  "http": {
    "baseUrl": "https://acuityscheduling.com/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{userId}}",
        "password": "{{apiKey}}"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
