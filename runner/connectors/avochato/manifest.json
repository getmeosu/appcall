      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json"
    },
    "query": {
      "auth_id": "{{apiKey}}",
      "auth_secret": "{{authSecret}}"
    }
  },
