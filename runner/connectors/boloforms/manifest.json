{
  "key": "boloforms",
  "name": "BoloForms",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "forms"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "BoloForms API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "sapi.boloforms.com"
    ]
  },
  "models": [
    "document",
    "template-respondent",
    "form-response",
    "template",
    "form"
  ],
  "http": {
    "baseUrl": "https://sapi.boloforms.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "data.message",
        "data.error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the BoloForms API key by listing one page of documents.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/signature/get-documents",
        "success": [
          200
        ],
        "query": {
          "page": 1,
          "limit": 1
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
