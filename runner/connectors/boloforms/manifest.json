      "description": "List documents and form statistics from the current BoloForms workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "documentId": {
            "type": "string",
            "minLength": 1
          },
          "filter": {
            "type": "string",
            "minLength": 1
          },
          "sortBy": {
            "type": "string",
            "minLength": 1
          },
          "sortOrder": {
            "type": "string",
            "minLength": 1
          },
          "dateFrom": {
            "type": "string",
            "minLength": 1
          },
          "dateTo": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/signature/get-documents",
        "success": [
          200
        ],
        "query": {
          "query": "{{query}}",
          "documentId": "{{documentId}}",
          "filter": "{{filter}}",
          "sortBy": "{{sortBy}}",
          "sortOrder": "{{sortOrder}}",
          "dateFrom": "{{dateFrom}}",
          "dateTo": "{{dateTo}}",
          "page": "{{page}}",
          "limit": "{{limit}}"
        },
        "headers": {
          "workspaceid": "{{workspaceId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
