    "templates.send": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Send template for signing",
      "description": "Send a BoloForms PDF or form template via POST /signature/pdf-template-lambda.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "description": "Template or form documentId from the BoloForms dashboard."
          },
          "receiversList": {
            "type": "array",
            "minItems": 1,
            "description": "Recipients to send the template to.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "email"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Recipient role name."
                },
                "email": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Recipient email."
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Per-recipient email subject."
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Per-recipient email message."
                }
              }
            }
          },
          "mailSubject": {
            "type": "string",
            "minLength": 1,
            "description": "Global email subject."
          },
          "mailMessage": {
            "type": "string",
            "minLength": 1,
            "description": "Global email message."
          },
          "signingType": {
            "type": "string",
            "enum": [
              "PDF_TEMPLATE",
              "FORM_TEMPLATE"
            ],
            "description": "Template kind to send."
          }
        },
        "additionalProperties": false,
        "required": [
          "documentId",
          "signingType",
          "receiversList"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/signature/pdf-template-lambda",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "documentId": "{{documentId}}",
          "signingType": "{{signingType}}",
          "receiversList": "{{receiversList}}",
          "mailData": {
            "subject": "{{mailSubject}}",
            "message": "{{mailMessage}}"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
