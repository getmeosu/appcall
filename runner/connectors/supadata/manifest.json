{
  "key": "supadata",
  "name": "Supadata",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Supadata API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.supadata.ai"
    ]
  },
  "models": [
    "account",
    "youtube-video",
    "youtube-channel",
    "youtube-playlist",
    "transcript",
    "metadata",
    "web-page"
  ],
  "http": {
    "baseUrl": "https://api.supadata.ai/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "details",
        "error",
        "error.message"
      ]
    }
  },
  "operations": {
