            "description": "Last name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email address."
          },
          "consent": {
            "type": "string",
            "enum": [
              "none",
              "optedOut",
              "transactional",
              "single",
              "double"
            ],
            "description": "Consent state."
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "description": "External identifier."
          }
        },
        "additionalProperties": false,
        "required": [
