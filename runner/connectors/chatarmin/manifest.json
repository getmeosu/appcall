{
  "key": "chatarmin",
  "name": "Chatarmin",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Chatarmin API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.chatarmin.com"
    ]
  },
  "models": [
    "contact",
    "campaign",
    "flow",
    "voucherPool",
    "webhook",
    "message"
  ],
  "http": {
    "baseUrl": "https://api.chatarmin.com/api/public",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail",
        "errors"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Chatarmin API key with GET /contacts?page=1&limit=1.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/contacts",
        "query": {
          "page": "1",
          "limit": "1"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
