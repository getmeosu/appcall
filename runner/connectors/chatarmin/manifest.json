        "method": "PUT",
        "path": "/contacts",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "phone": "{{phone}}",
          "firstname": "{{firstname}}",
          "lastname": "{{lastname}}",
          "email": "{{email}}",
          "consent": "{{consent}}",
          "externalId": "{{externalId}}"
