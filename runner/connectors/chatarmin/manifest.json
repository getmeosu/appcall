    "messages.send": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Send message",
      "description": "Send a WhatsApp text, media, or template message to a Chatarmin contact.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "description": "Recipient phone number."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Recipient email used to look up the contact."
          },
          "contactId": {
            "type": "string",
            "minLength": 1,
            "description": "Contact ID or externalId."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "video",
              "document",
              "template"
            ],
            "description": "Message type."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Message body. Required for type=text."
          },
          "mediaUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Public media URL for image, video, or document."
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "description": "Optional media caption."
          },
          "templateName": {
            "type": "string",
            "minLength": 1,
            "description": "Approved WhatsApp template name."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "WhatsApp language code such as en or de."
          }
        },
        "additionalProperties": false,
        "required": [
          "type"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/messages/send",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "phone": "{{phone}}",
          "email": "{{email}}",
          "contactId": "{{contactId}}",
          "type": "{{type}}",
          "text": "{{text}}",
          "mediaUrl": "{{mediaUrl}}",
          "caption": "{{caption}}",
          "templateName": "{{templateName}}",
          "language": "{{language}}"
        }
      }
    },
