{
  "key": "accredible-certificates",
  "name": "Accredible",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Accredible API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.accredible.com"
    ]
  },
  "models": [
    "issuer",
    "group",
    "credential",
    "design",
    "evidence",
    "collection"
  ],
  "http": {
    "baseUrl": "https://api.accredible.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Token token={{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "error.message",
        "message",
        "errors",
        "data"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Accredible API key with GET /v1/issuer/details.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/issuer/details",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
