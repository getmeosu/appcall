        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "assetClassTypes": {
            "items": {
              "enum": [
                "HARDWARE",
                "POLICY",
                "DOCUMENT",
                "PERSONNEL",
                "SOFTWARE",
                "CODE",
                "CONTAINER",
                "COMPUTE",
                "NETWORKING",
                "DATABASE",
                "STORAGE"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "assetType": {
            "enum": [
              "PHYSICAL",
              "VIRTUAL"
            ],
            "type": "string"
          },
          "ownerId": {
            "minimum": 1,
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "assetClassTypes",
          "assetType",
          "ownerId"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
