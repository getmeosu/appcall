{
  "key": "bug-herd",
  "name": "BugHerd",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "BugHerd API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "www.bugherd.com"
    ]
  },
  "models": [
    "organization",
    "project",
    "task",
    "comment",
    "user",
    "column",
    "attachment",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://www.bugherd.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": "x"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "errors",
        "meta.error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the BugHerd API key by retrieving the authenticated organization.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api_v2/organization.json",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "projects.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
