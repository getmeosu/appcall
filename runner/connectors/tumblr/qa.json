{
  "connector": "tumblr",
  "scenarios": [
    {
      "name": "Authenticated account identity",
      "operation": "users.me",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "user",
            "op": "isObject"
          },
          {
            "path": "user.name",
            "op": "type",
            "value": "string"
          },
          {
            "path": "user.blogs",
            "op": "type",
            "value": "array"
          }
        ]
      }
    },
    {
      "name": "First read-only page",
      "operation": "following.list",
      "input": {
        "limit": 1,
        "offset": 0
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "blogs",
            "op": "type",
            "value": "array"
          }
        ]
      }
    }
  ]
}
