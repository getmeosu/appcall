          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/task.detail",
        "query": {
          "task_id": "{{task_id}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tasks.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create task",
      "description": "Create a Manus task. The agent runs asynchronously.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Prompt text for the task."
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "description": "Optional project ID."
          },
          "title": {
            "type": "string",
            "description": "Optional custom title."
          },
          "locale": {
            "type": "string",
            "description": "Output locale such as en or zh-CN."
          }
        },
        "required": [
          "content"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v2/task.create",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "message": {
            "content": "{{content}}"
          },
          "project_id": "{{project_id}}",
          "title": "{{title}}",
          "locale": "{{locale}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
