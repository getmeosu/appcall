{
  "key": "alpha-vantage",
  "name": "Alpha Vantage",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "banking-data"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Alpha Vantage API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "www.alphavantage.co"
    ]
  },
  "models": [
    "market",
    "quote",
    "symbol",
    "timeSeries",
    "company",
    "forex",
    "crypto",
    "news",
    "indicator"
  ],
  "http": {
    "baseUrl": "https://www.alphavantage.co",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "apikey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Error Message",
        "Information",
        "Note"
      ],
      "bodyErrorPaths": [
        "Error Message",
        "Information",
        "Note"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Alpha Vantage API key with MARKET_STATUS.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/query",
        "query": {
          "function": "MARKET_STATUS"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
