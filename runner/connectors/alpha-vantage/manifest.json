      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "RSI",
      "description": "Get the relative strength index technical indicator (RSI).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Ticker symbol."
          },
          "interval": {
            "type": "string",
            "enum": [
              "1min",
              "5min",
              "15min",
              "30min",
              "60min",
              "daily",
              "weekly",
              "monthly"
            ],
            "description": "Time interval."
          },
          "timePeriod": {
            "type": "integer",
            "description": "Number of data points used to calculate each RSI value.",
            "minimum": 1
          },
          "seriesType": {
            "type": "string",
            "enum": [
              "close",
              "open",
              "high",
              "low"
            ],
            "description": "Price series used in the calculation."
          }
        },
        "additionalProperties": false,
        "required": [
          "symbol",
          "interval",
          "timePeriod",
          "seriesType"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/query",
        "query": {
          "function": "RSI",
