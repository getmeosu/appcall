    "pdf.update-fields": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 100000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 4194304,
      "title": "Update fillable fields",
      "description": "Set values on fillable PDF fields. POST /v1/update-pdf-fields. Success JSON contains a file URL and per-field status. The source URL is a JSON field. This connector does not download PDF bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pdf_url", "fields"],
        "properties": {
          "pdf_url": {
            "type": "string",
            "minLength": 1,
            "description": "HTTPS URL of a PDF with named form fields. Sent as JSON url. Not the connector host."
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "description": "Field updates. id must match a field name in the PDF.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "value"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Fillable field name."
                },
                "value": {
                  "description": "New field value. Text and choices are strings. Checkboxes may be boolean.",
                  "anyOf": [
                    { "type": "string" },
                    { "type": "boolean" },
                    { "type": "number" }
                  ]
                },
                "readOnly": {
                  "type": "boolean",
                  "description": "Lock the field after the update."
                },
                "fontSize": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Font size for a text field."
                }
              }
            }
          },
          "expiration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080,
            "description": "Generated file lifetime in minutes. Default 5. Range 1 to 10080."
          },
          "output_file": {
            "type": "string",
            "minLength": 1,
            "description": "Output file name. Default output.pdf."
          },
          "cloud_storage": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1 uploads the file to CraftMyPDF CDN. 0 skips CDN upload when Post Actions use your S3 bucket."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Field update JSON with status, file URL, and field_statuses."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/update-pdf-fields",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "url": "{{pdf_url}}",
          "fields": "{{fields}}",
          "expiration": "{{expiration}}",
          "output_file": "{{output_file}}",
          "cloud_storage": "{{cloud_storage}}"
        },
        "success": [200]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "editor-sessions.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "title": "Create editor session",
      "description": "Create an embeddable template editor URL. POST /v1/create-editor-session. Success JSON contains the editor URL. backURL is a JSON field for the editor back button, not the connector host.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_id", "expiration"],
        "properties": {
          "template_id": {
            "type": "string",
            "minLength": 1,
            "description": "Template to open in the editor."
          },
          "expiration": {
            "type": "integer",
            "minimum": 1,
            "description": "Session lifetime in minutes. 1440 is 24 hours."
          },
          "canSave": {
            "type": "boolean",
            "description": "Allow saving the template. Default true."
          },
          "canCreatePDF": {
            "type": "boolean",
            "description": "Allow generating a PDF from the editor. Default true."
          },
          "canViewSettings": {
            "type": "boolean",
            "description": "Allow viewing editor settings. Default true."
          },
          "canPreview": {
            "type": "boolean",
            "description": "Allow preview. Default true."
          },
          "canEditJSON": {
            "type": "boolean",
            "description": "Allow editing template JSON. Default true."
          },
          "canShowHeader": {
            "type": "boolean",
            "description": "Show the CraftMyPDF header. Default true."
          },
          "canShowLayers": {
            "type": "boolean",
            "description": "Show the layers panel. Default true."
          },
          "canShowPropertyPanel": {
            "type": "boolean",
            "description": "Show the property panel. Default true."
          },
          "canShowHelp": {
            "type": "boolean",
            "description": "Show the help tab. Default true."
          },
          "canShowData": {
            "type": "boolean",
            "description": "Show the data tab. Default true."
          },
          "canShowExpressionDoc": {
            "type": "boolean",
            "description": "Show expression documentation. Default true."
          },
          "canShowPropertyBinding": {
            "type": "boolean",
            "description": "Show property binding. Default true."
          },
          "canShowBackURL": {
            "type": "boolean",
            "description": "Show the back button. Default true."
          },
          "jsonMode": {
            "type": "integer",
            "enum": [1, 2],
            "description": "1 is the JSON editor. 2 is the JSON viewer. Default 1."
          },
          "backURL": {
            "type": "string",
            "minLength": 1,
            "description": "URL opened by the editor back button. Sent in the JSON body. Not the connector request URL."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Editor session JSON with url, expiration, and token_uuid."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/create-editor-session",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "template_id": "{{template_id}}",
          "expiration": "{{expiration}}",
          "canSave": "{{canSave}}",
          "canCreatePDF": "{{canCreatePDF}}",
          "canViewSettings": "{{canViewSettings}}",
          "canPreview": "{{canPreview}}",
          "canEditJSON": "{{canEditJSON}}",
          "canShowHeader": "{{canShowHeader}}",
          "canShowLayers": "{{canShowLayers}}",
          "canShowPropertyPanel": "{{canShowPropertyPanel}}",
          "canShowHelp": "{{canShowHelp}}",
          "canShowData": "{{canShowData}}",
          "canShowExpressionDoc": "{{canShowExpressionDoc}}",
          "canShowPropertyBinding": "{{canShowPropertyBinding}}",
          "canShowBackURL": "{{canShowBackURL}}",
          "jsonMode": "{{jsonMode}}",
          "backURL": "{{backURL}}"
        },
        "success": [200]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
