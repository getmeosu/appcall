      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "minLength": 1,
            "description": "Optional EBNF filter."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum records to return."
          },
          "page_token": {
            "type": "string",
