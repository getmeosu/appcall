{
  "key": "googlemeet",
  "name": "Google Meet",
  "version": "0.3.1",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "scheduling"
  ],
  "auth": {
    "type": "external_bearer",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/meetings.space.created",
      "https://www.googleapis.com/auth/meetings.space.readonly",
      "https://www.googleapis.com/auth/meetings.space.settings"
    ],
    "setup": {
      "mode": "external_bearer",
      "fields": []
    }
  },
  "network": {
    "allowedHosts": [
      "www.googleapis.com",
      "meet.googleapis.com"
    ]
  },
  "operations": {
    "meetings.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Meeting",
      "description": "Create a Google Calendar event with a Google Meet conference link.",
      "sideEffect": "write",
      "sample": {
        "summary": "Intro call",
        "start": "2026-06-01T09:00:00Z",
        "end": "2026-06-01T09:30:00Z",
        "attendees": [
          "prospect@example.com"
        ]
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Meeting title shown on the calendar event."
          },
          "start": {
            "type": "string",
            "description": "Start time, RFC3339 (e.g. 2026-06-01T09:00:00Z)."
          },
          "end": {
            "type": "string",
            "description": "End time, RFC3339."
          },
          "description": {
            "type": "string",
            "description": "Optional event description."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Attendee email addresses to invite; Google emails them a calendar invite."
          }
        },
        "required": [
          "summary",
          "start",
          "end"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "meeting": {
            "type": "object"
          }
        }
      }
    },
    "meetings.list": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Meetings",
      "description": "List upcoming Google Calendar events that carry a Google Meet conference link.",
      "sideEffect": "read",
      "sample": {
        "maxResults": 10
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxResults": {
            "type": "number",
            "description": "Optional. Maximum number of upcoming meetings to return. Default 50."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "meetings": {
            "type": "array",
            "description": "Normalized upcoming meetings."
          }
        }
      }
    },
    "meetings.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Meeting",
      "description": "Retrieve a Google Calendar event (with Meet link) by its event/meeting ID.",
      "sideEffect": "read",
      "sample": {
        "meetingId": "evt_123"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "Google Calendar event ID for the meeting."
          }
        },
        "required": [
          "meetingId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "meeting": {
            "type": "object"
          }
        }
      }
    },
    "meetings.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update Meeting",
      "description": "Patch a Google Calendar event that hosts a Google Meet conference (summary, times, description, attendees).",
      "sideEffect": "write",
      "sample": {
        "meetingId": "evt_123",
        "summary": "Intro call (rescheduled)",
        "start": "2026-06-01T10:00:00Z",
        "end": "2026-06-01T10:30:00Z"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "Google Calendar event ID for the meeting to update."
          },
          "summary": {
            "type": "string",
            "description": "Optional. Updated meeting title."
          },
          "start": {
            "type": "string",
            "description": "Optional. Updated start time, RFC3339."
          },
          "end": {
            "type": "string",
            "description": "Optional. Updated end time, RFC3339."
          },
          "description": {
            "type": "string",
            "description": "Optional. Updated event description."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional. Replacement attendee email list; Google emails updates when sendUpdates=all."
          }
        },
        "required": [
          "meetingId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "meeting": {
            "type": "object"
          }
        }
      }
    },
    "meetings.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Delete Meeting",
      "description": "Delete a Google Calendar event (and its Meet conference). This action is irreversible.",
      "sideEffect": "write",
      "sample": {
        "meetingId": "evt_123"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "Google Calendar event ID for the meeting to delete."
          }
        },
        "required": [
          "meetingId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          },
          "meetingId": {
            "type": "string"
          }
        }
      }
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify the supplied Google access token can read the primary calendar.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      }
    },
    "spaces.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Meet space",
      "description": "Create a Google Meet space via spaces.create. Does not attach a Calendar event.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Optional Space.config (accessType, entryPointAccess)."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/spaces",
        "success": [
          200
        ]
      },
      "sample": {
        "config": {
          "accessType": "TRUSTED"
        }
      }
    },
    "spaces.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Meet space",
      "description": "Get a Google Meet space by space id or spaces/{space} resource name.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "space_name": {
            "type": "string",
            "minLength": 1,
            "description": "Space id or spaces/{space}."
          }
        },
        "additionalProperties": false,
        "required": [
          "space_name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/spaces/{space}",
        "success": [
          200
        ]
      },
      "sample": {
        "space_name": "abc"
      }
    },
    "spaces.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update Meet space",
      "description": "Patch a Google Meet space config via spaces.patch. Requires meetings.space.created.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Space id or spaces/{space}."
          },
          "config": {
            "type": "object",
            "description": "Space.config fields to write."
          },
          "updateMask": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated field mask, for example config.accessType."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "PATCH",
        "path": "/spaces/{space}",
        "success": [
          200
        ]
      },
      "sample": {
        "name": "spaces/abc",
        "updateMask": "config.accessType"
      }
    },
    "spaces.end-active-conference": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "End active conference",
      "description": "End the active conference in a Meet space via spaces.endActiveConference.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "space_name": {
            "type": "string",
            "minLength": 1,
            "description": "Space id or spaces/{space}."
          }
        },
        "additionalProperties": false,
        "required": [
          "space_name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/spaces/{space}:endActiveConference",
        "success": [
          200
        ]
      },
      "sample": {
        "space_name": "spaces/jQCFfuBOdN5z"
      }
    },
    "conference-records.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
