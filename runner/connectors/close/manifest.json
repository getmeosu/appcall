{
  "key": "close",
  "name": "Close CRM",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Close API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.close.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.close.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the Close API key by listing leads.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/lead/",
        "query": {
          "_limit": "1"
        },
        "success": [
          200
        ],
        "echo": {
          "status": "ok"
        },
        "result": {
          "status": "ok"
        }
      },
      "enforceOutputSchema": true
    },
    "leads.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "List Leads",
      "description": "List Close leads with bounded limit and offset pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "skip": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "leads": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "leads",
          "hasMore"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/v1/lead/",
        "query": {
          "_limit": "{{limit}}",
          "_skip": "{{skip}}"
        },
        "success": [
          200
        ],
        "result": {
          "leads": "{{response.data}}",
          "hasMore": "{{response.has_more}}"
        }
      },
      "enforceOutputSchema": true
    },
    "leads.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 262144,
      "sideEffect": "read",
