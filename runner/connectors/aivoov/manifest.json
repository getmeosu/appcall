{
  "key": "aivoov",
  "name": "AiVOOV",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "AiVOOV API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "aivoov.com"
    ]
  },
  "models": [
    "voice",
    "audio",
    "job"
  ],
  "http": {
    "baseUrl": "https://aivoov.com/api/v8",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-KEY",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the AiVOOV API key by listing voices.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/voices",
        "success": [
          200
        ]
      }
    },
    "voices.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List voices",
      "description": "List available AiVOOV voices, optionally filtered by language code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "languageCode": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/voices",
        "query": {
          "language_code": "{{languageCode}}"
        },
        "success": [
          200
        ]
      }
    },
    "audio.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create audio",
      "description": "Generate spoken audio from one voice and text pair.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "voiceId": {
            "type": "string",
            "description": "AiVOOV voice identifier.",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "description": "Text to synthesize.",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "voiceId",
          "text"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/create",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyEncoding": "form",
        "body": {
          "voice_id[]": "{{voiceId}}",
          "transcribe_text[]": "{{text}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
