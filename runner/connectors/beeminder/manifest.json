          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display title."
          },
          "yaxis": {
            "type": "string",
            "minLength": 1,
            "description": "Y-axis label."
          },
          "secret": {
            "type": "boolean",
            "description": "Hide the goal from public view."
          },
          "datapublic": {
            "type": "boolean",
            "description": "Publish datapoints."
          },
          "callbackUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Datapoint webhook callback URL."
          }
        },
        "additionalProperties": false,
        "required": [
          "username",
          "goalSlug"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PUT",
        "path": "/users/{{username}}/goals/{{goalSlug}}.json",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "title": "{{title}}",
          "yaxis": "{{yaxis}}",
          "secret": "{{secret}}",
          "datapublic": "{{datapublic}}",
          "callback_url": "{{callbackUrl}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
