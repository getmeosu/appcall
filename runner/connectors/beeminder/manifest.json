    "goals.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create goal",
      "description": "Create a Beeminder goal. Exactly two of goaldate, goalval, and rate are required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "Beeminder username."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "description": "Goal slug used in the URL."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display title."
          },
          "goalType": {
            "type": "string",
            "minLength": 1,
            "description": "Goal type such as hustler, fatloser, or custom."
          },
          "gunits": {
            "type": "string",
            "minLength": 1,
            "description": "Units plotted on the y-axis."
          },
          "goaldate": {
            "type": "integer",
            "description": "Unix timestamp of the goal date.",
            "minimum": 0
          },
          "goalval": {
            "type": "number",
            "description": "Target value."
          },
          "rate": {
            "type": "number",
            "description": "Bright red line rate."
          },
          "initval": {
            "type": "number",
            "description": "Initial value for today."
          }
        },
        "additionalProperties": false,
        "required": [
          "username",
          "slug",
          "title",
          "goalType",
          "gunits"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/users/{{username}}/goals.json",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "slug": "{{slug}}",
          "title": "{{title}}",
          "goal_type": "{{goalType}}",
          "gunits": "{{gunits}}",
          "goaldate": "{{goaldate}}",
          "goalval": "{{goalval}}",
          "rate": "{{rate}}",
          "initval": "{{initval}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "goals.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update goal",
      "description": "Update a Beeminder goal's title, visibility, axis label, or datapoint webhook URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "description": "Beeminder username."
