{
  "key": "givebutter",
  "name": "Givebutter",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "payments"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Givebutter API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.givebutter.com"
    ]
  },
  "models": [
    "campaign",
    "contact",
    "transaction",
    "fund",
    "ticket",
    "pledge",
    "payout",
    "plan"
  ],
  "http": {
    "baseUrl": "https://api.givebutter.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
