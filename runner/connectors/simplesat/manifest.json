{
  "key": "simplesat",
  "name": "Simplesat",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "forms"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Simplesat API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.simplesat.io"
    ]
  },
  "models": [
    "survey",
    "question",
    "customer",
    "response",
    "answer",
    "teamMember"
  ],
  "http": {
    "baseUrl": "https://api.simplesat.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Simplesat-Token",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "message",
        "error"
      ]
    }
  },
  "operations": {
