    "credentials.issue": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Issue credential",
      "description": "Issue a verifiable credential via POST /credentials.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Credential name."
          },
          "issuer": {
            "type": "string",
            "minLength": 1,
            "description": "Issuer DID controlled by this account."
          },
          "subjectDid": {
            "type": "string",
            "minLength": 1,
            "description": "Credential subject DID."
          }
        },
        "additionalProperties": false,
        "required": [
          "issuer",
          "subjectDid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/credentials",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "persist": true,
          "credential": {
            "name": "{{name}}",
            "issuer": "{{issuer}}",
            "type": [
              "VerifiableCredential"
            ],
            "credentialSubject": {
              "id": "{{subjectDid}}"
            }
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
