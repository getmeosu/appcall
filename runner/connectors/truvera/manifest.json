{
  "key": "truvera",
  "name": "Truvera",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Truvera API key",
          "required": true,
          "secret": true
        },
        {
          "key": "host",
          "label": "Truvera API host (api-testnet or api)",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api-testnet.truvera.io",
      "api.truvera.io"
    ]
  },
  "models": [
    "profile",
    "did",
    "schema",
    "credential",
    "registry",
    "job",
    "template",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://{{host}}.truvera.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
