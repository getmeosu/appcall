    "campaigns.create": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create Campaign",
      "description": "Create a Meta Ads campaign via POST /act_{ad-account-id}/campaigns. Creates omit effect keys.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "adAccountId": {
            "type": "string",
            "description": "Ad account id with or without act_ prefix."
          },
          "name": {
            "type": "string",
            "description": "Campaign name."
          },
          "objective": {
            "type": "string",
            "description": "Campaign objective, e.g. OUTCOME_TRAFFIC."
          },
          "status": {
            "type": "string",
            "description": "ACTIVE, PAUSED, or DELETED."
          },
          "specialAdCategories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Special ad categories (empty array allowed)."
          },
          "dailyBudget": {
            "type": "number",
            "description": "Daily budget in account currency minor units."
          },
          "lifetimeBudget": {
            "type": "number",
            "description": "Lifetime budget in account currency minor units."
          },
          "bidStrategy": {
            "type": "string",
            "description": "Bid strategy."
          },
