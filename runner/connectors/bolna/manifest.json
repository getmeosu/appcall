      "responseFormat": "json"
    },
    "agents.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create agent",
      "description": "Create a Bolna voice AI agent from agent_config and agent_prompts.",
      "inputSchema": {
        "type": "object",
        "required": [
          "agent_config",
          "agent_prompts"
        ],
        "additionalProperties": false,
        "properties": {
          "agent_config": {
            "type": "object",
            "description": "Agent configuration including agent_name and tasks."
          },
          "agent_prompts": {
            "type": "object",
            "description": "Prompts keyed by task, for example task_1.system_prompt."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v2/agent",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "agent_config": "{{agent_config}}",
          "agent_prompts": "{{agent_prompts}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "agents.update": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Patch agent",
      "description": "Partially update a Bolna voice agent. Unlike PUT, only supplied fields change.",
      "inputSchema": {
        "type": "object",
        "required": [
          "agent_id"
        ],
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "description": "Agent ID."
          },
          "agent_config": {
            "type": "object",
            "description": "Partial agent_config update."
          },
          "agent_prompts": {
            "type": "object",
            "description": "Partial prompt update."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/v2/agent/{{agent_id}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "agent_config": "{{agent_config}}",
          "agent_prompts": "{{agent_prompts}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
