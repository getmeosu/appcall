        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/agent/all",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "agents.get": {
      "kind": "action",
