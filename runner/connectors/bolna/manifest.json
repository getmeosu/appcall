          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "agent_id": "{{agent_id}}",
          "recipient_phone_number": "{{recipient_phone_number}}",
          "from_phone_number": "{{from_phone_number}}",
          "user_data": "{{user_data}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
