                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Layer name."
                },
                "text": {
                  "type": "string",
                  "description": "Replacement text."
                },
                "image_url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Replacement image URL."
                }
              }
            }
          },
          "webhook_url": {
            "type": "string",
            "minLength": 1,
            "description": "Optional completion webhook URL."
          },
          "metadata": {
            "type": "string",
            "description": "Optional caller metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "template",
          "modifications"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
