    "templates.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create template",
      "description": "Create a blank Bannerbear template with a name and canvas size.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Template name."
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "description": "Canvas width in pixels."
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "description": "Canvas height in pixels."
          },
          "metadata": {
            "type": "string",
            "description": "Optional caller metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v2/templates",
        "success": [
          200,
          201,
          202
        ],
        "body": {
          "name": "{{name}}",
          "width": "{{width}}",
          "height": "{{height}}",
          "metadata": "{{metadata}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
