    "images.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create image",
      "description": "Queue a Bannerbear image render from a template and layer modifications. Rendering is asynchronous; poll images.get or use a webhook.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1,
            "description": "Resource identifier."
          },
          "modifications": {
            "type": "array",
            "minItems": 1,
            "description": "Layer modifications.",
