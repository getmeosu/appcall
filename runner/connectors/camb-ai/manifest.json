{
  "key": "camb-ai",
  "name": "CAMB.AI",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "artificial-intelligence"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "CAMB.AI API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "client.camb.ai"
    ]
  },
  "models": [
    "voice",
    "translation-task",
    "subtitle-task",
    "dub-task"
  ],
  "http": {
    "baseUrl": "https://client.camb.ai/apis",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "detail.0.msg"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "voices.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Voices",
      "description": "List CAMB.AI voices. GET /list-voices takes no query parameters and returns a JSON array.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/list-voices",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "text.translate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Translate Text",
      "description": "Create a CAMB.AI translation task for one or more text segments. The JSON success body is task_id. This call does not poll or fetch the translated texts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLanguage",
          "targetLanguage",
          "texts"
        ],
        "properties": {
          "sourceLanguage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Source locale tag, such as en-us."
          },
          "targetLanguage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Target locale tag, such as es-es."
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "Text segments to translate, in order.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "age": {
            "type": "integer",
            "minimum": 0,
            "description": "Intended audience age used to adapt vocabulary."
          },
          "formality": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "Formality code: 1 formal, 2 informal."
          },
          "gender": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              9
            ],
            "description": "Grammatical gender code: 0 unspecified, 1 masculine, 2 feminine, 9 other."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "task_id"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/translate",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "source_language": "{{sourceLanguage}}",
          "target_language": "{{targetLanguage}}",
          "texts": "{{texts}}",
          "age": "{{age}}",
          "formality": "{{formality}}",
          "gender": "{{gender}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "subtitles.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 262144,
      "title": "Generate Subtitles",
      "description": "Create a CAMB.AI subtitle task from a media URL. The JSON success body is task_id. This call does not poll or download subtitle files.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaUrl",
          "sourceLanguage",
          "targetLanguages"
        ],
        "properties": {
          "mediaUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Public or signed media URL sent as media_url. It does not change the API host."
          },
          "sourceLanguage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Spoken source locale tag, such as en-us."
          },
          "targetLanguages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "Target locale tags for subtitle output.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "transcriptionMode": {
            "type": "string",
            "enum": [
              "fast",
              "slow"
            ],
            "description": "fast is quicker; slow may improve transcription accuracy."
          },
          "formattingOptions": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional subtitle segmentation settings forwarded as formatting_options.",
            "properties": {
              "max_segment_duration_in_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "min_segment_duration_in_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_characters_in_segment": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          },
          "folderId": {
            "type": "integer",
            "minimum": 1,
            "description": "Optional workspace folder ID."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "task_id"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/sub",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "media_url": "{{mediaUrl}}",
          "source_language": "{{sourceLanguage}}",
          "target_languages": "{{targetLanguages}}",
          "transcription_mode": "{{transcriptionMode}}",
          "formatting_options": "{{formattingOptions}}",
          "folder_id": "{{folderId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "dub.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 262144,
      "title": "Dub Media",
      "description": "Create a CAMB.AI end-to-end dubbing task from a media URL. The JSON success body is task_id. This call does not poll or download audio or video bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "videoUrl",
          "sourceLanguage",
          "targetLanguages"
        ],
        "properties": {
          "videoUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Public or signed media URL sent as video_url. It does not change the API host."
          },
          "sourceLanguage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Spoken source locale tag, such as en-us."
          },
          "targetLanguages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "Target locale tags for dubbed outputs.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "transcriptionMode": {
            "type": "string",
            "enum": [
              "fast",
              "slow"
            ],
            "description": "fast is quicker; slow may improve transcription accuracy."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "task_id"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/dub",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "video_url": "{{videoUrl}}",
          "source_language": "{{sourceLanguage}}",
          "target_languages": "{{targetLanguages}}",
          "transcription_mode": "{{transcriptionMode}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
