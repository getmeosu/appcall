{
  "key": "gem",
  "name": "Gem",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Gem team API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.gem.com"
    ]
  },
  "models": [
    "user",
    "candidate",
    "project",
    "note",
    "sequence",
    "custom-field"
  ],
  "http": {
    "baseUrl": "https://api.gem.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "status",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
