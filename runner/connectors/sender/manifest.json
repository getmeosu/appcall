  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Sender API access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.sender.net"
    ]
  },
  "models": [
    "group",
    "subscriber",
    "campaign",
    "field",
    "segment",
    "workflow"
  ],
  "http": {
    "baseUrl": "https://api.sender.net/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors"
      ],
      "bodyErrorPaths": [
        "message"
      ]
    }
  },
