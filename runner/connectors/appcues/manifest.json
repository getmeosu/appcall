{
  "key": "appcues",
  "name": "Appcues",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Appcues API key",
          "required": true,
          "secret": true
        },
        {
          "key": "apiSecret",
          "label": "Appcues API secret",
          "required": true,
          "secret": true
        },
        {
          "key": "accountId",
          "label": "Appcues account ID",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.appcues.com"
    ]
  },
  "models": [
    "account",
    "tag",
    "flow",
    "segment",
    "user",
    "pin",
    "checklist",
    "nps",
    "banner",
    "job"
  ],
  "http": {
    "baseUrl": "https://api.appcues.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": "{{apiSecret}}"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "title",
        "message"
      ]
    }
  },
