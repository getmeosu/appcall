      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Capsule CRM token with GET /users/current.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/users/current",
        "success": [
          200
        ],
        "result": {
          "user": "{{response}}"
        }
      },
      "enforceOutputSchema": true
    },
    "parties.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "List Parties",
      "description": "List Capsule CRM parties with bounded page pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "parties"
        ],
        "properties": {
          "parties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pagination": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/parties",
        "query": {
          "page": "{{page}}"
        },
        "success": [
          200
        ],
        "result": {
          "parties": "{{response.parties}}",
          "pagination": {
            "nextPage": "{{response.meta.nextPage}}"
          }
        }
      },
      "enforceOutputSchema": true
    },
