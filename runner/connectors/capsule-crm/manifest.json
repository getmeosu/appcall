{
  "key": "capsule-crm",
  "name": "Capsule CRM",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm",
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Capsule CRM API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.capsulecrm.com"
    ]
  },
  "models": [
    "user",
    "party",
    "opportunity",
    "project",
    "task",
    "entry",
    "pipeline"
  ],
  "http": {
    "baseUrl": "https://api.capsulecrm.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
