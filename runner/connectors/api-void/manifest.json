      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the APIVoid API key by reading account credit information. This endpoint consumes no credits.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
