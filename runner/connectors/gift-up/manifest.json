          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/gift-cards",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
