    "gift-cards.redeem": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Redeem gift card",
      "description": "Redeem an amount or units from a Gift Up gift card.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Gift card code."
          },
          "amount": {
            "type": "number",
            "description": "Currency amount to redeem."
          },
          "units": {
            "type": "integer",
            "description": "Units to redeem.",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Reason recorded on the gift card ledger."
          },
          "locationId": {
            "type": "string",
            "minLength": 1,
            "description": "Location id where the redemption occurred."
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/gift-cards/{{code}}/redeem",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "amount": "{{amount}}",
          "units": "{{units}}",
          "reason": "{{reason}}",
          "locationId": "{{locationId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
