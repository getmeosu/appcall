{
  "key": "gift-up",
  "name": "Gift Up",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ecommerce"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Gift Up API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.giftup.app"
    ]
  },
  "models": [
    "company",
    "gift_card",
    "order",
    "item",
    "group",
    "location",
    "promotion",
    "user"
  ],
  "http": {
    "baseUrl": "https://api.giftup.app",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "title",
        "detail"
      ]
    }
  },
  "operations": {
