    "orders.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create order",
      "description": "Create a Gift Up order that issues one or more gift cards.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "purchaserName": {
            "type": "string",
            "minLength": 1,
            "description": "Purchaser full name."
          },
          "purchaserEmail": {
            "type": "string",
            "minLength": 1,
            "description": "Purchaser email address."
          },
          "revenue": {
            "type": "number",
            "description": "Order revenue amount."
          },
          "disableAllEmails": {
            "type": "boolean",
            "description": "When true, Gift Up sends no emails for this order."
          },
          "referrer": {
            "type": "string",
            "minLength": 1,
            "description": "Order referrer or source label."
          },
          "itemDetails": {
            "type": "array",
            "description": "Gift card items to issue.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "quantity": {
                  "type": "integer",
                  "description": "Quantity of this item.",
                  "minimum": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Item name."
                },
                "price": {
                  "type": "number",
                  "description": "Price charged."
                },
                "value": {
                  "type": "number",
                  "description": "Gift card value."
                },
                "backingType": {
                  "type": "string",
                  "enum": [
                    "Currency",
                    "Units"
                  ]
                }
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "purchaserName",
          "purchaserEmail",
          "itemDetails"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/orders",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "purchaserName": "{{purchaserName}}",
          "purchaserEmail": "{{purchaserEmail}}",
          "revenue": "{{revenue}}",
          "disableAllEmails": "{{disableAllEmails}}",
          "referrer": "{{referrer}}",
          "itemDetails": "{{itemDetails}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
