{
  "key": "aircall",
  "name": "Aircall",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "messaging"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiId",
          "label": "Aircall API ID",
          "required": true,
          "secret": false
        },
        {
          "key": "apiKey",
          "label": "Aircall API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.aircall.io"
    ]
  },
  "models": [
    "user",
    "number",
    "team",
    "call",
    "contact",
    "tag",
    "company",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.aircall.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiId}}",
        "password": "{{apiKey}}"
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "troubleshoot"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
