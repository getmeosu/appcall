      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "timelink API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.timelink.io"
    ]
  },
  "models": [
    "token",
    "company",
    "user",
    "client",
    "project",
    "service",
    "timeEntry"
  ],
  "http": {
    "baseUrl": "https://api.timelink.io/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
