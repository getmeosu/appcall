{
  "key": "crossref",
  "name": "Crossref",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Crossref Metadata Plus API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.crossref.org"
    ]
  },
  "models": [
    "work",
    "agency",
    "style",
    "journal",
    "member",
    "prefix",
    "funder",
    "type",
    "license"
  ],
  "http": {
    "baseUrl": "https://api.crossref.org/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Crossref-Plus-API-Token",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "message.0.message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
