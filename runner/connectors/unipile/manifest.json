{
  "key": "unipile",
  "name": "Unipile",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["messaging"],
  "auth": {
    "type": "api_key",
    "setup": {
      "mode": "api_key",
      "fields": [
        { "key": "apiKey", "label": "API Key", "required": true, "secret": true },
        { "key": "dsn", "label": "DSN (e.g. https://api8.unipile.com:13851)", "required": true, "secret": false }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api1.unipile.com",
      "api2.unipile.com",
      "api3.unipile.com",
      "api4.unipile.com",
      "api5.unipile.com",
      "api6.unipile.com",
      "api7.unipile.com",
      "api8.unipile.com",
      "api9.unipile.com",
      "api10.unipile.com",
      "api11.unipile.com",
      "api12.unipile.com",
      "api13.unipile.com",
      "api14.unipile.com",
      "api15.unipile.com"
    ]
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Unipile connector. Returns connector health status. No network call is made.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "status": { "type": "string", "description": "Connector health status, e.g. \"ok\"." },
          "source": { "type": "string" }
        }
      }
    },
    "accounts.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Accounts",
      "description": "Retrieve all messaging/email accounts connected to this Unipile workspace. Returns a list of account objects with provider, status, and metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "accounts": { "type": "array", "description": "List of connected account objects." },
          "cursor": { "type": "string", "description": "Cursor for next page, if any." }
        }
      }
    },
    "accounts.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Account",
      "description": "Retrieve the details of a single Unipile account by its account ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string", "description": "The ID of the account to retrieve." }
        },
        "required": ["accountId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "account": { "type": "object", "description": "The account resource." }
        }
      }
    },
    "chats.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Chats",
      "description": "Retrieve a paginated list of chats (conversations/threads) for a given Unipile account. Supports cursor-based pagination and limit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "number", "description": "Optional. Number of chats to return per page." },
          "cursor": { "type": "string", "description": "Optional. Pagination cursor for the next page." }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "chats": { "type": "array", "description": "List of chat/conversation objects." },
          "cursor": { "type": "string", "description": "Cursor to fetch the next page." }
        }
      }
    },
    "chats.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Chat",
      "description": "Retrieve the details of a single Unipile chat by its chat ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chatId": { "type": "string", "description": "The ID of the chat to retrieve." }
        },
        "required": ["chatId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "chat": { "type": "object", "description": "The chat resource." }
        }
      }
    },
    "messages.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Messages",
      "description": "Retrieve a paginated list of messages in a specific Unipile chat. Supports cursor-based pagination and limit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chatId": { "type": "string", "description": "The ID of the chat whose messages to list." },
          "limit": { "type": "number", "description": "Optional. Number of messages to return per page." },
          "cursor": { "type": "string", "description": "Optional. Pagination cursor for the next page." }
        },
        "required": ["chatId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "messages": { "type": "array", "description": "List of message objects." },
          "cursor": { "type": "string", "description": "Cursor for the next page." }
        }
      }
    },
    "messages.send": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Send Message",
      "description": "Send a new message into an existing Unipile chat. Returns the created message resource.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chatId": { "type": "string", "description": "The ID of the chat to send the message into." },
          "text": { "type": "string", "description": "The text content of the message to send." }
        },
        "required": ["chatId", "text"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "message": { "type": "object", "description": "The created message resource." }
        }
      }
    },
    "chats.start": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Start Chat",
      "description": "Start a new direct message chat with one or more attendees on a given Unipile account, optionally sending an initial message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "attendees_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of attendee provider IDs to include in the new chat."
          },
          "text": { "type": "string", "description": "Optional. Initial message text for the new chat." }
        },
        "required": ["attendees_ids"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "chat": { "type": "object", "description": "The newly created chat resource." }
        }
      }
    },
    "emails.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Emails",
      "description": "Retrieve a paginated list of emails for a given Unipile account. Supports cursor-based pagination and limit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "number", "description": "Optional. Number of emails to return per page." },
          "cursor": { "type": "string", "description": "Optional. Pagination cursor for the next page." }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "emails": { "type": "array", "description": "List of email objects." },
          "cursor": { "type": "string", "description": "Cursor for the next page." }
        }
      }
    },
    "emails.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 524288,
      "title": "Get Email",
      "description": "Retrieve the details of a single Unipile email by its email ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "emailId": { "type": "string", "description": "The ID of the email to retrieve." }
        },
        "required": ["emailId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "email": { "type": "object", "description": "The email resource." }
        }
      }
    },
    "emails.send": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 65536,
      "title": "Send Email",
      "description": "Send a new email via a Unipile email account. Provide account ID, recipients, subject, and body.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "identifier": { "type": "string", "description": "Email address of the recipient." }
              },
              "required": ["identifier"]
            },
            "description": "Array of recipient objects, each with an 'identifier' (email address)."
          },
          "subject": { "type": "string", "description": "Subject line of the email." },
          "body": { "type": "string", "description": "HTML or plain-text body of the email." }
        },
        "required": ["to", "subject", "body"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "email": { "type": "object", "description": "The created email resource." }
        }
      }
    },
    "linkedin.profile.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 524288,
      "title": "Get LinkedIn Profile",
      "description": "Retrieve a LinkedIn user profile by provider ID or public identifier, scoped to a specific Unipile account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "identifier": { "type": "string", "description": "LinkedIn provider ID or public profile identifier." }
        },
        "required": ["identifier"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "profile": { "type": "object", "description": "The LinkedIn user profile resource." }
        }
      }
    },
    "linkedin.invitation.send": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Send LinkedIn Invitation",
      "description": "Send a LinkedIn connection invitation to a user by provider ID, optionally including a personalized message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider_id": { "type": "string", "description": "LinkedIn provider ID of the person to invite." },
          "message": { "type": "string", "description": "Optional. Personalized note to send with the invitation. MUST be 200 characters or fewer on a FREE LinkedIn account; Premium accounts may use up to 300 (the runner verifies Premium status live for a 201-300 note and rejects with NOTE_TOO_LONG when it cannot confirm it). Free accounts also allow only ~5 noted invitations per month." }
        },
        "required": ["provider_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "invitation": { "type": "object", "description": "The created invitation resource." }
        }
      }
    },
    "linkedin.relations.list": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List LinkedIn Relations",
      "description": "Retrieve a paginated list of LinkedIn connections (relations) for a given Unipile account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "number", "description": "Optional. Number of results per page." },
          "cursor": { "type": "string", "description": "Optional. Pagination cursor for the next page." }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "relations": { "type": "array", "description": "List of LinkedIn connection/relation objects." },
          "cursor": { "type": "string", "description": "Cursor for the next page." }
        }
      }
    }
  },
  "models": ["account", "chat", "message", "email"]
}
