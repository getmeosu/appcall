      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List conversations",
      "description": "Retrieve conversation history for one SiteSpeakAI chatbot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chatbot_id": {
            "type": "string",
            "description": "Chatbot ID.",
            "minLength": 1
          },
          "conversation_id": {
            "type": "string",
            "description": "Filter by visitor conversation ID.",
            "minLength": 1
          },
          "include_deleted": {
            "type": "boolean",
            "description": "Include cleared conversations."
          },
          "include_sources": {
            "type": "boolean",
            "description": "Include source records."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum conversations to return.",
            "minimum": 1
          },
          "order": {
            "type": "string",
            "description": "Sort order.",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "chatbot_id"
        ]
      },
      "outputSchema": {
        "type": "object",
