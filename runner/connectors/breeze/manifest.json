        "type": "object",
        "properties": {
          "details": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "filter_json": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/people",
        "query": {
          "details": "{{details}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "filter_json": "{{filter_json}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
