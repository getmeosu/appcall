{
  "key": "storyblok",
  "name": "Storyblok",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Storyblok access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.storyblok.com",
      "mapi.storyblok.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.storyblok.com/v2/cdn",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "token",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    }
  },
  "operations": {
