      "title": "Get a story",
      "description": "Retrieve one published or draft story by id, uuid, or slug from the Content Delivery API.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "find_by": {
            "type": "string",
            "enum": [
              "uuid"
            ]
          },
          "resolve_links": {
            "type": "string",
            "enum": [
              "story",
              "url",
              "link"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/stories/{{id}}",
        "query": {
          "version": "{{version}}",
          "language": "{{language}}",
          "find_by": "{{find_by}}",
          "resolve_links": "{{resolve_links}}"
        },
        "success": [
          200
        ]
      }
