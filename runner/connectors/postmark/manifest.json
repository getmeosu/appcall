{
  "key": "postmark",
  "name": "Postmark",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Postmark server token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.postmarkapp.com"
    ]
  },
  "models": [
    "server",
    "message",
    "bounce",
    "template",
    "webhook",
    "suppression"
  ],
  "http": {
    "baseUrl": "https://api.postmarkapp.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Postmark-Server-Token",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
