{
  "connector": "mastodon",
  "scenarios": [
    {
      "name": "verify authenticated identity",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "accountId",
            "op": "type",
            "value": "string"
          },
          {
            "path": "accountId",
            "op": "matches",
            "value": "^[0-9]+$"
          }
        ]
      }
    },
    {
      "name": "read accessible collection",
      "operation": "timelines.home",
      "input": {
        "limit": 2
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "statuses",
            "op": "isArray"
          }
        ]
      }
    }
  ]
}
