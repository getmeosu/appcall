        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID."
          },
          "strategy": {
            "type": "string",
            "enum": [
              "task",
              "session"
            ],
            "description": "Stop the task or the whole session."
          }
        },
        "additionalProperties": false,
        "required": [
          "sessionId"
        ]
      },
      "outputSchema": {
        "type": "object",
