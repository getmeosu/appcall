    "sessions.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create session",
      "description": "Create a Browser Use Cloud v3 session and optionally dispatch a task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1,
            "description": "Natural-language instruction for the agent."
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "description": "Existing idle session ID."
          },
          "keepAlive": {
            "type": "boolean",
            "description": "Keep the session idle after the task."
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "description": "Browser profile ID."
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace ID."
          },
          "proxyCountryCode": {
            "type": "string",
            "minLength": 1,
            "description": "Proxy country code."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/sessions",
        "success": [
          200,
          201
        ],
        "body": {
          "task": "{{task}}",
          "sessionId": "{{sessionId}}",
          "keepAlive": "{{keepAlive}}",
          "profileId": "{{profileId}}",
          "workspaceId": "{{workspaceId}}",
          "proxyCountryCode": "{{proxyCountryCode}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "sessions.stop": {
      "kind": "action",
