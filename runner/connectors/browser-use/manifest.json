{
  "key": "browser-use",
  "name": "Browser Use",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Browser Use API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.browser-use.com"
    ]
  },
  "models": [
    "account",
    "session",
    "browser",
    "profile",
    "workspace"
  ],
  "http": {
    "baseUrl": "https://api.browser-use.com/api/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Browser-Use-API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "detail.0.msg",
        "message",
        "error"
      ]
    }
  },
  "operations": {
