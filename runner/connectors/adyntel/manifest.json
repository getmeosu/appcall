        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "keyword": "{{keyword}}",
          "country_code": "{{countryCode}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "google.shopping.start": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 60000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Start Google Shopping Search",
      "description": "Start an asynchronous Google Shopping ads search for a company domain from POST /google_shopping. Use the returned id with google.shopping.status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Company website domain in company.com form, with no https:// or www. prefix."
          }
        },
        "additionalProperties": false,
        "required": [
          "companyDomain"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/google_shopping",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "company_domain": "{{companyDomain}}"
        },
        "success": [
          200,
          202
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
