{
  "key": "adyntel",
  "name": "Adyntel",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ads"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Adyntel API key",
          "required": true,
          "secret": true
        },
        {
          "key": "email",
          "label": "Adyntel account email",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.adyntel.com"
    ]
  },
  "models": [
    "google-ad",
    "shopping-job",
    "linkedin-ad",
    "meta-ad",
    "keyword-overview",
    "tiktok-ad"
  ],
  "http": {
    "baseUrl": "https://api.adyntel.com",
    "auth": {
      "field": "apiKey"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "detail",
        "error"
      ]
    }
  },
  "operations": {
    "google.ads.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 90000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get Google Ads By Company",
      "description": "Retrieve Google ads for a company domain from POST /google. A call returns one page; total_ad_count can exceed the ads array.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Company website domain in company.com form, with no https:// or www. prefix."
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "video"
            ],
            "description": "Filter results by creative format. Omit for the provider default."
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 16,
            "description": "ISO 3166-1 alpha-2 country code, or anywhere. Send the same code again when paginating."
          },
          "continuationToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Token from the previous response used to fetch the next page of ads."
          }
        },
        "additionalProperties": false,
        "required": [
          "companyDomain"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/google",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "company_domain": "{{companyDomain}}",
          "media_type": "{{mediaType}}",
          "country_code": "{{countryCode}}",
          "continuation_token": "{{continuationToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "google.shopping.status": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get Google Shopping Search Status",
      "description": "Check a Google Shopping search started by POST /google_shopping. Status checks are not charged. HTTP 202 means the job is still running.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Job identifier returned by the Google Shopping start call."
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/google_shopping_status",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "id": "{{id}}"
        },
        "success": [
          200,
          202
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "linkedin.ads.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 90000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get LinkedIn Ads By Company",
      "description": "Retrieve LinkedIn ads for a company domain or LinkedIn page id from POST /linkedin.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Company website domain in company.com form. Either companyDomain or linkedinPageId is required."
          },
          "linkedinPageId": {
            "description": "LinkedIn Page numeric identifier. Either companyDomain or linkedinPageId is required.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            ]
          },
          "continuationToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Token from the previous response used to fetch the next page of ads."
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "companyDomain"
            ]
          },
          {
            "required": [
              "linkedinPageId"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/linkedin",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "company_domain": "{{companyDomain}}",
          "linkedin_page_id": "{{linkedinPageId}}",
          "continuation_token": "{{continuationToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "meta.ads.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 90000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get Meta Ads By Company Or Page",
      "description": "Retrieve Meta ads for a company domain or Facebook page URL from POST /facebook.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Company website domain in company.com form. Either companyDomain or facebookUrl is required."
          },
          "facebookUrl": {
            "type": "string",
            "minLength": 12,
            "maxLength": 2048,
            "description": "Facebook page URL. Must start with https://. Either facebookUrl or companyDomain is required."
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image",
              "meme",
              "image_and_meme",
              "video"
            ],
            "description": "Filter results by media format."
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8,
            "description": "Two-letter ISO country code. One country per synchronous call."
          },
          "activeStatus": {
            "type": "string",
            "enum": [
              "inactive",
              "all"
            ],
            "description": "Filter by campaign status. Omit to receive active ads only."
          },
          "continuationToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Token from the previous response used to fetch the next set of ads."
          },
          "webhookUrl": {
            "type": "string",
            "minLength": 12,
            "maxLength": 2048,
            "description": "HTTPS endpoint that should receive the ads. The call still returns JSON."
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "companyDomain"
            ]
          },
          {
            "required": [
              "facebookUrl"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/facebook",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "company_domain": "{{companyDomain}}",
          "facebook_url": "{{facebookUrl}}",
          "media_type": "{{mediaType}}",
          "country_code": "{{countryCode}}",
          "active_status": "{{activeStatus}}",
          "continuation_token": "{{continuationToken}}",
          "webhook_url": "{{webhookUrl}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "keywords.paid-vs-organic": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 90000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get Paid Vs Organic Keywords",
      "description": "Compare paid and organic keyword estimates for a company domain from POST /domain-keywords.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyDomain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Company website domain in company.com form, with no https:// or www. prefix."
          }
        },
        "additionalProperties": false,
        "required": [
          "companyDomain"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/domain-keywords",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "company_domain": "{{companyDomain}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "meta.ads.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 90000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Search Meta Ads",
      "description": "Search the Meta ad library by keyword from POST /facebook_ad_search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Keyword to search for in the Meta ad library."
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8,
            "description": "ISO 3166-1 alpha-2 country code. Omit for an unfiltered search."
          },
          "continuationToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Token from continuation_token when is_result_complete is false."
          }
        },
        "additionalProperties": false,
        "required": [
          "keyword"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/facebook_ad_search",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "api_key": "{{apiKey}}",
          "email": "{{email}}",
          "keyword": "{{keyword}}",
          "country_code": "{{countryCode}}",
          "continuation_token": "{{continuationToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tiktok.ads.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 90000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Search TikTok Ads By Keyword",
      "description": "Search the TikTok ad library by keyword from POST /tiktok_search. US is not a documented country filter.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Search query used to find TikTok ads."
          },
          "countryCode": {
            "type": "string",
            "enum": [
              "AT",
              "BE",
              "BG",
              "CH",
              "CY",
              "CZ",
              "DE",
              "DK",
              "EE",
              "ES",
              "FI",
              "FR",
              "GB",
              "GR",
              "HR",
              "HU",
              "IE",
              "IS",
              "IT",
              "LI",
              "LT",
              "LU",
              "LV",
              "MT",
              "NL",
              "NO",
              "PL",
              "PT",
              "RO",
              "SE",
              "SI",
              "SK",
              "ALL",
              "at",
              "be",
              "bg",
              "ch",
              "cy",
              "cz",
              "de",
              "dk",
              "ee",
              "es",
              "fi",
              "fr",
              "gb",
              "gr",
