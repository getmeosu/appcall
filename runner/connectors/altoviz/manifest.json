{
  "key": "altoviz",
  "name": "Altoviz",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "accounting"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Altoviz API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.altoviz.com"
    ]
  },
  "models": [
    "customer",
    "product",
    "invoice",
    "quote",
    "contact",
    "supplier"
  ],
  "http": {
    "baseUrl": "https://api.altoviz.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "errors"
      ]
    }
  },
