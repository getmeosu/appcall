{
  "key": "resend",
  "name": "Resend",
  "version": "0.3.0",
  "runtime": "bun",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [],
      "routes": [
        {
          "id": "api_key",
          "label": "API Key",
          "fields": [
            {
              "key": "apiKey",
              "label": "API Key",
              "required": true,
              "secret": true
            }
          ]
        },
        {
          "id": "smtp",
          "label": "SMTP relay",
          "fields": [
            {
              "key": "smtpHost",
              "label": "SMTP host (e.g. smtp.resend.com)",
              "required": true,
              "secret": false
            },
            {
              "key": "smtpPort",
              "label": "Port (587 or 465)",
              "required": true,
              "secret": false
            },
            {
              "key": "smtpUser",
              "label": "SMTP login (usually 'resend')",
              "required": true,
              "secret": false
            },
            {
              "key": "smtpPassword",
              "label": "SMTP password / API key",
              "required": true,
              "secret": true
            }
          ]
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.resend.com",
      "smtp.resend.com"
    ]
  },
  "operations": {
    "emails.send": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 65536,
      "title": "Send Email",
      "description": "Send a transactional email via the Resend API (POST /emails). Supports plain text and/or HTML bodies and optional reply-to, cc, and bcc addresses.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Sender address, e.g. \"Acme <onboarding@resend.dev>\". Required."
          },
          "to": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Recipient address or list of recipient addresses. Required."
          },
          "subject": {
            "type": "string",
            "description": "Email subject line. Required."
          },
          "html": {
            "type": "string",
            "description": "HTML body of the email."
          },
          "text": {
            "type": "string",
            "description": "Plain text body of the email."
          },
          "replyTo": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Reply-to address or list of addresses."
          },
          "cc": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "CC address or list of addresses."
          },
          "bcc": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "BCC address or list of addresses."
          }
        },
        "required": [
          "from",
          "to",
          "subject"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "ID of the email returned by Resend."
          }
        }
      }
    },
    "emails.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Email",
      "description": "Retrieve a sent email by ID via GET /emails/{id}, including last_event delivery status.",
      "sideEffect": "read",
      "sample": {
        "id": "4ef9a417-02e9-4d39-ad75-9611e0fcc33c"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Resend email ID returned by emails.send."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "email": {
            "type": "object",
            "description": "Normalized sent email including lastEvent."
          }
        }
      }
    },
    "emails.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Emails",
      "description": "List sent emails via GET /emails with optional cursor pagination (limit, after, before).",
      "sideEffect": "read",
      "sample": {
        "limit": 20
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Optional page size (1-100). Default 20 on the provider."
          },
          "after": {
            "type": "string",
            "description": "Optional cursor: return the page after this email ID."
          },
          "before": {
            "type": "string",
            "description": "Optional cursor: return the page before this email ID."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "emails": {
            "type": "array",
            "description": "Normalized sent emails."
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    },
    "domains.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "List Domains",
      "description": "List sending domains via GET /domains with optional cursor pagination (limit, after, before).",
      "sideEffect": "read",
      "sample": {
        "limit": 20
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Optional page size (1-100)."
          },
          "after": {
            "type": "string",
            "description": "Optional cursor: return the page after this domain ID."
          },
          "before": {
            "type": "string",
            "description": "Optional cursor: return the page before this domain ID."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "description": "Normalized sending domains."
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    },
    "domains.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Domain",
      "description": "Retrieve a sending domain by ID via GET /domains/{id}, including DNS records and verification status.",
      "sideEffect": "read",
      "sample": {
        "id": "d91cd9bd-1176-453e-8fc1-35364d380206"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Resend domain ID returned by domains.list."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "domain": {
            "type": "object",
            "description": "Normalized domain including DNS records and status."
          }
        }
      }
    },
    "contacts.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Contacts",
      "description": "List contacts via GET /contacts with optional cursor pagination (limit, after, before).",
      "sideEffect": "read",
      "sample": {
        "limit": 20
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Optional page size (1-100). Default 20 on the provider."
          },
          "after": {
            "type": "string",
            "description": "Optional cursor: return the page after this contact ID."
          },
          "before": {
            "type": "string",
            "description": "Optional cursor: return the page before this contact ID."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "contacts": {
            "type": "array",
            "description": "Normalized contacts."
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Resend connector. Takes no input and returns the connector health status.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    }
  },
  "models": [
    "email",
    "domain",
    "contact"
  ]
}
