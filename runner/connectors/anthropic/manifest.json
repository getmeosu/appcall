                "custom_id",
                "params"
              ],
              "properties": {
                "custom_id": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model",
                    "max_tokens",
                    "messages"
                  ],
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "max_tokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "messages": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "role",
                          "content"
                        ],
                        "properties": {
                          "role": {
                            "type": "string",
                            "enum": [
                              "user",
                              "assistant"
                            ]
                          },
                          "content": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "requests"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/messages/batches",
        "success": [
          200
        ],
        "body": {
          "requests": "{{requests}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
