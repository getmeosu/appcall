{
  "key": "buttondown",
  "name": "Buttondown",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Buttondown API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.buttondown.com"
    ]
  },
  "models": [
    "account",
    "newsletter",
    "subscriber",
    "tag",
    "email",
    "comment",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.buttondown.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Token {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "error",
        "message"
      ]
    }
  },
