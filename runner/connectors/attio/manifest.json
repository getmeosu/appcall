    "attributes.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Attributes",
      "description": "List attributes for an Attio object or list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "objects",
              "lists"
            ]
          },
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "showArchived": {
            "type": "boolean"
          }
        },
        "required": [
          "target",
          "identifier"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "attributes"
        ],
        "properties": {
          "attributes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pagination": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/{{target}}/{{identifier}}/attributes",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}",
          "show_archived": "{{showArchived}}"
        },
        "success": [
          200
        ],
        "result": {
          "attributes": "{{response.data}}",
          "pagination": "{{response.pagination}}"
        }
      },
      "enforceOutputSchema": true
    },
