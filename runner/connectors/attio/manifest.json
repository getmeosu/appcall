            }
          },
          "pagination": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/v2/objects/{{object}}/records/query",
        "body": {
          "filter": "{{filter}}",
          "filter_view_id": "{{filterViewId}}",
          "sorts": "{{sorts}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        },
        "success": [
