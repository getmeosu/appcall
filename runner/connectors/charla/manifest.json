    "kb.articles.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 5242880,
      "maxResponseBytes": 5242880,
      "title": "Create Knowledge Base Article",
      "description": "Create a knowledge base article with POST /kb/articles. Charla generates the URL slug from the title and may train the chatbot from the article. status and visibility are required by the API. contentHtml is stored in the JSON field article.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "Article title. Omit when Charla should store an untitled article."
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Published"
            ],
            "description": "Publication status. Charla requires this value on save. Draft is the safer choice."
          },
          "visibility": {
            "type": "string",
            "enum": [
              "Private",
              "Public"
            ],
            "description": "Article visibility. Charla requires this value on save. Private is the safer choice."
          },
          "description": {
            "type": "string",
            "description": "Short article summary."
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "description": "Category set Composio calls category_ids. Each entry is {id} because Charla rejects a bare integer array.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647,
                  "description": "Existing knowledge base category id."
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "contentHtml": {
            "type": "string",
            "description": "Article body HTML. Composio calls this content_html. Sent as the JSON field article."
          }
        },
        "required": [
          "categories",
          "status",
          "visibility"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "slug": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "article": {
                "type": [
                  "string",
                  "null"
                ]
