  },
  "models": [
    "contact",
    "conversation",
    "kb-article",
    "kb-category"
  ],
  "http": {
    "baseUrl": "https://api.charla.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Api-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
