{
  "key": "productboard",
  "name": "Productboard",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accessToken",
          "label": "Productboard personal access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.productboard.com"
    ]
  },
  "models": [
    "entity",
    "note",
    "member",
    "team"
  ],
  "http": {
    "baseUrl": "https://api.productboard.com/v2",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors"
      ]
    }
  },
