{
  "key": "formbricks",
  "name": "Formbricks",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "forms"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Formbricks management API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "app.formbricks.com"
    ]
  },
  "models": [
    "organization",
    "contact-attribute-key",
    "survey",
    "response",
    "contact",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://app.formbricks.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "errorMessage"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
