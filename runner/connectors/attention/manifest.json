  "operations": {
    "conversations.get": {
      "description": "Get one Attention conversation by internal or external ID.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "enum": [
              "id",
              "external_id"
            ],
            "type": "string"
          },
          "detailedTranscript": {
            "type": "boolean"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/conversations/{{id}}",
        "query": {
          "by": "{{by}}",
          "detailedTranscript": "{{detailedTranscript}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get conversation",
      "validationMode": "strict-generated"
    },
    "conversations.list": {
      "description": "List Attention conversations with bounded pagination and title filter.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "detailedTranscript": {
            "type": "boolean"
          },
          "hideInternal": {
            "type": "boolean"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/conversations/list",
        "query": {
          "detailedTranscript": "{{detailedTranscript}}",
          "filter[hide_internal]": "{{hideInternal}}",
          "filter[title]": "{{title}}",
          "page": "{{page}}",
          "size": "{{size}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "List conversations",
      "validationMode": "strict-generated"
    },
