{
  "key": "greenhouse",
  "name": "Greenhouse",
  "version": "0.8.0",
  "runtime": "bun",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "clientId",
          "label": "OAuth client ID",
          "required": true,
          "secret": false
        },
        {
          "key": "clientSecret",
          "label": "OAuth client secret",
          "required": true,
          "secret": true
        },
        {
          "key": "userId",
          "label": "Harvest user id (OAuth sub / Site Admin)",
          "required": false,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "harvest.greenhouse.io",
      "boards-api.greenhouse.io",
      "auth.greenhouse.io"
    ]
  },
  "http": {
    "baseUrl": "https://harvest.greenhouse.io/v3",
    "auth": {
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "jobs.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List jobs",
      "description": "List public job postings via GET /v1/boards/{boardToken}/jobs."
    },
    "jobs.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get job",
      "description": "Fetch a single Harvest job via authenticated GET /v3/jobs/{id}. Distinct from boards jobs.list."
    },
    "candidates.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List candidates",
      "description": "List candidates via authenticated Harvest GET /v3/candidates. Optional perPage, page, createdBefore/After, updatedBefore/After, jobId, email, and candidateIds filters."
    },
    "candidates.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get candidate",
      "description": "Fetch a single candidate via authenticated Harvest GET /v3/candidates/{id}."
    },
    "applications.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List applications",
      "description": "List applications via authenticated Harvest GET /v3/applications. Optional perPage, page, createdBefore/After, lastActivityAfter, jobId, and status filters."
    },
    "applications.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get application",
      "description": "Fetch a single application via authenticated Harvest GET /v3/applications/{id}."
    },
    "applications.move": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "applications.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Move application",
      "description": "Move an application to another interview stage (or transfer to another job) via authenticated Harvest POST /v3/applications/{id}/move. Requires fromStageId matching the current stage. EffectPolicy Reconcile observes the post-move application via applications.get (move itself returns 204).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromStageId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Harvest application id."
          },
          "fromStageId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Current job interview stage id; must match the application's current stage."
          },
          "toStageId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Destination stage id within the same job."
          },
          "toJobId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Destination job id when transferring the application to another job."
          },
          "emailFromUserId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional user id used as the from address for stage-transition emails."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized application after reconcile via applications.get."
          }
        }
      }
    },
    "applications.create": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
      "reconcile": "applications.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create application",
      "description": "Create an application for an existing candidate via authenticated Harvest POST /v3/applications. Requires candidateId and jobId. EffectPolicy Idempotent observes the created application via applications.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "jobId"
        ],
        "properties": {
          "candidateId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Harvest candidate id to attach the application to."
          },
          "jobId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Harvest job id for the candidate application."
          },
          "initialStageId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional job interview stage id to place the application in."
          },
          "sourceId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional source id credited for this application."
          },
          "recruiterId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional recruiter user id."
          },
          "coordinatorId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional coordinator user id."
          },
          "referrerId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional referrer id."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized application after reconcile via applications.get."
          }
        }
      }
    },
    "users.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List users",
      "description": "List users via authenticated Harvest GET /v3/users. Optional perPage, page, email, employeeId, and created/updated before/after filters."
    },
    "interviews.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List interviews",
      "description": "List interviews via authenticated Harvest GET /v3/interviews (v1: scheduled_interviews). Optional perPage, page, applicationId, jobId, and created/updated before/after filters."
    },
    "job_interview_stages.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List job interview stages",
      "description": "List job interview stages via authenticated Harvest GET /v3/job_interview_stages. Optional perPage, jobIds, ids, and active filters. Supports move-stage workflows."
    },
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Mint an OAuth client-credentials token then GET /v3/users?per_page=1 (proves Bearer auth and optional Site Admin sub).",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": [
              "array",
              "object"
            ]
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated"
    },
    "candidates.create": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
      "reconcile": "candidates.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create candidate",
      "description": "Create a candidate via authenticated Harvest POST /v3/candidates. Requires firstName and lastName. Optional email maps to email_addresses; optional jobId attaches an application. EffectPolicy Idempotent observes via candidates.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Candidate first name."
          },
          "lastName": {
            "type": "string",
            "description": "Candidate last name."
          },
          "company": {
            "type": "string",
            "description": "Current or most recent company."
          },
          "title": {
            "type": "string",
            "description": "Current or most recent title."
          },
          "email": {
            "type": "string",
            "description": "Primary personal email; sent as Harvest email_addresses[0]."
          },
          "phone": {
            "type": "string",
            "description": "Primary mobile phone; sent as Harvest phone_numbers[0]."
          },
          "jobId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional Harvest job id; sent as applications[0].job_id."
          }
        },
        "required": [
          "firstName",
          "lastName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate"
        ],
        "properties": {
          "candidate": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized candidate after EffectPolicy Idempotent via candidates.get."
          }
        }
      }
    },
    "candidates.update": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "candidates.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update candidate",
      "description": "Update a candidate via authenticated Harvest PATCH /v3/candidates/{id}. EffectPolicy Reconcile observes via candidates.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Harvest candidate id."
          },
          "firstName": {
            "type": "string",
            "description": "Candidate first name."
          },
          "lastName": {
            "type": "string",
            "description": "Candidate last name."
          },
          "company": {
            "type": "string",
            "description": "Current or most recent company."
          },
          "title": {
            "type": "string",
            "description": "Current or most recent title."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate"
        ],
        "properties": {
          "candidate": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized candidate after EffectPolicy Reconcile via candidates.get."
          }
        }
      }
    },
    "offers.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List offers",
      "description": "List offers via authenticated Harvest GET /v3/offers. Optional perPage, page, jobId, applicationId, and status filters."
    },
    "offers.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get offer",
      "description": "Fetch a single offer via authenticated Harvest GET /v3/offers/{id}."
    },
    "scorecards.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List scorecards",
      "description": "List interview scorecards via authenticated Harvest GET /v3/scorecards. Optional perPage, page, applicationId, and jobId filters."
    },
    "scorecards.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get scorecard",
      "description": "Fetch a single scorecard via authenticated Harvest GET /v3/scorecards/{id}."
    },
    "departments.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List departments",
