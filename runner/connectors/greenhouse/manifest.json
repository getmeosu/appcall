    },
    "sources.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List sources",
      "description": "List candidate sources via authenticated Harvest GET /v3/sources."
    },
    "close_reasons.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List close reasons",
      "description": "List application close reasons via authenticated Harvest GET /v3/close_reasons."
    },
    "users.get": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get user",
      "description": "Fetch a single user via authenticated Harvest GET /v3/users/{id}."
    },
    "applications.reject": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Reconcile",
      "reconcile": "applications.get",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Reject application",
      "description": "Reject an application (POST /v3/applications/{id}/reject). rejectionReasonId is required on Harvest v3.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Harvest application id."
          },
          "rejectionReasonId": {
            "type": [
              "string",
              "number"
            ],
            "description": "Required Harvest rejection reason id (v3)."
          },
          "notes": {
            "type": "string",
            "description": "Optional private rejection notes."
          },
          "rejectionEmail": {
            "type": "object",
            "description": "Optional rejection email payload."
          }
        },
        "required": [
          "id",
          "rejectionReasonId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized application after EffectPolicy Reconcile via applications.get."
          }
        }
      }
    },
    "applications.hire": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Hire application",
      "description": "Mark an application as hired via POST /v3/applications/{id}/hire (204). EffectPolicy Reconcile observes via applications.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Harvest application id."
          },
          "startDate": {
            "type": "string",
            "description": "Optional start date (ISO)."
          },
          "openingId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional opening id to close."
          },
          "closeReasonId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional close reason id."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "effectPolicy": "Reconcile",
      "reconcile": "applications.get"
    },
    "applications.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update application",
      "description": "Patch application attribution/metadata via PATCH /v3/applications/{id}. EffectPolicy Reconcile observes via applications.get.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
