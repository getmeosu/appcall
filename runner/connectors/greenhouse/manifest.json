          },
          "customFields": {
            "type": "object",
            "description": "Optional custom fields map."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application"
        ],
        "properties": {
          "application": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "effectPolicy": "Reconcile",
      "reconcile": "applications.get"
    },
    "application_stages.list": {
