    "notes.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create note",
      "description": "Create a candidate note/email/activity via POST /v3/notes. Visibility create enums: admin_only|private|public. Effect keys omitted (no note.get).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Candidate id."
          },
          "body": {
            "type": "string",
            "description": "Note body."
          },
          "visibility": {
            "type": "string",
            "enum": [
              "admin_only",
              "private",
              "public"
            ],
            "description": "Create-time visibility."
          },
          "noteType": {
            "type": "string",
            "enum": [
              "NOTE",
              "EMAIL",
              "ACTIVITY"
            ],
            "description": "Note classification."
          },
          "applicationId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional application id."
          },
          "subject": {
            "type": "string",
            "description": "Subject (required for EMAIL)."
          },
          "userId": {
            "type": [
