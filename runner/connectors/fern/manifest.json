      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/customers",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "customerType": "{{customerType}}",
          "email": "{{email}}",
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "businessName": "{{businessName}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
