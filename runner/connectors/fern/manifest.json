{
  "key": "fern",
  "name": "Fern",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "payments"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Fern API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.fernhq.com"
    ]
  },
  "models": [
    "customer",
    "payment-account",
    "transaction",
    "quote",
    "automation-rule"
  ],
  "http": {
    "baseUrl": "https://api.fernhq.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate a Fern API key by listing one customer page.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated",
      "request": {
        "method": "GET",
        "path": "/customers",
        "query": {
          "pageSize": "1"
        },
        "success": [
          200
        ]
      }
    },
