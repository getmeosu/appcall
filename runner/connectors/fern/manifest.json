      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "write",
      "title": "Update customer",
      "description": "Patch Fern customer KYC fields before or during verification.",
