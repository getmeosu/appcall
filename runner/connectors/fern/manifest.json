    "customers.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create customer",
      "description": "Create a Fern individual or business customer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerType": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "BUSINESS"
            ],
            "description": "Customer type."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Customer email."
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "description": "First name for an individual customer."
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "description": "Last name for an individual customer."
          },
          "businessName": {
            "type": "string",
            "minLength": 1,
            "description": "Business name for a business customer."
          }
        },
        "additionalProperties": false,
        "required": [
          "customerType",
          "email"
