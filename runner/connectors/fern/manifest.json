          "lastName": {
            "type": "string",
            "minLength": 1,
            "description": "Updated last name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Updated email."
          }
        },
        "additionalProperties": false,
        "required": [
          "customerId"
        ]
      },
      "outputSchema": {
        "type": "object",
