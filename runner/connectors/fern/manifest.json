        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/customers/{{customerId}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "email": "{{email}}"
