      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "sessions.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create session",
      "description": "Create a Browserbase cloud browser session. projectId is taken from the stored connection when omitted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keepAlive": {
            "type": "boolean",
            "description": "Keep the session alive after disconnects."
          },
          "region": {
            "type": "string",
            "enum": [
              "us-west-2",
              "us-east-1",
              "eu-central-1",
              "ap-southeast-1"
            ],
            "description": "Browser region."
          },
          "timeout": {
            "type": "integer",
            "minimum": 60,
            "maximum": 21600,
            "description": "Session timeout in seconds."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/sessions",
        "success": [
          201,
          200
        ],
        "body": {
          "projectId": "{{projectId}}",
          "keepAlive": "{{keepAlive}}",
          "region": "{{region}}",
          "timeout": "{{timeout}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "sessions.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update session",
      "description": "Request that a Browserbase session complete by setting status to REQUEST_RELEASE.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Resource identifier."
          },
          "status": {
            "type": "string",
            "enum": [
              "REQUEST_RELEASE"
            ],
            "description": "Set REQUEST_RELEASE to close the session."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
