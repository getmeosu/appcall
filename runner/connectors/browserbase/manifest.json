      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create webhook",
      "description": "Register an HTTPS Browserbase webhook endpoint. The signing secret is returned only on create.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "description": "HTTPS receiver URL."
          },
          "eventTypes": {
            "type": "array",
            "minItems": 1,
            "description": "Event types to subscribe to.",
            "items": {
              "type": "string",
              "enum": [
                "functions.builds.running",
                "functions.builds.completed",
                "functions.builds.failed",
                "functions.invocations.pending",
                "functions.invocations.running",
                "functions.invocations.completed",
                "functions.invocations.failed"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "endpoint",
          "eventTypes"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/webhooks",
        "success": [
          201,
          200
        ],
        "body": {
          "endpoint": "{{endpoint}}",
          "eventTypes": "{{eventTypes}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
