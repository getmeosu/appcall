    "sessions.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List sessions",
      "description": "List Browserbase sessions with optional status or metadata query filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "User-metadata query."
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "ERROR",
              "TIMED_OUT",
              "COMPLETED"
            ],
            "description": "Session status filter."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/sessions",
        "success": [
          200
        ],
        "query": {
          "q": "{{q}}",
          "status": "{{status}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "sessions.get": {
      "kind": "action",
