    "monitors.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create monitor",
      "description": "Create an UptimeRobot monitor via POST /newMonitor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "friendly_name": {
            "type": "string",
            "description": "Display name.",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "description": "URL or IP to monitor.",
            "minLength": 1
          },
          "type": {
            "type": "integer",
            "description": "Monitor type: 1=HTTP, 2=keyword, 3=ping, 4=port, 5=heartbeat."
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "description": "Check interval in seconds."
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "Timeout in seconds."
          },
          "keyword_type": {
            "type": "integer",
            "description": "Keyword type: 1=exists, 2=not exists."
          },
          "keyword_value": {
            "type": "string",
            "description": "Keyword to match.",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "description": "Port for type=4 monitors."
          },
          "subtype": {
            "type": "integer",
            "description": "Port subtype."
          },
          "alert_contacts": {
            "type": "string",
            "description": "Dash-separated alert contact IDs.",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "friendly_name",
          "url",
          "type"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/newMonitor",
        "success": [
          200
        ],
        "body": {
          "api_key": "{{apiKey}}",
          "format": "json",
          "friendly_name": "{{friendly_name}}",
          "url": "{{url}}",
          "type": "{{type}}",
          "interval": "{{interval}}",
          "timeout": "{{timeout}}",
          "keyword_type": "{{keyword_type}}",
          "keyword_value": "{{keyword_value}}",
          "port": "{{port}}",
          "subtype": "{{subtype}}",
          "alert_contacts": "{{alert_contacts}}"
        },
        "bodyEncoding": "form"
