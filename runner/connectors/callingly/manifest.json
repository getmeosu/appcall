            "description": "Agency client account ID.",
            "minimum": 1
          },
          "call_mode": {
            "type": "string",
            "description": "Call routing mode.",
            "enum": [
              "simultaneous",
              "round_robin"
            ]
          },
          "is_record": {
            "type": "integer",
            "description": "Whether calls are recorded (0 or 1)."
          },
          "language": {
            "type": "string",
            "description": "Whisper language code."
          }
        },
        "additionalProperties": false,
