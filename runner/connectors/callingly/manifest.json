        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/teams",
        "success": [
          200,
          201
        ],
        "body": {
          "name": "{{name}}",
          "account_id": "{{account_id}}",
          "call_mode": "{{call_mode}}",
          "is_record": "{{is_record}}",
          "language": "{{language}}"
        },
        "headers": {
