    "teams.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create team",
      "description": "Create a Callingly team with routing and retry settings.",
      "inputSchema": {
        "type": "object",
