            "enum": [
              "INVESTIGATING",
              "IDENTIFIED",
              "MONITORING",
              "RESOLVED"
            ]
          },
          "notify": {
            "type": "boolean",
            "description": "Notify subscribers."
          },
          "started": {
            "type": "string",
            "minLength": 1,
            "description": "Incident start time (ISO-8601)."
