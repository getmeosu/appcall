{
  "key": "new-relic",
  "name": "New Relic",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "New Relic user key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.newrelic.com"
    ]
  },
  "models": [
    "user",
    "alert-policy",
    "application",
    "alert-condition"
  ],
  "http": {
    "baseUrl": "https://api.newrelic.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Api-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "errors.0.message"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Validate New Relic user key with the read-only alerts policies endpoint.",
      "description": "Validate New Relic user key with the read-only alerts policies endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/alerts_policies.json",
        "success": [
          200
        ]
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "alert-policies.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List New Relic alert policies.",
      "description": "List New Relic alert policies.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/alerts_policies.json",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "filter[name]": "{{name}}"
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "applications.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List New Relic APM applications.",
      "description": "List New Relic APM applications via REST v2.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/applications.json",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "filter[name]": "{{name}}"
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "nrql.query": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Execute a NRQL query via NerdGraph.",
      "description": "Run a NRQL query against a New Relic account using NerdGraph POST /graphql.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "minimum": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "accountId",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/graphql",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "query": "query ($accountId: Int!, $query: Nrql!) { actor { account(id: $accountId) { nrql(query: $query) { results } } } }",
          "variables": {
            "accountId": "{{accountId}}",
            "query": "{{query}}"
          }
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "alert-conditions.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List New Relic alert conditions for a policy.",
      "description": "List APM/browser/mobile alert conditions under an alert policy via REST v2.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "policyId": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "policyId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v2/alerts_conditions.json",
        "success": [
          200
        ],
        "query": {
          "policy_id": "{{policyId}}",
          "page": "{{page}}"
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    }
  },
  "provenance": {
    "source": {
