{
  "key": "new-relic",
  "name": "New Relic",
  "version": "0.3.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "New Relic user key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.newrelic.com"
    ]
  },
  "models": [
    "user",
    "alert-policy",
    "application",
    "alert-condition",
    "server",
    "deployment",
    "incident",
    "host",
    "label"
  ],
  "http": {
    "baseUrl": "https://api.newrelic.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Api-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "errors.0.message"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
