    "nrql.query": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Execute a NRQL query via NerdGraph.",
      "description": "Run a NRQL query against a New Relic account using NerdGraph POST /graphql.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "accountId",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/graphql",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "query": "query ($accountId: Int!, $query: Nrql!) { actor { account(id: $accountId) { nrql(query: $query) { results } } } }",
          "variables": {
            "accountId": "{{accountId}}",
            "query": "{{query}}"
          }
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
