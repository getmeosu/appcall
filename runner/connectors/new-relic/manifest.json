    "deployments.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Record deployment",
      "description": "Record a deployment against a New Relic APM application via REST v2. revision is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "integer",
            "minimum": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "description": "Deployment revision, typically a git SHA or version."
          },
          "changelog": {
            "type": "string",
            "minLength": 1,
            "description": "Optional changelog summary."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Optional deployment description."
          },
          "user": {
            "type": "string",
            "minLength": 1,
            "description": "Optional user who recorded the deployment."
          }
        },
        "required": [
          "applicationId",
          "revision"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v2/applications/{{applicationId}}/deployments.json",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "deployment": {
