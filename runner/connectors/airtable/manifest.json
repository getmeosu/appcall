      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 7864320,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Upload Attachment",
      "description": "Upload a file (up to 5 MB) directly into an Airtable attachment field via the content API and return the updated record.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "baseId": {
