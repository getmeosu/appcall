{
  "key": "clickup",
  "name": "ClickUp",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": ["productivity"],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Personal API token (starts with pk_)",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": ["api.clickup.com"]
  },
  "http": {
    "baseUrl": "https://api.clickup.com/api",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [429],
      "retryAfterHeader": "x-ratelimit-reset",
      "retryAfterKind": "unix",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": ["err", "ECODE"]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the ClickUp personal API token by calling GET /v2/user. Takes no input and returns the connector health status with the authenticated user's ID.",
      "inputSchema": { "type": "object", "properties": {} },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "userId": { "type": "number" }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/user",
        "success": [200],
        "echo": { "status": "ok" },
        "result": { "status": "ok", "userId": "{{response.user.id}}", "username": "{{response.user.username}}" }
      }
    },
    "workspaces.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "List Workspaces",
      "description": "List the ClickUp Workspaces (called Teams in the API) the token can access. Every other operation needs a workspace, space, folder, or list ID, so this is the entry point for discovering the hierarchy.",
      "inputSchema": { "type": "object", "properties": {} },
      "outputSchema": {
        "type": "object",
        "properties": { "workspaces": { "type": "array", "items": { "type": "object" } } }
      },
      "request": {
        "method": "GET",
        "path": "/v2/team",
        "success": [200],
        "result": { "workspaces": "{{response.teams}}" }
      }
    },
    "spaces.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "List Spaces",
      "description": "List the Spaces in a ClickUp Workspace. A Space is the top level of the hierarchy below the Workspace and contains Folders and Lists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "teamId": { "type": "string", "description": "Workspace (team) ID, from List Workspaces." },
          "archived": { "type": "boolean", "description": "Include archived Spaces. Defaults to false." }
        },
        "required": ["teamId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "spaces": { "type": "array", "items": { "type": "object" } } }
      },
      "request": {
        "method": "GET",
        "path": "/v2/team/{{teamId}}/space",
        "query": { "archived": "{{archived}}" },
        "success": [200],
        "result": { "spaces": "{{response.spaces}}" }
      }
    },
    "folders.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "List Folders",
      "description": "List the Folders in a ClickUp Space. Subfolders are returned in the same flat list, each carrying a parent_folder field naming the Folder it is nested inside.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": { "type": "string", "description": "Space ID, from List Spaces." },
          "archived": { "type": "boolean", "description": "Include archived Folders. Defaults to false." }
        },
        "required": ["spaceId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "folders": { "type": "array", "items": { "type": "object" } } }
      },
      "request": {
        "method": "GET",
        "path": "/v2/space/{{spaceId}}/folder",
        "query": { "archived": "{{archived}}" },
        "success": [200],
        "result": { "folders": "{{response.folders}}" }
      }
    },
    "lists.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "List Lists In Folder",
      "description": "List the ClickUp Lists inside a Folder. Lists that live directly in a Space rather than a Folder are returned by List Folderless Lists instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folderId": { "type": "string", "description": "Folder ID, from List Folders." },
          "archived": { "type": "boolean", "description": "Include archived Lists. Defaults to false." }
        },
        "required": ["folderId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "lists": { "type": "array", "items": { "type": "object" } } }
      },
      "request": {
        "method": "GET",
        "path": "/v2/folder/{{folderId}}/list",
        "query": { "archived": "{{archived}}" },
        "success": [200],
        "result": { "lists": "{{response.lists}}" }
      }
    },
    "lists.list-folderless": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "List Folderless Lists",
      "description": "List the ClickUp Lists that sit directly in a Space rather than inside a Folder. A Space's Lists are split across this operation and List Lists In Folder, so discovering every List in a Space needs both.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spaceId": { "type": "string", "description": "Space ID, from List Spaces." },
          "archived": { "type": "boolean", "description": "Include archived Lists. Defaults to false." }
        },
        "required": ["spaceId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "lists": { "type": "array", "items": { "type": "object" } } }
      },
      "request": {
        "method": "GET",
        "path": "/v2/space/{{spaceId}}/list",
        "query": { "archived": "{{archived}}" },
        "success": [200],
        "result": { "lists": "{{response.lists}}" }
      }
    },
    "lists.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Get List",
      "description": "Fetch one ClickUp List by ID, including its available statuses, assignee, and the Folder and Space it belongs to.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": { "type": "string", "description": "List ID." }
        },
        "required": ["listId"]
      },
      "outputSchema": { "type": "object", "properties": { "list": { "type": "object" } } },
      "request": {
        "method": "GET",
        "path": "/v2/list/{{listId}}",
        "success": [200],
        "result": { "list": "{{response}}" }
      }
    },
    "lists.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create List",
      "description": "Create a ClickUp List inside a Folder.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folderId": { "type": "string", "description": "Folder ID the List is created in." },
          "name": { "type": "string", "description": "List name." },
          "content": { "type": "string", "description": "List description." },
          "dueDate": { "type": "integer", "description": "Due date as a Unix timestamp in milliseconds." },
          "priority": { "type": "integer", "description": "Priority: 1 urgent, 2 high, 3 normal, 4 low." },
          "assignee": { "type": "integer", "description": "User ID to assign the List to." },
          "status": { "type": "string", "description": "List colour status." }
        },
        "required": ["folderId", "name"]
      },
      "outputSchema": { "type": "object", "properties": { "list": { "type": "object" } } },
      "sample": { "folderId": "457", "name": "Q4 Launch" },
      "request": {
        "method": "POST",
        "path": "/v2/folder/{{folderId}}/list",
        "body": {
          "name": "{{name}}",
          "content": "{{content}}",
          "due_date": "{{dueDate}}",
          "priority": "{{priority}}",
          "assignee": "{{assignee}}",
          "status": "{{status}}"
        },
        "success": [200],
        "result": { "list": "{{response}}" }
      }
    },
    "tasks.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "List Tasks In List",
      "description": "List the tasks whose home List is the given ClickUp List. Returns at most 100 tasks per page; read further pages with the page input. Closed tasks are excluded unless includeClosed is set.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": { "type": "string", "description": "List ID." },
          "page": { "type": "integer", "description": "Zero-based page number. 100 tasks per page." },
          "orderBy": {
            "type": "string",
            "enum": ["id", "created", "updated", "due_date"],
            "description": "Field to sort by. Defaults to created."
          },
          "reverse": { "type": "boolean", "description": "Reverse the sort order." },
          "subtasks": { "type": "boolean", "description": "Include subtasks." },
          "includeClosed": { "type": "boolean", "description": "Include closed tasks." },
          "archived": { "type": "boolean", "description": "Include archived tasks." },
          "statuses": { "type": "array", "items": { "type": "string" }, "description": "Only tasks in these statuses." },
          "assignees": { "type": "array", "items": { "type": "string" }, "description": "Only tasks assigned to these user IDs." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Only tasks carrying these tags." },
          "dueDateGt": { "type": "integer", "description": "Only tasks due after this Unix timestamp in milliseconds." },
          "dueDateLt": { "type": "integer", "description": "Only tasks due before this Unix timestamp in milliseconds." }
        },
        "required": ["listId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tasks": { "type": "array", "items": { "type": "object" } },
          "lastPage": { "type": "boolean" }
        }
      },
      "sample": { "listId": "901300000000", "includeClosed": false },
      "request": {
        "method": "GET",
        "path": "/v2/list/{{listId}}/task",
        "query": {
          "page": "{{page}}",
          "order_by": "{{orderBy}}",
          "reverse": "{{reverse}}",
          "subtasks": "{{subtasks}}",
          "include_closed": "{{includeClosed}}",
          "archived": "{{archived}}",
          "statuses": "{{statuses}}",
          "assignees": "{{assignees}}",
          "tags": "{{tags}}",
          "due_date_gt": "{{dueDateGt}}",
          "due_date_lt": "{{dueDateLt}}"
        },
        "success": [200],
        "result": { "tasks": "{{response.tasks}}", "lastPage": "{{response.last_page}}" }
      }
    },
    "tasks.search": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Search Workspace Tasks",
      "description": "Search tasks across an entire ClickUp Workspace, optionally narrowed to given Spaces, Folders, or Lists. Use this when the List is not known; use List Tasks In List when it is. Returns at most 100 tasks per page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "teamId": { "type": "string", "description": "Workspace (team) ID." },
          "page": { "type": "integer", "description": "Zero-based page number." },
          "orderBy": {
            "type": "string",
            "enum": ["id", "created", "updated", "due_date"],
            "description": "Field to sort by."
          },
          "reverse": { "type": "boolean", "description": "Reverse the sort order." },
          "subtasks": { "type": "boolean", "description": "Include subtasks." },
          "includeClosed": { "type": "boolean", "description": "Include closed tasks." },
          "spaceIds": { "type": "array", "items": { "type": "string" }, "description": "Restrict to these Space IDs." },
          "listIds": { "type": "array", "items": { "type": "string" }, "description": "Restrict to these List IDs." },
          "statuses": { "type": "array", "items": { "type": "string" }, "description": "Only tasks in these statuses." },
          "assignees": { "type": "array", "items": { "type": "string" }, "description": "Only tasks assigned to these user IDs." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Only tasks carrying these tags." },
          "dueDateGt": { "type": "integer", "description": "Only tasks due after this Unix timestamp in milliseconds." },
          "dueDateLt": { "type": "integer", "description": "Only tasks due before this Unix timestamp in milliseconds." }
        },
        "required": ["teamId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tasks": { "type": "array", "items": { "type": "object" } },
          "lastPage": { "type": "boolean" }
        }
      },
      "request": {
        "method": "GET",
        "path": "/v2/team/{{teamId}}/task",
        "query": {
          "page": "{{page}}",
          "order_by": "{{orderBy}}",
          "reverse": "{{reverse}}",
          "subtasks": "{{subtasks}}",
          "include_closed": "{{includeClosed}}",
          "space_ids[]": "{{spaceIds}}",
          "list_ids[]": "{{listIds}}",
          "statuses[]": "{{statuses}}",
          "assignees[]": "{{assignees}}",
          "tags[]": "{{tags}}",
          "due_date_gt": "{{dueDateGt}}",
          "due_date_lt": "{{dueDateLt}}"
        },
        "success": [200],
        "result": { "tasks": "{{response.tasks}}", "lastPage": "{{response.last_page}}" }
      }
    },
    "tasks.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Get Task",
      "description": "Fetch one ClickUp task by ID, including its status, assignees, custom fields, and the List, Folder, and Space it belongs to.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "Task ID, e.g. \"9hz\"." },
          "includeSubtasks": { "type": "boolean", "description": "Include the task's subtasks." },
          "includeMarkdownDescription": { "type": "boolean", "description": "Return the description as Markdown." },
          "customTaskIds": { "type": "boolean", "description": "Treat taskId as a custom task ID. Requires teamId." },
          "teamId": { "type": "string", "description": "Workspace ID. Required when customTaskIds is true." }
        },
        "required": ["taskId"]
      },
      "outputSchema": { "type": "object", "properties": { "task": { "type": "object" } } },
      "request": {
        "method": "GET",
        "path": "/v2/task/{{taskId}}",
        "query": {
          "include_subtasks": "{{includeSubtasks}}",
          "include_markdown_description": "{{includeMarkdownDescription}}",
          "custom_task_ids": "{{customTaskIds}}",
          "team_id": "{{teamId}}"
        },
        "success": [200],
        "result": { "task": "{{response}}" }
      }
    },
    "tasks.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create Task",
      "description": "Create a task in a ClickUp List. Only the name is required. Set parent to create a subtask of an existing task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": { "type": "string", "description": "List ID the task is created in." },
          "name": { "type": "string", "description": "Task name." },
          "description": { "type": "string", "description": "Plain-text task description." },
          "markdownContent": { "type": "string", "description": "Markdown task description. Takes precedence over description." },
          "status": { "type": "string", "description": "Status name, which must be one the List defines." },
          "priority": { "type": "integer", "enum": [1, 2, 3, 4], "description": "1 urgent, 2 high, 3 normal, 4 low." },
          "dueDate": { "type": "integer", "description": "Due date as a Unix timestamp in milliseconds." },
          "startDate": { "type": "integer", "description": "Start date as a Unix timestamp in milliseconds." },
          "timeEstimate": { "type": "integer", "description": "Time estimate in milliseconds." },
          "points": { "type": "number", "description": "Sprint points." },
          "assignees": { "type": "array", "items": { "type": "integer" }, "description": "User IDs to assign." },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Tag names to apply." },
          "parent": { "type": "string", "description": "Task ID this task becomes a subtask of." },
          "notifyAll": { "type": "boolean", "description": "Notify every assignee of the change." }
        },
        "required": ["listId", "name"]
      },
      "outputSchema": { "type": "object", "properties": { "task": { "type": "object" } } },
      "sample": { "listId": "901300000000", "name": "Write the launch post", "priority": 3 },
      "request": {
        "method": "POST",
        "path": "/v2/list/{{listId}}/task",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "markdown_content": "{{markdownContent}}",
          "status": "{{status}}",
          "priority": "{{priority}}",
          "due_date": "{{dueDate}}",
          "start_date": "{{startDate}}",
          "time_estimate": "{{timeEstimate}}",
          "points": "{{points}}",
          "assignees": "{{assignees}}",
          "tags": "{{tags}}",
          "parent": "{{parent}}",
          "notify_all": "{{notifyAll}}"
        },
        "success": [200],
        "result": { "task": "{{response}}" }
      }
    },
    "tasks.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Update Task",
      "description": "Update a ClickUp task. Only the fields supplied are changed; everything else is left alone. Changing assignees is not exposed here because ClickUp takes an add/remove pair for that field rather than a list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "Task ID to update." },
          "name": { "type": "string", "description": "New task name." },
          "description": { "type": "string", "description": "New plain-text description." },
          "markdownContent": { "type": "string", "description": "New Markdown description." },
          "status": { "type": "string", "description": "New status name, which must be one the List defines." },
          "priority": { "type": "integer", "enum": [1, 2, 3, 4], "description": "1 urgent, 2 high, 3 normal, 4 low." },
          "dueDate": { "type": "integer", "description": "Due date as a Unix timestamp in milliseconds." },
          "startDate": { "type": "integer", "description": "Start date as a Unix timestamp in milliseconds." },
          "timeEstimate": { "type": "integer", "description": "Time estimate in milliseconds." },
          "points": { "type": "number", "description": "Sprint points." },
          "parent": { "type": "string", "description": "Task ID to nest this task under." },
          "archived": { "type": "boolean", "description": "Archive or unarchive the task." }
        },
        "required": ["taskId"]
      },
      "outputSchema": { "type": "object", "properties": { "task": { "type": "object" } } },
      "request": {
        "method": "PUT",
        "path": "/v2/task/{{taskId}}",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "markdown_content": "{{markdownContent}}",
          "status": "{{status}}",
          "priority": "{{priority}}",
          "due_date": "{{dueDate}}",
          "start_date": "{{startDate}}",
          "time_estimate": "{{timeEstimate}}",
          "points": "{{points}}",
          "parent": "{{parent}}",
          "archived": "{{archived}}"
        },
        "success": [200],
        "result": { "task": "{{response}}" }
      }
    },
    "tasks.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Delete Task",
      "description": "Permanently delete a ClickUp task. The API returns no body on success.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "Task ID to delete." }
        },
        "required": ["taskId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "deleted": { "type": "boolean" }, "taskId": { "type": "string" } }
      },
      "request": {
        "method": "DELETE",
        "path": "/v2/task/{{taskId}}",
        "success": [200, 204],
        "result": { "deleted": true, "taskId": "{{input.taskId}}" }
      }
    },
    "comments.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "List Task Comments",
      "description": "List a ClickUp task's comments, newest first. Returns the 25 most recent by default; read older pages by passing the start and startId of the oldest comment in the current page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "Task ID." },
          "start": { "type": "integer", "description": "Date of the oldest comment in the current page, as a Unix timestamp in milliseconds. Must be sent with startId." },
          "startId": { "type": "string", "description": "ID of the oldest comment in the current page. Must be sent with start." }
        },
        "required": ["taskId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "comments": { "type": "array", "items": { "type": "object" } } }
      },
      "request": {
        "method": "GET",
        "path": "/v2/task/{{taskId}}/comment",
        "query": { "start": "{{start}}", "start_id": "{{startId}}" },
        "success": [200],
        "result": { "comments": "{{response.comments}}" }
      }
    },
    "comments.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create Task Comment",
      "description": "Post a comment on a ClickUp task. notifyAll is required by the API: set it false to comment without notifying every assignee.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": { "type": "string", "description": "Task ID to comment on." },
          "commentText": { "type": "string", "description": "Comment body." },
          "notifyAll": { "type": "boolean", "description": "Notify every assignee. Required by ClickUp; pass false for a quiet comment." },
          "assignee": { "type": "integer", "description": "User ID to assign the comment to." }
        },
        "required": ["taskId", "commentText", "notifyAll"]
      },
      "outputSchema": { "type": "object", "properties": { "comment": { "type": "object" } } },
      "sample": { "taskId": "9hz", "commentText": "Shipped, moving to review.", "notifyAll": false },
      "request": {
        "method": "POST",
        "path": "/v2/task/{{taskId}}/comment",
        "body": {
          "comment_text": "{{commentText}}",
          "notify_all": "{{notifyAll}}",
          "assignee": "{{assignee}}"
        },
        "success": [200],
        "result": { "comment": "{{response}}" }
      }
    },
    "time-entries.start": {
      "kind": "action",
      "timeoutMs": 10000,
