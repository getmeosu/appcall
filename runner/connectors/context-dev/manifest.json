          }
        ],
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "batches.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "List Batches",
      "description": "List asynchronous web batches from newest to oldest via GET /v1/batch/list.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum batches in this page, from 1 through 100.",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "description": "Opaque next_cursor from the previous page.",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "type": "string",
            "description": "Filter by batch lifecycle status.",
            "enum": [
              "queued",
              "running",
              "cancelling",
              "completed",
              "cancelled",
              "failed"
            ]
          },
          "query": {
            "type": "string",
            "description": "Search batch id, source URL or domain, and tags. Sent as the q query parameter.",
            "minLength": 1,
            "maxLength": 200
          },
          "searchType": {
            "type": "string",
            "description": "prefix matches as you type. exact matches full tokens.",
            "enum": [
              "prefix",
              "exact"
            ]
          },
          "tags": {
            "type": "array",
            "description": "Filter to batches that have any of these tags.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "Context.dev JSON object wrapped for the action result.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Context.dev."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/batch/list",
        "parameters": [
          {
            "wireName": "limit",
            "inputName": "limit",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "cursor",
            "inputName": "cursor",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "status",
            "inputName": "status",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "q",
            "inputName": "query",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "search_type",
            "inputName": "searchType",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "tags",
            "inputName": "tags",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          }
        ],
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "monitors.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "title": "List Monitors",
      "description": "List web monitors for the connected organization via GET /v1/monitors.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Free-text term matched against searchFields. Sent as the q query parameter.",
            "minLength": 1,
            "maxLength": 200
          },
          "searchFields": {
            "type": "array",
            "description": "Fields searched by query. Sent as search_by.",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "enum": [
                "name",
                "url",
                "instructions",
                "tags"
              ]
            }
          },
          "searchType": {
            "type": "string",
            "description": "prefix matches as you type. exact matches full tokens.",
            "enum": [
              "prefix",
              "exact"
            ]
          },
          "status": {
            "type": "string",
            "description": "Filter by monitor lifecycle status.",
            "enum": [
              "active",
              "paused",
              "failed"
            ]
          },
          "targetType": {
            "type": "string",
            "description": "Filter by monitor target type.",
            "enum": [
              "page",
              "sitemap",
              "extract"
            ]
          },
          "changeDetectionType": {
            "type": "string",
            "description": "Filter by change-detection strategy.",
            "enum": [
              "exact",
              "semantic"
            ]
          },
          "tags": {
            "type": "array",
            "description": "Filter to monitors that have any of these tags.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "tag": {
            "type": "string",
            "description": "Filter to monitors that have this one tag.",
            "minLength": 1,
            "maxLength": 50
          },
          "limit": {
            "type": "integer",
            "description": "Maximum monitors in this page, from 1 through 100.",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "description": "Opaque next_cursor from the previous page.",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "Context.dev JSON object wrapped for the action result.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Context.dev."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/monitors",
        "parameters": [
          {
            "wireName": "q",
            "inputName": "query",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "search_by",
            "inputName": "searchFields",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "search_type",
            "inputName": "searchType",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "status",
            "inputName": "status",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "target_type",
            "inputName": "targetType",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
