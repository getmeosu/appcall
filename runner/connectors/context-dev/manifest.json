              "disabled"
            ]
          },
          "timeoutOpts": {
            "type": "object",
            "additionalProperties": false,
            "description": "Scrape deadline. milliseconds is required when this object is set.",
            "required": [
              "milliseconds"
            ],
            "properties": {
              "milliseconds": {
                "type": "integer",
                "description": "Deadline in milliseconds, from 1 through 300000.",
                "minimum": 1,
                "maximum": 300000
              },
              "behavior": {
                "type": "string",
                "description": "fail rejects at the deadline. return-partial returns outputs that finished.",
                "enum": [
                  "fail",
                  "return-partial"
                ]
              }
            }
          },
          "tags": {
            "type": "array",
            "description": "Up to 20 usage tags, each 1-50 characters.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
