                "description": "Include image references in the Markdown."
              },
              "inlineImages": {
                "type": "string",
                "description": "How to represent inline images.",
                "enum": [
                  "placeholder",
                  "preserve"
                ]
              }
            }
          },
          "sharedParams": {
            "type": "object",
            "additionalProperties": false,
            "description": "Browser and content filters shared by the scrape.",
            "properties": {
              "country": {
                "type": "string",
                "description": "Two-letter proxy country code, such as US.",
                "minLength": 2,
                "maxLength": 2
              },
              "waitFor": {
                "type": "integer",
                "description": "Milliseconds to wait after page load, from 0 through 30000.",
                "minimum": 0,
                "maximum": 30000
              },
              "settleAnimations": {
                "type": "boolean",
                "description": "Wait briefly for CSS animations to settle."
              },
              "mainContentOnly": {
                "type": "boolean",
                "description": "Omit headers, footers, sidebars, and navigation."
              },
              "includeSelectors": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "description": "Keep only content matching these CSS selectors."
              },
              "excludeSelectors": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "description": "Remove content matching these CSS selectors."
              },
              "includeFrames": {
                "type": "boolean",
                "description": "Include rendered iframe content."
              }
            }
          },
          "maxAgeMs": {
            "type": "integer",
            "description": "Maximum cached result age in milliseconds. 0 forces a fresh scrape.",
