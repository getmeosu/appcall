{
  "key": "context-dev",
  "name": "Context.dev",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "developer-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "docsUrl": "https://docs.context.dev/account/api-keys",
      "fields": [
        {
          "key": "apiKey",
          "label": "Context.dev API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.context.dev"
    ]
  },
  "models": [
    "brand",
    "styleguide",
    "batch",
    "monitor",
    "extraction",
    "scrape"
  ],
  "http": {
    "baseUrl": "https://api.context.dev/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error_code"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "web.extract": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Extract Structured Web Data",
      "description": "Crawl from one public URL and return JSON matching the caller schema via POST /v1/web/extract.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "Starting HTTP or HTTPS URL to crawl.",
            "minLength": 1,
            "maxLength": 2048
          },
          "schema": {
            "type": "object",
            "minProperties": 1,
            "description": "JSON Schema for the object to extract. This is a schema, not an example."
          },
          "instructions": {
            "type": "string",
            "description": "Optional extraction guidance, up to 2000 characters.",
            "minLength": 1,
            "maxLength": 2000
          },
          "factCheck": {
            "type": "boolean",
            "description": "Require every returned value to be grounded in page content."
          },
          "followSubdomains": {
            "type": "boolean",
            "description": "Follow links on subdomains of the starting domain."
          },
          "maxPages": {
            "type": "integer",
            "description": "Maximum pages to analyze, from 1 through 50.",
            "minimum": 1,
            "maximum": 50
          },
          "maxDepth": {
            "type": "integer",
            "description": "Maximum link depth from the starting URL. 0 analyzes only the starting page.",
            "minimum": 0,
            "maximum": 50
          },
          "includeFrames": {
            "type": "boolean",
            "description": "Include rendered iframe content before extraction."
          },
          "maxAgeMs": {
            "type": "integer",
            "description": "Maximum cached scrape age in milliseconds, from 0 through 2592000000.",
            "minimum": 0,
            "maximum": 2592000000
          },
          "waitForMs": {
            "type": "integer",
            "description": "Milliseconds to wait after each page load, from 0 through 30000.",
            "minimum": 0,
            "maximum": 30000
          },
          "settleAnimations": {
            "type": "boolean",
            "description": "Wait briefly for CSS animations to settle before reading each page."
          },
          "stopAfterMs": {
            "type": "integer",
            "description": "Soft crawl time budget in milliseconds, from 10000 through 110000.",
            "minimum": 10000,
            "maximum": 110000
          },
          "zdr": {
            "type": "string",
            "description": "enabled requests zero data retention. The organization must have that feature turned on.",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "tags": {
            "type": "array",
            "description": "Up to 20 usage tags, each 1-50 characters.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        },
        "required": [
          "url",
          "schema"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "Context.dev JSON object wrapped for the action result.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Context.dev."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/web/extract",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "url": "{{url}}",
          "schema": "{{schema}}",
          "instructions": "{{instructions}}",
          "factCheck": "{{factCheck}}",
          "followSubdomains": "{{followSubdomains}}",
          "maxPages": "{{maxPages}}",
          "maxDepth": "{{maxDepth}}",
          "includeFrames": "{{includeFrames}}",
          "maxAgeMs": "{{maxAgeMs}}",
          "waitForMs": "{{waitForMs}}",
          "settleAnimations": "{{settleAnimations}}",
          "stopAfterMs": "{{stopAfterMs}}",
          "zdr": "{{zdr}}",
          "tags": "{{tags}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "brand.retrieve": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 131072,
      "maxResponseBytes": 2097152,
      "title": "Get Brand",
      "description": "Retrieve one brand profile with POST /v1/brand/retrieve. Set type and exactly one identifier: domain, name, email, ticker, directUrl, or transactionInfo.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "Lookup discriminator.",
            "enum": [
              "by_domain",
              "by_name",
              "by_email",
              "by_ticker",
              "by_direct_url",
              "by_transaction"
            ]
          },
          "domain": {
            "type": "string",
            "description": "Domain for by_domain, such as stripe.com.",
            "minLength": 1,
            "maxLength": 253
          },
          "name": {
            "type": "string",
            "description": "Company name for by_name.",
            "minLength": 1,
            "maxLength": 200
          },
          "countryGl": {
            "type": "string",
            "description": "Optional country hint for name or transaction lookup.",
            "minLength": 2,
            "maxLength": 2
          },
          "email": {
            "type": "string",
            "description": "Work email for by_email.",
            "minLength": 3,
            "maxLength": 320
          },
          "ticker": {
            "type": "string",
            "description": "Stock ticker for by_ticker.",
            "minLength": 1,
            "maxLength": 16
          },
          "tickerExchange": {
            "type": "string",
            "description": "Exchange for a ticker lookup. Omit to let Context.dev default to NASDAQ.",
            "minLength": 1,
            "maxLength": 32
          },
          "directUrl": {
            "type": "string",
            "description": "Exact HTTP or HTTPS page for by_direct_url.",
            "minLength": 1,
            "maxLength": 2048
          },
          "transactionInfo": {
            "type": "string",
            "description": "Card or bank descriptor for by_transaction.",
            "minLength": 3,
            "maxLength": 500
          },
          "city": {
            "type": "string",
            "description": "City hint for a transaction lookup.",
            "minLength": 1,
            "maxLength": 120
          },
          "mcc": {
            "description": "Merchant category code hint for a transaction lookup.",
            "type": [
              "string",
              "number"
            ]
          },
          "phone": {
            "description": "Phone hint for a transaction lookup.",
            "type": [
              "string",
              "number"
            ]
          },
          "highConfidenceOnly": {
            "type": "boolean",
            "description": "For a transaction lookup, require extra match verification."
          },
          "forceLanguage": {
            "type": "string",
            "description": "Provider language name for the profile text, such as english or french.",
            "minLength": 1,
            "maxLength": 40
          },
          "maxSpeed": {
            "type": "boolean",
            "description": "Prefer a faster, less complete profile. Not used for by_direct_url."
          },
          "maxAgeMs": {
            "type": "integer",
            "description": "Maximum cached brand age in milliseconds. The provider clamps this from one day to one year, and 0 refreshes.",
            "minimum": 0,
            "maximum": 31536000000
          },
          "timeoutOpts": {
            "type": "object",
            "additionalProperties": false,
            "description": "Provider deadline. milliseconds is required when this object is set.",
            "required": [
              "milliseconds"
            ],
            "properties": {
              "milliseconds": {
                "type": "integer",
                "description": "Deadline in milliseconds.",
                "minimum": 1000,
                "maximum": 300000
              },
              "behavior": {
                "type": "string",
                "description": "fail rejects at the deadline. return-partial returns what is ready.",
                "enum": [
                  "fail",
                  "return-partial"
                ]
              }
            }
          },
          "tags": {
            "type": "array",
            "description": "Up to 20 usage tags, each 1-50 characters.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        },
        "required": [
          "type"
        ],
        "oneOf": [
          {
            "required": [
              "domain"
            ]
          },
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "ticker"
            ]
          },
          {
            "required": [
              "directUrl"
            ]
          },
          {
            "required": [
              "transactionInfo"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "Context.dev JSON object wrapped for the action result.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Context.dev."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/brand/retrieve",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "type": "{{type}}",
          "domain": "{{domain}}",
          "name": "{{name}}",
          "country_gl": "{{countryGl}}",
          "email": "{{email}}",
          "ticker": "{{ticker}}",
          "ticker_exchange": "{{tickerExchange}}",
          "direct_url": "{{directUrl}}",
          "transaction_info": "{{transactionInfo}}",
          "city": "{{city}}",
          "mcc": "{{mcc}}",
          "phone": "{{phone}}",
          "high_confidence_only": "{{highConfidenceOnly}}",
          "force_language": "{{forceLanguage}}",
          "maxSpeed": "{{maxSpeed}}",
          "maxAgeMs": "{{maxAgeMs}}",
          "timeoutOpts": "{{timeoutOpts}}",
          "tags": "{{tags}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "monitors.limits": {
