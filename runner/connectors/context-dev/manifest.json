            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "timeoutOpts",
            "inputName": "timeoutOpts",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "allowReserved": false
          },
          {
            "wireName": "colorScheme",
            "inputName": "colorScheme",
            "in": "query",
            "style": "form",
            "explode": false,
