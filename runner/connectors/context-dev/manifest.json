    "web.scrapeMarkdown": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 10485760,
      "title": "Scrape Webpage to Markdown",
      "description": "Render one public URL and return Markdown via POST /v1/web/scrape with formats.markdown fixed to true. This operation does not request HTML, bytes, screenshots, or other formats.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "Public HTTP or HTTPS URL to render.",
