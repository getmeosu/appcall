    "web.styleguide": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 300000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 10485760,
      "title": "Get Website Styleguide",
      "description": "Extract colors, typography, and component styles from one domain or one direct URL via GET /v1/web/styleguide.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "description": "Domain to inspect, such as example.com. Do not also send directUrl.",
            "minLength": 3,
            "maxLength": 253
          },
          "directUrl": {
            "type": "string",
            "description": "Exact HTTP or HTTPS page to inspect. Do not also send domain.",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxAgeMs": {
            "type": "integer",
            "description": "Maximum cached styleguide age in milliseconds. 0 refreshes.",
            "minimum": 0,
            "maximum": 31536000000
          },
          "timeoutOpts": {
            "type": "object",
            "additionalProperties": false,
            "description": "Provider deadline. milliseconds is required when this object is set.",
            "required": [
              "milliseconds"
            ],
            "properties": {
              "milliseconds": {
                "type": "integer",
                "description": "Deadline in milliseconds.",
                "minimum": 1000,
                "maximum": 300000
              },
              "behavior": {
                "type": "string",
                "description": "fail rejects at the deadline. return-partial returns what is ready.",
                "enum": [
                  "fail",
                  "return-partial"
                ]
              }
            }
          },
          "colorScheme": {
            "type": "string",
            "description": "Browser color scheme to emulate.",
            "enum": [
              "light",
              "dark"
            ]
          },
          "zdr": {
            "type": "string",
            "description": "enabled requests zero data retention. The organization must have that feature turned on.",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "tags": {
            "type": "array",
            "description": "Up to 20 usage tags, each 1-50 characters.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "domain"
            ]
          },
          {
            "required": [
              "directUrl"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "Context.dev JSON object wrapped for the action result.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON object returned by Context.dev."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/web/styleguide",
        "parameters": [
          {
            "wireName": "domain",
            "inputName": "domain",
            "in": "query",
            "style": "form",
            "explode": false,
            "allowReserved": false
          },
          {
            "wireName": "directUrl",
