          "required": true,
          "secret": true
        }
      ],
      "mode": "api_key"
    },
    "type": "api_key"
  },
  "categories": [
    "productivity"
  ],
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "http": {
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "baseUrl": "https://heyzine.com",
    "errors": {
      "bodyErrorPaths": [
        "msg"
      ],
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "msg",
        "message",
        "error"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "key": "heyzine",
  "models": [
    "flipbook",
    "bookshelf",
    "webhook"
  ],
  "name": "Heyzine",
  "network": {
