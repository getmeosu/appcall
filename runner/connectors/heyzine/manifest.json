{
  "key": "heyzine",
  "name": "Heyzine",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Heyzine API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "heyzine.com"
    ]
  },
  "models": [
    "flipbook",
    "bookshelf",
    "access"
  ],
  "http": {
    "baseUrl": "https://heyzine.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "msg",
        "message",
        "error"
      ],
      "bodyErrorPaths": [
        "msg"
      ]
    }
  },
  "operations": {
