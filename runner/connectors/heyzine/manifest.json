    "flipbooks.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create flipbook",
      "description": "Convert a public PDF, DOCX, or PPTX URL into a Heyzine flipbook synchronously.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pdf": {
            "type": "string",
            "minLength": 1,
            "description": "Direct URL of the document to convert."
          },
          "client_id": {
            "type": "string",
            "minLength": 1,
            "description": "Heyzine client id used by the conversion REST endpoint."
          },
          "title": {
            "type": "string",
            "description": "Flipbook title."
          },
          "subtitle": {
            "type": "string",
            "description": "Flipbook subtitle."
          },
          "description": {
            "type": "string",
            "description": "Flipbook description."
          }
        },
        "required": [
          "pdf",
          "client_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/api1/rest",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "pdf": "{{pdf}}",
          "client_id": "{{client_id}}",
          "title": "{{title}}",
          "subtitle": "{{subtitle}}",
          "description": "{{description}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
