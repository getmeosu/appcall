    "flipbooks.access_list.update": {
      "description": "Grant user access to a flipbook via POST /api1/access-add. Composio access_list is applied one official access-add call per entry (not a bulk replace endpoint).",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "access_list": {
            "description": "List of access entries to set on the flipbook.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "access_type": {
                  "description": "Access method for this entry.",
                  "enum": [
                    "user_pass",
                    "google",
                    "pass_only",
                    "otp",
                    "email_link",
                    "send_code",
                    "email_code",
                    "webhook_code"
                  ],
                  "type": "string"
                },
                "password": {
                  "description": "Password, OTP, or webhook URL depending on access_type.",
                  "minLength": 1,
                  "type": "string"
                },
                "user": {
                  "description": "Username or email required for user_pass, google, and email-based types.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "access_type"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "flipbook_id": {
            "description": "Identifier of the flipbook to update access for.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "access_list",
          "flipbook_id"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "access_type": "{{access_type}}",
          "name": "{{flipbook_id}}",
          "password": "{{password}}",
          "type": "{{type}}",
          "user": "{{user}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api1/access-add",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "title": "Update flipbook access list",
      "validationMode": "strict-generated"
    },
    "flipbooks.create.async": {
      "description": "Tool to create a flipbook asynchronously. Use when converting large documents off-thread; poll for updates on conversion state.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "background_color": {
            "description": "Solid hex background without #, for example 000000 or ffffff.",
            "minLength": 1,
            "type": "string"
          },
          "client_id": {
            "description": "Heyzine client identifier from the developers dashboard.",
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "description": "Description shown on the flipbook and social shares.",
            "minLength": 1,
            "type": "string"
          },
          "download": {
            "description": "Allow downloading the original PDF when true.",
            "type": "boolean"
          },
          "full_screen": {
            "description": "Show the fullscreen button when true.",
            "type": "boolean"
          },
          "logo": {
            "description": "URL of the company logo (Standard plan and above).",
            "minLength": 1,
            "type": "string"
          },
          "page_effect": {
            "description": "Reader page effect: magazine, book, album, notebook, slideshow, cards, coverflow, or onepage.",
            "minLength": 1,
            "type": "string"
          },
          "pdf": {
            "description": "Direct URL to the PDF, DOCX, or PPTX to convert. Must not redirect.",
            "minLength": 1,
            "type": "string"
          },
          "prev_next": {
            "description": "Show previous/next buttons when true.",
            "type": "boolean"
          },
          "private_note": {
            "description": "Internal note never shown to visitors; maps to flipbook details private.",
            "minLength": 1,
            "type": "string"
          },
          "rtl": {
            "description": "Right-to-left reading direction when true.",
            "type": "boolean"
          },
          "share": {
            "description": "Show the share button when true.",
            "type": "boolean"
          },
          "show_info": {
            "description": "Overlay title/subtitle/description when true.",
            "type": "boolean"
          },
          "subtitle": {
            "description": "Subtitle shown on the flipbook and social shares.",
            "minLength": 1,
            "type": "string"
          },
          "tags": {
            "description": "Comma-separated tags for organizing the flipbook in the admin panel.",
            "minLength": 1,
            "type": "string"
          },
          "template": {
            "description": "Flipbook ID whose design (logo, effect, background, controls, styles) is copied.",
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "description": "Title shown on the flipbook and social shares.",
            "minLength": 1,
            "type": "string"
          },
          "url_domain": {
            "description": "Custom domain assigned to the account, for example docs.example.com.",
            "minLength": 1,
            "type": "string"
          },
          "url_path": {
            "description": "Custom path after the domain. Unique, no spaces or reserved characters.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "pdf"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "background_color": "{{background_color}}",
          "client_id": "{{client_id}}",
          "description": "{{description}}",
          "download": "{{download}}",
          "full_screen": "{{full_screen}}",
          "logo": "{{logo}}",
          "page_effect": "{{page_effect}}",
          "pdf": "{{pdf}}",
          "prev_next": "{{prev_next}}",
          "private_note": "{{private_note}}",
          "rtl": "{{rtl}}",
          "share": "{{share}}",
          "show_info": "{{show_info}}",
          "subtitle": "{{subtitle}}",
          "tags": "{{tags}}",
          "template": "{{template}}",
          "title": "{{title}}",
          "url_domain": "{{url_domain}}",
          "url_path": "{{url_path}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api1/async",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "title": "Create flipbook asynchronously",
      "validationMode": "strict-generated"
    },
