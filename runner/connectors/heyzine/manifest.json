            "type": "string",
            "description": "Updated subtitle."
          },
          "description": {
            "type": "string",
            "description": "Updated description."
          },
          "page_effect": {
            "type": "string",
            "enum": [
              "magazine",
              "book",
              "album",
              "notebook",
              "slideshow",
              "cards",
              "coverflow",
              "onepage"
