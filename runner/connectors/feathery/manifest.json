            "minLength": 1,
            "description": "Existing or new Feathery user ID."
          },
          "forms": {
            "type": "array",
            "description": "Form IDs to initialize submissions for.",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "object",
            "description": "Mapping of field identifier to value."
          },
          "complete": {
            "type": "boolean",
            "description": "Whether the submission is complete."
          }
        },
        "additionalProperties": false,
        "required": [
