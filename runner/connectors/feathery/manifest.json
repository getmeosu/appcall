    "account.edit": {
      "description": "Edit an existing account's role and permissions. Maps to FEATHERY_ACCOUNT_EDIT. Official PATCH /api/account/ accepts an array of account objects.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Email of the account to edit. Required if account_id is not provided."
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "description": "UUID of the account to edit. Required if email is not provided."
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "New role for the account.",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ]
          },
          "permission_edit_logic": {
            "type": "boolean",
            "description": "Allow editing custom logic rules."
          },
          "permission_edit_theme": {
            "type": "boolean",
            "description": "Allow editing form themes."
          },
          "permission_edit_form_results": {
            "type": "boolean",
            "description": "Allow editing form results."
          },
          "permission_invite_collaborators": {
            "type": "boolean",
            "description": "Allow inviting form collaborators."
          },
          "permission_edit_collaborator_template": {
            "type": "boolean",
            "description": "Allow editing collaborator settings."
          }
        }
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "PATCH",
        "path": "/api/account/",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": [
          {
            "email": "{{email}}",
            "account_id": "{{account_id}}",
            "role": "{{role}}",
            "permission_edit_logic": "{{permission_edit_logic}}",
            "permission_edit_theme": "{{permission_edit_theme}}",
            "permission_edit_form_results": "{{permission_edit_form_results}}",
            "permission_invite_collaborators": "{{permission_invite_collaborators}}",
            "permission_edit_collaborator_template": "{{permission_edit_collaborator_template}}"
          }
        ]
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "title": "Edit Feathery account",
      "validationMode": "strict-generated"
    },
