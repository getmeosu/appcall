    "forms.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create form",
      "description": "Create a Feathery form from a template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form_name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the new form."
          },
          "template_form_id": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the template form to copy."
          }
        },
        "additionalProperties": false,
        "required": [
          "form_name",
          "template_form_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/form/",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "form_name": "{{form_name}}",
          "template_form_id": "{{template_form_id}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "forms.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update form",
      "description": "Update a Feathery form name or enabled status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form_id": {
            "type": "string",
            "minLength": 1,
            "description": "Form ID."
          },
          "form_name": {
            "type": "string",
            "minLength": 1,
            "description": "New form name."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the form is enabled."
          }
        },
        "additionalProperties": false,
        "required": [
          "form_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/api/form/{{form_id}}/",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "form_name": "{{form_name}}",
          "enabled": "{{enabled}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "forms.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Delete form",
      "description": "Delete a Feathery form after confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form_id": {
            "type": "string",
            "minLength": 1,
            "description": "Form ID."
          },
          "confirm_delete": {
            "type": "boolean",
            "description": "Must be true to delete the form."
          }
        },
        "additionalProperties": false,
        "required": [
          "form_id",
          "confirm_delete"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "deleted",
          "form_id"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "form_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/api/form/{{form_id}}/",
        "success": [
          200,
          204
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "confirm_delete": "{{confirm_delete}}"
        },
        "result": {
          "deleted": true,
          "form_id": "{{input.form_id}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
