{
  "key": "bloomerang",
  "name": "Bloomerang",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Bloomerang private API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.bloomerang.co"
    ]
  },
  "models": [
    "constituent",
    "transaction",
    "interaction",
    "note",
    "task",
    "fund",
    "campaign",
    "appeal"
  ],
  "http": {
    "baseUrl": "https://api.bloomerang.co/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-KEY",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Bloomerang API key with a one-record constituent list probe.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/constituents",
        "query": {
          "take": 1
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "constituents.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List constituents",
      "description": "List Bloomerang constituents with optional skip/take pagination and type or sort filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skip": {
            "type": "integer",
            "minimum": 0
          },
          "take": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "type": {
            "type": "string",
            "enum": [
              "Individual",
              "Organization"
            ]
          },
          "orderBy": {
            "type": "string",
            "enum": [
              "Id",
              "CreatedDate",
              "LastModifiedDate"
            ]
          },
          "orderDirection": {
            "type": "string",
            "enum": [
              "Asc",
              "Desc"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/constituents",
        "query": {
          "skip": "{{skip}}",
          "take": "{{take}}",
          "type": "{{type}}",
          "orderBy": "{{orderBy}}",
          "orderDirection": "{{orderDirection}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "constituents.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search constituents",
      "description": "Search Bloomerang constituents and households by text with optional skip/take pagination.",
      "inputSchema": {
        "type": "object",
        "required": [
          "search"
        ],
        "properties": {
          "search": {
            "type": "string",
            "minLength": 1
          },
          "skip": {
            "type": "integer",
            "minimum": 0
          },
          "take": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "type": {
            "type": "string",
            "enum": [
              "Individual",
              "Organization",
              "Household"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/constituents/search",
        "query": {
          "search": "{{search}}",
          "skip": "{{skip}}",
          "take": "{{take}}",
          "type": "{{type}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "constituents.get": {
      "kind": "action",
