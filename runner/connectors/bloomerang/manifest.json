    "constituents.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create constituent",
      "description": "Create a Bloomerang constituent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "Type": {
            "type": "string",
            "description": "Constituent type.",
            "enum": [
              "Individual",
              "Organization"
            ]
          },
          "FirstName": {
            "type": "string",
            "description": "First name.",
            "minLength": 1
          },
          "LastName": {
            "type": "string",
            "description": "Last name.",
            "minLength": 1
          },
          "FullName": {
            "type": "string",
            "description": "Organization or full name.",
            "minLength": 1
          },
          "Status": {
            "type": "string",
            "description": "Status.",
            "enum": [
              "Active",
              "Inactive",
              "Deceased"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "Type"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/constituent",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "Type": "{{Type}}",
          "FirstName": "{{FirstName}}",
          "LastName": "{{LastName}}",
          "FullName": "{{FullName}}",
          "Status": "{{Status}}"
        }
      }
    },
