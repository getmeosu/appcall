{
  "key": "crew-ai",
  "name": "CrewAI",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility",
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "docsUrl": "https://docs.crewai.com/en/api-reference/introduction",
      "fields": [
        {
          "key": "apiKey",
          "label": "CrewAI bearer token",
          "description": "Sent as Authorization: Bearer. Control-plane calls on app.crewai.com use the Personal Access Token from Settings, Account. Execution calls on the crew host use the Bearer token from that crew's Status tab. One connection stores one bearer.",
          "required": true,
          "secret": true
        },
        {
          "key": "crewName",
          "label": "Crew hostname label",
          "description": "Single DNS label of the deployed crew host, such as research-assistant-crew for https://research-assistant-crew.crewai.com. Do not include a scheme, dot, slash, port, userinfo, or path.",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "app.crewai.com",
      "*.crewai.com"
    ]
  },
  "models": [
    "deployment",
    "execution",
    "input"
  ],
  "http": {
    "baseUrl": "https://{{crewName}}.crewai.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "deployments.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Crew Deployments",
      "description": "List CrewAI AMP crew deployments visible to the bearer token and return their names, UUIDs, and statuses.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/crewai_plus/api/v1/crews",
        "baseUrl": "https://app.crewai.com",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "deployments.status": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Deployment Status",
      "description": "Return the current AMP deployment status for one crew UUID from the CrewAI SaaS control plane.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "crewUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Crew deployment UUID returned by List Crew Deployments."
          }
        },
        "additionalProperties": false,
        "required": [
          "crewUuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/crewai_plus/api/v1/crews/{{crewUuid}}/status",
        "baseUrl": "https://app.crewai.com",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "deployments.logs": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "Get Deployment Logs",
      "description": "Return deployment lifecycle logs for one CrewAI deployment UUID. This is the deployment log collection, not a second log type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "crewUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Crew deployment UUID returned by List Crew Deployments."
          }
        },
        "additionalProperties": false,
        "required": [
          "crewUuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/crewai_plus/api/v1/crews/{{crewUuid}}/logs/deployment",
        "baseUrl": "https://app.crewai.com",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "deployments.redeploy": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Redeploy Crew",
      "description": "Trigger a new deployment of an existing CrewAI automation by UUID. The call is body-less and returns the enqueued deployment JSON.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "crewUuid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Existing CrewAI automation UUID to redeploy."
          }
        },
        "additionalProperties": false,
        "required": [
          "crewUuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/crewai_plus/api/v1/crews/{{crewUuid}}/deploy",
        "baseUrl": "https://app.crewai.com",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "inputs.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Required Inputs",
      "description": "Return the input names required by the connected deployed CrewAI automation before starting an execution.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/inputs",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "executions.start": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Start Crew Execution",
      "description": "Start one execution of the connected deployed CrewAI automation and return its kickoff ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": "string",
              "maxLength": 8000
            },
            "description": "Input values keyed by the names returned by Get Required Inputs."
          },
          "meta": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": true,
            "description": "Optional metadata to associate with this execution."
          },
          "taskWebhookUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Optional callback URL CrewAI notifies after each task. Not used as this connector's request host."
          },
          "stepWebhookUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Optional callback URL CrewAI notifies after each agent step. Not used as this connector's request host."
          },
          "crewWebhookUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Optional callback URL CrewAI notifies when the execution completes. Not used as this connector's request host."
          }
        },
        "additionalProperties": false,
        "required": [
          "inputs"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/kickoff",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "inputs": "{{inputs}}",
          "meta": "{{meta}}",
          "taskWebhookUrl": "{{taskWebhookUrl}}",
          "stepWebhookUrl": "{{stepWebhookUrl}}",
          "crewWebhookUrl": "{{crewWebhookUrl}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "executions.status": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "Get Execution Status",
      "description": "Return the current state, progress, result, or error for a deployed-crew execution identified by its kickoff ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kickoffId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Execution identifier returned by Start Crew Execution."
          }
        },
        "additionalProperties": false,
        "required": [
          "kickoffId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/status/{{kickoffId}}",
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "executions.resume": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Resume Crew Execution",
      "description": "Approve or retry a human-in-the-loop task and resume its paused CrewAI execution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Kickoff ID of the execution paused for human input."
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Task ID that should receive the human decision."
          },
          "humanFeedback": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "Approval context or retry feedback for the paused task."
          },
          "isApprove": {
            "type": "boolean",
            "description": "True approves and continues. False retries the task using humanFeedback."
          },
          "taskWebhookUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Original task callback URL. CrewAI does not carry it forward. Not this connector's request host."
          },
          "stepWebhookUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Original step callback URL. CrewAI does not carry it forward. Not this connector's request host."
          },
          "crewWebhookUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Original crew callback URL. CrewAI does not carry it forward. Not this connector's request host."
          }
        },
        "additionalProperties": false,
        "required": [
          "executionId",
          "taskId",
          "humanFeedback",
          "isApprove"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/resume",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "execution_id": "{{executionId}}",
          "task_id": "{{taskId}}",
          "human_feedback": "{{humanFeedback}}",
          "is_approve": "{{isApprove}}",
          "taskWebhookUrl": "{{taskWebhookUrl}}",
          "stepWebhookUrl": "{{stepWebhookUrl}}",
          "crewWebhookUrl": "{{crewWebhookUrl}}"
        },
        "success": [
          200
        ],
        "result": {
          "data": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
