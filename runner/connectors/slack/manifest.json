{
  "key": "slack",
  "name": "Slack",
  "version": "0.2.0",
  "runtime": "bun",
  "categories": ["messaging"],
  "auth": {
    "type": "oauth2",
    "scopes": [
      "channels:history",
      "channels:read",
      "channels:write",
      "channels:manage",
      "channels:join",
      "chat:write",
      "emoji:read",
      "files:read",
      "pins:read",
      "pins:write",
      "reactions:read",
      "reactions:write",
      "team:read",
      "users:read",
      "users:read.email"
    ],
    "setup": {
      "mode": "oauth2",
      "fields": []
    },
    "oauth": {
      "authorizeUrl": "https://slack.com/oauth/v2/authorize",
      "tokenUrl": "https://slack.com/api/oauth.v2.access",
      "pkce": false,
      "supportsRefresh": false
    }
  },
  "network": {
    "allowedHosts": [
      "slack.com"
    ]
  },
  "operations": {
    "messages.list": {
      "kind": "sync",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "messages.send": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Send Message",
      "description": "Post a text message to a Slack channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Slack channel ID or name to post the message to."
          },
          "text": {
            "type": "string",
            "description": "Message text to send (1 to 40000 characters)."
          }
        },
        "required": ["channel", "text"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "providerMessageId": {
            "type": "string",
            "description": "Slack message timestamp (ts) identifying the posted message."
          },
          "channelId": {
            "type": "string",
            "description": "ID of the channel the message was posted to."
          },
          "text": {
            "type": "string",
            "description": "Text of the posted message."
          }
        }
      }
    },
    "chat.update": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update Message",
      "description": "Update the text of an existing Slack message identified by its channel and timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID containing the message to update."
          },
          "ts": {
            "type": "string",
            "description": "Timestamp (ts) of the message to update."
          },
          "text": {
            "type": "string",
            "description": "New text for the message (1 to 40000 characters)."
          }
        },
        "required": ["channel", "ts", "text"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID of the updated message." },
          "ts": { "type": "string", "description": "Timestamp of the updated message." },
          "text": { "type": "string", "description": "New text of the updated message." }
        }
      }
    },
    "chat.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete Message",
      "description": "Delete an existing Slack message from a channel using its timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID from which the message should be deleted."
          },
          "ts": {
            "type": "string",
            "description": "Timestamp (ts) of the message to delete."
          }
        },
        "required": ["channel", "ts"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID of the deleted message." },
          "ts": { "type": "string", "description": "Timestamp of the deleted message." }
        }
      }
    },
    "chat.postEphemeral": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Post Ephemeral Message",
      "description": "Send an ephemeral message visible only to a specified user in a Slack channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID where the ephemeral message will appear."
          },
          "user": {
            "type": "string",
            "description": "User ID of the user who will see the ephemeral message."
          },
          "text": {
            "type": "string",
            "description": "Message text (1 to 40000 characters)."
          }
        },
        "required": ["channel", "user", "text"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "messageTs": { "type": "string", "description": "Timestamp of the ephemeral message." }
        }
      }
    },
    "conversations.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Channel",
      "description": "Create a new Slack channel (public or private).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name for the new channel (lowercase, no spaces)."
          },
          "isPrivate": {
            "type": "boolean",
            "description": "When true, creates a private channel. Defaults to public."
          }
        },
        "required": ["name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "object", "description": "Normalized channel object for the newly created channel." }
        }
      }
    },
    "conversations.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Channels",
      "description": "List all public and private Slack channels the authenticated user can see, with optional pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor returned by a previous call."
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of channels to return (1–1000). Defaults to Slack's default."
          },
          "excludeArchived": {
            "type": "boolean",
            "description": "When true, archived channels are excluded from the results."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channels": { "type": "array", "description": "Array of normalized channel objects." },
          "nextCursor": { "type": "string", "description": "Cursor for the next page, or null when exhausted." }
        }
      }
    },
    "conversations.history": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Channel History",
      "description": "Fetch the message history of a Slack channel, with optional pagination and time-range filtering.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID to retrieve messages from."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor from a previous response."
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of messages to return (1–1000)."
          },
          "oldest": {
            "type": "string",
            "description": "Start of time range as a Unix timestamp string."
          },
          "latest": {
            "type": "string",
            "description": "End of time range as a Unix timestamp string."
          }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "messages": { "type": "array", "description": "Array of raw Slack message objects." },
          "hasMore": { "type": "boolean", "description": "Whether additional messages are available." },
          "nextCursor": { "type": "string", "description": "Cursor for the next page, or null when exhausted." }
        }
      }
    },
    "conversations.info": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Channel Info",
      "description": "Retrieve metadata and settings for a specific Slack channel by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID to look up."
          }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "object", "description": "Normalized channel metadata." }
        }
      }
    },
    "conversations.invite": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Invite Users to Channel",
      "description": "Invite one or more users to an existing Slack channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID to invite users into."
          },
          "users": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of user IDs to invite to the channel."
          }
        },
        "required": ["channel", "users"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "object", "description": "Updated channel metadata after the invite." }
        }
      }
    },
    "conversations.members": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "List Channel Members",
      "description": "List the user IDs of all members in a Slack channel, with optional pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Channel ID whose members should be listed."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor from a previous response."
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of member IDs to return (1–1000)."
          }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "members": { "type": "array", "items": { "type": "string" }, "description": "List of user IDs who are members of the channel." },
          "nextCursor": { "type": "string", "description": "Cursor for the next page, or null when exhausted." }
        }
      }
    },
    "users.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Users",
      "description": "List all users (members) in the Slack workspace, including profile information and bot status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Pagination cursor from a previous response."
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of users to return (1–1000)."
          }
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "members": { "type": "array", "description": "Array of normalized user objects." },
          "nextCursor": { "type": "string", "description": "Cursor for the next page, or null when exhausted." }
        }
      }
    },
    "users.info": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get User Info",
      "description": "Retrieve a Slack user's profile and account metadata by user ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": { "type": "string", "description": "User ID to look up." }
        },
        "required": ["user"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": { "type": "object", "description": "Normalized user object." }
        }
      }
    },
    "users.lookupByEmail": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Lookup User By Email",
      "description": "Find a Slack user by email address and return their profile.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "description": "Email address to look up." }
        },
        "required": ["email"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": { "type": "object", "description": "Normalized user object." }
        }
      }
    },
    "conversations.replies": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Thread Replies",
      "description": "Fetch replies in a Slack message thread identified by channel and parent timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID containing the thread." },
          "ts": { "type": "string", "description": "Timestamp of the parent message." },
          "cursor": { "type": "string", "description": "Pagination cursor from a previous response." },
          "limit": { "type": "number", "description": "Maximum number of replies to return (1–1000)." }
        },
        "required": ["channel", "ts"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "messages": { "type": "array", "description": "Parent message followed by replies." },
          "hasMore": { "type": "boolean", "description": "Whether additional replies are available." },
          "nextCursor": { "type": "string", "description": "Cursor for the next page, or null when exhausted." }
        }
      }
    },
    "team.info": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Team Info",
      "description": "Retrieve metadata for the Slack workspace associated with the authenticated token.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "team": { "type": "object", "description": "Workspace metadata from Slack team.info." }
        }
      }
    },
    "emoji.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Emoji",
      "description": "List custom emoji aliases and image URLs for the Slack workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "emoji": { "type": "object", "description": "Map of emoji name to image URL or alias." }
        }
      }
    },
    "pins.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "List Pins",
      "description": "List items pinned in a Slack channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID whose pins should be listed." }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "description": "Pinned items in the channel." }
        }
      }
    },
    "reactions.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Reactions",
      "description": "Get emoji reactions on a Slack message identified by channel and timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID containing the message." },
          "ts": { "type": "string", "description": "Timestamp (ts) of the message." }
        },
        "required": ["channel", "ts"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "Reacted item type, typically message." },
          "channel": { "type": "string", "description": "Channel ID of the message." },
          "message": { "type": "object", "description": "Message object including reactions." }
        }
      }
    },
    "files.info": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get File Info",
      "description": "Retrieve metadata for a Slack file by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "description": "Slack file ID." }
        },
        "required": ["file"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "file": { "type": "object", "description": "Slack file metadata." }
        }
      }
    },
    "auth.test": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Auth Test",
      "description": "Verify the Slack token and return the authenticated workspace, user, and bot identity.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "Workspace URL." },
          "team": { "type": "string", "description": "Workspace name." },
          "user": { "type": "string", "description": "Authenticated user name." },
          "teamId": { "type": "string", "description": "Workspace ID." },
          "userId": { "type": "string", "description": "Authenticated user ID." },
          "botId": { "type": "string", "description": "Bot ID when the token belongs to a bot." }
        }
      }
    },
    "reactions.add": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Add Reaction",
      "description": "Add an emoji reaction to a Slack message identified by channel and timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID containing the message." },
          "ts": { "type": "string", "description": "Timestamp (ts) of the message." },
          "name": { "type": "string", "description": "Emoji name without colons, e.g. thumbsup." }
        },
        "required": ["channel", "ts", "name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "description": "Whether the reaction was added." }
        }
      }
    },
    "reactions.remove": {
      "kind": "action",
      "sideEffect": "destructive",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Remove Reaction",
      "description": "Remove an emoji reaction from a Slack message identified by channel and timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID containing the message." },
          "ts": { "type": "string", "description": "Timestamp (ts) of the message." },
          "name": { "type": "string", "description": "Emoji name without colons, e.g. thumbsup." }
        },
        "required": ["channel", "ts", "name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "description": "Whether the reaction was removed." }
        }
      }
    },
    "pins.add": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Pin Message",
      "description": "Pin a Slack message in a channel using its timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID to pin the message in." },
          "ts": { "type": "string", "description": "Timestamp (ts) of the message to pin." }
        },
        "required": ["channel", "ts"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "description": "Whether the message was pinned." }
        }
      }
    },
    "pins.remove": {
      "kind": "action",
      "sideEffect": "destructive",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Unpin Message",
      "description": "Remove a pinned Slack message from a channel using its timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID containing the pin." },
          "ts": { "type": "string", "description": "Timestamp (ts) of the pinned message." }
        },
        "required": ["channel", "ts"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "description": "Whether the pin was removed." }
        }
      }
    },
    "conversations.join": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Join Channel",
      "description": "Join a public Slack channel as the authenticated user or bot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID to join." }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "object", "description": "Normalized channel object after joining." }
        }
      }
    },
    "conversations.leave": {
      "kind": "action",
      "sideEffect": "destructive",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Leave Channel",
      "description": "Leave a Slack channel as the authenticated user or bot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID to leave." }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID that was left." }
        }
      }
    },
    "conversations.archive": {
      "kind": "action",
      "sideEffect": "destructive",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Archive Channel",
      "description": "Archive a Slack channel so it is no longer active.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID to archive." }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID that was archived." }
        }
      }
    },
    "conversations.unarchive": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Unarchive Channel",
      "description": "Restore an archived Slack channel to active status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID to unarchive." }
        },
        "required": ["channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "description": "Channel ID that was unarchived." }
        }
      }
    },
    "conversations.rename": {
      "kind": "action",
      "sideEffect": "write",
      "effectPolicy": "Idempotent",
