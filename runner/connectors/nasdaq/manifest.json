          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/datasets/{{databaseCode}}/{{datasetCode}}.json",
        "success": [
          200
        ],
        "query": {
          "limit": "{{limit}}",
          "start_date": "{{startDate}}",
          "end_date": "{{endDate}}",
          "order": "{{order}}",
          "collapse": "{{collapse}}",
          "transform": "{{transform}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
