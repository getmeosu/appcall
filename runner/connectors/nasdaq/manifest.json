{
  "key": "nasdaq",
  "name": "Nasdaq Data Link",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "banking-data"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Nasdaq Data Link API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "data.nasdaq.com"
    ]
  },
  "models": [
    "datatable",
    "quote",
    "dividend",
    "ticker",
    "action",
    "fundamental",
    "dataset",
    "database"
  ],
  "http": {
    "baseUrl": "https://data.nasdaq.com/api/v3",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "X-Api-Token": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "quandl_error.message",
        "message",
        "error"
      ],
      "bodyErrorPaths": [
        "quandl_error"
      ]
    }
  },
  "operations": {
