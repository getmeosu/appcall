          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/datatables/QUOTEMEDIA/PRICES.json",
        "query": {
          "date.gte": "{{dateGte}}",
          "date.lte": "{{dateLte}}",
          "qopts.columns": "ticker,date,open,high,low,close,volume,dividend,split",
          "qopts.cursor_id": "{{cursorId}}",
