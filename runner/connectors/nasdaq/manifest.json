          "datasetCode": {
            "type": "string",
            "minLength": 1,
            "description": "Dataset code, for example GDP."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of rows."
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive start date."
