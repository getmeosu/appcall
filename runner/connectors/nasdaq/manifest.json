  "http": {
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "api_key",
      "value": "{{apiKey}}"
    },
    "baseUrl": "https://data.nasdaq.com/api/v3",
    "errors": {
      "bodyErrorPaths": [
        "quandl_error"
      ],
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "quandl_error.message",
        "message",
        "error"
      ],
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after"
    },
    "headers": {
      "Accept": "application/json",
      "X-Api-Token": "{{apiKey}}"
    }
  },
  "key": "nasdaq",
  "models": [
    "datatable",
    "quote",
    "dividend"
  ],
  "name": "Nasdaq Data Link",
  "network": {
    "allowedHosts": [
      "data.nasdaq.com"
    ]
  },
  "operations": {
    "datatables.metadata": {
      "description": "Retrieve schema and refresh metadata for a Nasdaq Data Link datatable.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "tableCode": {
            "minLength": 1,
            "type": "string"
          },
          "vendorCode": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "vendorCode",
          "tableCode"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/datatables/{{vendorCode}}/{{tableCode}}/metadata.json",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get datatable metadata",
      "validationMode": "strict-generated"
    },
    "datatables.query": {
      "description": "Return one page of Nasdaq Data Link datatable rows.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "minLength": 1,
            "type": "string"
          },
          "cursorId": {
            "minLength": 1,
            "type": "string"
          },
          "perPage": {
            "minimum": 1,
            "type": "integer"
          },
          "tableCode": {
            "minLength": 1,
            "type": "string"
          },
          "ticker": {
            "minLength": 1,
            "type": "string"
          },
          "vendorCode": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "vendorCode",
          "tableCode"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/datatables/{{vendorCode}}/{{tableCode}}.json",
        "query": {
          "qopts.columns": "{{columns}}",
          "qopts.cursor_id": "{{cursorId}}",
          "qopts.per_page": "{{perPage}}",
          "ticker": "{{ticker}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Query datatable",
      "validationMode": "strict-generated"
    },
    "dividends.history": {
      "description": "Retrieve quarterly SHARADAR/SF1 dividend fundamentals for a ticker.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursorId": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "minLength": 1,
            "type": "string"
          },
          "perPage": {
            "minimum": 1,
            "type": "integer"
          },
          "ticker": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticker"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/datatables/SHARADAR/SF1.json",
        "query": {
          "datekey": "{{date}}",
          "dimension": "ARQ",
          "qopts.columns": "ticker,dimension,calendardate,datekey,dps,divyield,payoutratio,ncfdiv",
          "qopts.cursor_id": "{{cursorId}}",
          "qopts.per_page": "{{perPage}}",
          "ticker": "{{ticker}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get dividend history",
      "validationMode": "strict-generated"
    },
