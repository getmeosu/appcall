          "endDate": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive end date."
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Row order."
          },
          "collapse": {
            "type": "string",
            "minLength": 1,
            "description": "Frequency collapse."
          },
          "transform": {
            "type": "string",
            "minLength": 1,
            "description": "Transformation."
          }
        },
        "additionalProperties": false,
        "required": [
          "databaseCode",
          "datasetCode"
