      },
      "request": {
        "method": "GET",
        "path": "/datatables/SHARADAR/TICKERS/metadata.json",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "title": "Healthcheck",
      "validationMode": "strict-generated"
    },
    "quotes.eod": {
      "description": "Retrieve QuoteMedia end-of-day prices for a ticker.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursorId": {
            "minLength": 1,
            "type": "string"
          },
          "dateGte": {
            "minLength": 1,
            "type": "string"
          },
          "dateLte": {
            "minLength": 1,
            "type": "string"
          },
          "perPage": {
            "minimum": 1,
            "type": "integer"
          },
          "ticker": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ticker"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
