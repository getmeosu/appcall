{
  "key": "toggl",
  "name": "Toggl Track",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Toggl API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.track.toggl.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.track.toggl.com/api/v9",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": "api_token"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "message",
        "error",
        "errors.0.message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the Toggl Track API token and return the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "user": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "GET",
        "path": "/me",
        "success": [
          200
        ],
        "echo": {
          "status": "ok"
        },
        "result": {
          "status": "ok",
          "user": "{{response}}"
        }
      }
    },
    "users.me": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Current User",
      "description": "Get the authenticated Toggl Track user profile.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "request": {
        "method": "GET",
        "path": "/me",
        "success": [
          200
        ],
        "result": {
          "user": "{{response}}"
        }
      }
    },
