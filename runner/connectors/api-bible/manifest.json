    "search": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Search verses",
      "description": "Search verse text or passage references in one Bible version.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bibleId": {
            "type": "string",
            "minLength": 1,
            "description": "Bible version ID, for example de4e12af7f28f599-01."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Keywords or a passage reference such as John 3:16."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum results to return.",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "description": "Number of results to skip.",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "bibleId",
          "query"
