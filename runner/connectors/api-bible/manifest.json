        "type": "object",
        "properties": {
          "bibleId": {
            "type": "string",
            "minLength": 1,
            "description": "Bible version ID, for example de4e12af7f28f599-01."
          }
        },
        "additionalProperties": false,
        "required": [
          "bibleId"
        ]
      },
      "outputSchema": {
        "type": "object",
