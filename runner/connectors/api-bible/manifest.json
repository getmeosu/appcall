      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "books.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get book",
      "description": "Get one book in a Bible version, optionally including chapter summaries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bibleId": {
            "type": "string",
            "minLength": 1,
            "description": "Bible version ID, for example de4e12af7f28f599-01."
          },
          "bookId": {
            "type": "string",
            "minLength": 1,
            "description": "USFM book ID, for example JHN or GEN."
          },
          "includeChapters": {
            "type": "boolean",
            "description": "Include chapter summaries for the book."
          }
        },
        "additionalProperties": false,
        "required": [
          "bibleId",
          "bookId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/bibles/{{bibleId}}/books/{{bookId}}",
        "success": [
          200
        ],
        "query": {
          "include-chapters": "{{includeChapters}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "chapters.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get chapter",
      "description": "Get one chapter including verse content for a Bible version.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bibleId": {
            "type": "string",
            "minLength": 1,
            "description": "Bible version ID, for example de4e12af7f28f599-01."
          },
          "chapterId": {
            "type": "string",
            "minLength": 1,
            "description": "Chapter ID in BOOK.CHAPTER form, for example JHN.3."
          },
          "contentType": {
            "type": "string",
            "minLength": 1,
            "description": "Returned content format: html, json, or text."
          },
          "includeNotes": {
            "type": "boolean",
            "description": "Include footnotes in content."
          },
          "includeTitles": {
            "type": "boolean",
            "description": "Include section titles in content."
          },
          "includeChapterNumbers": {
            "type": "boolean",
            "description": "Include chapter numbers in content."
          },
          "includeVerseNumbers": {
            "type": "boolean",
            "description": "Include verse numbers in content."
          },
          "parallels": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated Bible IDs for parallel content."
          }
        },
        "additionalProperties": false,
        "required": [
          "bibleId",
          "chapterId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/bibles/{{bibleId}}/chapters/{{chapterId}}",
        "success": [
          200
        ],
        "query": {
          "content-type": "{{contentType}}",
          "include-notes": "{{includeNotes}}",
          "include-titles": "{{includeTitles}}",
          "include-chapter-numbers": "{{includeChapterNumbers}}",
          "include-verse-numbers": "{{includeVerseNumbers}}",
          "parallels": "{{parallels}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
