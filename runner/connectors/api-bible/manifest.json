    "audioBibles.books.get": {
      "description": "Retrieve a single audio book for an audio Bible, optionally including chapter summaries.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "audioBibleId": {
            "description": "Unique identifier of the audio Bible (e.g. 52a82b80a85343c5-01).",
            "minLength": 1,
            "type": "string"
          },
          "bookId": {
            "description": "USFM book ID (e.g. GEN, MAT, JHN).",
            "minLength": 1,
            "type": "string"
          },
          "include_chapters": {
            "description": "When true, include an array of chapter summaries.",
            "type": "boolean"
          }
        },
        "required": [
          "audioBibleId",
          "bookId"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v1/audio-bibles/{{audioBibleId}}/books/{{bookId}}",
        "query": {
          "include-chapters": "{{include_chapters}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "title": "Get audio book",
      "validationMode": "strict-generated"
