    "groups.customFields.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "enforceOutputSchema": true,
      "title": "List Group Custom Fields",
      "description": "List custom fields for a Folk group and entity type (person, company, or custom object name).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "minLength": 1,
            "description": "Folk group ID (grp_\u2026)."
          },
          "entityType": {
            "type": "string",
            "minLength": 1,
            "description": "Entity type: person, company, or a custom object name."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Number of items to return (1-100)."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "Pagination cursor from a previous pagination.nextLink."
          }
        },
        "required": [
