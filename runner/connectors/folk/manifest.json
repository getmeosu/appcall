{
  "key": "folk",
  "name": "folk",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm",
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Folk API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.folk.app"
    ]
  },
  "models": [
    "user",
    "group",
    "person",
    "company",
    "note",
    "reminder",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://api.folk.app/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error.message",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "enforceOutputSchema": true,
      "title": "Healthcheck",
      "description": "Validate the Folk API key with GET /users/me (current workspace user).",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/users/me",
        "success": [
          200
        ],
        "result": {
          "user": "{{response.data}}"
        }
      }
    },
    "users.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "enforceOutputSchema": true,
      "title": "List Users",
      "description": "List Folk workspace users with explicit cursor pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Number of items to return (1-100)."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "Pagination cursor from a previous pagination.nextLink."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "users"
        ],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pagination": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/users",
        "query": {
          "limit": "{{limit}}",
          "cursor": "{{cursor}}"
        },
        "success": [
          200
        ],
        "result": {
          "users": "{{response.data.items}}",
          "pagination": {
            "nextLink": "{{response.data.pagination.nextLink}}",
            "nextCursor": "{{response.data.pagination.nextCursor}}"
          }
        }
      }
    },
    "users.get": {
      "kind": "action",
