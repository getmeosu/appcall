        {
          "key": "apiKey",
          "label": "Folk API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.folk.app"
    ]
  },
  "models": [
    "user",
    "group",
    "person",
    "company",
    "note",
    "task"
  ],
  "http": {
    "baseUrl": "https://api.folk.app/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
