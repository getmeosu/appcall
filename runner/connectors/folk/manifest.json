          },
          "combinator": {
            "type": "string",
            "enum": [
              "and",
              "or"
            ],
            "description": "How to combine multiple filters."
          },
          "filter": {
            "type": "object",
            "description": "Folk filter object, e.g. {\"firstName\":{\"eq\":\"Ada\"}}."
