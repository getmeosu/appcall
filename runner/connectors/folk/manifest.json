    "people.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "enforceOutputSchema": true,
      "title": "Create Person",
      "description": "Create a person in the Folk workspace. Optional names, emails, phones, groups, and custom fields.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "First name of the person."
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the person."
          },
          "fullName": {
            "type": "string",
            "description": "Full name of the person."
          },
          "description": {
            "type": "string",
            "description": "Short description of the person."
          },
          "birthday": {
            "type": "string",
            "description": "Birthday in YYYY-MM-DD format. Empty string or null clears it."
          },
          "jobTitle": {
            "type": "string",
            "description": "Job title of the person."
          },
          "groups": {
            "type": "array",
            "description": "Groups to associate. Provide objects with Folk group IDs.",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Folk group ID (grp_\u2026)."
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            }
          },
          "companies": {
            "type": "array",
            "description": "Companies to associate. Provide {id} or {name}; the first is primary.",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Existing Folk company ID (com_\u2026)."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Company name; created if the id is omitted."
                }
              },
              "additionalProperties": false
            }
          },
          "addresses": {
            "type": "array",
            "description": "Addresses. The first is primary.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "emails": {
            "type": "array",
            "description": "Email addresses. The first is primary.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "phones": {
            "type": "array",
            "description": "Phone numbers. The first is primary.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "urls": {
            "type": "array",
            "description": "URLs. The first is primary.",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "customFieldValues": {
            "type": "object",
            "description": "Custom field values grouped by group ID, then field name.",
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "person"
        ],
        "properties": {
          "person": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/people",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "fullName": "{{fullName}}",
          "description": "{{description}}",
          "birthday": "{{birthday}}",
          "jobTitle": "{{jobTitle}}",
          "groups": "{{groups}}",
          "companies": "{{companies}}",
          "addresses": "{{addresses}}",
          "emails": "{{emails}}",
          "phones": "{{phones}}",
          "urls": "{{urls}}",
          "customFieldValues": "{{customFieldValues}}"
        },
        "success": [
          200
        ],
        "result": {
          "person": "{{response.data}}"
        }
      }
    },
