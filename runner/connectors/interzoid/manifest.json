      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Interzoid API license key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.interzoid.com"
    ]
  },
  "models": [
