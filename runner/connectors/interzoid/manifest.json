  "http": {
    "baseUrl": "https://api.interzoid.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "license",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "Error",
        "message"
      ],
      "bodyErrorPaths": [
        "Message"
      ]
    }
