{
  "key": "crawlbase",
  "name": "Crawlbase",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Crawlbase API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.crawlbase.com"
    ]
  },
  "models": [
    "usage",
    "stored-page",
    "request-id"
  ],
  "http": {
    "baseUrl": "https://api.crawlbase.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "token",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "account.crawlingUsage": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Crawling Usage",
      "description": "Return current Crawling API usage, and previous-month statistics when requested, from GET /account?product=crawling-api.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includePreviousMonth": {
            "type": "boolean",
            "description": "Include previous-month crawling usage statistics when true."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "totalSuccess",
          "totalFailed",
          "totalDue",
          "domainStats"
        ],
        "properties": {
          "totalSuccess": {
            "type": "integer"
          },
          "totalFailed": {
            "type": "integer"
          },
          "totalDue": {
            "type": "number"
          },
          "remainingCredits": {
            "type": "integer"
          },
          "domainStats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "totalRequests": {
                  "type": "integer"
                },
                "success": {
                  "type": "integer"
                },
                "failure": {
                  "type": "integer"
                },
                "successRate": {
                  "type": "number"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/account",
        "query": {
          "product": "crawling-api",
          "previous_month": "{{includePreviousMonth}}"
        },
        "success": [
          200
        ],
        "result": {
          "totalSuccess": "{{response.totalSuccess}}",
          "totalFailed": "{{response.totalFailed}}",
          "totalDue": "{{response.totalDue}}",
          "remainingCredits": "{{response.remainingCredits}}",
          "domainStats": "{{response.domainStats}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "storage.count": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Storage Count",
      "description": "Return how many pages are currently held in Crawlbase Cloud Storage.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "totalCount"
        ],
        "properties": {
          "totalCount": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/storage/total_count",
        "success": [
          200
        ],
        "result": {
          "totalCount": "{{response.totalCount}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "storage.rids.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 2097152,
      "title": "List Stored Page IDs",
      "description": "Return one page of Cloud Storage request IDs from GET /storage/rids. Send scroll true on the first page to receive scroll_id, then pass that cursor as nextCursor without scroll.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Maximum number of stored request IDs to return. Crawlbase caps this at 10000."
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Order stored request IDs from oldest to newest (asc) or newest to oldest (desc)."
          },
          "scroll": {
            "type": "boolean",
            "description": "Start a scroll session and return scroll_id. Do not send this with nextCursor."
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "description": "Short-lived scroll_id from the previous response. Use it within about 15 seconds and omit scroll."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "rids"
        ],
        "properties": {
          "rids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scroll_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/storage/rids",
        "query": {
          "limit": "{{limit}}",
          "scroll_order": "{{order}}",
          "scroll": "{{scroll}}",
          "scroll_id": "{{nextCursor}}"
        },
        "success": [
          200
        ],
        "result": {
          "rids": "{{response.rids}}",
          "scroll_id": "{{response.scroll_id}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "storage.pages.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 26214400,
      "title": "Get Stored Pages",
      "description": "Retrieve up to 100 Cloud Storage pages by request ID without deleting them. POST /storage/bulk returns a JSON array; each body is base64-encoded gzip of the stored page.",
      "inputSchema": {
        "type": "object",
        "required": [
          "rids"
        ],
        "properties": {
          "rids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "One to 100 unique request IDs of stored pages to retrieve.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "pages"
        ],
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rid",
                "body"
              ],
              "properties": {
                "stored_at": {
                  "type": "string"
                },
                "original_status": {
                  "type": "integer"
                },
                "cb_status": {
                  "type": "integer"
                },
                "pc_status": {
                  "type": "integer"
                },
                "rid": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/storage/bulk",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "rids": "{{rids}}"
        },
        "success": [
          200
        ],
        "result": {
          "pages": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "storage.pages.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Delete Stored Pages",
      "description": "Irreversibly delete one to 100 stored pages by request ID. POST /storage/bulk_delete returns a JSON array with each page's deletion outcome.",
      "inputSchema": {
        "type": "object",
        "required": [
          "rids"
        ],
        "properties": {
          "rids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "One to 100 unique request IDs of stored pages to delete.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rid",
                "result",
                "status"
              ],
              "properties": {
                "rid": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "status": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/storage/bulk_delete",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "rids": "{{rids}}"
        },
        "success": [
          200
        ],
        "result": {
          "results": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
