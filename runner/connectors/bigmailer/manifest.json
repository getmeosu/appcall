{
  "key": "bigmailer",
  "name": "BigMailer",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "BigMailer API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.bigmailer.io"
    ]
  },
  "models": [
    "brand",
    "list",
    "contact",
    "template",
    "transactionalCampaign"
  ],
  "http": {
    "baseUrl": "https://api.bigmailer.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-API-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "code",
        "type"
      ]
    }
  },
