    "uptimeTests.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create uptime test",
      "description": "Create a StatusCake uptime check via POST /uptime.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the check."
          },
          "testType": {
            "type": "string",
            "minLength": 1,
            "description": "Uptime check type such as HTTP or TCP."
          },
          "websiteUrl": {
            "type": "string",
            "minLength": 1,
            "description": "URL or IP address under test."
          },
          "checkRate": {
            "type": "integer",
            "description": "Seconds between checks.",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "testType",
          "websiteUrl",
          "checkRate"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/uptime",
        "success": [
          201
        ],
        "body": {
          "name": "{{name}}",
          "test_type": "{{testType}}",
          "website_url": "{{websiteUrl}}",
          "check_rate": "{{checkRate}}"
        },
        "bodyEncoding": "form",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
