{
  "key": "statuscake",
  "name": "statuscake",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "StatusCake API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.statuscake.com"
    ]
  },
  "models": [
    "account",
    "monitor",
    "uptimeTest",
    "heartbeatTest",
    "pagespeedTest",
    "sslTest",
    "contactGroup",
    "maintenanceWindow",
    "location"
  ],
  "http": {
    "baseUrl": "https://api.statuscake.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
