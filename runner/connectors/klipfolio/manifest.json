{
  "key": "klipfolio",
  "name": "Klipfolio",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Klipfolio API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "app.klipfolio.com"
    ]
  },
  "models": [
    "client",
    "dashboard",
    "klip",
    "datasource",
    "user"
  ],
  "http": {
    "baseUrl": "https://app.klipfolio.com/api/1.0",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "kf-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "meta.error_message",
        "meta.message",
        "message",
        "error"
      ]
    }
  },
