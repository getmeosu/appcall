{
  "key": "quickbooks",
  "name": "QuickBooks Online",
  "version": "0.2.0",
  "runtime": "bun",
  "categories": [
    "accounting"
  ],
  "auth": {
    "type": "oauth2",
    "scopes": [
      "com.intuit.quickbooks.accounting"
    ],
    "setup": {
      "mode": "oauth2",
      "fields": [
        {
          "key": "realmId",
          "label": "QuickBooks company ID (realmId)",
          "required": true,
          "secret": false
        }
      ]
    },
    "oauth": {
      "authorizeUrl": "https://appcenter.intuit.com/connect/oauth2",
      "tokenUrl": "https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer",
      "pkce": false,
      "supportsRefresh": true
    }
  },
  "network": {
    "allowedHosts": [
      "quickbooks.api.intuit.com",
      "appcenter.intuit.com",
      "oauth.platform.intuit.com"
    ]
  },
  "http": {
    "baseUrl": "https://quickbooks.api.intuit.com/v3/company/{{realmId}}",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Fault.Error.0.Message",
        "Fault.Error.0.Detail",
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "invoices.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "customers.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "payments.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify QuickBooks Online credentials by reading CompanyInfo for the connected realm.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status."
          },
          "company": {
            "type": "object",
            "description": "QuickBooks CompanyInfo entity."
          }
        },
        "required": [
          "status"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/companyinfo/{{realmId}}",
        "success": [
          200
        ],
        "echo": {
          "status": "ok"
        },
        "result": {
          "status": "ok",
          "company": "{{response.CompanyInfo}}"
        }
      }
    },
    "company.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Company Info",
      "description": "Get CompanyInfo for the connected QuickBooks Online company via GET /v3/company/{realmId}/companyinfo/{realmId}.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "company": {
            "type": "object"
          }
        },
        "required": [
          "company"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/companyinfo/{{realmId}}",
        "success": [
          200
        ],
        "result": {
          "company": "{{response.CompanyInfo}}"
        }
      }
    },
    "query.run": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Run Query",
      "description": "Run a QuickBooks Online SQL-like query via GET /v3/company/{realmId}/query. Example: SELECT * FROM Customer MAXRESULTS 20.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "QuickBooks query language statement."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "queryResponse": {
            "type": "object"
          }
        },
        "required": [
          "queryResponse"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/query",
        "query": {
          "query": "{{query}}"
        },
        "success": [
          200
        ],
        "result": {
          "queryResponse": "{{response.QueryResponse}}"
        }
      }
    },
    "customers.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Customer",
      "description": "Get one QuickBooks customer by Id via GET /v3/company/{realmId}/customer/{customerId}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "description": "QuickBooks customer Id."
          }
        },
        "required": [
          "customerId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object"
          }
        },
        "required": [
          "customer"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/customer/{{customerId}}",
        "success": [
          200
        ],
        "result": {
          "customer": "{{response.Customer}}"
        }
      }
    },
    "customers.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Create Customer",
      "description": "Create a QuickBooks customer via POST /v3/company/{realmId}/customer. DisplayName is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "description": "Customer display name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Primary email address."
          },
          "companyName": {
            "type": "string",
            "minLength": 1,
            "description": "Company name."
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "description": "Notes stored on the customer."
          }
        },
        "required": [
          "displayName"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object"
          }
        },
        "required": [
          "customer"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/customer",
        "success": [
          200
        ],
        "body": {
          "DisplayName": "{{displayName}}",
          "CompanyName": "{{companyName}}",
          "Notes": "{{notes}}",
          "PrimaryEmailAddr": {
            "Address": "{{email}}"
          }
        },
        "result": {
          "customer": "{{response.Customer}}"
        }
      }
    },
    "customers.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Update Customer",
      "description": "Sparse-update a QuickBooks customer via POST /v3/company/{realmId}/customer. Id and SyncToken are required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "description": "QuickBooks customer Id."
          },
          "syncToken": {
            "type": "string",
            "minLength": 1,
            "description": "Current SyncToken from a prior read."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "description": "Updated display name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Updated primary email address."
          }
        },
        "required": [
          "customerId",
          "syncToken"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object"
          }
        },
        "required": [
          "customer"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/customer",
        "success": [
          200
        ],
        "body": {
          "sparse": true,
          "Id": "{{customerId}}",
          "SyncToken": "{{syncToken}}",
          "DisplayName": "{{displayName}}",
          "PrimaryEmailAddr": {
            "Address": "{{email}}"
          }
        },
        "result": {
          "customer": "{{response.Customer}}"
        }
      }
    },
    "invoices.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Invoice",
      "description": "Get one QuickBooks invoice by Id via GET /v3/company/{realmId}/invoice/{invoiceId}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "minLength": 1,
            "description": "QuickBooks invoice Id."
          }
        },
        "required": [
          "invoiceId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "invoice": {
            "type": "object"
          }
        },
        "required": [
          "invoice"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/invoice/{{invoiceId}}",
        "success": [
          200
        ],
        "result": {
          "invoice": "{{response.Invoice}}"
        }
      }
    },
    "invoices.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Create Invoice",
      "description": "Create a QuickBooks invoice via POST /v3/company/{realmId}/invoice. Requires customerId, itemId, and amount.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "description": "Customer Id for CustomerRef.value."
          },
          "itemId": {
            "type": "string",
            "minLength": 1,
            "description": "Item Id for the sales line ItemRef.value."
          },
          "amount": {
            "type": "number",
            "description": "Line amount in the company home currency."
          },
          "docNumber": {
            "type": "string",
            "minLength": 1,
            "description": "Optional document number."
          }
        },
        "required": [
          "customerId",
          "itemId",
          "amount"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "invoice": {
            "type": "object"
          }
        },
        "required": [
          "invoice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/invoice",
        "success": [
          200
        ],
        "body": {
          "DocNumber": "{{docNumber}}",
          "CustomerRef": {
            "value": "{{customerId}}"
          },
          "Line": [
            {
              "Amount": "{{amount}}",
              "DetailType": "SalesItemLineDetail",
              "SalesItemLineDetail": {
                "ItemRef": {
                  "value": "{{itemId}}"
                }
              }
            }
          ]
        },
        "result": {
          "invoice": "{{response.Invoice}}"
        }
      }
    },
    "invoices.send": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Send Invoice",
      "description": "Email a QuickBooks invoice via POST /v3/company/{realmId}/invoice/{invoiceId}/send. Optional sendTo overrides the customer email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "minLength": 1,
            "description": "QuickBooks invoice Id."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Override recipient email (sendTo)."
          }
        },
        "required": [
          "invoiceId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "invoice": {
            "type": "object"
          }
        },
        "required": [
          "invoice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/invoice/{{invoiceId}}/send",
        "query": {
          "sendTo": "{{email}}"
        },
        "success": [
          200
        ],
        "result": {
          "invoice": "{{response.Invoice}}"
        }
      }
    },
