        }
      }
    },
    "payments.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "sideEffect": "write",
      "title": "Create Payment",
      "description": "Create a QuickBooks payment via POST /v3/company/{realmId}/payment. Requires customerId and amount.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "description": "Customer Id for CustomerRef.value."
          },
          "amount": {
            "type": "number",
            "description": "Payment TotalAmt in the company home currency."
          }
        },
        "required": [
          "customerId",
          "amount"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "payment": {
            "type": "object"
          }
        },
        "required": [
          "payment"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/payment",
        "success": [
          200
        ],
        "body": {
          "CustomerRef": {
            "value": "{{customerId}}"
          },
          "TotalAmt": "{{amount}}"
        },
        "result": {
          "payment": "{{response.Payment}}"
        }
      }
    },
    "vendors.get": {
