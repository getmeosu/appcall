{
  "key": "espocrm",
  "name": "EspoCRM",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "EspoCRM API key",
          "required": true,
          "secret": true
        },
        {
          "key": "instance",
          "label": "EspoCRM Cloud instance subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.espocloud.com"
    ]
  },
  "models": [
    "user",
    "metadata",
    "record",
    "related",
    "stream",
    "attachment",
    "webhook",
    "team",
    "currencyRate"
  ],
  "http": {
    "baseUrl": "https://{{instance}}.espocloud.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Api-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errorMessage"
      ]
    }
  },
  "operations": {
