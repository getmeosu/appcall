{
  "key": "grafana",
  "name": "Grafana",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Grafana service account token",
          "required": true,
          "secret": true
        },
        {
          "key": "stack",
          "label": "Grafana Cloud stack slug",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "*.grafana.net"
    ]
  },
  "models": [
    "organization",
    "datasource",
    "alert-rule",
    "contact-point",
    "folder",
    "dashboard",
    "annotation"
  ],
  "http": {
    "baseUrl": "https://{{stack}}.grafana.net",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail",
        "title"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
