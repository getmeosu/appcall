    "sobjects.query": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "SOQL Query",
      "description": "Execute a SOQL (Salesforce Object Query Language) query against the Salesforce REST API and return matching records.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A valid SOQL query string, e.g. 'SELECT Id, Name FROM Account WHERE Industry = \\'Technology\\' LIMIT 50'."
          }
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "result": {
            "type": "object",
            "properties": {
              "totalSize": { "type": "number" },
              "done": { "type": "boolean" },
              "nextRecordsUrl": { "type": "string" },
              "records": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "sobjects.search": {
