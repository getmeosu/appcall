      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "SOSL Search",
      "description": "Execute a SOSL (Salesforce Object Search Language) full-text search across multiple Salesforce objects and return matching records.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A valid SOSL query string, e.g. 'FIND {Acme} IN ALL FIELDS RETURNING Account(Id, Name), Contact(Id, Name)'."
          }
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "result": {
            "type": "object",
            "properties": {
              "searchRecords": { "type": "array", "items": { "type": "object" } },
              "count": { "type": "number" }
            }
          }
        }
      }
    },
