        "type": "object",
        "properties": {
          "designId": {
            "type": "string",
            "minLength": 1,
            "description": "Design ID."
          },
          "callbackUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Webhook URL that receives NEW_BANNER_BATCH."
          },
          "templateFormatNames": {
            "type": "array",
            "minItems": 1,
            "description": "Format names to generate.",
            "items": {
              "type": "string"
            }
          },
          "elements": {
            "type": "object",
            "description": "Layer overrides keyed by element name."
          }
        },
        "additionalProperties": false,
        "required": [
