    "banners.generate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Generate image",
      "description": "Synchronously generate one image from an Abyssale design.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "designId": {
            "type": "string",
            "minLength": 1,
            "description": "Design ID."
          },
          "templateFormatName": {
            "type": "string",
            "minLength": 1,
            "description": "Format name to generate."
          },
          "elements": {
            "type": "object",
            "description": "Layer overrides keyed by element name."
          }
        },
        "additionalProperties": false,
        "required": [
          "designId",
          "templateFormatName"
        ]
      },
      "outputSchema": {
        "type": "object",
