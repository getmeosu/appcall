          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "template_format_name": "{{templateFormatName}}",
          "elements": "{{elements}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
