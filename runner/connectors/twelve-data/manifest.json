            "type": "string",
            "minLength": 1,
            "description": "Exchange where the instrument is traded."
          },
          "micCode": {
            "type": "string",
            "minLength": 1,
            "description": "Market Identifier Code (MIC)."
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive historical start date or datetime."
          },
          "endDate": {
            "type": "string",
            "minLength": 1,
            "description": "Inclusive historical end date or datetime."
          },
          "order": {
            "type": "string",
            "minLength": 1,
            "description": "Sort order of returned values.",
            "enum": [
              "ASC",
              "DESC"
            ]
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "description": "Output timezone such as Exchange, UTC, or an IANA name."
