{
  "key": "freshteam",
  "name": "Freshteam",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ats-recruitment"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Freshteam API key",
          "required": true,
          "secret": true
        },
        {
          "key": "domain",
          "label": "Freshteam domain",
          "description": "The Freshteam subdomain only, for example acme in acme.freshteam.com. Do not include a scheme, path, port, or another host.",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.freshteam.com"
    ]
  },
  "models": [
    "employee",
    "job-posting",
    "time-off",
    "department",
    "team",
    "role",
    "new-hire"
  ],
  "http": {
    "baseUrl": "https://{{domain}}.freshteam.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "errors.0.message",
        "message",
        "description",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate Freshteam credentials with a first-page employee list probe.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/api/employees",
        "query": {
          "page": 1
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "employees.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
