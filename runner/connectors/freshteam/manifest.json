    "employees.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Create employee",
      "description": "Create a Freshteam employee directory record.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "Employee first name.",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "description": "Employee last name.",
            "minLength": 1
          },
          "officialEmail": {
            "type": "string",
            "description": "Official work email.",
            "minLength": 1
          },
          "roleIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "description": "Role identifier.",
              "minimum": 1
            },
            "description": "Role IDs assigned at create time."
          },
          "joiningDate": {
            "type": "string",
            "description": "Joining date as YYYY-MM-DD."
          },
          "designation": {
            "type": "string",
            "description": "Job title."
          }
        },
        "additionalProperties": false,
        "required": [
          "firstName",
          "lastName",
          "officialEmail",
          "roleIds"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/employees",
        "success": [
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "first_name": "{{firstName}}",
          "last_name": "{{lastName}}",
          "official_email": "{{officialEmail}}",
          "role_ids": "{{roleIds}}",
          "joining_date": "{{joiningDate}}",
          "designation": "{{designation}}"
        }
      }
    },
