{
  "key": "trello",
  "name": "Trello",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": ["productivity"],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "API key",
          "required": true,
          "secret": false
        },
        {
          "key": "token",
          "label": "API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": ["api.trello.com"]
  },
  "http": {
    "baseUrl": "https://api.trello.com/1",
    "auth": {
      "field": "token",
      "in": "query",
      "name": "token",
      "value": "{{token}}"
    },
    "query": {
      "key": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [429],
      "defaultRetryAfterSeconds": 10,
      "messagePaths": ["message", "error"]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the API key and token by calling GET /members/me, using the literal \"me\" the API accepts for the caller's own member. Takes no input beyond the key and token, and requests a trimmed field set (id, username, fullName, url) to avoid the default full member payload.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "id": { "type": "string" },
          "username": { "type": "string" },
          "fullName": { "type": "string" },
          "url": { "type": "string" }
        }
      },
      "request": {
        "method": "GET",
        "path": "/members/me",
        "query": {
          "fields": "id,username,fullName,url"
        },
        "success": [200],
        "echo": { "status": "ok" },
        "result": {
          "status": "ok",
          "id": "{{response.id}}",
          "username": "{{response.username}}",
          "fullName": "{{response.fullName}}",
          "url": "{{response.url}}"
        }
      }
    },
    "card.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create Card",
      "description": "Create a card on a list. idList is required. All parameters are sent in the query string, not a JSON body — Trello's spec declares them in:query even for this POST, and a JSON body is silently ignored. The created card's id is id; its navigable URL is shortUrl.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "idList": { "type": "string", "description": "List id the card is created on." },
          "name": { "type": "string", "description": "Card title." },
          "desc": { "type": "string", "description": "Card description." },
          "pos": { "type": "string", "description": "Position: \"top\", \"bottom\", or a positive number." },
          "due": { "type": "string", "description": "Due date, ISO 8601, or null to clear." },
          "start": { "type": "string", "description": "Start date, ISO 8601, or null to clear." },
          "dueComplete": { "type": "boolean", "description": "Whether the due date is marked complete." },
          "idMembers": { "type": "array", "items": { "type": "string" }, "description": "Member ids to assign to the card." },
          "idLabels": { "type": "array", "items": { "type": "string" }, "description": "Label ids to apply to the card." },
          "urlSource": { "type": "string", "description": "An http/https URL to attach to the card on create." },
          "idCardSource": { "type": "string", "description": "Id of a card to copy this card's data from." },
          "keepFromSource": { "type": "string", "description": "\"all\" or a comma-separated list of properties to copy when idCardSource is given." }
        },
        "required": ["idList"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "card": { "type": "object" } }
      },
      "sample": { "idList": "5f1e9a2b3c4d5e6f7a8b9c0d", "name": "Draft the release notes" },
      "request": {
        "method": "POST",
        "path": "/cards",
        "query": {
          "idList": "{{idList}}",
          "name": "{{name}}",
          "desc": "{{desc}}",
          "pos": "{{pos}}",
          "due": "{{due}}",
          "start": "{{start}}",
          "dueComplete": "{{dueComplete}}",
          "idMembers": "{{idMembers}}",
          "idLabels": "{{idLabels}}",
          "urlSource": "{{urlSource}}",
          "idCardSource": "{{idCardSource}}",
          "keepFromSource": "{{keepFromSource}}"
        },
        "success": [200],
        "result": { "card": "{{response}}" }
      }
    },
    "card.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Get Card",
      "description": "Fetch a single card by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Card id." },
          "fields": { "type": "string", "description": "\"all\" or a comma-separated list of card fields to include." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "card": { "type": "object" } }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c1a" },
      "request": {
        "method": "GET",
        "path": "/cards/{{id}}",
        "query": {
          "fields": "{{fields}}"
        },
        "success": [200],
        "result": { "card": "{{response}}" }
      }
    },
    "card.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Update Card",
      "description": "Update a card. Omitted fields are left unchanged, and every parameter is sent in the query string, not a JSON body. Setting closed=true IS the archive operation — Trello has no separate archive endpoint. This is not the same as Delete Card, which permanently removes the card and cannot be undone; use closed=true here to archive, and Delete Card only when the card must be gone for good.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Card id to update." },
          "name": { "type": "string", "description": "New card title." },
          "desc": { "type": "string", "description": "New card description." },
          "closed": { "type": "boolean", "description": "true archives the card (the archive operation); false unarchives it. Trello has no separate archive endpoint." },
          "idMembers": { "type": "array", "items": { "type": "string" }, "description": "Replacement list of assigned member ids." },
          "idAttachmentCover": { "type": "string", "description": "Attachment id to use as the card cover." },
          "idList": { "type": "string", "description": "Move the card to this list id." },
          "idLabels": { "type": "array", "items": { "type": "string" }, "description": "Replacement list of label ids." },
          "idBoard": { "type": "string", "description": "Move the card to this board id." },
          "pos": { "type": "string", "description": "Position: \"top\", \"bottom\", or a positive number." },
          "due": { "type": "string", "description": "Due date, ISO 8601, or null to clear." },
          "start": { "type": "string", "description": "Start date, ISO 8601, or null to clear." },
          "dueComplete": { "type": "boolean", "description": "Whether the due date is marked complete." },
          "subscribed": { "type": "boolean", "description": "Whether the caller is subscribed to the card." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "card": { "type": "object" } }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c1a", "closed": true },
      "request": {
        "method": "PUT",
        "path": "/cards/{{id}}",
        "query": {
          "name": "{{name}}",
          "desc": "{{desc}}",
          "closed": "{{closed}}",
          "idMembers": "{{idMembers}}",
          "idAttachmentCover": "{{idAttachmentCover}}",
          "idList": "{{idList}}",
          "idLabels": "{{idLabels}}",
          "idBoard": "{{idBoard}}",
          "pos": "{{pos}}",
          "due": "{{due}}",
          "start": "{{start}}",
          "dueComplete": "{{dueComplete}}",
          "subscribed": "{{subscribed}}"
        },
        "success": [200],
        "result": { "card": "{{response}}" }
      }
    },
    "card.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Delete Card",
      "description": "PERMANENTLY delete a card. This cannot be undone and is NOT the archive operation — to archive a card (reversible), use Update Card with closed=true instead. Only use this when the card must be gone for good.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Card id to permanently delete." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": { "type": "boolean" },
          "id": { "type": "string" }
        }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c1a" },
      "request": {
        "method": "DELETE",
        "path": "/cards/{{id}}",
        "success": [200, 204],
        "result": {
          "deleted": true,
          "id": "{{input.id}}"
        }
      }
    },
    "card.addComment": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Add Comment to Card",
      "description": "Post a comment on a card, as a new Action. text is required and is sent in the query string, not a JSON body. The response is an Action object: the comment id is id, the comment text is at data.text, and the card it was posted to is at data.card.id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Card id to comment on." },
          "text": { "type": "string", "description": "Comment text." }
        },
        "required": ["id", "text"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "comment": { "type": "object" } }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c1a", "text": "Shipped, moving to review." },
      "request": {
        "method": "POST",
        "path": "/cards/{{id}}/actions/comments",
        "query": {
          "text": "{{text}}"
        },
        "success": [200],
        "result": { "comment": "{{response}}" }
      }
    },
    "card.addChecklist": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Add Checklist to Card",
      "description": "Create a checklist on a card. All parameters are sent in the query string, not a JSON body.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Card id to add the checklist to." },
          "name": { "type": "string", "description": "Checklist name." },
          "idChecklistSource": { "type": "string", "description": "Id of an existing checklist to copy items from." },
          "pos": { "type": "string", "description": "Position: \"top\", \"bottom\", or a positive number." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "checklist": { "type": "object" } }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c1a", "name": "Launch checklist" },
      "request": {
        "method": "POST",
        "path": "/cards/{{id}}/checklists",
        "query": {
          "name": "{{name}}",
          "idChecklistSource": "{{idChecklistSource}}",
          "pos": "{{pos}}"
        },
        "success": [200],
        "result": { "checklist": "{{response}}" }
      }
    },
    "checklist.addItem": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Add Checklist Item",
      "description": "Add an item to a checklist. id (the checklist id) and name are required and are sent in the query string, not a JSON body.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Checklist id." },
          "name": { "type": "string", "description": "Item text, 1-16384 characters." },
          "pos": { "type": "string", "description": "Position: \"top\", \"bottom\", or a positive number." },
          "checked": { "type": "boolean", "description": "Whether the item starts checked." },
          "due": { "type": "string", "description": "Due date, ISO 8601." },
          "idMember": { "type": "string", "description": "Member id to assign the item to." }
        },
        "required": ["id", "name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "checkItem": { "type": "object" } }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c2b", "name": "Write the changelog" },
      "request": {
        "method": "POST",
        "path": "/checklists/{{id}}/checkItems",
        "query": {
          "name": "{{name}}",
          "pos": "{{pos}}",
          "checked": "{{checked}}",
          "due": "{{due}}",
          "idMember": "{{idMember}}"
        },
        "success": [200],
        "result": { "checkItem": "{{response}}" }
      }
    },
    "list.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create List",
      "description": "Create a list on a board. name and idBoard are required and are sent in the query string, not a JSON body. Lists have no navigable URL of their own; use the board's shortUrl.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "List name." },
          "idBoard": { "type": "string", "description": "Board id the list is created on." },
          "idListSource": { "type": "string", "description": "Id of an existing list to copy from." },
          "pos": { "type": "string", "description": "Position: \"top\", \"bottom\", or a positive number." }
        },
        "required": ["name", "idBoard"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "list": { "type": "object" } }
      },
      "sample": { "name": "In review", "idBoard": "5f1e9a2b3c4d5e6f7a8b9c0a" },
      "request": {
        "method": "POST",
        "path": "/lists",
        "query": {
          "name": "{{name}}",
          "idBoard": "{{idBoard}}",
          "idListSource": "{{idListSource}}",
          "pos": "{{pos}}"
        },
        "success": [200],
        "result": { "list": "{{response}}" }
      }
    },
    "list.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Update List",
      "description": "Update a list. Omitted fields are left unchanged, and every parameter is sent in the query string, not a JSON body. Setting closed=true archives the list; Trello has no separate list-delete endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "List id to update." },
          "name": { "type": "string", "description": "New list name." },
          "closed": { "type": "boolean", "description": "true archives the list; false unarchives it." },
          "idBoard": { "type": "string", "description": "Move the list to this board id." },
          "pos": { "type": "string", "description": "Position: \"top\", \"bottom\", or a positive number." },
          "subscribed": { "type": "boolean", "description": "Whether the caller is subscribed to the list." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "list": { "type": "object" } }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c0d", "closed": true },
      "request": {
        "method": "PUT",
        "path": "/lists/{{id}}",
        "query": {
          "name": "{{name}}",
          "closed": "{{closed}}",
          "idBoard": "{{idBoard}}",
          "pos": "{{pos}}",
          "subscribed": "{{subscribed}}"
        },
        "success": [200],
        "result": { "list": "{{response}}" }
      }
    },
    "list.getCards": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get List Cards",
      "description": "List the cards on a list. Trello has no cursor for this endpoint — it returns the entire array in one response, so there is no pagination to drive here.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "List id." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "cards": { "type": "array", "items": { "type": "object" } }
        }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c0d" },
      "request": {
        "method": "GET",
        "path": "/lists/{{id}}/cards",
        "success": [200],
        "result": { "cards": "{{response}}" }
      }
    },
    "board.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "sideEffect": "write",
      "title": "Create Board",
      "description": "Create a board. name is required, 1-16384 characters, and every parameter is sent in the query string, not a JSON body. The path is POST /boards/ WITH a trailing slash — POST /boards (no slash) does not exist in Trello's spec. The created board's id is id; its navigable URL is shortUrl.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Board name, 1-16384 characters." },
          "defaultLabels": { "type": "boolean", "description": "Create the default set of labels on the board." },
          "defaultLists": { "type": "boolean", "description": "Create the default set of lists on the board." },
          "desc": { "type": "string", "description": "Board description." },
          "idOrganization": { "type": "string", "description": "Workspace (organization) id to create the board in." },
          "idBoardSource": { "type": "string", "description": "Id of an existing board to copy from." },
          "keepFromSource": { "type": "string", "description": "\"all\" or a comma-separated list of properties to copy when idBoardSource is given." },
          "powerUps": { "type": "string", "description": "Power-ups to enable, e.g. \"all\"." },
          "prefs_permissionLevel": { "type": "string", "description": "\"org\", \"private\", or \"public\"." },
          "prefs_selfJoin": { "type": "boolean", "description": "Whether workspace members may join the board themselves." },
          "prefs_cardCovers": { "type": "boolean", "description": "Whether card covers are shown." },
          "prefs_background": { "type": "string", "description": "Board background id or color name." },
          "prefs_cardAging": { "type": "string", "description": "\"pirate\" or \"regular\"." }
        },
        "required": ["name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": { "board": { "type": "object" } }
      },
      "sample": { "name": "Q3 Launch" },
      "request": {
        "method": "POST",
        "path": "/boards/",
        "query": {
          "name": "{{name}}",
          "defaultLabels": "{{defaultLabels}}",
          "defaultLists": "{{defaultLists}}",
          "desc": "{{desc}}",
          "idOrganization": "{{idOrganization}}",
          "idBoardSource": "{{idBoardSource}}",
          "keepFromSource": "{{keepFromSource}}",
          "powerUps": "{{powerUps}}",
          "prefs_permissionLevel": "{{prefs_permissionLevel}}",
          "prefs_selfJoin": "{{prefs_selfJoin}}",
          "prefs_cardCovers": "{{prefs_cardCovers}}",
          "prefs_background": "{{prefs_background}}",
          "prefs_cardAging": "{{prefs_cardAging}}"
        },
        "success": [200],
        "result": { "board": "{{response}}" }
      }
    },
    "board.getLists": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Board Lists",
      "description": "List the lists on a board. Trello has no cursor for this endpoint — it returns the entire array in one response, so there is no pagination to drive here.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Board id." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "lists": { "type": "array", "items": { "type": "object" } }
        }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c0a" },
      "request": {
        "method": "GET",
        "path": "/boards/{{id}}/lists",
        "success": [200],
        "result": { "lists": "{{response}}" }
      }
    },
    "board.getCards": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Board Cards",
      "description": "List the cards on a board. Trello has no cursor for this endpoint — it returns the entire array in one response, so there is no pagination to drive here.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Board id." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "cards": { "type": "array", "items": { "type": "object" } }
        }
      },
      "sample": { "id": "5f1e9a2b3c4d5e6f7a8b9c0a" },
      "request": {
        "method": "GET",
        "path": "/boards/{{id}}/cards",
        "success": [200],
        "result": { "cards": "{{response}}" }
      }
    },
    "member.getBoards": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "sideEffect": "read",
      "title": "Get Member's Boards",
      "description": "List the boards a member can see. id accepts a member id, a username, or the literal string \"me\" for the caller's own boards. Trello has no cursor for this endpoint — it returns the entire array in one response. Note: this call is part of the /1/members/ route family, which Trello rate-limits separately at 100 requests per 900 seconds, tighter than the standard per-key and per-token limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Member id, username, or the literal \"me\"." },
          "filter": { "type": "string", "description": "\"all\" or a comma-separated list of: closed, members, open, organization, public, starred." },
          "fields": { "type": "string", "description": "\"all\" or a comma-separated list of board fields to include." },
          "lists": { "type": "string", "description": "\"all\", \"closed\", \"none\", or \"open\" — which lists to include per board." }
        },
        "required": ["id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "boards": { "type": "array", "items": { "type": "object" } }
        }
      },
      "sample": { "id": "me" },
      "request": {
        "method": "GET",
        "path": "/members/{{id}}/boards",
        "query": {
          "filter": "{{filter}}",
          "fields": "{{fields}}",
          "lists": "{{lists}}"
        },
