    "teams_meetings.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Teams Meeting",
      "description": "Create a new Microsoft Teams online meeting via the Microsoft Graph API. Optionally scope the meeting to a specific user with userId. Returns the meeting's joinWebUrl, id, and joinInformation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Title/subject of the Teams meeting."
          },
          "startDateTime": {
            "type": "string",
            "description": "Meeting start date/time as an ISO 8601 string with timezone offset, e.g. '2026-06-01T09:00:00Z'."
          },
          "endDateTime": {
            "type": "string",
            "description": "Meeting end date/time as an ISO 8601 string with timezone offset."
          },
          "userId": {
            "type": "string",
            "description": "Optional. The ID or UPN of the user on whose behalf the meeting is created. Defaults to the authenticated user (me)."
          }
        },
        "required": ["subject", "startDateTime", "endDateTime"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "meeting": {
            "type": "object",
            "description": "The created online meeting object including id, joinWebUrl, and joinInformation."
          }
        }
      }
    },
    "teams_meetings.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Teams Meeting",
      "description": "Retrieve a specific Microsoft Teams online meeting by its meeting ID from Microsoft Graph.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The unique identifier of the Teams online meeting to retrieve."
          },
          "userId": {
            "type": "string",
            "description": "Optional. The ID or UPN of the user who owns the meeting. Defaults to the authenticated user (me)."
          }
        },
        "required": ["meetingId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "meeting": { "type": "object", "description": "The retrieved online meeting object." }
        }
      }
    },
    "teams_meetings.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Update Teams Meeting",
      "description": "Update an existing Microsoft Teams online meeting's subject, start time, or end time via Microsoft Graph.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
            "type": "string",
            "description": "The unique identifier of the Teams online meeting to update."
          },
          "subject": {
            "type": "string",
            "description": "New subject/title for the meeting."
          },
          "startDateTime": {
            "type": "string",
            "description": "New start date/time as ISO 8601 string."
          },
          "endDateTime": {
            "type": "string",
            "description": "New end date/time as ISO 8601 string."
          },
          "userId": {
            "type": "string",
            "description": "Optional. The ID or UPN of the meeting owner. Defaults to the authenticated user (me)."
          }
        },
        "required": ["meetingId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "meeting": { "type": "object", "description": "The updated online meeting object." }
        }
      }
    },
    "teams_meetings.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Delete Teams Meeting",
      "description": "Delete a Microsoft Teams online meeting by its meeting ID via Microsoft Graph. The Graph API returns 204 No Content on success.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "meetingId": {
