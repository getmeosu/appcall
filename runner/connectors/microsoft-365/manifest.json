      "maxResponseBytes": 5242880
    },
    "drive.items.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get OneDrive Item",
