    "drive.items.copy": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Copy OneDrive Item",
      "description": "Copy a file or folder to another location in the authenticated user's OneDrive. Returns an async operation URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "description": "The unique identifier of the drive item to copy."
          },
          "destinationId": {
            "type": "string",
            "description": "The ID of the destination folder."
          },
          "name": {
            "type": "string",
            "description": "Optional new name for the copied item."
          }
