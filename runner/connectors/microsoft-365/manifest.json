{
  "key": "microsoft-365",
  "name": "Microsoft 365",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["productivity"],
  "auth": {
    "type": "oauth2",
    "scopes": [
      "Mail.Read",
      "Mail.ReadWrite",
      "Mail.Send",
      "Calendars.Read",
      "Calendars.ReadWrite",
      "Files.Read.All",
      "Files.ReadWrite.All",
      "User.Read.All",
      "Contacts.Read",
      "Contacts.ReadWrite",
      "OnlineMeetings.Read",
      "OnlineMeetings.ReadWrite"
    ],
    "setup": {
      "mode": "oauth2",
      "fields": []
    }
  },
  "network": {
    "allowedHosts": [
      "graph.microsoft.com"
    ]
  },
  "operations": {
    "messages.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "messages.send": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 10485760,
      "maxResponseBytes": 1048576,
      "title": "Send Email",
      "description": "Send an email message from the authenticated user's Outlook mailbox via Microsoft Graph.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "description": "Recipient email addresses. Each item may be a plain address string, an object with an 'address' field, or an object with an 'emailAddress.address' field.",
            "items": {
              "type": ["string", "object"]
            },
            "minItems": 1
          },
          "subject": {
            "type": "string",
            "description": "Subject line of the email."
          },
          "body": {
            "type": "string",
            "description": "Body content of the email."
          },
          "contentType": {
            "type": "string",
            "description": "Format of the body content. Defaults to 'text'.",
            "enum": ["text", "html"]
          }
        },
        "required": ["to", "subject", "body"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "sent": { "type": "boolean" }
        }
      }
    },
    "messages.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Email Message",
      "description": "Retrieve a specific email message by its ID from the authenticated user's Outlook mailbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The unique identifier of the message to retrieve."
          }
        },
        "required": ["messageId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "message": { "type": "object", "description": "The normalized message object." }
        }
      }
    },
    "messages.reply": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 65536,
      "title": "Reply to Email",
      "description": "Reply to an existing email message in the authenticated user's Outlook mailbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The unique identifier of the message to reply to."
          },
          "comment": {
            "type": "string",
            "description": "The reply comment/body text."
          }
        },
        "required": ["messageId", "comment"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "replied": { "type": "boolean" }
        }
      }
    },
    "messages.move": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Move Email Message",
      "description": "Move an email message to a different mail folder in the authenticated user's Outlook mailbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The unique identifier of the message to move."
          },
          "destinationId": {
            "type": "string",
            "description": "The ID of the destination mail folder, or a well-known name like 'inbox', 'drafts', 'sentItems', 'deletedItems'."
          }
        },
        "required": ["messageId", "destinationId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "messageId": { "type": "string" }
        }
      }
    },
    "messages.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Delete Email Message",
      "description": "Permanently delete an email message from the authenticated user's Outlook mailbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "The unique identifier of the message to delete."
          }
        },
        "required": ["messageId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "deleted": { "type": "boolean" }
        }
      }
    },
    "mailFolders.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "List Mail Folders",
      "description": "List all mail folders in the authenticated user's Outlook mailbox.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "folders": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "events.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "events.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create Calendar Event",
      "description": "Create a new event in the authenticated user's default Outlook calendar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Title of the calendar event."
          },
          "start": {
            "type": "object",
            "description": "Start date/time with timeZone.",
            "properties": {
              "dateTime": { "type": "string", "description": "ISO 8601 date-time string, e.g. '2026-06-01T09:00:00'." },
              "timeZone": { "type": "string", "description": "IANA time zone name, e.g. 'UTC' or 'America/New_York'." }
            },
            "required": ["dateTime", "timeZone"]
          },
          "end": {
            "type": "object",
            "description": "End date/time with timeZone.",
            "properties": {
              "dateTime": { "type": "string" },
              "timeZone": { "type": "string" }
            },
            "required": ["dateTime", "timeZone"]
          },
          "body": {
            "type": "string",
            "description": "Body/description of the event."
          },
          "location": {
            "type": "string",
            "description": "Display name of the event location."
          },
          "attendees": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Email addresses of required attendees."
          },
          "isOnlineMeeting": {
            "type": "boolean",
            "description": "Whether to create a Teams online meeting link."
          }
        },
        "required": ["subject", "start", "end"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "event": { "type": "object" }
        }
      }
    },
    "events.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Update Calendar Event",
      "description": "Update an existing calendar event in the authenticated user's Outlook calendar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "The unique identifier of the event to update."
          },
          "subject": {
            "type": "string",
            "description": "New title for the event."
          },
          "start": {
            "type": "object",
            "properties": {
              "dateTime": { "type": "string" },
              "timeZone": { "type": "string" }
            },
            "required": ["dateTime", "timeZone"]
          },
          "end": {
            "type": "object",
            "properties": {
              "dateTime": { "type": "string" },
              "timeZone": { "type": "string" }
            },
            "required": ["dateTime", "timeZone"]
          },
          "body": {
            "type": "string",
            "description": "New body/description for the event."
          },
          "location": {
            "type": "string",
            "description": "New display name of the event location."
          }
        },
        "required": ["eventId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "event": { "type": "object" }
        }
      }
    },
    "events.delete": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Delete Calendar Event",
      "description": "Delete a calendar event from the authenticated user's Outlook calendar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "The unique identifier of the event to delete."
          }
        },
        "required": ["eventId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "deleted": { "type": "boolean" }
        }
      }
    },
    "events.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Calendar Event",
      "description": "Retrieve a specific calendar event by its ID from the authenticated user's Outlook calendar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "The unique identifier of the event to retrieve."
          }
        },
        "required": ["eventId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "event": { "type": "object" }
        }
      }
    },
    "calendars.list": {
      "kind": "sync",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576
    },
    "files.list": {
      "kind": "sync",
