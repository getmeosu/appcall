          "userId": {
            "type": "string",
            "description": "Optional. The ID or UPN of the meeting owner. Defaults to the authenticated user (me)."
          }
        },
        "required": ["meetingId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "deleted": { "type": "boolean" }
        }
      }
    },
