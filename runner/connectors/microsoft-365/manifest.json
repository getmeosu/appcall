      "inputSchema": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "description": "The unique identifier of the drive item to delete."
          }
        },
        "required": ["itemId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
