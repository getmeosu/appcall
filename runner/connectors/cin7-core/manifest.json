{
  "key": "cin7-core",
  "name": "Cin7 Core",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ecommerce"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Cin7 Core API Application Key",
          "required": true,
          "secret": true
        },
        {
          "key": "accountId",
          "label": "Cin7 Core Account ID",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "inventory.dearsystems.com"
    ]
  },
  "models": [
    "account",
    "customer",
    "product",
    "sale",
    "purchase",
    "supplier",
    "stock",
    "location",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://inventory.dearsystems.com/ExternalApi/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "api-auth-applicationkey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "api-auth-accountid": "{{accountId}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "message",
        "Error",
        "error",
        "ExceptionMessage"
      ]
    }
  },
  "operations": {
