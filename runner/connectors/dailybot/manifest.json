    "kudos.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List kudos",
      "description": "List Dailybot kudos the caller can access.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "enum": [
              "kudos_received",
              "kudos_given"
            ],
            "description": "Received or given."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number."
