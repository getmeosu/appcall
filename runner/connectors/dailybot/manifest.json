          200
        ],
        "query": {
          "start_date": "{{start_date}}",
          "end_date": "{{end_date}}",
          "page": "{{page}}",
          "page_size": "{{page_size}}",
          "user": "{{user}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
