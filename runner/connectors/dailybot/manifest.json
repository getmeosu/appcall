      "responseFormat": "json"
    },
    "checkins.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create check-in",
      "description": "Create a Dailybot check-in with questions and participants.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Check-in name."
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "description": "Check-in questions.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Question type."
                },
                "label": {
                  "type": "string",
                  "description": "Question label."
                },
                "short_question": {
                  "type": "string",
                  "description": "Short question text."
                }
              },
              "required": [
                "type",
                "label"
              ]
            }
          },
          "participants": {
            "type": "object",
            "description": "Participants object with user_uuids.",
            "additionalProperties": false,
            "properties": {
              "user_uuids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "team_uuids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "questions",
          "participants"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/checkins/create/",
        "success": [
          200,
          201
        ],
        "body": {
          "name": "{{name}}",
          "questions": "{{questions}}",
          "participants": "{{participants}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
