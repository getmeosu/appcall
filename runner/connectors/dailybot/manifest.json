      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List team members",
      "description": "List members of a Dailybot team.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "team_uuid": {
            "type": "string",
            "minLength": 1,
