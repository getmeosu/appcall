          "team_uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/teams/{{team_uuid}}/members/",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "teams.members.add": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Add team member",
      "description": "Add a user to a Dailybot team.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "team_uuid": {
            "type": "string",
            "minLength": 1,
            "description": "Team UUID."
          },
          "user_uuid": {
            "type": "string",
            "minLength": 1,
            "description": "User UUID to add."
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "lead"
            ],
            "description": "Team role."
          }
        },
        "additionalProperties": false,
        "required": [
          "team_uuid",
          "user_uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/teams/{{team_uuid}}/member/",
        "success": [
          200,
          201
        ],
        "body": {
          "user_uuid": "{{user_uuid}}",
          "role": "{{role}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "teams.members.remove": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Remove team member",
      "description": "Remove a user from a Dailybot team.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "team_uuid": {
            "type": "string",
            "minLength": 1,
            "description": "Team UUID."
          },
          "user_uuid": {
            "type": "string",
            "minLength": 1,
            "description": "User UUID to remove."
          }
        },
        "additionalProperties": false,
        "required": [
          "team_uuid",
          "user_uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/v1/teams/{{team_uuid}}/member/{{user_uuid}}/",
        "success": [
          204,
          200
        ],
        "result": {
          "deleted": true,
          "id": "{{input.user_uuid}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "checkins.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List check-ins",
      "description": "List Dailybot check-ins in the organization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Page size."
          },
          "search": {
            "type": "string",
            "description": "Case-insensitive name search."
          },
          "start_date": {
            "type": "string",
            "description": "Created on or after YYYY-MM-DD."
          },
          "end_date": {
            "type": "string",
            "description": "Created on or before YYYY-MM-DD."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/checkins/",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "page_size": "{{page_size}}",
          "search": "{{search}}",
          "start_date": "{{start_date}}",
          "end_date": "{{end_date}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "checkins.get": {
      "kind": "action",
