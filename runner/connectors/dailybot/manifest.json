          },
          "start_date": {
            "type": "string",
            "description": "Inclusive start date YYYY-MM-DD."
          },
          "end_date": {
            "type": "string",
            "description": "Inclusive end date YYYY-MM-DD."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Page size."
          },
          "user": {
            "type": "string",
            "description": "Filter to a participant UUID."
          }
        },
        "additionalProperties": false,
        "required": [
          "uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
