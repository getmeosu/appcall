            "type": "string",
            "description": "Optional Graph API version like v25.0. Defaults to v25.0 when omitted."
          }
        },
        "required": [
          "mediaId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "raw": {
            "type": "object"
          }
        }
      }
    },
