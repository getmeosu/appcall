            "type": "string"
          },
          "providerMessageId": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "raw": {
            "type": "object"
          }
        }
      }
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the WhatsApp connector. Takes no input and returns the connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    },
    "messages.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Get WhatsApp Message",
      "description": "Fetch a WhatsApp Cloud API message by its provider message ID (wamid) via the Graph API node lookup.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "description": "Provider message ID (wamid) to fetch."
          },
          "graphVersion": {
            "type": "string",
            "description": "Optional Graph API version like v25.0. Defaults to v25.0 when omitted."
          }
        },
        "required": [
          "messageId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "object",
            "description": "Raw Graph message node."
          }
        }
      }
    },
    "templates.list": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "List WhatsApp Templates",
      "description": "List message templates on a WhatsApp Business Account. Requires the WABA ID; templates must be approved by Meta before they can be sent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wabaId": {
            "type": "string",
            "description": "WhatsApp Business Account ID whose templates to list."
          },
          "limit": {
            "type": "integer",
            "description": "Page size for the Graph cursor."
          },
          "after": {
            "type": "string",
            "description": "Graph cursor from a previous page."
          },
          "graphVersion": {
            "type": "string",
            "description": "Optional Graph API version like v25.0. Defaults to v25.0 when omitted."
          }
        },
        "required": [
          "wabaId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "templates": {
            "type": "array",
            "description": "Template objects."
          },
          "paging": {
            "type": "object"
          }
        }
      }
    },
    "media.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "sideEffect": "read",
      "title": "Get WhatsApp Media",
      "description": "Fetch metadata for an uploaded WhatsApp media object, including a short-lived download URL. This connector does not download the bytes and does not allowlist the CDN host \u2014 only graph.facebook.com is reachable.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "Media ID returned by media.upload or an inbound media message."
          },
          "graphVersion": {
            "type": "string",
            "description": "Optional Graph API version like v25.0. Defaults to v25.0 when omitted."
          }
        },
        "required": [
          "mediaId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "media": {
            "type": "object",
            "description": "Media metadata including url, mime_type, sha256, and file_size."
          }
        }
      }
    },
    "media.upload": {
      "kind": "action",
      "timeoutMs": 20000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Upload WhatsApp Media",
      "description": "Upload media bytes to the WhatsApp Cloud API and receive a media ID that can be used in subsequent send calls. Provide filename, MIME type, and the file contents as base64. The connector posts multipart form data to the phone number's media endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Filename to send with the multipart upload."
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the file, such as image/jpeg or audio/ogg."
          },
          "fileBase64": {
            "type": "string",
            "description": "File contents encoded as base64."
          },
          "graphVersion": {
            "type": "string",
            "description": "Optional Graph API version like v25.0. Defaults to v25.0 when omitted."
          }
        },
        "required": [
          "filename",
          "mimeType",
          "fileBase64"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "mediaId": {
            "type": "string"
          },
          "raw": {
            "type": "object"
          }
        }
      }
    },
    "media.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "sideEffect": "write",
      "title": "Delete WhatsApp Media",
      "description": "Delete an uploaded WhatsApp media object by ID. Inbound media cannot be deleted this way.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "Media ID to delete."
