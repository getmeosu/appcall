  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Raindrop.io test token or access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.raindrop.io"
    ]
  },
  "models": [
    "user",
    "collection",
    "raindrop",
    "tag",
    "highlight",
    "filter"
  ],
  "http": {
    "baseUrl": "https://api.raindrop.io/rest/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errorMessage",
        "error",
        "message"
      ]
    }
  },
