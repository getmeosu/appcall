    "documents.resend": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 2097152,
      "title": "Resend Document",
      "description": "Resend signing notifications for specific recipients. POST https://app.docnify.io/api/v1/documents/{documentId}/resend requires a JSON recipients array and returns a JSON message. The live tool page only lists id; the v1 body still requires recipient ids.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "recipients"
        ],
        "properties": {
          "documentId": {
            "type": "integer",
            "minimum": 1,
            "description": "Document ID. Live tool parameter id."
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Recipient IDs who should receive the signing notification again."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/documents/{{documentId}}/resend",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "recipients": "{{recipients}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.send": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 2097152,
      "title": "Send Document",
      "description": "Send a document for signing. POST https://app.docnify.io/api/v1/documents/{documentId}/send accepts a JSON object and returns the document JSON plus a message. Omitted email flags use the server default.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId"
        ],
        "properties": {
          "documentId": {
            "type": "integer",
            "minimum": 1,
            "description": "Document ID. Live tool parameter id."
          },
          "sendEmail": {
            "type": "boolean",
            "description": "Whether to email recipients. The server defaults this to true when omitted."
          },
          "sendCompletionEmails": {
            "type": "boolean",
            "description": "Whether to send completion emails. Omit to keep the document email settings."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/documents/{{documentId}}/send",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "sendEmail": "{{sendEmail}}",
          "sendCompletionEmails": "{{sendCompletionEmails}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.fields.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "title": "Update Document Field",
      "description": "Update one document field. PATCH https://app.docnify.io/api/v1/documents/{documentId}/fields/{fieldId} is the single JSON route for the live update-fields tool; each field is this same path, not a second route.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "fieldId"
        ],
        "properties": {
          "documentId": {
            "type": "integer",
            "minimum": 1,
            "description": "Document ID. Live tool parameter documentId."
          },
          "fieldId": {
            "type": "integer",
            "minimum": 1,
            "description": "Field ID placed in the path. The v1 update route is one field per request."
          },
          "recipientId": {
            "type": "integer",
            "minimum": 1,
            "description": "Recipient who must complete this field."
          },
          "type": {
            "type": "string",
            "enum": [
              "SIGNATURE",
              "FREE_SIGNATURE",
              "INITIALS",
              "NAME",
              "EMAIL",
              "DATE",
              "TEXT",
              "NUMBER",
              "RADIO",
              "CHECKBOX",
              "DROPDOWN"
            ],
            "description": "Docnify field type."
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page number."
          },
          "pageX": {
            "type": "number",
            "description": "Horizontal position of the field."
          },
          "pageY": {
            "type": "number",
            "description": "Vertical position of the field."
          },
          "pageWidth": {
            "type": "number",
            "description": "Field width."
          },
          "pageHeight": {
            "type": "number",
            "description": "Field height."
          },
          "fieldMeta": {
            "type": "object",
            "additionalProperties": true,
            "description": "Replacement field metadata, such as label or required."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "PATCH",
        "path": "/documents/{{documentId}}/fields/{{fieldId}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "recipientId": "{{recipientId}}",
          "type": "{{type}}",
          "pageNumber": "{{pageNumber}}",
          "pageX": "{{pageX}}",
          "pageY": "{{pageY}}",
          "pageWidth": "{{pageWidth}}",
          "pageHeight": "{{pageHeight}}",
          "fieldMeta": "{{fieldMeta}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.recipients.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
