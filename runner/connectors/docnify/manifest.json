          "documentId",
          "recipientId"
        ],
        "properties": {
          "documentId": {
            "type": "integer",
            "minimum": 1,
            "description": "Document ID. Live tool parameter documentId."
          },
          "recipientId": {
            "type": "integer",
            "minimum": 1,
            "description": "Recipient ID. Live tool parameter recipientId."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Full name of the recipient."
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "description": "Email address of the recipient."
          },
          "role": {
            "type": "string",
            "enum": [
              "SIGNER",
              "APPROVER",
              "VIEWER",
              "ASSISTANT",
              "CC"
            ],
            "description": "Recipient role."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "PATCH",
        "path": "/documents/{{documentId}}/recipients/{{recipientId}}",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "role": "{{role}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
