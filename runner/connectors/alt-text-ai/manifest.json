    "images.create": {
      "description": "Add an image by public URL or base64 payload and generate alt text via POST /images. Maps ALTTEXT_AI_CREATE_IMAGE. Rate limited to 4 calls per second.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "async_mode": {
            "description": "Queue generation in the background. Official JSON field is async. Default false.",
            "type": "boolean"
          },
          "ecomm": {
            "additionalProperties": false,
            "description": "Ecommerce product data for product-aware alt text.",
            "properties": {
              "brand": {
                "description": "Brand name.",
                "minLength": 1,
                "type": "string"
              },
              "color": {
                "description": "Product color.",
                "minLength": 1,
                "type": "string"
              },
              "product": {
                "description": "Product name.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "product"
            ],
            "type": "object"
          },
          "gpt_prompt": {
            "description": "Final-pass prompt. Must include the {{AltText}} macro and be written in English.",
            "minLength": 1,
            "type": "string"
          },
          "image": {
            "additionalProperties": false,
            "description": "Image payload. Provide either url or raw.",
            "properties": {
              "asset_id": {
                "description": "Optional client asset ID. Cannot contain ?&#/%<>+",
                "minLength": 1,
                "type": "string"
              },
              "metadata": {
                "description": "Custom metadata returned on later reads and webhooks.",
                "type": "object"
              },
              "raw": {
                "description": "RFC 4648 base64-encoded image bytes when the file has no public URL.",
                "minLength": 1,
                "type": "string"
              },
              "tags": {
                "description": "Words or phrases associated with the image.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "url": {
                "description": "Publicly accessible image URL.",
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "keyword_source": {
            "description": "Text mined for keywords when keywords is omitted. Minimum 12 characters.",
            "minLength": 12,
            "type": "string"
          },
          "keywords": {
            "description": "SEO keywords or phrases (max 6, English).",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "lang": {
            "description": "Comma-separated language codes (for example en,es,fr). Default account language.",
            "minLength": 1,
            "type": "string"
          },
          "max_chars": {
            "description": "Maximum generated alt text length.",
            "maximum": 500,
            "minimum": 80,
            "type": "integer"
          },
          "model_name": {
            "description": "Language model for generation.",
            "enum": [
              "describe-detailed",
              "describe-regular",
              "describe-factual",
              "succinct-describe-factual",
              "describe-terse"
            ],
            "type": "string"
          },
          "negative_keywords": {
            "description": "Keywords to strip from generated alt text (max 6, English).",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "overwrite": {
            "description": "Regenerate alt text when the URL or asset ID already exists. Default false.",
            "type": "boolean"
          },
          "timeout_secs": {
            "description": "Seconds to wait for generation (5-30). Default 12.",
            "maximum": 30,
            "minimum": 5,
            "type": "integer"
          },
          "webhook_url": {
            "description": "Per-request webhook override. Omit to use the account default.",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 22020096,
      "maxResponseBytes": 1048576,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "async": "{{async_mode}}",
          "ecomm": "{{ecomm}}",
          "gpt_prompt": "{{gpt_prompt}}",
          "image": "{{image}}",
          "keyword_source": "{{keyword_source}}",
          "keywords": "{{keywords}}",
          "lang": "{{lang}}",
          "max_chars": "{{max_chars}}",
          "model_name": "{{model_name}}",
          "negative_keywords": "{{negative_keywords}}",
          "overwrite": "{{overwrite}}",
          "timeout_secs": "{{timeout_secs}}",
          "webhook_url": "{{webhook_url}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/images",
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 35000,
      "title": "Create image",
      "validationMode": "strict-generated"
    },
    "images.bulk_create": {
