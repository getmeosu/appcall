            "type": "object"
          },
          "lang": {
            "description": "Language code(s) for the updated alt text.",
            "minLength": 1,
            "type": "string"
          },
          "overwrite": {
            "description": "Overwrite existing alt text in the requested language(s). Default false.",
            "type": "boolean"
          }
        },
        "required": [
          "asset_id",
          "image"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
