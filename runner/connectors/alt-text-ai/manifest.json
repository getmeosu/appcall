      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "include_existing": {
            "description": "Process images that already have HTML alt text. Default false.",
            "type": "boolean"
          },
          "keywords": {
            "description": "SEO keywords for each scraped image (max 6, English).",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "lang": {
            "description": "Comma-separated language codes for generated alt text.",
            "minLength": 1,
            "type": "string"
          },
          "negative_keywords": {
            "description": "Keywords to strip from generated alt text (max 6, English).",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "page_scrape": {
            "additionalProperties": false,
            "description": "Page to scrape. Provide url and/or html.",
            "properties": {
              "html": {
                "description": "Raw HTML document to parse when not fetching a URL.",
                "minLength": 1,
                "type": "string"
              },
              "url": {
                "description": "Page URL to download and scrape.",
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "page_scrape"
        ],
        "type": "object"
      },
