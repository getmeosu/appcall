          },
          "image": {
            "additionalProperties": false,
            "description": "Fields to update. URL cannot be changed.",
            "properties": {
              "alt_text": {
                "description": "Replacement alt text.",
                "minLength": 1,
                "type": "string"
              },
              "asset_id": {
                "description": "New unique asset ID.",
                "minLength": 1,
                "type": "string"
              },
              "metadata": {
                "description": "Replacement custom metadata.",
                "type": "object"
