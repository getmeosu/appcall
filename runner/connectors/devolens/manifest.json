    "web-api-logs.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Web API Logs",
      "description": "Return one page of Cryptolens Web API logs with GET https://api.cryptolens.io/api/ai/GetWebAPILog. eventTypes are integer state codes sent as one JSON array in States, for example 3010 for CreateKey. timeFilter is the Time JSON object of unix bounds gt, gte, lt, and lte. nextCursor is StartingAfter: a log id, or the request unix time when timeFilter is set. licenseKey requires productId. The token needs Get Web API Log.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum logs in this page. The provider default is 10 and the maximum is 1000."
          },
          "productId": {
            "type": "integer",
            "minimum": 1,
            "description": "Only return logs for this product ID. Required when licenseKey is set."
          },
          "eventTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "description": "Integer Cryptolens state codes to include, sent as the States JSON array. 3010 is CreateKey and 2010 is a successful activation.",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            }
          },
          "licenseKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Only return logs for this license key. Requires productId."
          },
          "nextCursor": {
            "type": "integer",
            "minimum": 0,
            "description": "Forward cursor sent as StartingAfter. It is a log id, or a request Unix timestamp when timeFilter is set."
          },
          "timeFilter": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "description": "Unix timestamp bounds for the request time. At least one of gt, gte, lt, or lte is required.",
            "properties": {
              "gt": {
                "type": "integer",
                "minimum": 0,
                "description": "Request time strictly greater than this Unix timestamp."
              },
              "gte": {
                "type": "integer",
                "minimum": 0,
                "description": "Request time greater than or equal to this Unix timestamp."
              },
              "lt": {
                "type": "integer",
                "minimum": 0,
                "description": "Request time strictly less than this Unix timestamp."
              },
              "lte": {
                "type": "integer",
                "minimum": 0,
