            "type": "string",
            "description": "API type.",
            "enum": [
              "fetch",
              "preview"
            ]
          },
          "locale": {
            "type": "string",
            "description": "Locale code, for example en-us.",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "description": "Digital channel reference name.",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "description": "Page path, for example /about.",
            "minLength": 1
          },
          "contentLinkDepth": {
            "type": "integer",
            "description": "Linked content expansion depth.",
            "minimum": 0,
            "maximum": 5
          },
          "expandAllContentLinks": {
            "type": "boolean",
            "description": "Expand linked content references."
          }
        },
        "additionalProperties": false,
        "required": [
          "guid",
          "apiType",
          "locale",
          "channel"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/{{guid}}/{{apiType}}/{{locale}}/page/{{channel}}",
        "success": [
          200,
          201
        ],
        "query": {
          "path": "{{path}}",
          "contentLinkDepth": "{{contentLinkDepth}}",
          "expandAllContentLinks": "{{expandAllContentLinks}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
