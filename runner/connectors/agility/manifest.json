    "content.save": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Save content item",
      "description": "Create or update an Agility CMS content item via the Management API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "description": "Agility instance GUID.",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "description": "Locale code, for example en-us.",
            "minLength": 1
          },
          "contentID": {
            "type": "integer",
            "description": "Content ID. Use 0 to create.",
            "minimum": 0
          },
          "definitionName": {
            "type": "string",
            "description": "Content model definition name.",
            "minLength": 1
          },
          "referenceName": {
            "type": "string",
            "description": "Content list reference name.",
            "minLength": 1
          },
          "fields": {
            "type": "object",
            "description": "Content field values.",
            "additionalProperties": true
          }
        },
        "additionalProperties": false,
        "required": [
          "guid",
          "locale",
          "definitionName",
          "referenceName",
          "fields"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/api/v1/instance/{{guid}}/{{locale}}/item",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": "Bearer {{apiKey}}"
        },
        "body": {
          "contentID": "{{contentID}}",
          "properties": {
            "definitionName": "{{definitionName}}",
            "referenceName": "{{referenceName}}"
          },
          "fields": "{{fields}}"
        },
        "baseUrl": "https://mgmt.aglty.io"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
