{
  "key": "agility",
  "name": "Agility CMS",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Agility CMS API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.aglty.io",
      "mgmt.aglty.io"
    ]
  },
  "models": [
    "content-model",
    "content",
    "page",
    "sitemap",
    "gallery",
    "sync",
    "redirection",
    "container",
    "asset",
    "locale"
  ],
  "http": {
    "baseUrl": "https://api.aglty.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "APIKey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail",
        "title"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate an Agility CMS API key by listing content models.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "minLength": 1
          },
          "apiType": {
            "type": "string",
            "enum": [
              "fetch",
              "preview"
            ]
          }
        },
        "required": [
          "guid",
          "apiType"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/{{guid}}/{{apiType}}/contentmodels",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "content.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List content",
      "description": "Retrieve an Agility CMS content list by reference name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "minLength": 1
          },
          "apiType": {
            "type": "string",
            "enum": [
              "fetch",
              "preview"
            ]
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "referenceName": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "string",
            "minLength": 1
          },
          "take": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250
          },
          "skip": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "guid",
          "apiType",
          "locale",
          "referenceName"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/{{guid}}/{{apiType}}/{{locale}}/list/{{referenceName}}",
        "query": {
          "Fields": "{{fields}}",
          "Take": "{{take}}",
          "Skip": "{{skip}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
