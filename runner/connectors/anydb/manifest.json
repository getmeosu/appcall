            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "success"
                ]
              },
              "data": {
                "type": "array"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
