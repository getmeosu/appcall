    "records.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List records",
      "description": "List records in an AnyDB database with optional pagination.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "teamid": {
            "type": "string",
            "minLength": 1,
            "description": "Team ID."
          },
          "adbid": {
            "type": "string",
            "minLength": 1,
            "description": "Database ID."
          },
          "parentid": {
            "type": "string",
            "minLength": 1,
            "description": "Optional parent record ID."
          },
          "pagesize": {
            "type": "integer",
            "description": "Page size.",
            "minimum": 1,
            "maximum": 100
          },
          "lastmarker": {
            "type": "string",
            "minLength": 1,
            "description": "Pagination marker from a previous page."
          }
        },
        "required": [
          "teamid",
          "adbid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/integrations/ext/list",
        "success": [
          200
        ],
        "query": {
          "teamid": "{{teamid}}",
          "adbid": "{{adbid}}",
          "parentid": "{{parentid}}",
          "pagesize": "{{pagesize}}",
          "lastmarker": "{{lastmarker}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
