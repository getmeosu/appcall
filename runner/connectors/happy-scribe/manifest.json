            "type": "string",
            "minLength": 1,
            "description": "Language code."
          },
          "organization_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Organization ID."
          },
          "service": {
            "type": "string",
            "enum": [
              "auto",
              "pro"
            ],
            "description": "Machine or human service."
          },
          "confirm": {
            "type": "boolean",
            "description": "Submit the order immediately."
          },
          "name": {
            "type": "string",
            "description": "Resulting transcription name."
          }
        },
        "additionalProperties": false,
        "required": [
          "url",
          "language",
          "organization_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/orders",
        "success": [
          200,
          201,
          202
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "order": {
            "url": "{{url}}",
            "language": "{{language}}",
            "organization_id": "{{organization_id}}",
            "service": "{{service}}",
            "confirm": "{{confirm}}",
            "name": "{{name}}"
          }
