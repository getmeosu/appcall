{
  "key": "happy-scribe",
  "name": "Happy Scribe",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Happy Scribe API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "www.happyscribe.com"
    ]
  },
  "models": [
    "organization",
    "transcription",
    "order",
    "export",
    "meeting",
    "folder"
  ],
  "http": {
    "baseUrl": "https://www.happyscribe.com/api/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "detail",
        "errors.0"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Happy Scribe API key with GET /organizations.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/organizations",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "organizations.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List organizations",
      "description": "List Happy Scribe organizations available to the API key.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/organizations",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcriptions.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List transcriptions",
      "description": "List Happy Scribe transcriptions in an organization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "folderId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "organizationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcriptions",
        "query": {
          "organization_id": "{{organizationId}}",
          "page": "{{page}}",
          "per_page": "{{perPage}}",
          "folder_id": "{{folderId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcriptions.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get transcription",
      "description": "Get one Happy Scribe transcription by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "transcriptionId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcriptions/{{transcriptionId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "orders.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get order",
      "description": "Get the current state of a Happy Scribe order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "orderId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/orders/{{orderId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcriptions.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create transcription",
      "description": "Create a Happy Scribe transcription from a publicly reachable media URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Transcription name."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "BCP-47 language code."
          },
          "tmp_url": {
            "type": "string",
            "minLength": 1,
            "description": "Public media URL."
          },
          "organization_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Organization ID."
          },
          "is_subtitle": {
            "type": "boolean",
            "description": "Treat the file as subtitles."
          },
          "folder_id": {
            "type": "string",
            "minLength": 1,
            "description": "Destination folder ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "language",
          "tmp_url",
          "organization_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/transcriptions",
        "success": [
          200,
          201,
          202
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "transcription": {
            "name": "{{name}}",
            "language": "{{language}}",
            "tmp_url": "{{tmp_url}}",
            "organization_id": "{{organization_id}}",
            "is_subtitle": "{{is_subtitle}}",
            "folder_id": "{{folder_id}}"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcriptions.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Update transcription",
      "description": "Rename a Happy Scribe transcription, move it, or toggle link sharing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptionId": {
            "type": "string",
            "minLength": 1,
            "description": "Transcription ID."
          },
          "organization_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Organization ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "New name."
          },
          "sharing_enabled": {
            "type": "boolean",
            "description": "Enable public link sharing."
          },
          "folder_id": {
            "type": "string",
            "minLength": 1,
            "description": "Destination folder ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "transcriptionId",
          "organization_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "PATCH",
        "path": "/transcriptions/{{transcriptionId}}",
        "success": [
          200,
          201,
          202
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "transcription": {
            "organization_id": "{{organization_id}}",
            "name": "{{name}}",
            "sharing_enabled": "{{sharing_enabled}}",
            "folder_id": "{{folder_id}}"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcriptions.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Delete transcription",
      "description": "Delete a Happy Scribe transcription. Unfinished jobs are cancelled when the pipeline allows it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptionId": {
            "type": "string",
            "minLength": 1,
            "description": "Transcription ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "transcriptionId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "transcriptionId": {
            "type": "string"
          }
        },
        "required": [
          "deleted",
          "transcriptionId"
        ],
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/transcriptions/{{transcriptionId}}",
        "success": [
          204,
          200
        ],
        "query": {
          "permanent": "{{permanent}}"
        },
        "result": {
          "deleted": true,
          "transcriptionId": "{{input.transcriptionId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcriptions.summary": {
      "kind": "action",
