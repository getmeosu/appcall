    "keys.usage.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get key usage",
      "description": "Report paid lookups consumed on an API key for a date range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "description": "Range start as a UNIX timestamp in milliseconds.",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "description": "Range end as a UNIX timestamp in milliseconds.",
            "minimum": 0
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tags to filter lookups.",
            "minLength": 1
          },
          "licensee": {
            "type": "string",
            "description": "Licensee key to filter usage.",
            "minLength": 1
          },
          "userToken": {
            "type": "string",
            "description": "Optional management key beginning uk_.",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/keys/{{apiKey}}/usage",
        "query": {
          "start": "{{start}}",
          "end": "{{end}}",
          "tags": "{{tags}}",
          "licensee": "{{licensee}}",
          "user_token": "{{userToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
