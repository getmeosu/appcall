      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/keys/{{apiKey}}/details",
        "query": {
          "user_token": "{{userToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "keys.details.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
