    "customers.create": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "write",
      "title": "Create customer",
      "description": "Create a Chargebee customer with JSON-friendly form fields.",
