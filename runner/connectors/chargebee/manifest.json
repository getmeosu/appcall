          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/customers",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "id": "{{id}}",
          "email": "{{email}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "company": "{{company}}",
          "phone": "{{phone}}"
        },
