        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Optional Chargebee customer id."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "Customer email."
          },
          "first_name": {
            "type": "string",
            "description": "Customer first name."
          },
          "last_name": {
            "type": "string",
            "description": "Customer last name."
          },
          "company": {
            "type": "string",
            "description": "Company name."
          },
          "phone": {
            "type": "string",
            "description": "Phone number."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
