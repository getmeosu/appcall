            "type": "array",
            "description": "List of availability schedule objects."
          }
        }
      }
    },
    "event_types.create": {
      "sideEffect": "write",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Create Event Type",
      "description": "Create a new Cal.com event type with a title, slug, and duration in minutes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Display title of the event type."
          },
          "slug": {
            "type": "string",
            "description": "URL slug for the event type booking page."
          },
          "lengthInMinutes": {
            "type": "number",
            "description": "Default duration of bookings for this event type in minutes."
          },
          "description": {
            "type": "string",
            "description": "Optional. Description shown on the booking page."
          },
          "hidden": {
            "type": "boolean",
            "description": "Optional. When true, the event type is hidden from the public booking page."
          },
          "scheduleId": {
            "type": "number",
            "description": "Optional. Availability schedule ID to attach to this event type."
          },
          "locations": {
            "type": "array",
            "description": "Optional. Meeting locations (e.g. Google Meet, Zoom, or an address)."
          }
        },
        "required": [
          "title",
          "slug",
          "lengthInMinutes"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "eventType": {
            "type": "object",
            "description": "The created event type resource."
          }
        }
      }
    },
