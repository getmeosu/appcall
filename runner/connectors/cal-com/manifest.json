      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Update Event Type",
      "description": "Update an existing Cal.com event type by numeric ID. Only provided fields are changed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The numeric ID of the event type to update."
          },
          "title": {
            "type": "string",
            "description": "Optional. New display title."
          },
          "slug": {
            "type": "string",
            "description": "Optional. New URL slug."
          },
          "lengthInMinutes": {
            "type": "number",
            "description": "Optional. New default duration in minutes."
          },
          "description": {
            "type": "string",
            "description": "Optional. New description."
          },
          "hidden": {
            "type": "boolean",
            "description": "Optional. Hide or unhide the event type."
          },
          "scheduleId": {
            "type": "number",
            "description": "Optional. Availability schedule ID to attach."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "eventType": {
            "type": "object",
            "description": "The updated event type resource."
          }
        }
      }
    },
