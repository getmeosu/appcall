    "schedules.get": {
      "sideEffect": "read",
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Get Schedule",
      "description": "Retrieve a single Cal.com availability schedule by its numeric ID, including weekly hours and overrides.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The numeric ID of the schedule to retrieve."
