{
  "key": "fake",
  "name": "Fake Connector",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["utility"],
  "visibility": "internal",
  "auth": {
    "type": "none",
    "scopes": []
  },
  "network": {
    "allowedHosts": [
      "example.com"
    ]
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 1000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1024,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Fake Connector connector. Takes no input and returns the connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    }
  },
  "models": [
    "message"
  ]
}
