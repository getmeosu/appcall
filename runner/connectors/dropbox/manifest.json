{
  "key": "dropbox",
  "name": "Dropbox",
  "version": "0.2.0",
  "runtime": "bun",
  "description": "Dropbox JSON metadata operations using a manually supplied OAuth2 access token.",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "oauth2",
    "scopes": [
      "account_info.read",
      "files.metadata.read",
      "files.metadata.write",
      "files.content.read",
      "files.content.write",
      "sharing.read",
      "sharing.write"
    ],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accessToken",
          "label": "OAuth2 access token (manual; no automatic refresh)",
          "secret": true,
          "required": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.dropboxapi.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.dropboxapi.com/2",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "retryAfterKind": "seconds",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "error_summary",
        "message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Read the authenticated Dropbox account",
      "description": "Read the authenticated Dropbox account. Requires account_info.read.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions.",
            "required": [
              "account_id"
            ],
            "properties": {
              "account_id": {
                "type": "string",
                "minLength": 1,
                "description": "Authenticated provider account identifier."
              }
            }
          }
        },
        "required": [
          "account"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/users/get_current_account",
        "success": [
          200
        ],
        "result": {
          "account": "{{response}}"
        },
        "echo": {
          "status": "ok"
        }
      }
    },
    "root.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List the root folder in the token's accessible namespace",
      "description": "List the root folder in the token's accessible namespace. Continue while hasMore is true.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Requested page size from 1 to 2000, enforced by Dropbox."
          },
          "recursive": {
            "type": "boolean",
            "description": "Include nested folders when true; omitted uses provider default false."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "description": "Provider file/folder metadata, including deleted entries when enabled.",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor for folders.continue. Retain even when hasMore is false for later changes.",
            "minLength": 1
          },
          "hasMore": {
            "type": "boolean",
            "description": "Continue immediately while true; false means this snapshot is drained."
          }
        },
        "required": [
          "entries",
          "cursor",
          "hasMore"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/list_folder",
        "success": [
          200
        ],
        "result": {
          "entries": "{{response.entries}}",
          "cursor": "{{response.cursor}}",
          "hasMore": "{{response.has_more}}"
        },
        "body": {
          "path": "",
          "limit": "{{limit}}",
          "recursive": "{{recursive}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "folders.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List a non-root folder",
      "description": "List a non-root folder. Continue with folders.continue while hasMore is true.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference. Use root.list for the root folder."
          },
          "limit": {
            "type": "integer",
            "description": "Requested page size from 1 to 2000, enforced by Dropbox."
          },
          "recursive": {
            "type": "boolean",
            "description": "Include nested folders when true; omitted uses provider default false."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "description": "Provider file/folder metadata, including deleted entries when enabled.",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor for folders.continue. Retain even when hasMore is false for later changes.",
            "minLength": 1
          },
          "hasMore": {
            "type": "boolean",
            "description": "Continue immediately while true; false means this snapshot is drained."
          }
        },
        "required": [
          "entries",
          "cursor",
          "hasMore"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/list_folder",
        "success": [
          200
        ],
        "result": {
          "entries": "{{response.entries}}",
          "cursor": "{{response.cursor}}",
          "hasMore": "{{response.has_more}}"
        },
        "body": {
          "path": "{{path}}",
          "limit": "{{limit}}",
          "recursive": "{{recursive}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "folders.continue": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Continue a Dropbox folder listing or fetch changes using its saved cursor",
      "description": "Continue a Dropbox folder listing or fetch changes using its saved cursor. A reset error requires restarting the listing.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from a previous root.list, folders.list or folders.continue result."
          }
        },
        "required": [
          "cursor"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "description": "Provider file/folder metadata, including deleted entries when enabled.",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor for folders.continue. Retain even when hasMore is false for later changes.",
            "minLength": 1
          },
          "hasMore": {
            "type": "boolean",
            "description": "Continue immediately while true; false means this snapshot is drained."
          }
        },
        "required": [
          "entries",
          "cursor",
          "hasMore"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/list_folder/continue",
        "success": [
          200
        ],
        "result": {
          "entries": "{{response.entries}}",
          "cursor": "{{response.cursor}}",
          "hasMore": "{{response.has_more}}"
        },
        "body": {
          "cursor": "{{cursor}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.getMetadata": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Read metadata for a file or folder without downloading content",
      "description": "Read metadata for a file or folder without downloading content.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference. Use root.list for the root folder."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          }
        },
        "required": [
          "metadata"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/get_metadata",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response}}"
        },
        "body": {
          "path": "{{path}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "folders.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create a Dropbox folder at an explicit path",
      "description": "Create a Dropbox folder at an explicit path. Conflicting names fail; automatic renaming is disabled.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Destination path beginning with /, such as /Reports."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          }
        },
        "required": [
          "metadata"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/create_folder_v2",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response.metadata}}"
        },
        "body": {
          "path": "{{path}}",
          "autorename": false
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.move": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Move a file or folder to a new path, including folder contents",
      "description": "Move a file or folder to a new path, including folder contents. Conflicts fail; case-only renames are unsupported.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromPath": {
            "type": "string",
            "description": "Existing source path or id: reference."
          },
          "toPath": {
            "type": "string",
            "description": "Destination path beginning with /."
          }
        },
        "required": [
          "fromPath",
          "toPath"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          }
        },
        "required": [
          "metadata"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/move_v2",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response.metadata}}"
        },
        "body": {
          "from_path": "{{fromPath}}",
          "to_path": "{{toPath}}",
          "autorename": false
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Delete a Dropbox file or folder, recursively including folder contents",
      "description": "Delete a Dropbox file or folder, recursively including folder contents. Provider retention and recovery policies apply.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference. Use root.list for the root folder."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          }
        },
        "required": [
          "metadata"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/delete_v2",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response.metadata}}"
        },
        "body": {
          "path": "{{path}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.copy": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Copy a file or folder to a new path",
      "description": "Copy a file or folder to a new path, including folder contents. Conflicts fail; automatic renaming is disabled.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromPath": {
            "type": "string",
            "description": "Existing source path or id: reference."
          },
          "toPath": {
            "type": "string",
            "description": "Destination path beginning with /."
          }
        },
        "required": [
          "fromPath",
          "toPath"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          }
        },
        "required": [
          "metadata"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/copy_v2",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response.metadata}}"
        },
        "body": {
          "from_path": "{{fromPath}}",
          "to_path": "{{toPath}}",
          "autorename": false
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.search": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search files and folders by name or content",
      "description": "Search files and folders by name or content. Continue with the returned cursor while hasMore is true.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search string matched against file names and content the token can read."
          },
          "path": {
            "type": "string",
            "description": "Optional folder to restrict the search. Omit to search the whole accessible namespace."
          },
          "maxResults": {
            "type": "integer",
            "description": "Requested page size from 1 to 1000, enforced by Dropbox."
          },
          "filenameOnly": {
            "type": "boolean",
            "description": "Match file names only when true; omitted searches names and content."
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "description": "Search hits with provider file or folder metadata.",
            "items": {
              "type": "object"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor for a later search continue call."
          },
          "hasMore": {
            "type": "boolean",
            "description": "Continue immediately while true; false means this result set is drained."
          }
        },
        "required": [
          "matches",
          "cursor",
          "hasMore"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/search_v2",
        "success": [
          200
        ],
        "result": {
          "matches": "{{response.matches}}",
          "cursor": "{{response.cursor}}",
          "hasMore": "{{response.has_more}}"
        },
        "body": {
          "query": "{{query}}",
          "options": {
            "path": "{{path}}",
            "max_results": "{{maxResults}}",
            "filename_only": "{{filenameOnly}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.getTemporaryLink": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create a temporary download link for a file",
      "description": "Create a temporary HTTPS link for a file. The link expires after a few hours and does not require Dropbox authentication to fetch.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          },
          "link": {
            "type": "string",
            "description": "Temporary HTTPS URL for the file contents."
          }
        },
        "required": [
          "metadata",
          "link"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/get_temporary_link",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response.metadata}}",
          "link": "{{response.link}}"
        },
        "body": {
          "path": "{{path}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.saveUrl": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Save a file into Dropbox from a public URL",
      "description": "Save a file into Dropbox from a public HTTPS URL. The provider may finish immediately or return an async job id.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Destination path beginning with /, such as /Reports/notes.txt."
          },
          "url": {
            "type": "string",
            "description": "Public HTTPS URL whose contents should be saved."
          }
        },
        "required": [
          "path",
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "description": "Completed file metadata or an async job identifier."
          }
        },
        "required": [
          "result"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/save_url",
        "success": [
          200
        ],
        "result": {
          "result": "{{response}}"
        },
        "body": {
          "path": "{{path}}",
          "url": "{{url}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.listRevisions": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List revisions for a Dropbox file",
      "description": "List revisions for a Dropbox file. Entries are newest first.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference."
          },
          "limit": {
            "type": "integer",
            "description": "Requested page size from 1 to 100, enforced by Dropbox."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "isDeleted": {
            "type": "boolean",
            "description": "True when the path currently points at a deleted file."
          },
          "entries": {
            "type": "array",
            "description": "Revision metadata, newest first.",
            "items": {
              "type": "object"
            }
          },
          "serverReset": {
            "type": "boolean",
            "description": "True when the caller should discard local revision state."
          }
        },
        "required": [
          "isDeleted",
          "entries",
          "serverReset"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/list_revisions",
        "success": [
          200
        ],
        "result": {
          "isDeleted": "{{response.is_deleted}}",
          "entries": "{{response.entries}}",
          "serverReset": "{{response.server_reset}}"
        },
        "body": {
          "path": "{{path}}",
          "limit": "{{limit}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "files.restore": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Restore a file to a previous revision",
      "description": "Restore a file to a previous revision identified by its rev. The current contents are replaced.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference."
          },
          "rev": {
            "type": "string",
            "description": "Revision identifier from files.listRevisions."
          }
        },
        "required": [
          "path",
          "rev"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "description": "Provider metadata; fields depend on the resource subtype and granted permissions."
          }
        },
        "required": [
          "metadata"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/files/restore",
        "success": [
          200
        ],
        "result": {
          "metadata": "{{response}}"
        },
        "body": {
          "path": "{{path}}",
          "rev": "{{rev}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "sharing.createSharedLink": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create a shared link for a file or folder",
      "description": "Create a shared link for a file or folder. Existing links for the same path cause a conflict.",
      "sideEffect": "write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Nonempty Dropbox path beginning with /, or a supported id: reference."
          }
        },
        "required": [
          "path"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "link": {
            "type": "object",
            "description": "Created shared link, including its public URL."
          }
        },
        "required": [
          "link"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/sharing/create_shared_link_with_settings",
        "success": [
          200
        ],
        "result": {
          "link": "{{response}}"
        },
        "body": {
          "path": "{{path}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "sharing.listSharedLinks": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List shared links for a file, folder, or the account",
      "description": "List shared links for a file, folder, or the whole account. Continue with the cursor while hasMore is true.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
