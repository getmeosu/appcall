{
  "connector": "dropbox",
  "scenarios": [
    {
      "name": "Authenticated identity",
      "operation": "healthcheck",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "source",
            "op": "eq",
            "value": "provider"
          },
          {
            "path": "account",
            "op": "isObject"
          },
          {
            "path": "account.account_id",
            "op": "type",
            "value": "string"
          },
          {
            "path": "account.account_id",
            "op": "matches",
            "value": "\\S"
          }
        ]
      }
    },
    {
      "name": "Read-only root page",
      "operation": "root.list",
      "input": {
        "limit": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "source",
            "op": "eq",
            "value": "provider"
          },
          {
            "path": "entries",
            "op": "type",
            "value": "array"
          },
          {
            "path": "cursor",
            "op": "type",
            "value": "string"
          },
          {
            "path": "cursor",
            "op": "matches",
            "value": "\\S"
          },
          {
            "path": "hasMore",
            "op": "type",
            "value": "boolean"
          }
        ]
      }
    }
  ]
}
