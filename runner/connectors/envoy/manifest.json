      "title": "Create invite",
      "description": "Create an Envoy visitor invite for a location and sign-in flow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expectedArrivalAt": {
            "type": "string",
            "minLength": 1,
            "description": "Expected arrival time in UTC."
          },
          "locationId": {
            "type": "string",
            "minLength": 1,
            "description": "Location identifier."
          },
          "flowId": {
            "type": "string",
            "minLength": 1,
            "description": "Sign-in flow identifier."
          },
          "inviteeName": {
            "type": "string",
            "minLength": 1,
            "description": "Invitee full name."
          },
          "inviteeEmail": {
            "type": "string",
            "minLength": 1,
            "description": "Invitee email address."
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "description": "Internal notes for the invite."
          }
        },
        "additionalProperties": false,
        "required": [
          "expectedArrivalAt",
          "locationId",
          "inviteeName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/invites",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "invite": {
            "expectedArrivalAt": "{{expectedArrivalAt}}",
            "locationId": "{{locationId}}",
            "flowId": "{{flowId}}",
            "notes": "{{notes}}",
            "invitee": {
              "name": "{{inviteeName}}",
              "email": "{{inviteeEmail}}"
            }
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
