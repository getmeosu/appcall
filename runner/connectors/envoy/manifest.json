          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/rest/v1/locations",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "perPage": "{{perPage}}",
          "sort": "{{sort}}",
          "order": "{{order}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
