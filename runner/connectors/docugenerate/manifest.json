{
  "key": "docugenerate",
  "name": "DocuGenerate",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "documents"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "DocuGenerate API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.docugenerate.com"
    ]
  },
  "models": [
    "template",
    "document"
  ],
  "http": {
    "baseUrl": "https://api.docugenerate.com/v1",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "message",
        "error"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "templates.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 5242880,
      "title": "List Templates",
      "description": "List DocuGenerate templates, newest first. An optional folder path filters to that folder. The official route has no page or per_page parameter.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "folder": {
            "type": "array",
            "maxItems": 100,
            "description": "Folder path from root to leaf. Each name is repeated as the folder query parameter.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/template",
        "query": {
          "folder": "{{folder}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "templates.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Template",
      "description": "Get one DocuGenerate template by ID. The JSON includes file URLs and does not download the template file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateId"
        ],
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Template ID."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/template/{{templateId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 5242880,
      "title": "List Documents",
      "description": "List documents generated from one template, newest first. Each item is JSON metadata with a document_uri, not file bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateId"
        ],
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Template ID whose generated documents should be listed."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/document",
        "query": {
          "template_id": "{{templateId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Document",
      "description": "Get one generated document by ID. The JSON includes document_uri and does not download the file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Document ID."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/document/{{documentId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.generate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 120000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Generate Document",
      "description": "Generate a document from a template and JSON merge data. The 201 body is document metadata including document_uri. It does not upload a data file or return PDF bytes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateId",
          "data"
        ],
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "ID of the template to merge."
          },
          "data": {
            "description": "Merge data. One object generates one document. An array generates one document per object.",
            "oneOf": [
              {
                "type": "object",
                "minProperties": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Logical document name."
          },
          "outputName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Output filename without an extension."
          },
          "outputFormat": {
            "type": "string",
            "enum": [
              ".docx",
              ".doc",
              ".odt",
              ".txt",
              ".html",
              ".png",
              ".pdf",
              ".pdf/a-1b",
              ".pdf/a-2b",
              ".pdf/a-3b"
            ],
            "description": "Output format. The default upstream format is .docx when this is omitted."
          },
          "outputQuality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Image quality for PDF or PNG output, from 1 to 100."
          },
          "singleFile": {
            "type": "boolean",
            "description": "Combine multiple data rows into one file when true."
          },
          "pageBreak": {
            "type": "boolean",
            "description": "Insert a page break between combined rows when singleFile is true."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/document",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "template_id": "{{templateId}}",
          "data": "{{data}}",
          "name": "{{name}}",
          "output_name": "{{outputName}}",
          "output_format": "{{outputFormat}}",
          "output_quality": "{{outputQuality}}",
          "single_file": "{{singleFile}}",
          "page_break": "{{pageBreak}}"
        },
        "success": [
          201
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 1048576,
      "title": "Update Document",
      "description": "Rename a generated document. The JSON response includes document_uri and does not download the file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "name"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Document ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "New logical document name."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "PUT",
        "path": "/document/{{documentId}}",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
