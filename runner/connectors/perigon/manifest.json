{
  "key": "perigon",
  "name": "Perigon",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Perigon API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.perigon.io"
    ]
  },
  "models": [
    "topic",
    "journalist",
    "person",
    "article",
    "story",
    "source",
    "company",
    "monitor",
    "contact_point",
    "watchlist"
  ],
  "http": {
    "baseUrl": "https://api.perigon.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "title"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the Perigon API key with GET /v1/topics/all?size=1.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/topics/all",
        "query": {
          "size": "1"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "topics.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List topics",
      "description": "Browse or filter Perigon topics used to classify news content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Topic name filter."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "Parent category filter."
          },
          "subcategory": {
            "type": "string",
            "minLength": 1,
            "description": "Subcategory filter."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based page number."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/topics/all",
        "query": {
          "name": "{{name}}",
          "category": "{{category}}",
          "subcategory": "{{subcategory}}",
          "page": "{{page}}",
          "size": "{{size}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
