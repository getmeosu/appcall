          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/v1/api/monitors",
        "success": [
          200,
          201
        ],
        "body": {
          "name": "{{name}}",
          "classificationType": "{{classificationType}}",
          "monitoringObjective": "{{monitoringObjective}}",
          "dataSchema": {
            "version": "V1",
            "allowExtra": false,
            "schema": {}
          },
          "query": {
            "q": "{{q}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
