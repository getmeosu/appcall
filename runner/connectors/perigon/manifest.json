      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create monitor",
      "description": "Create a Perigon monitor that classifies matching news over time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name."
          },
          "classificationType": {
            "type": "string",
            "enum": [
              "EVENT",
              "MENTIONS",
              "TOPIC"
            ],
            "description": "Monitor classification type."
          },
          "monitoringObjective": {
            "type": "string",
            "minLength": 1,
            "description": "Plain-language definition of what the monitor tracks."
          },
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "News query used as the monitor scope."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "classificationType",
