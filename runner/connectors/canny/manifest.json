{
  "key": "canny",
  "name": "Canny",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Canny secret API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "canny.io"
    ]
  },
  "models": [
    "board",
    "post",
    "comment",
    "vote",
    "tag",
    "user",
    "company",
    "entry",
    "category"
  ],
  "http": {
    "baseUrl": "https://canny.io/api",
    "auth": {
      "field": "apiKey",
      "in": "body",
      "name": "apiKey",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message"
      ]
    }
  },
