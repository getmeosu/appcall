    "kicking-rules.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create kicking rule",
      "description": "Create a privilege banning rule for a channel, user, or IP.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1,
            "description": "Agora App ID (vendor_key)."
          },
          "cname": {
            "type": "string",
            "minLength": 1,
            "description": "Channel name."
          },
          "uid": {
            "type": "integer",
            "description": "User ID to ban. Do not use 0."
          },
          "ip": {
            "type": "string",
            "minLength": 1,
            "description": "User IP address to ban."
          },
          "time": {
            "type": "integer",
            "description": "Ban duration in minutes.",
            "minimum": 1,
            "maximum": 1440
          },
          "privileges": {
            "type": "array",
            "description": "Privileges to ban.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "appId",
          "time",
          "privileges"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/dev/v1/kicking-rule",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "appid": "{{appId}}",
          "cname": "{{cname}}",
          "uid": "{{uid}}",
          "ip": "{{ip}}",
          "time": "{{time}}",
          "privileges": "{{privileges}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
