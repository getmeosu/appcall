    "projects.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get project",
      "description": "Retrieve one Agora Console project by project ID and name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "projectId",
          "name"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/dev/v1/project",
        "query": {
          "id": "{{projectId}}",
          "name": "{{name}}"
        },
        "success": [
          200,
          201
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "usage.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get project usage",
      "description": "Retrieve Agora Console usage for one project and business type.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "fromDate": {
            "type": "string",
            "minLength": 1
          },
          "toDate": {
            "type": "string",
            "minLength": 1
          },
          "business": {
            "type": "string",
            "enum": [
              "default",
              "transcodeDuration",
              "recording",
              "cloudRecording",
              "miniapp"
            ]
          }
        },
        "required": [
          "projectId",
          "fromDate",
          "toDate",
          "business"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/dev/v3/usage",
        "query": {
          "project_id": "{{projectId}}",
          "from_date": "{{fromDate}}",
          "to_date": "{{toDate}}",
          "business": "{{business}}"
        },
        "success": [
          200,
          201
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
