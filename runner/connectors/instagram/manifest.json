    },
    "hashtags.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search hashtags",
      "description": "Search for an Instagram hashtag ID by name using the bound professional account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "Hashtag name without the # prefix."
          }
        },
        "additionalProperties": false,
        "required": [
          "q"
        ]
      },
      "outputSchema": {
