      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get comment",
      "description": "Read one Instagram comment by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "minLength": 1,
            "description": "Instagram comment ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "commentId"
        ]
