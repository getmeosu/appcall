      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1,
            "description": "Instagram media ID."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Comment text."
          }
        },
        "additionalProperties": false,
        "required": [
          "mediaId",
          "message"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/{{mediaId}}/comments",
        "success": [
          200
        ],
        "body": {
          "message": "{{message}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
