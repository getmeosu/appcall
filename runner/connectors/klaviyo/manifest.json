{
  "key": "klaviyo",
  "name": "Klaviyo",
  "version": "0.1.0",
  "runtime": "bun",
  "categories": ["email-marketing"],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "API Key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "a.klaviyo.com"
    ]
  },
  "operations": {
    "contacts.list": {
      "kind": "sync",
      "timeoutMs": 30000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "campaigns.list": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880
    },
    "lists.list": {
      "kind": "sync",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576
    },
    "contacts.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create Contact",
      "description": "Create a Klaviyo profile (contact) from an email address and optional name and phone number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Contact email address (required)."
          },
          "firstName": {
            "type": "string",
            "description": "Contact first name."
          },
          "lastName": {
            "type": "string",
            "description": "Contact last name."
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number in E.164 format."
          }
        },
        "required": [
          "email"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "contact": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerContactId": { "type": "string" },
              "email": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "phone": { "type": "string" },
              "createdAt": { "type": "string" },
              "updatedAt": { "type": "string" }
            }
          }
        }
      }
    },
    "profiles.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Profile",
      "description": "Retrieve a Klaviyo profile by its profile ID. Returns full profile attributes including email, name, phone, and timestamps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "description": "The Klaviyo profile ID to retrieve."
          }
        },
        "required": ["profileId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "profile": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerContactId": { "type": "string" },
              "email": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "phone": { "type": "string" },
              "createdAt": { "type": "string" },
              "updatedAt": { "type": "string" }
            }
          }
        }
      }
    },
    "profiles.update": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Update Profile",
      "description": "Update an existing Klaviyo profile's attributes such as email, name, phone number, or custom properties using a PATCH request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "description": "The Klaviyo profile ID to update."
          },
          "email": {
            "type": "string",
            "description": "New email address for the profile."
          },
          "firstName": {
            "type": "string",
            "description": "Updated first name."
          },
          "lastName": {
            "type": "string",
            "description": "Updated last name."
          },
          "phone": {
            "type": "string",
            "description": "Updated phone number in E.164 format."
          },
          "properties": {
            "type": "object",
            "description": "Custom properties key/value map to merge onto the profile."
          }
        },
        "required": ["profileId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "profile": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerContactId": { "type": "string" },
              "email": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" },
              "phone": { "type": "string" },
              "createdAt": { "type": "string" },
              "updatedAt": { "type": "string" }
            }
          }
        }
      }
    },
    "lists.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create List",
      "description": "Create a new Klaviyo list with the given name. Lists are used to group profiles for targeted email or SMS campaigns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name for the new list."
          }
        },
        "required": ["name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "list": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerListId": { "type": "string" },
              "name": { "type": "string" },
              "totalMembers": { "type": "number" },
              "createdAt": { "type": "string" }
            }
          }
        }
      }
    },
    "lists.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get List",
      "description": "Retrieve a Klaviyo list by its list ID, including the list name and total member count.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string",
            "description": "The Klaviyo list ID to retrieve."
          }
        },
        "required": ["listId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "list": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerListId": { "type": "string" },
              "name": { "type": "string" },
              "totalMembers": { "type": "number" },
              "createdAt": { "type": "string" }
            }
          }
        }
      }
    },
    "profiles.addToList": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Add Profiles to List",
      "description": "Add one or more Klaviyo profiles to a list by posting to the list relationships/profiles endpoint. Accepts an array of profile IDs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string",
            "description": "The Klaviyo list ID to add profiles to."
          },
          "profileIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of Klaviyo profile IDs to add to the list."
          }
        },
        "required": ["listId", "profileIds"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "added": { "type": "number", "description": "Number of profiles added." }
        }
      }
    },
    "profiles.removeFromList": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 65536,
      "title": "Remove Profiles from List",
      "description": "Remove one or more Klaviyo profiles from a list by sending a DELETE to the list relationships/profiles endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string",
            "description": "The Klaviyo list ID to remove profiles from."
          },
          "profileIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of Klaviyo profile IDs to remove from the list."
          }
        },
        "required": ["listId", "profileIds"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "removed": { "type": "number", "description": "Number of profiles removed." }
        }
      }
    },
    "events.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 65536,
      "title": "Create Event",
      "description": "Track a custom event (metric) for a Klaviyo profile. Associates the event with a profile by email and records optional properties and a monetary value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "metricName": {
            "type": "string",
            "description": "The name of the metric/event to track, e.g. 'Placed Order'."
          },
          "profileEmail": {
            "type": "string",
            "description": "Email address of the profile to associate the event with."
          },
          "profileId": {
            "type": "string",
            "description": "Optional Klaviyo profile ID. If provided, used alongside email to identify the profile."
          },
          "properties": {
            "type": "object",
            "description": "Key/value map of event properties to attach."
          },
          "value": {
            "type": "number",
            "description": "Optional monetary value associated with the event."
          },
          "time": {
            "type": "string",
            "description": "Optional ISO 8601 datetime string for when the event occurred. Defaults to now."
          }
        },
        "required": ["metricName", "profileEmail"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "event": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerEventId": { "type": "string" },
              "metricName": { "type": "string" },
              "profileEmail": { "type": "string" },
              "value": { "type": "number" },
              "time": { "type": "string" }
            }
          }
        }
      }
    },
    "segments.get": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Get Segment",
      "description": "Retrieve a Klaviyo segment by its segment ID. Returns the segment name, profile count, and timestamps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "description": "The Klaviyo segment ID to retrieve."
          }
        },
        "required": ["segmentId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "segment": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerSegmentId": { "type": "string" },
              "name": { "type": "string" },
              "profileCount": { "type": "number" },
              "createdAt": { "type": "string" },
              "updatedAt": { "type": "string" }
            }
          }
        }
      }
    },
    "campaigns.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create Campaign",
      "description": "Create a new Klaviyo email or SMS campaign with a name, channel, and optional send time and message details. Campaign starts in 'draft' status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the campaign."
          },
          "channel": {
            "type": "string",
            "enum": ["email", "sms"],
            "description": "Campaign channel: 'email' or 'sms'."
          },
          "listId": {
            "type": "string",
            "description": "Optional Klaviyo list ID to associate with the campaign."
          },
          "sendTime": {
            "type": "string",
            "description": "Optional ISO 8601 scheduled send time."
          },
          "fromEmail": {
            "type": "string",
            "description": "Sender email address for email campaigns."
          },
          "fromLabel": {
            "type": "string",
            "description": "Sender display name for email campaigns."
          },
          "subject": {
            "type": "string",
            "description": "Email subject line."
          }
        },
        "required": ["name", "channel"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "campaign": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string" },
              "providerCampaignId": { "type": "string" },
              "name": { "type": "string" },
              "status": { "type": "string" },
              "channelId": { "type": "string" },
              "createdAt": { "type": "string" }
            }
          }
        }
      }
    },
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Verify connectivity and credentials for the Klaviyo connector. Takes no input and returns the connector health status.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Connector health status, e.g. \"ok\" or \"error\"."
          }
        }
      }
    }
  },
  "models": [
    "contact",
    "campaign",
    "list",
    "profile",
    "event",
    "segment"
  ]
}
