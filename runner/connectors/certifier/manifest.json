    "credentials.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search credentials",
      "description": "Search Certifier credentials with a filter, sort, and cursor pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Credential status.",
            "enum": [
              "draft",
              "issued",
              "revoked"
            ]
          },
          "groupId": {
            "type": "string",
            "description": "Group (credential template) ID.",
            "minLength": 1
          },
          "recipientEmail": {
            "type": "string",
            "description": "Recipient email to match.",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "description": "Page size.",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor.",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/credentials/search",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "filter": {
            "AND": [
              {
                "status": {
                  "equals": "{{status}}"
                }
              },
              {
                "groupId": {
                  "equals": "{{groupId}}"
                }
              },
              {
                "recipient": {
                  "email": {
                    "equals": "{{recipientEmail}}"
                  }
                }
              }
            ]
          },
          "limit": "{{limit}}",
          "cursor": "{{cursor}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
