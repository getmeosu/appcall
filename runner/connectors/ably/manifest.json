{
  "key": "ably",
  "name": "Ably",
  "version": "0.3.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "keyName",
          "label": "Ably API key name",
          "required": true,
          "secret": false
        },
        {
          "key": "keySecret",
          "label": "Ably API key secret",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "main.realtime.ably.net"
    ]
  },
  "models": [
    "message",
    "presence",
    "stats",
    "channel",
    "push",
    "token"
  ],
  "http": {
    "baseUrl": "https://main.realtime.ably.net",
    "auth": {
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{keyName}}",
        "password": "{{keySecret}}"
      }
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Healthcheck",
      "description": "Verify Ably credentials by requesting application statistics.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/stats",
        "query": {
          "limit": "1"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "messages.history": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Retrieve message history for a channel.",
      "description": "Retrieve persisted or recent message history for an Ably channel via GET /channels/{channelId}/messages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "direction": {
            "type": "string",
            "enum": [
              "backwards",
              "forwards"
            ]
          }
        },
        "required": [
          "channelId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/channels/{{channelId}}/messages",
        "success": [
          200
        ],
        "query": {
          "start": "{{start}}",
          "end": "{{end}}",
          "limit": "{{limit}}",
          "direction": "{{direction}}"
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "messages.publish": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Publish a message to a channel.",
      "description": "Publish one message to a channel. Ably answers 201 with an empty body on success, so the result echoes channelId and optional name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "data": {}
        },
        "required": [
          "channelId",
          "data"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "published",
          "channelId"
        ],
        "properties": {
          "published": {
            "type": "boolean"
          },
          "channelId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/channels/{{channelId}}/messages",
        "success": [
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "data": "{{data}}"
        },
        "result": {
          "published": true,
          "channelId": "{{input.channelId}}",
          "name": "{{input.name}}"
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "presence.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List instantaneous presence on a channel.",
      "description": "Obtain members currently present on an Ably channel via GET /channels/{channelId}/presence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "clientId": {
            "type": "string",
            "minLength": 1
          },
          "connectionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "channelId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/channels/{{channelId}}/presence",
        "success": [
          200
        ],
        "query": {
          "limit": "{{limit}}",
          "clientId": "{{clientId}}",
          "connectionId": "{{connectionId}}"
        }
      },
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "enforceOutputSchema": true
    },
    "stats.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get Statistics",
