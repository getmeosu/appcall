    "credits.transactions.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List credit transactions",
      "description": "Return one page of credit transactions. GET /wallets/transactions. Pagination is page and limit. The type query is deduction, topup, adjustment, or refund.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number, starting at 1.",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "description": "Transactions in this page, from 1 to 100.",
            "minimum": 1,
            "maximum": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "deduction",
              "topup",
              "adjustment",
              "refund"
            ],
            "description": "Transaction type. Omit to include every type."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "GET",
        "path": "/wallets/transactions",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "limit": "{{limit}}",
          "type": "{{type}}"
        }
      }
    },
