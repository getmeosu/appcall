    "company.icp.search": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 60000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search company ICP",
      "description": "Run one ranked ICP cascade search at a company. POST /people-search/waterfall-icp-search.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company_linkedin_url": {
            "type": "string",
            "minLength": 1,
            "description": "LinkedIn company URL whose employees should be ranked.",
            "maxLength": 2048
          },
          "cascade": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "description": "Ordered ICP levels. Omit to use Enrich's default CEO/Founder, C-Suite, VP, then Director cascade.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "description": "One ICP cascade level. Documented keys are checked; additional provider keys are sent unchanged.",
              "properties": {
                "include_title": {
                  "type": "array",
                  "description": "Job titles to include.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exclude_title": {
                  "type": "array",
                  "description": "Job titles to exclude.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "job_levels": {
                  "type": "array",
                  "description": "Job seniority levels to include.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "job_functions": {
                  "type": "array",
                  "description": "Job functions to include.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "skills": {
                  "type": "array",
                  "description": "Skills to match.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "location": {
                  "type": "array",
                  "description": "Location codes, continent codes, or WORLD.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "include_headline_search": {
                  "type": "boolean",
                  "description": "Also match include_title against the LinkedIn headline."
                },
                "priority_bonus": {
                  "type": "integer",
                  "description": "Seniority priority bonus from 0 to 30.",
                  "minimum": 0,
                  "maximum": 30
                }
              }
            }
          },
          "max_results": {
            "type": "integer",
            "description": "Maximum ranked profiles to return, from 1 to 100.",
            "minimum": 1,
            "maximum": 100
          },
          "min_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Minimum normalized ICP score from 0 to 100."
          }
        },
        "required": [
          "company_linkedin_url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/people-search/waterfall-icp-search",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "company_linkedin_url": "{{company_linkedin_url}}",
          "cascade": "{{cascade}}",
          "max_results": "{{max_results}}",
          "min_score": "{{min_score}}"
        }
      }
    },
