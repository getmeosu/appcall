{
  "key": "bestbuy",
  "name": "Best Buy",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ecommerce"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Best Buy developer API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.bestbuy.com"
    ]
  },
  "models": [
    "category",
    "product",
    "store",
    "review",
    "recommendation",
    "openBox",
    "warranty"
  ],
  "http": {
    "baseUrl": "https://api.bestbuy.com",
    "auth": {
      "field": "apiKey",
      "in": "query",
      "name": "apiKey",
      "value": "{{apiKey}}"
    },
    "query": {
      "format": "json"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "errors.0"
      ]
    }
  },
