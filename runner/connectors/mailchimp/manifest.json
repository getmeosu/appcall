          "audience": { "type": "object", "description": "The normalized audience record." }
        }
      }
    },
    "campaigns.create": {
      "kind": "action",
      "timeoutMs": 15000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 1048576,
      "title": "Create Campaign",
      "description": "Create a new Mailchimp email campaign with settings and recipient list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "Campaign type, e.g. 'regular', 'plaintext', 'absplit', 'rss', 'variate'." },
