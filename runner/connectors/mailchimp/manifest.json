          "subjectLine": { "type": "string", "description": "Email subject line for the campaign." },
          "title": { "type": "string", "description": "Internal title of the campaign (not visible to recipients)." },
          "fromName": { "type": "string", "description": "Sender name shown to recipients." },
          "replyTo": { "type": "string", "description": "Reply-to email address for the campaign." },
          "previewText": { "type": "string", "description": "Preview text shown in email clients before opening." }
        },
        "required": ["type", "listId", "subjectLine", "title", "fromName", "replyTo"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": { "type": "string" },
          "action": { "type": "string" },
          "source": { "type": "string" },
          "campaign": { "type": "object", "description": "The normalized created campaign." }
