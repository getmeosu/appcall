    "conferences.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "title": "Create conference",
      "description": "Create a ClickMeeting room or webinar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "room_type": {
            "type": "string",
            "enum": [
              "meeting",
              "webinar"
            ]
          },
          "permanent_room": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "access_type": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "room_type",
          "permanent_room",
          "access_type"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/conferences",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "name": "{{name}}",
          "room_type": "{{room_type}}",
          "permanent_room": "{{permanent_room}}",
          "access_type": "{{access_type}}"
        },
        "bodyEncoding": "form"
      }
    },
