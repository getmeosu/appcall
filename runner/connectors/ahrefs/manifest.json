{
  "key": "ahrefs",
  "name": "Ahrefs",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Ahrefs API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.ahrefs.com"
    ]
  },
  "models": [
    "subscription",
    "metrics",
    "keyword",
    "backlink",
    "serp"
  ],
  "http": {
    "baseUrl": "https://api.ahrefs.com/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "query": {
      "output": "json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "detail",
        "title",
        "errors.0.message"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate an Ahrefs API key by reading subscription limits and usage.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/subscription-info/limits-and-usage",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "site-explorer.metrics": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Site Explorer metrics",
      "description": "Retrieve Ahrefs Site Explorer metrics for a domain or URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "exact",
              "prefix",
              "domain",
              "subdomains"
            ]
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "enum": [
              "both",
              "http",
              "https"
            ]
          },
          "volumeMode": {
            "type": "string",
            "enum": [
              "monthly",
              "average"
            ]
          }
        },
        "required": [
          "target",
          "date"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/site-explorer/metrics",
        "query": {
          "target": "{{target}}",
          "date": "{{date}}",
          "mode": "{{mode}}",
          "country": "{{country}}",
          "protocol": "{{protocol}}",
          "volume_mode": "{{volumeMode}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
