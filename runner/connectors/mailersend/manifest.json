{
  "key": "mailersend",
  "name": "mailersend",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "MailerSend API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.mailersend.com"
    ]
  },
  "models": [
    "domain",
    "message",
    "template",
    "webhook",
    "recipient",
    "identity",
    "token"
  ],
  "http": {
    "baseUrl": "https://api.mailersend.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "detail"
      ]
    }
  },
  "operations": {
