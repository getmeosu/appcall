          "returnPathSubdomain": {
            "type": "string",
            "minLength": 1,
            "description": "Return-path subdomain, e.g. rp."
          },
          "customTrackingSubdomain": {
            "type": "string",
            "minLength": 1,
            "description": "Custom tracking subdomain, e.g. track."
          }
