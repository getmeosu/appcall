{
  "key": "next-dns",
  "name": "NextDNS",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "utility"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "NextDNS API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "api.nextdns.io"
    ]
  },
  "models": [
    "profile",
    "log",
    "analytics",
    "denylist",
    "allowlist"
  ],
  "http": {
    "baseUrl": "https://api.nextdns.io",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Api-Key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.detail",
        "errors.0.message",
        "error.message",
        "message"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
