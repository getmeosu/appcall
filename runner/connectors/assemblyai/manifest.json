      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Search transcript words",
      "description": "Search an AssemblyAI transcript for words or phrases.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptId": {
            "type": "string",
            "description": "Transcript ID.",
            "minLength": 1
          },
          "words": {
            "type": "string",
            "description": "Comma-separated words to search.",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "transcriptId",
          "words"
