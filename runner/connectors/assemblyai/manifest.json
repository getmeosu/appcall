{
  "key": "assemblyai",
  "name": "AssemblyAI",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "AssemblyAI API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.assemblyai.com",
      "streaming.assemblyai.com",
      "llm-gateway.assemblyai.com"
    ]
  },
  "models": [
    "transcript",
    "lemur",
    "streaming",
    "llm"
  ],
  "http": {
    "baseUrl": "https://api.assemblyai.com/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "detail"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "kind": "action",
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Validate the AssemblyAI API key with GET /v2/transcript?limit=1.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcript",
        "query": {
          "limit": "1"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcripts.list": {
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "kind": "action",
      "sideEffect": "read",
      "title": "List transcripts",
      "description": "List AssemblyAI transcripts created by the current API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "error"
            ]
          },
          "createdOn": {
            "type": "string",
            "minLength": 1
          },
          "beforeId": {
            "type": "string",
            "minLength": 1
          },
          "afterId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcript",
        "query": {
          "limit": "{{limit}}",
          "status": "{{status}}",
          "created_on": "{{createdOn}}",
          "before_id": "{{beforeId}}",
          "after_id": "{{afterId}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcripts.get": {
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get transcript",
      "description": "Get one AssemblyAI transcript by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "transcriptId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcript/{{transcriptId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcripts.sentences": {
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get transcript sentences",
      "description": "Get an AssemblyAI transcript split into sentences.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "transcriptId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcript/{{transcriptId}}/sentences",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcripts.paragraphs": {
      "timeoutMs": 15000,
      "maxInputBytes": 16384,
      "maxResponseBytes": 1048576,
      "kind": "action",
      "sideEffect": "read",
      "title": "Get transcript paragraphs",
      "description": "Get an AssemblyAI transcript split into paragraphs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "transcriptId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/transcript/{{transcriptId}}/paragraphs",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcripts.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create transcript",
      "description": "Submit an AssemblyAI transcription job for a media URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "audioUrl": {
            "type": "string",
            "description": "Publicly reachable audio or video URL.",
            "minLength": 1
          },
          "languageCode": {
            "type": "string",
            "description": "Language code, for example en_us.",
            "minLength": 1
          },
          "speakerLabels": {
            "type": "boolean",
            "description": "Enable speaker diarization."
          },
          "punctuate": {
            "type": "boolean",
            "description": "Enable automatic punctuation."
          },
          "formatText": {
            "type": "boolean",
            "description": "Enable text formatting."
          },
          "webhookUrl": {
            "type": "string",
            "description": "HTTPS URL for transcript completed or error webhooks.",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "audioUrl"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/transcript",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "audio_url": "{{audioUrl}}",
          "language_code": "{{languageCode}}",
          "speaker_labels": "{{speakerLabels}}",
          "punctuate": "{{punctuate}}",
          "format_text": "{{formatText}}",
          "webhook_url": "{{webhookUrl}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "transcripts.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Delete transcript",
      "description": "Delete an AssemblyAI transcript and any uploaded media attached to it.",
      "inputSchema": {
        "type": "object",
