            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/transcript/{{transcriptId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
