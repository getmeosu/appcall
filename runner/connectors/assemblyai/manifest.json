    "realtime.createToken": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create streaming token",
      "description": "Generate a temporary AssemblyAI streaming authentication token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "integer",
            "description": "Token redemption window in seconds.",
            "minimum": 1,
            "maximum": 600
          },
          "maxSessionDurationSeconds": {
            "type": "integer",
            "description": "Maximum streaming session duration in seconds.",
            "minimum": 60,
            "maximum": 10800
          }
        },
        "additionalProperties": false,
        "required": [
          "expiresInSeconds"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v3/token",
        "success": [
          200,
          201
        ],
        "query": {
          "expires_in_seconds": "{{expiresInSeconds}}",
          "max_session_duration_seconds": "{{maxSessionDurationSeconds}}"
        },
        "baseUrl": "https://streaming.assemblyai.com"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "lemur.task": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "LeMUR task",
      "description": "Run a custom AssemblyAI LeMUR prompt against one or more transcripts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transcriptIds": {
            "type": "array",
            "minItems": 1,
            "description": "Transcript IDs to analyze.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prompt": {
            "type": "string",
            "description": "LeMUR prompt.",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "description": "Optional extra context.",
            "minLength": 1
          },
          "maxOutputSize": {
            "type": "integer",
            "description": "Maximum output size.",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "transcriptIds",
          "prompt"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/lemur/v3/generate/task",
        "success": [
          200,
          201
        ],
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "transcript_ids": "{{transcriptIds}}",
          "prompt": "{{prompt}}",
          "context": "{{context}}",
          "max_output_size": "{{maxOutputSize}}"
        },
        "baseUrl": "https://api.assemblyai.com"
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
