      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/checks/api",
        "success": [
          200,
          201
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "{{name}}",
          "activated": "{{activated}}",
          "frequency": "{{frequency}}",
          "request": {
            "method": "{{method}}",
            "url": "{{url}}"
          }
        }
      }
    },
