            "type": "string",
            "minLength": 1,
            "description": "Request URL."
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "description": "HTTP method."
          },
          "activated": {
            "type": "boolean",
            "description": "Whether the check is activated."
          },
          "frequency": {
            "type": "integer",
            "minimum": 1,
            "description": "Run frequency in minutes."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
