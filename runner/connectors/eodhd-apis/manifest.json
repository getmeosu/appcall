        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/exchange-details/{{exchange}}",
        "success": [
          200
        ],
        "query": {
          "from": "{{dateFrom}}",
          "to": "{{dateTo}}",
          "fmt": "json"
        }
