      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get exchange details",
      "description": "Get trading hours, holidays, and metadata for one EODHD exchange.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "exchange": {
            "type": "string",
            "minLength": 1,
            "description": "Exchange code, for example US."
          },
          "dateFrom": {
            "type": "string",
            "minLength": 1,
            "description": "Date in YYYY-MM-DD format."
          },
          "dateTo": {
            "type": "string",
            "minLength": 1,
            "description": "Date in YYYY-MM-DD format."
          }
        },
        "additionalProperties": false,
        "required": [
          "exchange"
        ]
      },
      "outputSchema": {
        "type": "object",
