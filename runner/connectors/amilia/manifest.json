  "visibility": "public",
  "categories": [
    "scheduling"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Amilia JWT token",
          "required": true,
          "secret": true
        },
        {
          "key": "organization",
          "label": "Amilia organization identifier",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "app.amilia.com"
    ]
  },
  "models": [
    "program",
    "activity",
    "account",
    "person",
    "location",
    "membership",
    "event",
    "registration",
    "staff",
    "webhook"
  ],
  "http": {
    "baseUrl": "https://app.amilia.com/api/v3/en/org/{{organization}}",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "Message",
        "message",
        "Error",
        "error",
        "detail",
        "title"
      ]
    }
  },
