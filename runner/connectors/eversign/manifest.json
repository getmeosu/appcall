      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Xodo Sign business id. Required on every call except list businesses."
          },
          "document_hash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Document or template hash."
          },
          "signer_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Id of the signer to replace."
          },
          "new_signer_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Name of the new signer."
          },
          "new_signer_email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "description": "Email of the new signer."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Optional reason for the reassignment."
          }
        },
        "required": [
          "business_id",
          "document_hash",
          "signer_id",
          "new_signer_name",
          "new_signer_email"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Reassign result. Success is success true."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/reassign",
        "query": {
          "business_id": "{{business_id}}"
