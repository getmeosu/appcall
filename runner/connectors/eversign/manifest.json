        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "document_hash": "{{document_hash}}",
          "signer_id": "{{signer_id}}",
          "new_signer_name": "{{new_signer_name}}",
          "new_signer_email": "{{new_signer_email}}",
          "reason": "{{reason}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.delete": {
      "kind": "action",
      "sideEffect": "destructive",
      "timeoutMs": 30000,
      "maxInputBytes": 8192,
      "maxResponseBytes": 5242880,
      "title": "Delete, trash, or cancel a document",
      "description": "Delete, trash, or cancel one document or template. All three are DELETE /document. Omit both flags to delete. Set trash or cancel to 1 for that flag. Send at most one flag.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Xodo Sign business id. Required on every call except list businesses."
          },
          "document_hash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Document or template hash."
          },
          "cancel": {
            "type": "integer",
            "enum": [
              1
            ],
            "description": "Set to 1 to cancel a pending document instead of deleting it."
          },
          "trash": {
            "type": "integer",
            "enum": [
              1
            ],
            "description": "Set to 1 to trash the document or template instead of deleting it."
          }
        },
        "required": [
          "business_id",
          "document_hash"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Delete result. Success is success true."
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/document",
        "query": {
          "document_hash": "{{document_hash}}",
          "cancel": "{{cancel}}",
          "trash": "{{trash}}",
          "business_id": "{{business_id}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
