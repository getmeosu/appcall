{
  "key": "tiktok-ads",
  "name": "TikTok Ads",
  "version": "0.3.0",
  "runtime": "bun",
  "categories": [
    "ads"
  ],
  "auth": {
    "type": "oauth2",
    "scopes": [
      "ad.management",
      "ad.read"
    ],
    "setup": {
      "mode": "oauth2",
      "fields": []
