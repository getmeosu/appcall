{
  "key": "codacy",
  "name": "Codacy",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "dev-tools"
  ],
  "models": [
    "user",
    "organization",
    "repository",
    "tool"
