  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Codacy API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "app.codacy.com"
    ]
  },
  "http": {
    "baseUrl": "https://app.codacy.com/api/v3",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "api-token",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429,
        503,
        504
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "code"
      ]
    }
  },
  "operations": {
