    "campaigns.mutate": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 30000,
      "maxInputBytes": 1048576,
      "maxResponseBytes": 5242880,
      "title": "Mutate Campaigns",
      "description": "Create, update, or remove campaigns (POST customers/{id}/campaigns:mutate). On create, public startDate/endDate (and legacy start_date/end_date) map to start_date_time/end_date_time (v23+). Optional containsEuPoliticalAdvertising passes through as contains_eu_political_advertising and is never defaulted (advertiser declaration; upstream FieldError.REQUIRED if omitted on create). EffectPolicy Reconcile observes post-write state via campaigns.get.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Google Ads customer ID (hyphens optional). For MCC, pass the child account ID."
          },
          "operations": {
            "type": "array",
            "description": "Mutate operations array (create/update/remove).",
            "items": {
              "type": "object"
            }
          },
          "validateOnly": {
            "type": "boolean",
            "description": "Validate without applying changes."
          },
          "partialFailure": {
            "type": "boolean",
            "description": "Allow partial success when some operations fail."
          },
          "responseContentType": {
            "type": "string",
            "description": "RESOURCE_NAME_ONLY or MUTABLE_RESOURCE."
          },
          "loginCustomerId": {
            "type": "string",
            "description": "Optional MCC/manager customer ID for the login-customer-id header."
          },
          "containsEuPoliticalAdvertising": {
            "type": "string",
            "description": "Optional EU political advertising self-declaration for campaign create. Passed through as contains_eu_political_advertising. Use CONTAINS_EU_POLITICAL_ADVERTISING or DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING. Never defaulted by the connector."
          }
        },
        "required": [
          "customerId",
          "operations"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "campaign": {
            "type": [
              "object",
              "null"
            ],
            "description": "Normalized campaign after EffectPolicy Reconcile via campaigns.get."
          },
          "resourceNames": {
            "type": "array",
            "description": "Mutate resource names (present on mutate-only path before runner Reconcile)."
          }
        }
      },
      "effectPolicy": "Reconcile",
      "reconcile": "campaigns.get"
    },
