      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 524288,
      "title": "Healthcheck",
      "description": "Validate the Affinity API key with GET /v2/auth/whoami.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "data"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v2/auth/whoami",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
