          "data"
        ],
        "type": "object"
      },
      "request": {
        "method": "GET",
        "path": "/v2/companies",
        "query": {
          "cursor": "{{cursor}}",
          "limit": "{{limit}}",
          "ids": "{{ids}}",
          "fieldIds": "{{fieldIds}}",
          "fieldTypes": "{{fieldTypes}}"
        },
        "success": [
          200
        ]
      },
      "responseFormat": "json",
      "sideEffect": "read",
      "timeoutMs": 15000,
