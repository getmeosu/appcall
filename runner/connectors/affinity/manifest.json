{
  "key": "affinity",
  "name": "Affinity",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "crm"
  ],
  "auth": {
    "type": "api_key",
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Affinity API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.affinity.co"
    ]
  },
  "models": [
    "user",
    "person",
    "company",
    "opportunity",
    "list",
    "note",
    "reminder",
    "email",
    "meeting"
  ],
  "http": {
    "baseUrl": "https://api.affinity.co",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "errors.0.message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
