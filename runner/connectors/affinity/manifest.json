          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "description": "Affinity company IDs to fetch directly. Emitted as repeated ids query keys.",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "fieldIds": {
            "type": "array",
            "minItems": 1,
            "description": "Field IDs whose values should be returned. Emitted as repeated fieldIds query keys.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fieldTypes": {
            "type": "array",
            "minItems": 1,
            "description": "Field types whose values should be returned. Emitted as repeated fieldTypes query keys.",
            "items": {
              "type": "string",
              "enum": [
                "enriched",
                "global",
                "relationship-intelligence"
              ]
            }
          }
        },
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
