{
  "key": "eventzilla",
  "name": "Eventzilla",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "scheduling"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Eventzilla API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "network": {
    "allowedHosts": [
      "www.eventzillaapi.net"
    ]
  },
  "models": [
    "event",
    "ticket",
    "user",
    "attendee",
    "transaction",
    "category",
    "checkout"
  ],
  "http": {
    "baseUrl": "https://www.eventzillaapi.net/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "value": "{{apiKey}}"
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error",
        "error_code",
        "detail",
        "title"
      ]
    }
  },
  "operations": {
