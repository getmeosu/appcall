{
  "key": "bamboohr",
  "name": "BambooHR",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "BambooHR API key",
          "required": true,
          "secret": true
        },
        {
          "key": "companyDomain",
          "label": "BambooHR company subdomain",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "*.bamboohr.com"
    ]
  },
  "models": [
    "company",
    "field",
    "employee",
    "timeOff",
    "user",
    "file"
  ],
  "http": {
    "baseUrl": "https://{{companyDomain}}.bamboohr.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": "x"
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "detail",
        "message",
        "error"
      ]
    }
  },
  "operations": {
