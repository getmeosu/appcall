          },
          "include_errors": {
            "description": "Include an error report with the results.",
            "type": "boolean"
          },
          "items": {
            "description": "Crawler or scraper input objects. Fields vary by dataset; URL crawlers commonly require url.",
            "items": {
              "additionalProperties": true,
              "properties": {},
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "items",
          "dataset_id"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
