          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "query": "{{query}}",
          "result_limit": "{{result_limit}}",
          "spec": {
            "columns": "{{columns}}",
            "name": "{{name}}",
            "query": "{{query}}",
            "title": "{{title}}"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/datasets/deep_lookup/v1/trigger",
