    "zones.create": {
      "description": "Create a durable SERP API zone using Bright Data's safe SERP plan (zone.type=serp, plan.type=unblocker, plan.serp=true). product=scraping_browser is accepted and still provisions a SERP zone; Browser API plan mapping is not applied.",
      "enforceOutputSchema": true,
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "description": "Lowercase ISO 3166-1 alpha-2 country code, or any.",
            "minLength": 1,
            "type": "string"
          },
          "custom_headers": {
            "description": "Allow custom request headers in the new zone.",
            "type": "boolean"
          },
          "name": {
            "description": "Name for the new Bright Data zone.",
            "minLength": 1,
            "type": "string"
          },
          "product": {
            "description": "Safe product to provision. scraping_browser is accepted; this operation always sends the official SERP plan.",
            "enum": [
              "serp",
              "scraping_browser"
            ],
            "type": "string"
          },
          "solve_captcha_disable": {
            "description": "For SERP zones, disable Bright Data captcha solving.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "product"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "request": {
        "body": {
          "plan": {
            "country": "{{country}}",
            "custom_headers": "{{custom_headers}}",
            "serp": true,
            "solve_captcha_disable": "{{solve_captcha_disable}}",
            "type": "unblocker"
          },
          "zone": {
            "name": "{{name}}",
            "type": "serp"
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/zone",
        "success": [
          200,
          201
        ]
      },
      "responseFormat": "json",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "title": "Create safe zone",
      "validationMode": "strict-generated"
    },
