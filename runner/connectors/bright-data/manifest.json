            "description": "Machine-readable name for the requested entity collection.",
            "minLength": 1,
            "type": "string"
          },
          "query": {
            "description": "Research query. Bright Data requires it to begin with 'Find all'.",
            "minLength": 1,
            "type": "string"
          },
          "result_limit": {
            "description": "Maximum number of matched, billable records to return.",
            "minimum": 1,
            "type": "integer"
          },
          "title": {
            "description": "Optional human-readable title for the lookup.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query",
          "columns",
          "result_limit"
        ],
        "type": "object"
      },
      "kind": "action",
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "outputSchema": {
        "additionalProperties": false,
