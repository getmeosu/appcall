            "type": "string",
            "minLength": 1,
            "description": "Optional snapshot status filter.",
            "enum": [
              "starting",
              "running",
              "ready",
              "failed",
              "canceled"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "Maximum snapshots to return.",
            "minimum": 1,
            "maximum": 5000
          }
        },
        "additionalProperties": false,
        "required": [
          "datasetId"
        ]
      },
      "outputSchema": {
        "type": "object",
