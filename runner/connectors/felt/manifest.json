{
  "key": "felt",
  "name": "Felt",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Felt API token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "felt.com"
    ]
  },
  "models": [
    "user",
    "project",
    "map",
    "layer",
    "comment",
    "source"
  ],
  "http": {
    "baseUrl": "https://felt.com/api/v2",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "errors.0.detail",
        "errors.0.title",
        "errors.0.code",
        "message"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
