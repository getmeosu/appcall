          "start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "1-based offset."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "description": "Page size from 1 to 5000."
          },
          "sort": {
            "type": "string",
            "enum": [
