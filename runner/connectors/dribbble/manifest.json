{
  "key": "dribbble",
  "name": "Dribbble",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "description": "Authenticated Dribbble API operations using a manually supplied OAuth2 access token.",
  "categories": [
    "social"
  ],
  "auth": {
    "type": "bearer",
    "scopes": [
      "public",
      "upload"
    ],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accessToken",
          "label": "OAuth2 user access token (manual; no automatic refresh)",
          "secret": true,
          "required": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.dribbble.com"
    ]
  },
  "models": [
    "user",
    "shot",
    "project",
    "attachment"
  ],
  "http": {
    "baseUrl": "https://api.dribbble.com/v2",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "x-ratelimit-reset",
      "retryAfterKind": "unix",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "message"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Healthcheck",
      "description": "Verify the OAuth2 user access token by reading the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "users.me": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get authenticated user",
      "description": "Read the authenticated Dribbble user profile.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
