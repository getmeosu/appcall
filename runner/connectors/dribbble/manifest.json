      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Remove shot from project",
      "description": "Detach a shot from a Dribbble project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "description": "Project ID owned by the authenticated user.",
            "minimum": 1
          },
          "shotId": {
            "type": "integer",
            "description": "Shot ID owned by the authenticated user.",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "projectId",
          "shotId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "deleted",
          "projectId"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "projectId": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "DELETE",
        "path": "/projects/{{projectId}}/shots/{{shotId}}",
        "success": [
          204,
          200
        ],
        "result": {
          "deleted": true,
          "projectId": "{{input.projectId}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  },
  "models": [
    "user",
    "shot",
    "project",
    "attachment"
  ]
}
