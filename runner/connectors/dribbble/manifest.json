            "type": "array"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/user/shots",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
