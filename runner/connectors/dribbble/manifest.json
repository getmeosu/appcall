{
  "key": "dribbble",
  "name": "Dribbble",
  "version": "0.2.0",
  "runtime": "bun",
  "description": "Authenticated Dribbble API operations using a manually supplied OAuth2 access token.",
  "categories": [
    "social"
  ],
  "auth": {
    "type": "bearer",
    "scopes": [
      "public",
      "upload"
    ],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "accessToken",
          "label": "OAuth2 user access token (manual; no automatic refresh)",
          "secret": true,
          "required": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.dribbble.com"
    ]
  },
  "http": {
    "baseUrl": "https://api.dribbble.com/v2",
    "auth": {
      "field": "accessToken",
      "in": "header",
      "name": "Authorization",
      "value": "Bearer {{accessToken}}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "x-ratelimit-reset",
      "retryAfterKind": "unix",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "message"
      ],
      "bodyErrorPaths": [
        "errors"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "Healthcheck",
      "description": "Verify the OAuth2 user access token by reading the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "success": [
          200
        ],
        "echo": {
          "status": "ok"
        },
        "result": {
          "user": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "users.me": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "Users Me",
      "description": "Read the authenticated user profile.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "success": [
          200
        ],
        "result": {
          "user": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "shots.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "Shots List",
      "description": "List shots owned by the authenticated user. Returns the raw Link header; read rel=next to request the next page. Never assume a short page is the last page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number, starting at 1. Use the page indicated by paginationLink rel=next."
          },
          "perPage": {
            "type": "integer",
            "description": "Page size up to 100; some endpoints may ignore this value."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "shots": {
            "type": "array",
            "description": "Provider result."
          },
          "paginationLink": {
            "type": "string",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/user/shots",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}"
        },
        "result": {
          "shots": "{{response}}",
          "paginationLink": "{{headers.link}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "shots.get": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "Shots Get",
      "description": "Get an existing shot owned by the authenticated user; this is not a public discovery endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Shot ID owned by the authenticated user."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "shot": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/shots/{{id}}",
        "success": [
          200
        ],
        "result": {
          "shot": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "shots.create": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 12582912,
      "maxResponseBytes": 12582912,
      "sideEffect": "write",
      "title": "Create Shot",
      "description": "Create a shot owned by the authenticated user via multipart image upload. Requires upload scope. Processing is asynchronous; the Location header points at the new shot once Dribbble accepts the file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Shot title."
          },
          "image": {
            "type": "string",
            "description": "Shot image as base64 or raw bytes encoded as a string. Must be GIF, JPG, or PNG, 400x300 or 800x600, and at most 8 MB."
          },
          "imageFileName": {
            "type": "string",
            "description": "Image file name including extension. Defaults to shot.png."
          },
          "imageContentType": {
            "type": "string",
            "description": "Image MIME type. Sniffed from magic bytes when omitted."
          },
          "description": {
            "type": "string",
            "description": "Shot description."
          },
          "tags": {
            "type": "array",
            "description": "Tags, maximum 12.",
            "items": {
              "type": "string"
            }
          },
          "lowProfile": {
            "type": "boolean",
            "description": "Whether the shot is low profile."
          },
          "reboundSourceId": {
            "type": "integer",
            "description": "ID of a reboundable source shot."
          },
          "scheduledFor": {
            "type": "string",
            "description": "ISO 8601 timestamp to publish the shot. Omit to publish immediately."
          },
          "teamId": {
            "type": "integer",
            "description": "Team ID to associate with the shot."
          }
        },
        "required": [
          "title",
          "image"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "Whether Dribbble accepted the upload."
          },
          "location": {
            "type": "string",
            "description": "Location of the new shot once processing completes."
          },
          "shotId": {
            "type": "integer",
            "description": "Shot ID parsed from the Location header when present."
          },
          "data": {
            "type": "object",
            "description": "Provider JSON body when present."
          }
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "shots.update": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "write",
      "title": "Shots Update",
      "description": "Update an owned shot title, description, tags or visibility. Requires upload scope. Omitted fields are unchanged; uploading media is unsupported.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Shot ID owned by the authenticated user."
          },
          "title": {
            "type": "string",
            "description": "Shot title."
          },
          "description": {
            "type": "string",
            "description": "Shot description."
          },
          "tags": {
            "type": "array",
            "description": "Replacement tags, maximum 12. Existing omitted tags are removed."
          },
          "lowProfile": {
            "type": "boolean",
            "description": "Whether the shot is low profile."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "shot": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "PUT",
        "path": "/shots/{{id}}",
        "success": [
          200
        ],
        "body": {
          "title": "{{title}}",
          "description": "{{description}}",
          "tags": "{{tags}}",
          "low_profile": "{{lowProfile}}"
        },
        "result": {
          "shot": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "shots.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "write",
      "title": "Shots Delete",
      "description": "Permanently delete a shot owned by the authenticated user. Requires upload scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Shot ID owned by the authenticated user."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/shots/{{id}}",
        "success": [
          204
        ],
        "result": {
          "deleted": true
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "projects.list": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "read",
      "title": "List My Projects",
      "description": "List projects owned by the authenticated user. Returns the raw Link header; read rel=next to request the next page. Never assume a short page is the last page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Page number, starting at 1. Use the page indicated by paginationLink rel=next."
          },
          "perPage": {
            "type": "integer",
            "description": "Page size up to 100; some endpoints may ignore this value."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "description": "Provider result."
          },
          "paginationLink": {
            "type": "string",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/user/projects",
        "success": [
          200
        ],
        "query": {
          "page": "{{page}}",
          "per_page": "{{perPage}}"
        },
        "result": {
          "projects": "{{response}}",
          "paginationLink": "{{headers.link}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "projects.create": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "write",
      "title": "Create Project",
      "description": "Create a project owned by the authenticated user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name."
          },
          "description": {
            "type": "string",
            "description": "Project description."
          }
        },
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/projects",
        "success": [
          201,
          200
        ],
        "body": {
          "name": "{{name}}",
          "description": "{{description}}"
        },
        "result": {
          "project": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "projects.update": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "write",
      "title": "Update Project",
      "description": "Update an owned project name or description. Omitted fields are unchanged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Project ID owned by the authenticated user."
          },
          "name": {
            "type": "string",
            "description": "Project name."
          },
          "description": {
            "type": "string",
            "description": "Project description."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "PUT",
        "path": "/projects/{{id}}",
        "success": [
          200
        ],
        "body": {
          "name": "{{name}}",
          "description": "{{description}}"
        },
        "result": {
          "project": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "projects.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "write",
      "title": "Delete Project",
      "description": "Delete a project owned by the authenticated user. Dribbble returns the deleted project.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Project ID owned by the authenticated user."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/projects/{{id}}",
        "success": [
          200,
          204
        ],
        "result": {
          "project": "{{response}}"
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "attachments.create": {
      "kind": "action",
      "timeoutMs": 30000,
      "maxInputBytes": 15728640,
      "maxResponseBytes": 15728640,
      "sideEffect": "write",
      "title": "Upload Shot Attachment",
      "description": "Upload an attachment file on a shot owned by the authenticated user. Requires upload scope. Processing is asynchronous.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shotId": {
            "type": "integer",
            "description": "Shot ID owned by the authenticated user."
          },
          "file": {
            "type": "string",
            "description": "Attachment file as base64 or raw bytes encoded as a string. At most 10 MB."
          },
          "fileName": {
            "type": "string",
            "description": "Attachment file name including extension. Defaults to attachment.bin."
          },
          "contentType": {
            "type": "string",
            "description": "Attachment MIME type. Defaults to application/octet-stream."
          }
        },
        "required": [
          "shotId",
          "file"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "Whether Dribbble accepted the upload."
          },
          "data": {
            "type": "object",
            "description": "Provider JSON body when present."
          }
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "attachments.delete": {
      "kind": "action",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 2097152,
      "sideEffect": "write",
      "title": "Delete Shot Attachment",
      "description": "Permanently delete a shot attachment owned by the authenticated user. Requires upload scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shotId": {
            "type": "integer",
            "description": "Shot ID owned by the authenticated user."
          },
          "id": {
            "type": "integer",
            "description": "Attachment ID owned by the authenticated user."
          }
        },
        "required": [
          "shotId",
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Provider result."
          }
        }
      },
      "request": {
        "method": "DELETE",
        "path": "/shots/{{shotId}}/attachments/{{id}}",
        "success": [
          204,
          200
        ],
        "result": {
          "deleted": true
        }
      },
      "enforceOutputSchema": true,
      "responseFormat": "json",
      "validationMode": "strict-generated"
    },
    "projects.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get project",
      "description": "Get one Dribbble project by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Project ID owned by the authenticated user.",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/projects/{{id}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
