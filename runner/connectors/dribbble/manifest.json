      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "shots.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 10000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create shot",
      "description": "Create a Dribbble shot metadata record. Image upload is asynchronous; requires the upload scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Shot or project title."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "HTML or text description."
          },
          "tags": {
            "type": "array",
            "description": "Replacement tags, maximum 12."
          },
          "lowProfile": {
            "type": "boolean",
            "description": "Whether the shot is low profile."
          }
        },
        "additionalProperties": false,
        "required": [
          "title"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "POST",
        "path": "/shots",
        "success": [
          202,
          201,
          200
        ],
        "body": {
          "title": "{{title}}",
          "description": "{{description}}",
          "tags": "{{tags}}",
          "low_profile": "{{lowProfile}}"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
