{
  "connector": "dribbble",
  "scenarios": [
    {
      "name": "Authenticated account identity",
      "operation": "users.me",
      "input": {},
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "user",
            "op": "isObject"
          },
          {
            "path": "user.name",
            "op": "type",
            "value": "string"
          },
          {
            "path": "user.id",
            "op": "type",
            "value": "number"
          }
        ]
      }
    },
    {
      "name": "First read-only page",
      "operation": "shots.list",
      "input": {
        "page": 1,
        "perPage": 1
      },
      "expect": {
        "status": "ok",
        "assertions": [
          {
            "path": "shots",
            "op": "type",
            "value": "array"
          }
        ]
      }
    }
  ]
}
