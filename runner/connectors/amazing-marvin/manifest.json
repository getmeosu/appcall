{
  "key": "amazing-marvin",
  "name": "Amazing Marvin",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiToken",
          "label": "Amazing Marvin API token",
          "required": true,
          "secret": true
        },
        {
          "key": "fullAccessToken",
          "label": "Amazing Marvin full access token",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "serv.amazingmarvin.com"
    ]
  },
  "models": [
    "task",
    "project",
    "reminder",
    "document",
    "time-tracking"
  ],
  "http": {
    "baseUrl": "https://serv.amazingmarvin.com/api",
    "auth": {
      "field": "apiToken"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 60,
      "messagePaths": [
        "error",
        "message",
        "reason"
      ]
    },
    "headers": {
      "Accept": "application/json"
    }
  },
  "operations": {
    "tasks.complete": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Complete Task",
      "description": "Mark one task complete with POST /api/markDone. confirm_completion must be true and is not sent. The provider uses timeZoneOffset minutes to choose the completion date. The documented success body is a JSON object; this call does not undo completion.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "confirm_completion",
          "time_zone_offset_minutes"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "ID of the task to mark complete (provider itemId)."
          },
          "confirm_completion": {
            "type": "boolean",
            "const": true,
            "description": "Must be true. Not sent to Amazing Marvin."
          },
          "time_zone_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840,
            "description": "Local UTC offset in minutes (local time minus UTC), such as -480 for UTC-08:00."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/markDone",
        "headers": {
          "Content-Type": "application/json",
          "X-API-Token": "{{apiToken}}"
        },
        "body": {
          "itemId": "{{task_id}}",
          "timeZoneOffset": "{{time_zone_offset_minutes}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "projects.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Project",
      "description": "Create a project with POST /api/addProject. time_estimate_ms is the provider timeEstimate in milliseconds. A hash in the title can be parsed as a parent id by the provider; this route ignores X-Auto-Complete.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Project title."
          },
          "note": {
            "type": "string",
            "maxLength": 20000,
            "description": "Optional project note."
          },
          "due_date": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Due date in YYYY-MM-DD format (provider dueDate)."
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high"
            ],
            "description": "Project priority."
          },
          "label_ids": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": "Label IDs (provider labelIds)."
          },
          "parent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Parent project or category ID. Omit for a root project."
          },
          "backburner": {
            "type": "boolean",
            "description": "Place the project on the backburner."
          },
          "planned_week": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Monday of the planned week in YYYY-MM-DD format."
          },
          "planned_month": {
            "type": "string",
            "minLength": 7,
            "maxLength": 7,
            "description": "Planned month in YYYY-MM format."
          },
          "scheduled_date": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Schedule date in YYYY-MM-DD format (provider day). Omit to leave the project unscheduled."
          },
          "time_estimate_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31536000000,
            "description": "Estimated duration in milliseconds (provider timeEstimate). Composio minutes times 60000."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/addProject",
        "headers": {
          "Content-Type": "application/json",
          "X-API-Token": "{{apiToken}}"
        },
        "body": {
          "title": "{{title}}",
          "note": "{{note}}",
          "parentId": "{{parent_id}}",
          "labelIds": "{{label_ids}}",
          "day": "{{scheduled_date}}",
          "dueDate": "{{due_date}}",
          "plannedWeek": "{{planned_week}}",
          "plannedMonth": "{{planned_month}}",
          "priority": "{{priority}}",
          "backburner": "{{backburner}}",
          "timeEstimate": "{{time_estimate_ms}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "tasks.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 1048576,
      "title": "Create Task",
      "description": "Create a task with POST /api/addTask. Title autocompletion stays on unless auto_complete_title is the string false, which sends X-Auto-Complete: false. time_estimate_ms is provider timeEstimate in milliseconds.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Task title. Shortcut syntax is parsed unless auto_complete_title is false."
          },
          "note": {
            "type": "string",
            "maxLength": 20000,
            "description": "Optional task note."
          },
          "due_date": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Due date in YYYY-MM-DD format (provider dueDate)."
          },
          "label_ids": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": "Label IDs (provider labelIds)."
          },
          "parent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Parent project or category ID. Omit for an unassigned inbox task."
          },
          "backburner": {
            "type": "boolean",
            "description": "Place the task on the backburner."
          },
          "planned_week": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Monday of the planned week in YYYY-MM-DD format."
          },
          "bonus_section": {
            "type": "string",
            "enum": [
              "Essential",
              "Bonus"
            ],
            "description": "Essential or Bonus section."
          },
          "daily_section": {
            "type": "string",
            "enum": [
              "Morning",
              "Afternoon",
              "Evening"
            ],
            "description": "Daily planning section."
          },
          "planned_month": {
            "type": "string",
            "minLength": 7,
            "maxLength": 7,
            "description": "Planned month in YYYY-MM format."
          },
          "scheduled_date": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Schedule date in YYYY-MM-DD format (provider day)."
          },
          "auto_complete_title": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ],
            "description": "Sent as X-Auto-Complete. false stores the title literally. Omit to leave provider autocompletion on."
          },
          "time_estimate_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31536000000,
            "description": "Estimated duration in milliseconds (provider timeEstimate). Composio minutes times 60000."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/addTask",
        "headers": {
          "Content-Type": "application/json",
          "X-API-Token": "{{apiToken}}",
          "X-Auto-Complete": "{{auto_complete_title}}"
        },
        "body": {
          "title": "{{title}}",
          "note": "{{note}}",
          "parentId": "{{parent_id}}",
          "labelIds": "{{label_ids}}",
          "day": "{{scheduled_date}}",
          "dueDate": "{{due_date}}",
          "plannedWeek": "{{planned_week}}",
          "plannedMonth": "{{planned_month}}",
          "dailySection": "{{daily_section}}",
          "bonusSection": "{{bonus_section}}",
          "backburner": "{{backburner}}",
          "timeEstimate": "{{time_estimate_ms}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "time-tracking.current": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Get Current Time Tracking",
      "description": "GET /api/trackedItem. The documented success body is the tracked task object. An idle timer can return an empty body, which this connector rejects instead of inventing tracked false.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/trackedItem",
        "headers": {
          "X-API-Token": "{{apiToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "reminders.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "List Reminders",
      "description": "GET /api/reminders with X-Full-Access-Token. Returns the JSON array of currently scheduled reminders, wrapped as data.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/reminders",
        "headers": {
          "X-Full-Access-Token": "{{fullAccessToken}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "time-tracking.set": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
      "title": "Set Time Tracking",
      "description": "Start or stop time tracking with POST /api/track. Stopping does not by itself update the task duration or times. Provider issues are returned on the JSON object.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "task_id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "START",
              "STOP"
            ],
            "description": "Whether to start or stop tracking the task."
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "ID of the task whose timer should change (provider taskId)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/track",
        "headers": {
          "Content-Type": "application/json",
          "X-API-Token": "{{apiToken}}"
        },
        "body": {
          "taskId": "{{task_id}}",
          "action": "{{action}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "documents.update": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 20000,
      "maxInputBytes": 262144,
      "maxResponseBytes": 1048576,
      "title": "Update Document",
      "description": "POST /api/doc/update with X-Full-Access-Token. setters replace fields on an existing document and the provider returns the persisted JSON object. An invalid key or value can corrupt the document and break the Marvin client.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "setters"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "ID of the existing document (provider itemId)."
          },
          "setters": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "description": "Ordered field replacements. Each item is a provider setter with key and val.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "val"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Document field name, such as title or fieldUpdates.title."
                },
                "val": {
                  "description": "JSON value written to that field.",
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "boolean" },
                    { "type": "null" },
                    { "type": "array" },
                    { "type": "object" }
                  ]
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "request": {
        "method": "POST",
        "path": "/doc/update",
        "headers": {
          "Content-Type": "application/json",
          "X-Full-Access-Token": "{{fullAccessToken}}"
        },
        "body": {
          "itemId": "{{document_id}}",
          "setters": "{{setters}}"
        },
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    }
  }
}
