        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "id": "{{id}}",
          "delete_recipients": "{{deleteRecipients}}"
        },
        "bodyEncoding": "form"
      }
    },
