{
  "key": "stannp",
  "name": "Stannp",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "ads"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Stannp API key",
          "required": true,
          "secret": true
        },
        {
          "key": "region",
          "label": "Stannp API region (eu or us)",
          "required": true,
          "secret": false
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api-eu1.stannp.com",
      "api-us1.stannp.com"
    ]
  },
  "models": [
    "account",
    "recipient",
    "group",
    "template",
    "letter",
    "postcard",
    "campaign"
  ],
  "http": {
    "baseUrl": "https://api-{{region}}1.stannp.com",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "Authorization",
      "basic": {
        "username": "{{apiKey}}",
        "password": ""
      }
    },
    "headers": {
      "Accept": "application/json"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "retry-after",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "error",
        "message",
        "data.error"
      ],
      "bodyErrorPaths": [
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Stannp API key with GET /v1/accounts/balance.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/accounts/balance",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "recipients.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List recipients",
      "description": "List Stannp recipients, optionally filtered by group and paginated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/recipients/list",
        "success": [
          200
        ],
        "query": {
          "group_id": "{{groupId}}",
          "offset": "{{offset}}",
          "limit": "{{limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "recipients.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Get recipient",
      "description": "Retrieve one Stannp recipient by ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "recipientId"
        ],
        "properties": {
          "recipientId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/recipients/get/{{recipientId}}",
        "success": [
          200
        ]
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "groups.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List groups",
      "description": "List Stannp recipient groups with optional offset and limit pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "method": "GET",
        "path": "/v1/groups/list",
        "success": [
          200
        ],
        "query": {
          "offset": "{{offset}}",
          "limit": "{{limit}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "recipients.create": {
      "kind": "action",
      "sideEffect": "write",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "Create recipient",
      "description": "Create a Stannp recipient, optionally adding them to a group.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string",
            "description": "First name."
          },
          "lastname": {
            "type": "string",
            "description": "Last name."
          },
          "address1": {
            "type": "string",
            "description": "Address line 1."
          },
          "city": {
            "type": "string",
            "description": "City."
          },
          "zipcode": {
            "type": "string",
            "description": "Postal or ZIP code."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "email": {
            "type": "string",
            "description": "Email address."
          },
          "groupId": {
            "type": "integer",
            "minimum": 1,
            "description": "Group to add the recipient to."
          },
          "onDuplicate": {
            "type": "string",
            "enum": [
              "update",
              "ignore",
              "duplicate"
            ],
            "description": "Duplicate handling."
          }
        },
        "additionalProperties": false,
        "required": [
          "firstname",
          "address1",
          "country"
        ]
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json",
      "request": {
        "method": "POST",
        "path": "/v1/recipients/new",
        "success": [
          200
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": {
          "firstname": "{{firstname}}",
          "lastname": "{{lastname}}",
          "address1": "{{address1}}",
          "city": "{{city}}",
          "zipcode": "{{zipcode}}",
          "country": "{{country}}",
          "email": "{{email}}",
          "group_id": "{{groupId}}",
          "on_duplicate": "{{onDuplicate}}"
        },
        "bodyEncoding": "form"
      }
    },
