          "template": {
            "type": "integer",
            "minimum": 1,
            "description": "Existing template id."
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tags."
          },
          "recipient": {
            "type": "object",
            "description": "Inline recipient address object or existing recipient id wrapper."
          }
        },
        "additionalProperties": false,
        "required": [
