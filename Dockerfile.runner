# appcall Bun runner: executes connector actions/healthchecks against real
# provider APIs. It has no dependency install step — the runner imports only
# relative TypeScript sources (runner/bun + runner/connectors) and node:crypto.
#
# Inside the container it must bind 0.0.0.0 so the API container can reach it;
# isolation comes from the compose network (the port is never published) plus
# the APPCALL_RUNNER_TOKEN bearer check.
FROM oven/bun:1-alpine@sha256:07235578f79ef8c6f97d94aee7938e76f5cdba5f21ae5dbfdd3d3d38058437eb
WORKDIR /app
COPY LICENSE NOTICE LICENSING /app/licenses/appcall/
COPY third_party/NOTICE /app/licenses/third-party/NOTICE
COPY third_party/anusa-sdk-go-NOTICE /app/licenses/third-party/anusa-sdk-go-NOTICE
COPY third_party/licenses/ /app/licenses/third-party/licenses/
COPY runner/bun /app/runner/bun
COPY runner/supervisor /app/runner/supervisor
COPY runner/connectors /app/runner/connectors
ENV APPCALL_RUNNER_HOST=0.0.0.0 \
    APPCALL_RUNNER_PORT=5081
EXPOSE 5081
USER bun
CMD ["bun", "run", "/app/runner/supervisor/src/index.ts"]
