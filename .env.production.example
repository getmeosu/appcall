# Rust production-topology configuration for docker-compose.prod.yml.
# Copy to .env.production and supply real values only in the gitignored copy.
# Image/local qualification is not proof that production rollout is complete.
# Compose injects APPCALL_DATABASE_URL, APPCALL_RUNNER_URL and APPCALL_HTTP_ADDR;
# do not override those here. Anusa is a separate configured service/database.

APPCALL_ENV=production
POSTGRES_PASSWORD=

# REQUIRED stable AES-256 vault key, 64 hex characters: openssl rand -hex 32
# Do not rotate without a migration for existing encrypted credentials.
APPCALL_SECRET_KEY=
# REQUIRED platform API key (historical variable name), at least 24 characters.
# Scoped to proj_dev; database-managed project keys are independently scoped.
# Generate: openssl rand -hex 32. Never use devkey or ak_dev_local in production.
APPCALL_DEV_API_KEY=
# REQUIRED shared bearer token for API/worker -> Bun runner.
APPCALL_RUNNER_TOKEN=

# REQUIRED externally reachable HTTPS origin served by the reverse proxy.
APPCALL_PUBLIC_BASE_URL=https://api.example.com
# REQUIRED callback signing secret: openssl rand -hex 32
APPCALL_WEBHOOK_SIGNING_SECRET=
# REQUIRED stable OAuth state key, 64 hex characters (or exactly 32 raw bytes).
# Use the same key across replicas and deploys: openssl rand -hex 32
APPCALL_OAUTH_STATE_SECRET=

# --- REQUIRED Anusa browser identity configuration ---
# Production never permits the loopback development dashboard or auth downgrade.
ANUSA_API_URL=https://identity.example.com
# Must match Anusa's access-token JWT signing secret.
ANUSA_JWT_ACCESS_SECRET=
# Separate long random cookie-encryption secret; rotation signs users out.
APPCALL_SESSION_SECRET=
# Production always marks the cookie Secure and requires the public HTTPS origin.
APPCALL_SESSION_COOKIE_SECURE=true
# Anusa's existing identity DB is REQUIRED for live membership and revocation.
# AppCall migrations do not create this schema. Use the appropriate TLS mode.
ANUSA_DATABASE_URL=
# Configure Anusa FRONTEND_URL to APPCALL_PUBLIC_BASE_URL for email/OAuth returns.

# --- Worker ---
# Compose leaves MAX_JOBS empty for persistent operation; do not set a one-shot cap.
# APPCALL_WORKER_ID=
# APPCALL_WORKER_INTERVAL_MS=1000

# --- Entitlements / limits ---
# Unipile linking is billable and denied at 0; raise deliberately to enable.
APPCALL_UNIPILE_MAX_ACCOUNTS=0
# APPCALL_SEND_CAP=0
# APPCALL_SPEND_CAP_MICROS=0
# APPCALL_SEND_COST_MICROS=0
# APPCALL_ACTION_CALLS_SOFT_LIMIT=0
# APPCALL_ACTION_CALLS_HARD_LIMIT=0
# APPCALL_RATE_LIMIT_RPS=50
# APPCALL_RATE_LIMIT_BURST=100

# --- Managed OAuth apps ---
# Unconfigured managed OAuth cannot be started. A configured client ID never
# falls back to local OAuth when its secret or redirect is invalid/missing.
# Redirect URIs must be registered with the provider; manifests supply endpoints.
# APPCALL_GOOGLE_OAUTH_CLIENT_ID=
# APPCALL_GOOGLE_OAUTH_CLIENT_SECRET=
# APPCALL_GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/v1/connectors/google-workspace/setup/oauth/callback
# APPCALL_SLACK_OAUTH_CLIENT_ID=
# APPCALL_SLACK_OAUTH_CLIENT_SECRET=
# APPCALL_SLACK_OAUTH_REDIRECT_URI=https://api.example.com/v1/connectors/slack/setup/oauth/callback

# --- LinkedIn safety: unset/0 preserves built-in caps and warm-up ---
# APPCALL_LINKEDIN_WARMUP_DISABLED=
# APPCALL_LINKEDIN_INVITE_DAILY_CAP=
# APPCALL_LINKEDIN_INVITE_WEEKLY_CAP=
# APPCALL_LINKEDIN_MESSAGE_DAILY_CAP=
# APPCALL_LINKEDIN_MESSAGE_WEEKLY_CAP=
# APPCALL_LINKEDIN_PROFILE_VIEW_DAILY_CAP=
# APPCALL_LINKEDIN_INVITE_MIN_SPACING_SECONDS=
# APPCALL_LINKEDIN_MESSAGE_MIN_SPACING_SECONDS=
