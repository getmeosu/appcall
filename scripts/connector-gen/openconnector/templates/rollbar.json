    "projects.get": {"kind": "action", "sideEffect": "read", "timeoutMs": 10000, "maxInputBytes": 4096, "maxResponseBytes": 1048576, "title": "Get Project", "description": "Get a Rollbar project by numeric ID.", "inputSchema": {"type": "object", "required": ["projectId"], "additionalProperties": false, "properties": {"projectId": {"type": "integer", "minimum": 1}}}, "outputSchema": {"type": "object"}, "request": {"method": "GET", "path": "/project/{{projectId}}", "success": [200], "result": "{{response.result}}"}, "enforceOutputSchema": true},
    "items.list": {"kind": "action", "sideEffect": "read", "timeoutMs": 15000, "maxInputBytes": 16384, "maxResponseBytes": 5242880, "title": "List Items", "description": "List Rollbar items with bounded page and limit filters.", "inputSchema": {"type": "object", "additionalProperties": false, "properties": {"page": {"type": "integer", "minimum": 1}, "status": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "limit": {"type": "integer", "minimum": 1, "maximum": 5000}}}, "outputSchema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"type": "object"}}}}, "request": {"method": "GET", "path": "/items", "query": {"page": "{{page}}", "status": "{{status}}", "environment": "{{environment}}", "limit": "{{limit}}"}, "success": [200], "result": "{{response.result}}"}, "enforceOutputSchema": true},
    "items.get": {"kind": "action", "sideEffect": "read", "timeoutMs": 10000, "maxInputBytes": 4096, "maxResponseBytes": 1048576, "title": "Get Item", "description": "Get a Rollbar item by numeric ID.", "inputSchema": {"type": "object", "required": ["itemId"], "additionalProperties": false, "properties": {"itemId": {"type": "integer", "minimum": 1}}}, "outputSchema": {"type": "object"}, "request": {"method": "GET", "path": "/item/{{itemId}}", "success": [200], "result": "{{response.result}}"}, "enforceOutputSchema": true}
