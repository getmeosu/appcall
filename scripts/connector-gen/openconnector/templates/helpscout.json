{
  "key": "helpscout",
  "name": "Help Scout",
  "version": "0.1.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": ["crm", "productivity"],
  "auth": {
    "type": "oauth2",
    "scopes": [],
    "setup": { "mode": "oauth2", "fields": [], "help": "Connect a Help Scout user account through OAuth2.", "docsUrl": "https://developer.helpscout.com/mailbox-api/overview/authentication/" },
    "oauth": {
      "authorizeUrl": "https://secure.helpscout.net/authentication/authorizeClientApplication",
      "tokenUrl": "https://api.helpscout.net/v2/oauth2/token",
      "pkce": false,
      "supportsRefresh": true,
      "clientAuth": "body"
    }
  },
  "network": { "allowedHosts": ["api.helpscout.net", "secure.helpscout.net"] },
  "models": ["inbox", "user", "tag", "conversation", "thread"],
  "http": {
    "baseUrl": "https://api.helpscout.net/v2",
    "auth": { "field": "accessToken", "in": "header", "name": "Authorization", "value": "Bearer {{accessToken}}" },
    "errors": { "rateLimitStatuses": [429], "retryAfterHeader": "Retry-After", "retryAfterKind": "seconds", "defaultRetryAfterSeconds": 5, "messagePaths": ["message", "error"] }
  },
  "operations": {
    "healthcheck": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 5000, "maxInputBytes": 4096, "maxResponseBytes": 65536,
      "title": "Healthcheck", "description": "Validate the OAuth access token with GET /users and return the first page metadata.",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["status", "users"], "properties": { "status": { "type": "string" }, "users": { "type": "array", "items": { "type": "object" } }, "page": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/users", "query": { "page": 1, "pageSize": 50 }, "success": [200], "result": { "status": "ok", "users": "{{response._embedded.users}}", "page": "{{response.page}}" } }
    },
    "inboxes.list": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 15000, "maxInputBytes": 4096, "maxResponseBytes": 1048576, "title": "List Inboxes", "description": "List accessible Help Scout mailboxes with explicit 1-based pagination.",
      "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["inboxes"], "properties": { "inboxes": { "type": "array", "items": { "type": "object" } }, "page": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/mailboxes", "query": { "page": "{{page}}", "pageSize": 50 }, "success": [200], "result": { "inboxes": "{{response._embedded.mailboxes}}", "page": "{{response.page}}" } }
    },
    "users.list": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 15000, "maxInputBytes": 4096, "maxResponseBytes": 1048576, "title": "List Users", "description": "List Help Scout users with explicit 1-based pagination.",
      "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["users"], "properties": { "users": { "type": "array", "items": { "type": "object" } }, "page": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/users", "query": { "page": "{{page}}", "pageSize": 50 }, "success": [200], "result": { "users": "{{response._embedded.users}}", "page": "{{response.page}}" } }
    },
    "tags.list": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 15000, "maxInputBytes": 4096, "maxResponseBytes": 1048576, "title": "List Tags", "description": "List Help Scout tags with explicit 1-based pagination.",
      "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["tags"], "properties": { "tags": { "type": "array", "items": { "type": "object" } }, "page": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/tags", "query": { "page": "{{page}}", "pageSize": 50 }, "success": [200], "result": { "tags": "{{response._embedded.tags}}", "page": "{{response.page}}" } }
    },
    "conversations.list": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 30000, "maxInputBytes": 65536, "maxResponseBytes": 5242880, "title": "List Conversations", "description": "List Help Scout conversations. Conversations use the documented 25 item page size.",
      "inputSchema": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1 }, "status": { "type": "string" }, "mailbox": { "type": "integer", "minimum": 1 }, "sortField": { "type": "string" }, "sortOrder": { "type": "string", "enum": ["asc", "desc"] } }, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["conversations"], "properties": { "conversations": { "type": "array", "items": { "type": "object" } }, "page": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/conversations", "query": { "page": "{{page}}", "pageSize": 25, "status": "{{status}}", "mailbox": "{{mailbox}}", "sortField": "{{sortField}}", "sortOrder": "{{sortOrder}}" }, "success": [200], "result": { "conversations": "{{response._embedded.conversations}}", "page": "{{response.page}}" } }
    },
    "conversations.get": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 15000, "maxInputBytes": 4096, "maxResponseBytes": 5242880, "title": "Get Conversation", "description": "Get one Help Scout conversation by numeric ID.",
      "inputSchema": { "type": "object", "properties": { "conversationId": { "type": "integer", "minimum": 1 } }, "required": ["conversationId"], "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["conversation"], "properties": { "conversation": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/conversations/{{conversationId}}", "success": [200], "result": { "conversation": "{{response}}" } }
    },
    "threads.list": {
      "kind": "action", "sideEffect": "read", "timeoutMs": 30000, "maxInputBytes": 4096, "maxResponseBytes": 5242880, "title": "List Threads", "description": "List threads for a Help Scout conversation with explicit pagination.",
      "inputSchema": { "type": "object", "properties": { "conversationId": { "type": "integer", "minimum": 1 }, "page": { "type": "integer", "minimum": 1 } }, "required": ["conversationId"], "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["threads"], "properties": { "threads": { "type": "array", "items": { "type": "object" } }, "page": { "type": "object" } } }, "enforceOutputSchema": true,
      "request": { "method": "GET", "path": "/conversations/{{conversationId}}/threads", "query": { "page": "{{page}}", "pageSize": 50 }, "success": [200], "result": { "threads": "{{response._embedded.threads}}", "page": "{{response.page}}" } }
    }
  },
  "provenance": {
    "source": {
      "url": "https://github.com/oomol-lab/open-connector",
      "revision": "33dd4ad6ee22f9ce5158a1516a11d8b8566b5c8a"
    }
  },
  "evidence": {
    "fixture": { "status": "supplied" },
    "live": { "status": "unverified" }
  }
}
