{
  "key": "kit",
  "name": "Kit",
  "version": "0.2.0",
  "runtime": "bun",
  "visibility": "public",
  "categories": [
    "email-marketing",
    "productivity"
  ],
  "auth": {
    "type": "api_key",
    "scopes": [],
    "setup": {
      "mode": "api_key",
      "fields": [
        {
          "key": "apiKey",
          "label": "Kit API key",
          "required": true,
          "secret": true
        }
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.kit.com"
    ]
  },
  "models": [
    "account",
    "user",
    "subscriber",
    "form",
    "tag",
    "sequence",
    "broadcast",
    "purchase",
    "custom_field"
  ],
  "http": {
    "baseUrl": "https://api.kit.com/v4",
    "auth": {
      "field": "apiKey",
      "in": "header",
      "name": "X-Kit-Api-Key",
      "value": "{{apiKey}}"
    },
    "errors": {
      "rateLimitStatuses": [
        429
      ],
      "retryAfterHeader": "Retry-After",
      "defaultRetryAfterSeconds": 30,
      "messagePaths": [
        "message",
        "error"
      ]
    }
  },
  "operations": {
    "healthcheck": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 5000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 65536,
      "title": "Healthcheck",
      "description": "Validate the Kit API key with the current account endpoint.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "object"
          },
          "user": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/account",
        "success": [
          200
        ],
        "result": {
          "account": "{{response.account}}",
          "user": "{{response.user}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "subscribers.list": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 15000,
      "maxInputBytes": 65536,
      "maxResponseBytes": 5242880,
      "title": "List Subscribers",
      "description": "List Kit subscribers with bounded cursor pagination and filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "after": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "bounced",
              "complained",
              "cancelled",
              "all"
            ]
          },
          "email_address": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "subscribers",
          "pagination"
        ],
        "properties": {
          "subscribers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pagination": {
            "type": "object"
          }
        }
      },
      "request": {
        "method": "GET",
        "path": "/subscribers",
        "query": {
          "after": "{{after}}",
          "before": "{{before}}",
          "per_page": "{{per_page}}",
          "status": "{{status}}",
          "email_address": "{{email_address}}",
          "include": "{{include}}"
        },
        "success": [
          200
        ],
        "result": {
          "subscribers": "{{response.subscribers}}",
          "pagination": "{{response.pagination}}"
        }
      },
      "enforceOutputSchema": true,
      "validationMode": "strict-generated",
      "responseFormat": "json"
    },
    "subscribers.get": {
      "kind": "action",
      "sideEffect": "read",
      "timeoutMs": 10000,
      "maxInputBytes": 4096,
      "maxResponseBytes": 1048576,
