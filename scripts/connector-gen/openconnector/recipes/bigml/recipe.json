      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to documented GET /model?limit=1 used by the pinned credential validator. This lists existing models and is not a billed prediction create. Native sends username via shared query and api_key via query auth. Native omits the upstream User-Agent. Native category is dev-tools rather than AI/Data. Private BigML deployments are not admitted."
      ]
    },
    "models.list": {
      "upstreamActionId": "list_models",
      "sourceRefs": [
        "action-list-models",
