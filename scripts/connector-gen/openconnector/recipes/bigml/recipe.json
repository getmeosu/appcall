        "request-auth"
      ],
      "documentationUrls": [
        "https://bigml.com/api/requests"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Official GET /model with optional limit, offset, order_by, project, and name__icontains. Input names follow pinned runtime (orderBy, nameContains)."
      ]
    },
    "models.get": {
      "upstreamActionId": "get_model",
      "sourceRefs": [
        "action-get-model",
        "handler-get-model",
        "request-auth"
