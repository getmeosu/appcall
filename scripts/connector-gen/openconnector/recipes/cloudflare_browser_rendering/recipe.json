      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "GET /accounts with optional page and per_page. Native omits the pinned default page=1 per_page=50 when the caller does not send them. OAuth memberships path is omitted.",
        "Returns raw Cloudflare JSON under data rather than the pinned {accounts, resultInfo} wrapper."
      ]
