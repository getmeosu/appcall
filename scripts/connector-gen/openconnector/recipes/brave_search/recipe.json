        "affectedProduct": "Brave Desktop/Android Rewards internals logs",
        "affectedData": "Uphold OAuth token in locally exported brave://rewards-internals logs; some logs were sent privately to Brave Support.",
        "status": "confirmed historical Rewards-client incident; remediations applied; not Brave Search API",
        "source": "https://community.brave.app/t/brave-rewards-internals-july-august-2020-security-incident/162459",
        "remediation": "Desktop 1.11.101 and Android 1.11.105 stopped logging the token; Uphold invalidated existing OAuth tokens on 2020-07-27; support copies deleted.",
        "residualRisk": "Historical client-log exposure; Search API credentials were not reported as involved."
      }
