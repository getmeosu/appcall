  "operationSources": {
    "healthcheck": {
      "upstreamActionId": "list_devices",
      "sourceRefs": [
        "provider-auth",
        "action-list-devices",
        "handler-list-devices",
        "credential-validate",
        "fetch-devices",
        "request-json",
        "proxy-auth"
      ],
      "documentationUrls": [
        "https://raw.githubusercontent.com/ambient-weather/api-docs/master/apiary.apib",
        "https://ambientweather.net/account"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to official GET /v1/devices, matching the pinned validator. This lists the caller's own stations and is not a billed weather lookup.",
        "Both apiKey and applicationKey are sent as query parameters. The upstream user-agent is not sent.",
        "Native category is utility rather than Location/Data: Rust CATEGORIES has neither of those buckets."
      ]
    },
    "devices.list": {
      "upstreamActionId": "list_devices",
      "sourceRefs": [
        "action-list-devices",
        "handler-list-devices",
        "fetch-devices",
        "request-json"
      ],
      "documentationUrls": [
        "https://raw.githubusercontent.com/ambient-weather/api-docs/master/apiary.apib"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Returns the raw Ambient Weather device array under data rather than the pinned {devices} wrapper."
      ]
    },
    "devices.latest": {
      "upstreamActionId": "get_latest_device_data",
      "sourceRefs": [
        "action-get-latest",
        "handler-get-latest",
        "fetch-records",
        "request-json"
      ],
      "documentationUrls": [
        "https://raw.githubusercontent.com/ambient-weather/api-docs/master/apiary.apib"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Requires macAddress. Native issues a single GET /v1/devices/{macAddress}?limit=1 instead of the pinned list-then-resolve fanout.",
        "Returns the raw observation array under data."
      ]
    },
    "devices.history": {
      "upstreamActionId": "get_device_history",
      "sourceRefs": [
        "action-get-history",
        "handler-get-history",
        "fetch-records",
        "request-json"
      ],
      "documentationUrls": [
        "https://raw.githubusercontent.com/ambient-weather/api-docs/master/apiary.apib"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Requires macAddress. Optional limit (1-288) and endDate bind to official query names. Native does not auto-resolve a default device.",
        "endDate is an ISO 8601 or epoch-ms string; the pinned exclusive integer/ISO union is collapsed to string because native strict schemas do not admit anyOf."
      ]
    }
