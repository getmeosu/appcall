          ],
          "result": {
            "data": "{{response.result}}"
          }
        },
        "enforceOutputSchema": true,
        "responseFormat": "json"
      },
      "metrics.occurrences": {
        "kind": "action",
        "sideEffect": "read",
        "timeoutMs": 15000,
        "maxInputBytes": 16384,
        "maxResponseBytes": 5242880,
        "title": "Get occurrence metrics",
        "description": "Get occurrence counts over a span of time with grouping, filtering, and aggregation. Maps to ROLLBAR_GET_OCCURRENCES_METRICS. POST /metrics/occurrences is a read query.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_time": {
              "type": "integer",
              "minimum": 0,
              "description": "Unix timestamp of start time for the query."
            },
            "end_time": {
              "type": "integer",
              "minimum": 0,
              "description": "Unix timestamp of end time for the query, inclusive."
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Column name to filter."
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Match values."
                  },
                  "operator": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Filter operator such as eq or gt."
                  }
                }
              },
              "description": "Filter conditions that narrow results by field values."
            },
            "group_by": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Column names to group the results."
            },
            "aggregates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Column to aggregate on."
                  },
                  "function": {
                    "type": "string",
                    "enum": [
                      "count_all",
                      "count_distinct",
                      "max",
                      "min"
                    ],
                    "description": "Aggregate function."
                  },
                  "alias": {
                    "type": "string",
