          }
        },
        "outputSchema": {
          "type": "object"
        },
        "request": {
          "method": "GET",
          "path": "/item/{{itemId}}",
          "success": [
            200
          ],
          "result": "{{response.result}}"
        },
        "enforceOutputSchema": true
      },
      "teams.check_project": {
        "kind": "action",
        "sideEffect": "read",
        "timeoutMs": 10000,
        "maxInputBytes": 4096,
        "maxResponseBytes": 1048576,
        "title": "Check team project assignment",
        "description": "Check whether a Rollbar team is assigned to a project. Maps to ROLLBAR_CHECK_TEAM_PROJECT_ASSIGNMENT. Returns 404 when the project is not on the team.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "team_id": {
              "type": "integer",
              "minimum": 1,
              "description": "The unique identifier of the team to check."
            },
            "project_id": {
              "type": "integer",
              "minimum": 1,
              "description": "The unique identifier of the project to check."
            }
          },
          "required": [
            "team_id",
            "project_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "type": [
                "object",
                "array"
              ]
            }
          }
        },
        "request": {
          "method": "GET",
          "path": "/team/{{team_id}}/project/{{project_id}}",
          "success": [
            200
          ],
          "result": {
            "data": "{{response.result}}"
          }
        },
        "enforceOutputSchema": true,
        "responseFormat": "json"
      },
      "teams.check_user": {
        "kind": "action",
        "sideEffect": "read",
        "timeoutMs": 10000,
        "maxInputBytes": 4096,
        "maxResponseBytes": 1048576,
        "title": "Check user team assignment",
        "description": "Check whether a user is assigned to a Rollbar team. Maps to ROLLBAR_CHECK_USER_TEAM_ASSIGNMENT.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "team_id": {
              "type": "integer",
              "minimum": 1,
              "description": "The unique identifier of the team to check."
            },
            "user_id": {
              "type": "integer",
              "minimum": 1,
              "description": "The unique identifier of the user to check."
            }
          },
          "required": [
            "team_id",
            "user_id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "data": {
              "type": [
                "object",
                "array"
              ]
            }
          }
        },
        "request": {
          "method": "GET",
          "path": "/team/{{team_id}}/user/{{user_id}}",
          "success": [
