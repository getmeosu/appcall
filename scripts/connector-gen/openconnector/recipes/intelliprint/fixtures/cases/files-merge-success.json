{
  "schemaVersion": 1,
  "id": "files-merge-success",
  "operation": "files.merge",
  "input": {
    "files": [
      {
        "url": "https://example.com/a.pdf"
      },
      {
        "url": "https://example.com/b.pdf"
      }
    ]
  },
  "credentials": {
    "apiKey": "fixturekey"
  },
  "evidence": {
    "sourceRefs": [
      "request-auth",
      "api-base"
    ],
    "documentationUrls": [
      "https://docs.composio.dev/toolkits/intelliprint"
    ],
    "basis": "Merge files is POST /tools/merge (exists; sibling merge paths 404). Files are merged in request order."
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intelliprint.net/v1/tools/merge",
        "headers": {
          "accept": "application/json",
          "authorization": "Bearer fixturekey",
          "content-type": "application/json"
        },
        "body": "{\"files\":[{\"url\":\"https://example.com/a.pdf\"},{\"url\":\"https://example.com/b.pdf\"}]}"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "bodyFile": "../responses/files-merge-success.json"
      }
    }
  ],
  "expected": {
    "kind": "success",
    "resultFile": "../expected/files-merge-success.json"
  }
}
