            "messageType",
            "type",
            "adminId",
            "body"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Intercom conversation id, or the literal \"last\"."
            },
            "messageType": {
              "type": "string",
              "enum": [
                "comment",
                "note"
              ],
              "description": "comment posts to the customer; note is internal."
            },
            "type": {
              "type": "string",
              "enum": [
                "admin"
              ],
              "description": "Reply author type (P0: admin)."
            },
            "adminId": {
              "type": "string",
              "minLength": 1,
              "description": "Admin id authoring the reply."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "description": "Reply or note body."
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "request": {
