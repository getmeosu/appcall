      "documentationUrls": [
        "https://developers.drata.com/openapi/reference/v2/tag/Vendors/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Returns raw Drata JSON under data. Vendor category/risk/status filters and expand[] are omitted to keep the native query on shared cursor pagination fields."
      ]
    }
