  "operationSources": {
    "healthcheck": {
      "upstreamActionId": "list_users",
      "sourceRefs": [
        "handler-list-users",
        "request-auth",
        "api-base"
      ],
      "documentationUrls": [
        "https://dev.avoma.com/",
        "https://help.avoma.com/api-integration-for-avoma"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to GET /v1/users/, a cheap authenticated account read. The pinned validator uses GET /v1/meetings/ with dummy 1970 dates; native healthcheck prefers list users over a date-bounded meeting search.",
        "Native category is scheduling rather than communication: Avoma is meeting intelligence, but Rust CATEGORIES has no communication bucket; admitted ops are meeting and user reads, so scheduling is the closer existing bucket."
      ]
    },
    "users.list": {
      "upstreamActionId": "list_users",
      "sourceRefs": [
        "action-list-users",
        "handler-list-users",
        "request-auth"
      ],
      "documentationUrls": [
        "https://dev.avoma.com/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Returns the raw Avoma JSON array under data. Upstream wraps the array as {users}."
      ]
    },
    "users.get": {
      "upstreamActionId": "get_user",
      "sourceRefs": [
        "action-get-user",
        "handler-get-user",
        "request-auth"
      ],
      "documentationUrls": [
        "https://dev.avoma.com/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "userUuid is URL-encoded as a path segment. UUID format is not locally enforced beyond a non-empty string. Returns raw Avoma JSON under data."
      ]
    },
    "meetings.list": {
      "upstreamActionId": "list_meetings",
      "sourceRefs": [
        "action-list-meetings",
        "handler-list-meetings",
        "request-auth"
      ],
      "documentationUrls": [
        "https://dev.avoma.com/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "fromDate and toDate are sent as from_date and to_date; pageSize as page_size; order as o. CSV attendee and CRM array filters are omitted because the native query template cannot comma-join arrays the way the pinned source does. Returns raw paginated JSON under data."
      ]
    },
    "meetings.get": {
      "upstreamActionId": "get_meeting",
      "sourceRefs": [
        "action-get-meeting",
        "handler-get-meeting",
        "request-auth"
      ],
      "documentationUrls": [
        "https://dev.avoma.com/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "meetingUuid is URL-encoded as a path segment. includeCrmAssociations is sent as include_crm_associations. Returns raw Avoma JSON under data instead of {meeting}."
      ]
    }
