      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "fromDate and toDate are sent as from_date and to_date; pageSize as page_size; order as o. CSV attendee and CRM array filters are omitted because the native query template cannot comma-join arrays the way the pinned source does. Returns raw paginated JSON under data."
      ]
    },
    "meetings.get": {
      "upstreamActionId": "get_meeting",
      "sourceRefs": [
        "action-get-meeting",
