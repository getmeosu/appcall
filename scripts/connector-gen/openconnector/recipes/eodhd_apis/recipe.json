      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "ticker is a required path segment on documented GET /eod/{ticker}. Native always sends fmt=json because the documented default is CSV. Optional from/to/period use official query names (dateFrom/dateTo map to from/to).",
        "filter is omitted because a last-value filter returns a scalar instead of a JSON array.",
        "Returns raw EODHD JSON under data rather than the upstream {rows,value,raw} wrapper."
      ]
