        "field": "apiKey",
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {{apiKey}}"
      },
      "headers": {
        "Accept": "application/json"
      },
      "errors": {
        "rateLimitStatuses": [
          429
        ],
        "retryAfterHeader": "retry-after",
