      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Official functional list sample misspells /mulit-tests; native uses the documented explorer path /multi-tests.",
        "Official functional docs require platform=functional; native sends that static query in addition to pinned workspaceId/projectId/skip/limit. sort array query is omitted."
      ]
    },
