      ],
      "documentationUrls": [
        "https://developers.abyssale.com/api-reference/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Returns the raw Abyssale JSON array under data; the upstream connector's normalized project objects are not reconstructed."
      ]
    },
    "designs.list": {
      "upstreamActionId": "list_designs",
      "sourceRefs": [
