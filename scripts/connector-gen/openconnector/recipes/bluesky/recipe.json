    "evidence": [
      "https://docs.bsky.app/docs/api/com-atproto-server-create-session",
      "https://docs.bsky.app/docs/get-started",
      "https://atproto.com/guides/sdk-auth",
      "https://docs.bsky.app/docs/api/app-bsky-actor-get-profile",
