    "searchCoverage": "Official Checkly API authentication, account, checks and security materials reviewed on 2026-09-13. The provider's August 10, updated August 13, 2026 notice documents a contained third-party Metabase incident; this bounded snapshot is not a breach-free claim.",
    "incidents": [
      {
        "incidentDate": "2026-08-03",
        "disclosureDate": "2026-08-10",
        "affectedProduct": "Checkly operational-data warehouse copy connected to internal Metabase",
        "affectedData": "Potentially plaintext custom check headers, cookies, query parameters, authorization values, plain environment variables, cryptographic hashes of OTEL API keys, encrypted integration tokens, and subset of scripts; Checkly states Checkly Secrets remained encrypted at rest and production was not accessed.",
        "status": "confirmed historical third-party analytics incident; contained per provider notice",
        "source": "https://www.checklyhq.com/blog/metabase-security-incident/",
        "remediation": "Metabase blocked exploited endpoints and patched the zero-day; Checkly rotated warehouse and Metabase credentials, reset Metabase users, removed the compromised administrator, audited logs, engaged third-party forensics, and contacted affected customers.",
        "residualRisk": "Customers should rotate credentials hard-coded in check configurations and OTEL API keys, review protected systems for unauthorized use since 2026-08-03, and reauthorize affected integrations. This snapshot records provider-reported remediation and residual customer action; it is not ongoing security certification."
      }
    ],
    "remainingGates": [
      "live authentication unverified"
    ],
    "waiverAuthority": "User waiver dated 2026-09-13 permits historical non-China incident coverage."
  },
