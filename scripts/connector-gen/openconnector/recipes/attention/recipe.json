    "users.list": {
      "upstreamActionId": "list_users",
      "sourceRefs": [
        "action-list-users",
        "handler-list-users",
        "request-auth"
      ],
      "documentationUrls": [
        "https://docs.attention.com/api-reference/user/list-users"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Optional teamUUID and includeDeleted are sent as query parameters. Array filter[id]/filter[email] are omitted because the native query template cannot comma-join arrays the way the pinned source does. Returns raw Attention JSON under data instead of {users,links}."
      ]
    },
    "conversations.list": {
      "upstreamActionId": "list_conversations",
      "sourceRefs": [
        "action-list-conversations",
        "handler-list-conversations",
        "request-auth"
      ],
      "documentationUrls": [
        "https://docs.attention.com/api-reference/conversation/list-conversations-optimized"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Uses official optimized GET /conversations/list (pinned path). Scalar page/size/title/hideInternal/detailedTranscript are sent; array owner/participant/CRM filters are omitted because the native query template cannot comma-join arrays. hideInternal is sent as filter[hide_internal]; title as filter[title]. Returns raw Attention JSON under data."
      ]
    },
    "conversations.get": {
      "upstreamActionId": "get_conversation",
      "sourceRefs": [
        "action-get-conversation",
        "handler-get-conversation",
        "request-auth"
      ],
      "documentationUrls": [
        "https://docs.attention.com/api-reference/conversation/get-conversation"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "id is URI-encoded. Optional by and detailedTranscript are sent as query parameters. Boolean include* array-style filters are omitted. Returns raw Attention JSON under data instead of {conversation}."
      ]
    },
