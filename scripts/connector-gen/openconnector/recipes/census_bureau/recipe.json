      ],
      "documentationUrls": [
        "https://www.census.gov/data/developers/guidance/api-user-guide.html",
        "https://www.census.gov/data/developers/data-sets/acs-5year.html"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to the pinned validator GET /data/2022/acs/acs5?get=NAME&for=us:* rather than a caller-supplied datasetPath. Census Data API keys are free; this is a tiny authenticated geography read, not a commercial billed SKU.",
        "datasetPath is pinned because native path templates encodeURIComponent the entire placeholder and cannot keep Census multi-segment paths (2022/acs/acs5) as unencoded slashes the way the source encodes each segment.",
        "Native category is utility: source Data is not in the Rust CATEGORIES allowlist.",
        "Returns raw Census JSON (a header row plus data rows) under data. The upstream user-agent is not sent."
      ]
    },
    "datasets.list": {
      "upstreamActionId": "list_datasets",
      "sourceRefs": [
        "action-list-datasets",
        "handler-list-datasets",
        "request-auth"
      ],
      "documentationUrls": [
        "https://www.census.gov/data/developers/guidance/api-user-guide.html",
        "https://api.census.gov/data.json"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Maps to official GET /data.json. Pinned source applies client-side search, vintage, limit, and offset after download; those filters are omitted because they are not request query parameters.",
        "Returns raw Census discovery JSON under data."
      ]
    },
    "groups.list": {
      "upstreamActionId": "list_groups",
      "sourceRefs": [
        "action-list-groups",
        "handler-list-groups",
        "request-auth"
      ],
      "documentationUrls": [
        "https://www.census.gov/data/developers/data-sets/acs-5year.html",
        "https://www.census.gov/data/developers/guidance/api-user-guide.html"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "datasetPath is pinned to 2022/acs/acs5, the vintage used by the pinned credential validator. Caller-supplied multi-segment datasetPath cannot be expressed in native path templates.",
        "Returns raw Census groups.json under data."
      ]
    },
    "dataset.query": {
      "upstreamActionId": "query_dataset",
      "sourceRefs": [
        "action-query-dataset",
        "handler-query-dataset",
        "request-auth"
      ],
      "documentationUrls": [
        "https://www.census.gov/data/developers/guidance/api-user-guide.html",
        "https://www.census.gov/data/developers/data-sets/acs-5year.html"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Queries the pinned ACS 2022 5-year dataset. Caller supplies the official get and for query names as strings rather than the upstream variables array join. Optional in binds to the documented in predicate. Dynamic extra predicates are omitted because native query templates use fixed keys.",
        "Returns raw Census JSON under data rather than the upstream {columns, rows, rawRows} wrapper."
      ]
    }
