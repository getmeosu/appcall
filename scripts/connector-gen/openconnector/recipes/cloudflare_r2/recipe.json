      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "accountId and bucketName are URL-encoded path segments on GET /accounts/{accountId}/r2/buckets/{bucketName}/cors.",
        "Optional jurisdiction header omitted. Returns raw Cloudflare JSON under data rather than {rules}. generate_presigned_url (AWS SigV4) and object download/upload writes are omitted."
