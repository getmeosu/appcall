      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck uses GET /v1/call_tags/, a cheap authenticated org-tag read. Official OpenAPI ping at GET /v1/test/ping is the pinned validator path but is not a defineProviderAction; native templates cannot express a non-action ping while still mapping an upstreamActionId.",
        "Native category is productivity (source AI/Productivity; Rust CATEGORIES has no AI bucket)."
      ]
    },
    "call_tags.list": {
      "upstreamActionId": "list_call_tags",
      "sourceRefs": [
        "action-list-call-tags",
        "handler-list-call-tags",
        "request-auth"
      ],
      "documentationUrls": [
        "https://api.glyphic.ai/openapi.json"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Maps to GET /v1/call_tags/ including the trailing slash from official OpenAPI and pinned source. Returns the raw tag array under data."
      ]
    },
    "calls.list": {
      "upstreamActionId": "list_calls",
      "sourceRefs": [
        "action-list-calls",
        "handler-list-calls",
        "request-auth"
      ],
      "documentationUrls": [
        "https://api.glyphic.ai/openapi.json"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Optional limit/cursor/direction/participantEmail bind to documented query names. tag_ids array and start_time_* filters are omitted from this bounded subset.",
        "Returns raw paginated JSON under data instead of the upstream {calls, nextCursor, pagination} wrapper."
      ]
    },
    "calls.get": {
      "upstreamActionId": "get_call",
      "sourceRefs": [
        "action-get-call",
        "handler-get-call",
        "request-auth"
      ],
      "documentationUrls": [
        "https://api.glyphic.ai/openapi.json"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "callId is a URL-encoded path segment on GET /v1/calls/{call_id}. Official OpenAPI constrains it to 24 hex characters; native strict schemas cannot express maxLength or pattern, so only minLength 1 is enforced. Returns raw call JSON under data. Media/snippets (presigned URLs) are omitted."
      ]
    },
    "playbooks.list": {
