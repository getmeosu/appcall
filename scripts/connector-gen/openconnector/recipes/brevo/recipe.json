    "searchCoverage": "Official Brevo v3 REST at https://api.brevo.com with api-key header. Cheap authenticated read GET /v3/account exists. On 2026-09-10 Brevo disclosed a SAML SSO flaw that accessed 138 accounts, sent phishing from 6, and exported contacts from 43. Vendor says the route closed at 08:30 UTC the same day. As of 2026-09-13 customer notices were still being published. HOLD rather than treat a three-day-old confirmed account compromise as a historical waived incident.",
    "incidents": [
      {
        "incidentDate": "2026-09-09",
        "disclosureDate": "2026-09-10",
        "affectedProduct": "Brevo SAML SSO / customer accounts",
        "affectedData": "138 customer accounts accessed; 6 used to send phishing; 43 had contact lists exported (Trezor reported ~347,000 newsletter addresses).",
        "status": "confirmed current vendor-disclosed compromise; attacker access claimed closed 2026-09-10 08:30 UTC; residual exported-contact and phishing risk not independently closed as of 2026-09-13",
        "source": "https://status.brevo.com/incidents/01M266V1CZKJQNGZRNEGFD5CQE",
        "remediation": "Vendor closed the SSO entry point and reset all active sessions. Affected customers are being notified.",
        "residualRisk": "Exported contact lists and phishing sent from customer accounts remain current residual risk three days after disclosure."
      }
    ],
    "remainingGates": [
      "current confirmed SAML SSO account compromise disclosed 2026-09-10 (138 accounts; contact export and phishing); vendor claims containment but residual exported-contact risk is not independently closed as of 2026-09-13",
      "live authentication unverified"
    ],
    "waiverAuthority": "User waiver dated 2026-09-13 permits historical non-China incident coverage. This incident is current as of the as-of date and is not treated as historical."
