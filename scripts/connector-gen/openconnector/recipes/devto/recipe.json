            "key": "apiKey",
            "label": "API key",
            "required": true,
            "secret": true
          }
        ]
      }
    },
    "network": {
      "allowedHosts": [
        "dev.to"
      ]
    },
    "models": [
      "article",
      "user",
      "comment",
      "tag",
      "organization",
      "webhook",
      "video",
      "podcast"
    ],
    "http": {
      "baseUrl": "https://dev.to/api",
      "auth": {
        "field": "apiKey",
        "in": "header",
        "name": "api-key",
        "value": "{{apiKey}}"
      },
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/vnd.forem.api-v1+json"
      },
      "errors": {
        "rateLimitStatuses": [
          429
        ],
