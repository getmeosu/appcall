  "operationSources": {
    "healthcheck": {
      "upstreamActionId": "list_trending_hashtags",
      "sourceRefs": [
        "action-list-trending-hashtags",
        "handler-list-trending-hashtags",
        "credential-validate",
        "request-auth",
        "api-base"
      ],
      "documentationUrls": [
        "https://ritekit.com/api-demo/trending-hashtags",
        "https://help.ritekit.com/en/article/general-ritekit-api-faq-legality-changing-tiers-using-multiple-endpoints-etc-1lvapvk/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to GET /v1/search/trending?green=1&latin=1 matching the pinned validator.",
        "client_id is sent as the documented query parameter. Official OAuth 2.0 is unused here because native oauth is not already supported for this provider shape and the vendor documents client_id as the common path.",
        "Native bodyErrorPaths cannot invert result:false; error and error_description are demoted when present. HTTP status remains the unauthorized signal.",
        "Native category is social rather than Social/Marketing: Rust CATEGORIES has no marketing bucket.",
        "Returns raw RiteKit JSON under data rather than the upstream {hashtags} wrapper. The upstream user-agent is not sent."
      ]
    },
    "hashtags.trending.list": {
      "upstreamActionId": "list_trending_hashtags",
      "sourceRefs": [
        "action-list-trending-hashtags",
        "handler-list-trending-hashtags",
        "request-auth"
      ],
      "documentationUrls": [
        "https://ritekit.com/api-demo/trending-hashtags"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Maps to official GET /v1/search/trending. Optional green and latin are integers 0|1 so the native query emits the documented 1/0 encoding rather than JSON true/false.",
        "Returns raw RiteKit JSON under data rather than the upstream {hashtags} wrapper."
      ]
    },
    "hashtags.stats.get": {
      "upstreamActionId": "get_hashtag_stats",
      "sourceRefs": [
        "action-get-hashtag-stats",
        "handler-get-hashtag-stats",
        "request-auth"
      ],
      "documentationUrls": [
        "https://documenter.getpostman.com/view/2010712/SzS7Qku5"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Maps to official GET /v1/stats/multiple-hashtags. tags is a comma-separated string rather than the upstream array join because native query templates cannot join arrays.",
        "Returns raw RiteKit JSON under data rather than the upstream {stats} wrapper."
      ]
    },
    "hashtags.suggest.text": {
      "upstreamActionId": "suggest_hashtags_for_text",
      "sourceRefs": [
        "action-suggest-hashtags-for-text",
        "handler-suggest-hashtags-for-text",
        "request-auth"
      ],
      "documentationUrls": [
        "https://documenter.getpostman.com/view/2010712/SzS7Qku5"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Maps to official GET /v1/stats/hashtag-suggestions?text=. The documented 1000-character maxLength is omitted because native strict-generated schema does not support maxLength.",
        "Returns raw RiteKit JSON under data rather than the upstream {hashtags} wrapper."
      ]
    }
