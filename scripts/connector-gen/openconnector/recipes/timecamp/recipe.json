        "https://github.com/timecamp-org/timecamp-api-ts"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Preserves raw provider JSON under data. Official TS client maps date_from/date_to onto query from/to and always adds opt_fields=tags; this recipe uses the wire names from/to and does not add opt_fields. Official docs and client parse a JSON array."
      ]
    }
