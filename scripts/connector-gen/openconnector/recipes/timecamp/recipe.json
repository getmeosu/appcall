        "https://github.com/timecamp-org/timecamp-api-ts"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Preserves raw provider JSON under data. GET /users may return a JSON array (older official docs) or an object map (official TS client TimeCampUsersMapResponse); outputSchema.data allows both. Optional activeOnly is sent as query active_only."
      ]
    },
    "tasks.list": {
      "upstreamActionId": "list_tasks",
      "sourceRefs": [
        "action-list-tasks",
        "handler-list-tasks",
        "request-headers"
      ],
      "documentationUrls": [
        "https://github.com/karankohli13/timecamp-api/blob/master/sections/tasks.md",
        "https://github.com/timecamp-org/timecamp-api-ts"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Preserves raw provider JSON under data. Official TS client GET /tasks treats the body as an object map (Object.values); outputSchema.data is object. Optional status is the documented filter; the official client getAll() always sends status=all, this recipe does not default it."
      ]
    },
    "timeEntries.list": {
      "upstreamActionId": "list_time_entries",
      "sourceRefs": [
