  "operationSources": {
    "healthcheck": {
      "upstreamActionId": "list_users",
      "sourceRefs": [
        "runtime-validate",
        "runtime-request",
        "definition-auth",
        "executors-proxy-auth"
      ],
      "documentationUrls": [
        "https://docs.instabot.io/docs/serverapi"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to official GET https://api.instabot.io/v1 (native path /). Pinned credential validator uses the same path. Native joins baseUrl without a trailing slash plus path /, producing https://api.instabot.io/v1/.",
        "Master API access sends both X-Instabot-Api-Key and Authorization: X-Instabot-Master-Api-Key, matching official Server API docs and pinned extraFields.masterApiKey.",
        "Official JSON bodies include apiStatusCode Success on success. Native bodyErrorPaths is [apiStatusMessage] because apiStatusCode Success is a non-empty string and docs say apiStatusMessage is omitted on success.",
        "Native category is messaging (source Marketing/Communication are not in native CATEGORIES).",
        "Create/update/delete/restore user writes are omitted."
      ]
    },
    "users.list": {
      "upstreamActionId": "list_users",
      "sourceRefs": [
        "action-list-users",
        "runtime-list-users",
        "runtime-list-helper",
        "runtime-request"
      ],
      "documentationUrls": [
        "https://docs.instabot.io/docs/serverapi-objects"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Maps to documented GET /users. Native always sends type=all as official user-search docs require so both anonymous and known users are returned.",
        "Optional limit, skip, orderBy, and getTotalCount match documented query names. resolve is omitted; official resolve is a comma-separated list and writes are omitted.",
        "Returns raw Instabot JSON under data."
      ]
    },
    "users.get": {
      "upstreamActionId": "get_user",
      "sourceRefs": [
        "action-get-user",
