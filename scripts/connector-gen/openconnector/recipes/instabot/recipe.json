        "runtime-request"
      ],
      "documentationUrls": [
        "https://docs.instabot.io/docs/serverapi-objects"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "userId is a required positive integer path segment on documented GET /users/{id}. Native stringifies the integer. Returns raw Instabot JSON under data."
      ]
    },
    "users.updated.list": {
      "upstreamActionId": "list_updated_users",
