      ],
      "documentationUrls": [
        "https://bestbuyapis.github.io/api-documentation/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Lists the unfiltered products collection; computed in-path SKU/UPC/name/price/category clauses are omitted.",
        "Optional page, pageSize, show, and sort bind to documented query names.",
        "Returns raw Best Buy JSON under data."
      ]
    },
    "products.get": {
      "upstreamActionId": "get_product_details",
      "sourceRefs": [
        "action-get-product-details",
        "runtime-get-product-details",
        "runtime-collection-path"
      ],
      "documentationUrls": [
        "https://bestbuyapis.github.io/api-documentation/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Uses documented collection filter path /v1/products(sku={sku}) rather than /products/{sku}.json.",
        "sku is a required string path segment; integer SKUs must be supplied as decimal strings.",
        "Returns the raw Best Buy collection JSON under data rather than the first collection item extracted by the upstream executor.",
        "Optional show binds to the documented query name; pageSize=1 is sent statically as in the pinned executor."
      ]
    },
