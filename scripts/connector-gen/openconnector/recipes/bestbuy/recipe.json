      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to GET /v1/categories(id=abcat0010000) with show=id,name and pageSize=1, matching pinned credential validation rather than a billable product search.",
        "Always sends format=json so collection responses are JSON rather than the XML default.",
        "Returns raw Best Buy JSON under data.",
        "Native category is ecommerce rather than commerce: Best Buy is a product catalog API, but Rust CATEGORIES has no commerce bucket; admitted ops are category, product, and store reads."
      ]
    },
    "categories.list": {
      "upstreamActionId": "get_categories",
      "sourceRefs": [
        "action-get-categories",
        "runtime-get-categories",
        "runtime-list-query"
      ],
      "documentationUrls": [
        "https://bestbuyapis.github.io/api-documentation/"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Lists the unfiltered categories collection; computed path filters (id/name pipe clauses) are omitted because native templates cannot reconstruct Best Buy in-path boolean query syntax.",
        "Optional page, pageSize, show, and sort bind to documented query names.",
        "Returns raw Best Buy JSON under data."
      ]
    },
    "products.list": {
      "upstreamActionId": "get_products",
      "sourceRefs": [
