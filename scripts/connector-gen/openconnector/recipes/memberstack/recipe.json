      "documentationUrls": [
        "https://developers.memberstack.com/admin-rest-api/member-actions"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "idOrEmail is URL-encoded as a path segment. Optional include query is the documented string (teams) rather than the upstream includeTeams boolean that computed include=teams. Missing members remain HTTP 200 with data null per official docs. Returns raw Memberstack JSON under data."
      ]
    }
