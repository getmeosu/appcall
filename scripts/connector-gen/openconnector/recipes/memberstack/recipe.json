      "documentationUrls": [
        "https://developers.memberstack.com/admin-rest-api/member-actions"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "GET /members with optional after, order, limit, and includeJSON. The first alias is omitted because native templates would send both first and limit, while pinned source drops limit when first is set. includeJSON is a boolean that native query stringifies as true/false, matching the documented string flag. Returns raw Memberstack JSON under data."
      ]
    },
    "members.get": {
      "upstreamActionId": "get_member",
      "sourceRefs": [
