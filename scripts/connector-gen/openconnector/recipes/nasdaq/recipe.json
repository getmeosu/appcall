        "https://github.com/Nasdaq/data-link-python"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "vendorCode and tableCode are required path segments on GET /datatables/{vendor}/{table}/metadata.json."
      ]
    },
    "datatables.query": {
      "upstreamActionId": "get_table_row",
      "sourceRefs": [
        "action-get-table-row",
        "handler-datatable-query",
        "nasdaq-get"
      ],
      "documentationUrls": [
        "https://docs.data.nasdaq.com/docs/tables-1",
        "https://github.com/Nasdaq/data-link-python"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Queries GET /datatables/{vendor}/{table}.json with optional ticker, qopts.columns, qopts.per_page, and qopts.cursor_id. Dynamic filter-column names from get_table_row are omitted because native query templates use fixed keys. Bulk qopts.export is omitted."
      ]
    },
    "quotes.eod": {
      "upstreamActionId": "get_end_of_day_quote",
