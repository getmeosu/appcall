        "maxInputBytes": 65536,
        "maxResponseBytes": 2097152,
        "sideEffect": "read",
        "title": "Check connection",
        "description": "Authenticate with GET users/me; this fails for invalid application passwords.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Connection status."
            },
            "user": {
              "type": "object",
              "description": "Provider resource."
            }
          }
        },
        "request": {
          "method": "GET",
          "path": "/users/me",
          "success": [
            200
          ],
          "result": {
            "status": "ok",
            "user": "{{response}}"
          },
          "echo": {
            "status": "ok"
          }
        }
      },
      "post.list": {
        "kind": "action",
        "timeoutMs": 15000,
        "maxInputBytes": 65536,
        "maxResponseBytes": 2097152,
        "sideEffect": "read",
        "title": "List posts",
        "description": "Read one page of posts. Increment page until totalPages is reached; totals are header strings. An out-of-range page can return an upstream error.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "description": "One-based page number; default 1."
            },
            "perPage": {
              "type": "integer",
              "description": "Page size, 1\u2013100; default 10."
            },
            "search": {
              "type": "string",
              "description": "Search text."
            }
          },
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "posts": {
              "type": "array",
              "description": "Provider resources.",
              "items": {
                "type": "object"
              }
            },
            "total": {
              "type": "string",
              "description": "X-WP-Total header."
            },
            "totalPages": {
              "type": "string",
              "description": "X-WP-TotalPages header."
            }
          }
        },
        "request": {
