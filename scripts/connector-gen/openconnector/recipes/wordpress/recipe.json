  "manifest": {
    "key": "wordpress",
    "name": "WordPress",
    "version": "0.2.0",
    "runtime": "bun",
    "visibility": "public",
    "categories": [
      "social"
    ],
    "auth": {
      "type": "api_key",
      "scopes": [],
      "setup": {
        "mode": "api_key",
        "fields": [
          {
            "key": "host",
            "label": "Canonical instance hostname (no scheme, path or port)",
            "required": true,
            "secret": false
          },
          {
            "key": "username",
            "label": "WordPress username",
            "required": true,
            "secret": false
          },
          {
            "key": "applicationPassword",
            "label": "Application password",
            "required": true,
            "secret": true
          }
        ],
        "derive": [
          {
            "field": "basicAuth",
            "kind": "basic",
            "from": [
              "username",
              "applicationPassword"
            ]
          }
        ]
      }
    },
    "network": {
      "allowedHosts": [
        "{{host}}"
      ]
    },
    "http": {
      "baseUrl": "https://{{host}}/wp-json/wp/v2",
      "auth": {
        "field": "applicationPassword",
        "in": "header",
        "name": "Authorization",
        "value": "Basic {{basicAuth}}"
      },
      "headers": {
        "Content-Type": "application/json"
      },
      "errors": {
        "rateLimitStatuses": [
          429
        ],
        "retryAfterHeader": "retry-after",
        "retryAfterKind": "seconds",
        "defaultRetryAfterSeconds": 60,
        "messagePaths": [
          "message",
          "code"
        ]
      }
    },
    "operations": {
