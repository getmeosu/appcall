    "http": {
      "baseUrl": "https://www.digistore24.com/api/call",
      "auth": {
        "field": "apiKey",
        "in": "header",
        "name": "X-DS-API-KEY",
        "value": "{{apiKey}}"
      },
      "headers": {
        "Accept": "application/json"
      },
      "errors": {
