          "type": "object"
        },
        "request": {
          "method": "GET",
          "path": "/listBuyers",
          "query": {
            "page_no": "{{pageNo}}",
            "page_size": "{{pageSize}}"
          },
          "success": [
            200
          ]
        },
        "responseFormat": "json",
