      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Credential-only healthcheck maps to pinned validator GET /breeds?limit=1, a cheap authenticated breed list rather than image search.",
        "Native category is utility: The Dog API is a breed/image data API. Source Design & Media / Data are not in the Rust CATEGORIES allowlist.",
        "The upstream user-agent is not sent. Some public endpoints work without a key; this recipe still sends x-api-key."
      ]
    },
    "breeds.list": {
      "upstreamActionId": "list_breeds",
      "sourceRefs": [
        "action-list-breeds",
        "handler-list-breeds",
        "request-auth"
      ],
      "documentationUrls": [
        "https://docs.thedogapi.com/docs/examples/breeds"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Returns raw The Dog API JSON under data (array). Optional limit and page bind to limit and page; omitted values are dropped. Official breed_groups / exclude_breed_groups / lang filters are omitted because the pinned list_breeds handler only sends limit and page."
      ]
    },
    "breeds.get": {
      "upstreamActionId": "get_breed",
      "sourceRefs": [
        "action-get-breed",
        "handler-get-breed",
        "request-auth"
      ],
      "documentationUrls": [
        "https://docs.thedogapi.com/docs/examples/breeds"
      ],
      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "breedId is a required nonempty path segment. Official docs show numeric ids; the native template sends the string as-is and URL-encodes it. Premium lang query is omitted because the pinned get_breed handler does not send it."
      ]
    },
