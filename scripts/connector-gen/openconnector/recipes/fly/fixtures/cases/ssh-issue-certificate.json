{
  "schemaVersion": 1,
  "id": "ssh-issue-certificate",
  "operation": "ssh.issue_certificate",
  "input": {
    "organization_id": "org_fixture",
    "principals": [
      "fly"
    ],
    "valid_hours": 2
  },
  "credentials": {
    "apiKey": "fly_fixture"
  },
  "evidence": {
    "fixture": {
      "status": "supplied"
    },
    "live": {
      "status": "unverified"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.fly.io/graphql",
        "headers": {
          "authorization": "Bearer fly_fixture",
          "accept": "application/json",
          "content-type": "application/json"
        },
        "body": "{\"query\":\"mutation IssueCertificate($input: IssueCertificateInput!) { issueCertificate(input: $input) { certificate clientMutationId } }\",\"variables\":{\"input\":{\"principals\":[\"fly\"],\"validHours\":2,\"organizationId\":\"org_fixture\"}}}"
      },
      "response": {
        "status": 200,
        "bodyFile": "../responses/ssh-issue-certificate.json"
      }
    }
  ],
  "expected": {
    "kind": "success",
    "resultFile": "../expected/ssh-issue-certificate.json"
  }
}
