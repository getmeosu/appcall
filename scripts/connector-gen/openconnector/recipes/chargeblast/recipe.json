      "responseContract": "appcall-provider-json-v1",
      "adaptations": [
        "Uses documented legacy GET /api/v2/alerts with the v2 filter query, matching pinned source. Official new integrations prefer v3 GET /api/v3/alerts with filter[type] bracketed query parameters; this recipe does not guess v3 filter encoding.",
