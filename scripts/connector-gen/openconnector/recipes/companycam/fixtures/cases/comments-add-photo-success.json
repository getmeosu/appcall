{
  "schemaVersion": 1,
  "id": "comments-add-photo-success",
  "operation": "comments.add",
  "input": {
    "commentCollection": "photos",
    "resourceId": "photo-1",
    "content": "looks good",
    "userEmail": "shawn@psych.co"
  },
  "credentials": {
    "apiKey": "fixture-cc-token"
  },
  "evidence": {
    "documentationUrls": [
      "https://companycam.readme.io/reference/createphotocomment"
    ],
    "basis": "Add Photo Comment is POST /photos/{id}/comments. Optional X-CompanyCam-User names the commenter."
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.companycam.com/v2/photos/photo-1/comments",
        "headers": {
          "authorization": "Bearer fixture-cc-token",
          "accept": "application/json",
          "content-type": "application/json",
          "x-companycam-user": "shawn@psych.co"
        },
        "body": "{\"comment\":{\"content\":\"looks good\"}}"
      },
      "response": {
        "status": 201,
        "headers": {
          "content-type": "application/json"
        },
        "bodyFile": "../responses/comment.json"
      }
    }
  ],
  "expected": {
    "kind": "success",
    "resultFile": "../expected/comment.json"
  }
