    "decision": "HOLD",
    "providerId": "app_store_connect",
    "appcallId": "app-store-connect",
    "edition": "international App Store Connect API",
    "marketFocus": "international",
    "reviewedAt": "2026-09-13",
    "reviewer": "research review",
    "evidence": [
      "https://developer.apple.com/documentation/appstoreconnectapi",
      "https://developer.apple.com/documentation/appstoreconnectapi/creating-api-keys-for-app-store-connect-api",
      "https://developer.apple.com/documentation/appstoreconnectapi/generating-tokens-for-api-requests"
    ],
    "searchCoverage": "Official App Store Connect API requires an ES256 JWT signed from a PKCS#8 P-256 .p8 key with kid and optional issuer. Native api_key templates cannot sign. Dated incident search on 2026-09-13 found no qualifying unresolved App Store Connect API compromise.",
    "incidents": [
      {
        "date": "2026-09-13",
        "source": "https://developer.apple.com/documentation/appstoreconnectapi/generating-tokens-for-api-requests",
        "finding": "HOLD is technical: JWT/signing is required and the native template cannot express ES256 signing, iat/exp, kid, or issuer claims. Not a security HOLD.",
        "limitation": "A stored Bearer JWT would expire within 20 minutes and is not the official credential shape."
      }
    ],
    "remainingGates": [
      "credentials: App Store Connect authenticates with a per-request ES256 JWT signed from keyId + optional issuerId + PKCS#8 P-256 private key (aud appstoreconnect-v1, exp-iat <= 20 minutes). Pinned source uses jose SignJWT in jwt.ts. Native templates only place a static header/query secret and cannot sign.",
      "operationQuality: signing is an unsupported request semantic; do not fake a pre-signed JWT as an API key.",
      "live authentication unverified"
    ],
    "waiverAuthority": "User waiver dated 2026-09-13 permits historical non-China incident coverage."
  },
