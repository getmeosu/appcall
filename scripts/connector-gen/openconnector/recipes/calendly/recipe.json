    "searchCoverage": "Official Calendly API v2 at https://api.calendly.com authenticates with a personal access token or OAuth Bearer token. PAT is generated under Integrations > API & Webhooks and is not OAuth-only. Cheap authenticated read is GET /users/me. Dated 2026-09-13 incident search found phishing that impersonates or routes through Calendly email, not a documented compromise of api.calendly.com customer tokens. Not a breach-free claim.",
    "incidents": [
      {
        "incidentDate": "2025-12",
        "disclosureDate": "2025-12-03",
        "affectedProduct": "Lookalike Calendly invite pages (not api.calendly.com)",
        "affectedData": "Google Workspace / Facebook Business sessions targeted via fake recruitment Calendly pages",
        "status": "historical brand-abuse phishing; distinguished from Calendly API credential compromise",
        "source": "https://cybernews.com/security/calendly-invite-phishing-recruitment-scam-targets-google-facebook-business-account-users/",
        "remediation": "Third-party brand impersonation; not a Calendly platform disclosure.",
        "residualRisk": "Historical non-China incident retained under the 2026-09-13 waiver."
      },
      {
        "incidentDate": "2026-04",
        "disclosureDate": "2026-06-25",
        "affectedProduct": "Calendly notification email (em1618.calendly.com) abused as a delivery channel",
        "affectedData": "Hotel front-desk systems via malware in follow-on ZIP payloads; not Calendly API tokens",
        "status": "historical authentication-laundering abuse of Calendly send infrastructure; distinguished from API key compromise",
        "source": "https://www.techtimes.com/articles/319150/20260626/hotel-phishing-attack-uses-calendly-bypass-email-authentication-filters.htm",
        "remediation": "Microsoft Threat Intelligence disclosure; not a documented api.calendly.com credential leak.",
        "residualRisk": "Historical non-China incident retained under the 2026-09-13 waiver."
      }
    ],
    "remainingGates": [
      "live authentication unverified"
    ],
    "waiverAuthority": "User waiver dated 2026-09-13 permits historical non-China incident coverage."
