# Keep the build context deterministic. Local workspaces are excluded;
# Docker builds the locked Cargo workspace and embedded assets.
.git
.env
.env.*
!.env.example
!.env.production.example
target/
node_modules
bin/
dist/
build/
qa
*.test
*.out
coverage.out
coverage.html
*.log
logs/
.worktrees/
worktrees/
.playwright-mcp/
app-*.png
.superpowers/
.claude/
guardrails/
runner/sena-e2e/state/
.DS_Store
.idea/
.vscode/

# Private development context and Markdown are not container inputs.
.agents/
.codex/
.mcp.json
docs/
**/*.md
**/*.markdown
**/__pycache__/
