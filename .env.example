# Rust application environment. Copy to .env, edit, then export in each shell:
#   set -a; . ./.env; set +a
# The binaries do not read .env automatically. Never commit real secrets.

# --- Required application storage and runtime ---
APPCALL_ENV=development
APPCALL_HTTP_ADDR=127.0.0.1:5080
# APPCALL_RUST_LISTEN overrides APPCALL_HTTP_ADDR when explicitly set.
# PostgreSQL is currently required; there is no verified Rust no-database demo.
APPCALL_DATABASE_URL=postgres://localhost/appcall?sslmode=disable
# REQUIRED: 32-byte AES key encoded as 64 hex characters. Generate once:
#   openssl rand -hex 32
# Keep stable across restarts; a casual change makes stored credentials unreadable.
APPCALL_SECRET_KEY=
# Local-only platform API key, scoped to proj_dev. Production requires >=24 chars.
# make run supplies devkey if this is empty; direct cargo/binary launches do not.
APPCALL_DEV_API_KEY=devkey
# Runner BASE URL: Rust appends /rpc. Do not append /rpc here.
APPCALL_RUNNER_URL=http://127.0.0.1:5081
# Share this value with the Bun runner; required in production.
# Generate with openssl rand -hex 32. The runner defaults to loopback locally.
APPCALL_RUNNER_TOKEN=
APPCALL_RUNNER_HOST=127.0.0.1
APPCALL_RUNNER_PORT=5081

# --- OAuth state and inbound connector callbacks ---
# Origin, without a trailing slash. Use public HTTPS for real provider callbacks.
APPCALL_PUBLIC_BASE_URL=http://127.0.0.1:5080
# Callback signing secret; required in production. Empty disables features that
# cannot safely authenticate a provider callback. Generate: openssl rand -hex 32
APPCALL_WEBHOOK_SIGNING_SECRET=
# OAuth state key: 64 hex characters (or exactly 32 raw bytes).
# Keep stable and identical across replicas. Empty in development generates a
# process-local key; pending real OAuth flows then do not survive a restart.
APPCALL_OAUTH_STATE_SECRET=

# --- Optional Anusa-backed dashboard: uncomment and configure the WHOLE block ---
# With JWT/session variables absent and a loopback listener, /app is a no-login
# PostgreSQL-backed proj_dev dashboard. Anusa-only administration is unavailable.
# Non-loopback listeners remain API-only; incomplete Anusa fails closed.
# Setting either JWT/session variable (even empty) requests browser assembly.
# ANUSA_API_URL=http://127.0.0.1:4290
# ANUSA_JWT_ACCESS_SECRET=
# APPCALL_SESSION_SECRET=
# REQUIRED for browser auth: Anusa's existing identity database, not AppCall's
# application schema. Used for live membership, active-user and revocation checks.
# ANUSA_DATABASE_URL=postgres://localhost/anusa?sslmode=disable
# APPCALL_SESSION_COOKIE_SECURE=false
# JWT secret must match Anusa's access-token signing key. Generate a separate
# long random session secret; rotating it signs out existing dashboard sessions.
# Configure Anusa FRONTEND_URL to match APPCALL_PUBLIC_BASE_URL so email links
# and bound OAuth callbacks return to this dashboard. With all values set:
#   make run-auth HTTP_ADDR=127.0.0.1:5080
# HTTPS is required when the cookie is Secure, and always in production.

# --- Managed OAuth applications: leave unset until a real app is configured ---
# The control plane owns these app credentials. A configured CLIENT_ID selects
# managed OAuth even if its secret/redirect is incomplete; errors never select
# local fallback. Production never uses local development OAuth.
# Local development fallback is scoped to proj_dev and stores no provider token.
# APPCALL_GOOGLE_OAUTH_CLIENT_ID=
# APPCALL_GOOGLE_OAUTH_CLIENT_SECRET=
# APPCALL_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5080/v1/connectors/google-workspace/setup/oauth/callback
# APPCALL_SLACK_OAUTH_CLIENT_ID=
# APPCALL_SLACK_OAUTH_CLIENT_SECRET=
# APPCALL_SLACK_OAUTH_REDIRECT_URI=http://127.0.0.1:5080/v1/connectors/slack/setup/oauth/callback
# Other keys follow APPCALL_<UPPERCASE_CONNECTOR_WITH_UNDERSCORES>_OAUTH_*.
# APPCALL_REDDIT_OAUTH_CLIENT_ID=
# APPCALL_REDDIT_OAUTH_CLIENT_SECRET=
# APPCALL_REDDIT_OAUTH_REDIRECT_URI=

# --- Worker ---
# Empty/unset MAX_JOBS runs persistently. A nonempty value selects one-shot mode.
# APPCALL_WORKER_MAX_JOBS=
# APPCALL_WORKER_INTERVAL_MS=1000
# APPCALL_WORKER_HTTP_ADDR=127.0.0.1:5082
# APPCALL_WORKER_ID=local-worker

# --- Usage and provider limits ---
# APPCALL_ACTION_CALLS_SOFT_LIMIT=0
# APPCALL_ACTION_CALLS_HARD_LIMIT=0
# APPCALL_SEND_CAP=0
# APPCALL_SPEND_CAP_MICROS=0
# APPCALL_SEND_COST_MICROS=0
# Unipile linking is denied at 0; raise deliberately to enable it.
APPCALL_UNIPILE_MAX_ACCOUNTS=0
# HTTP peer admission defaults; zero/unset selects defaults, not unlimited.
# APPCALL_RATE_LIMIT_RPS=50
# APPCALL_RATE_LIMIT_BURST=100

# --- LinkedIn account safety (Unipile) ---
# Optional: blank/0 uses built-in conservative caps, spacing and warm-up.
# Set WARMUP_DISABLED=1/true only to disable warm-up deliberately.
APPCALL_LINKEDIN_WARMUP_DISABLED=
APPCALL_LINKEDIN_INVITE_DAILY_CAP=
APPCALL_LINKEDIN_INVITE_WEEKLY_CAP=
APPCALL_LINKEDIN_MESSAGE_DAILY_CAP=
APPCALL_LINKEDIN_MESSAGE_WEEKLY_CAP=
APPCALL_LINKEDIN_PROFILE_VIEW_DAILY_CAP=
APPCALL_LINKEDIN_INVITE_MIN_SPACING_SECONDS=
APPCALL_LINKEDIN_MESSAGE_MIN_SPACING_SECONDS=

# --- Explicit live connector tests (make test-live); real provider calls ---
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TEST_TO=
