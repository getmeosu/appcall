{
  "about": "Shared accept/reject cases run through BOTH input validators: the control plane (crates/appcall-connectors/src/schema.rs, tests/schema_combinators.rs) and the runner registry (runner/bun/src/declarative/strict-schema.ts registry mode, runner/bun/test/schema_parity.test.ts). A case either names a manifest operation or carries an inline schema. `unsupported` schemas must be refused by both validators before any input is checked.",
  "operations": [
    { "connector": "github", "operation": "deployments.create",
      "accept": [{ "owner": "o", "repo": "r", "ref": "main" }, { "owner": "o", "repo": "r", "ref": "main", "payload": { "deploy": true } }, { "owner": "o", "repo": "r", "ref": "main", "payload": "{\"deploy\":true}" }],
      "reject": [{ "owner": "o", "repo": "r", "ref": "main", "payload": 5 }, { "owner": "o", "repo": "r", "ref": "main", "payload": ["x"] }, { "owner": "o", "repo": "r" }] },
    { "connector": "github", "operation": "deployments.get",
      "accept": [{ "owner": "o", "repo": "r", "deploymentId": 42 }, { "owner": "o", "repo": "r", "id": "42" }, { "owner": "o", "repo": "r", "id": 42 }, { "owner": "o", "repo": "r", "ref": "main", "environment": "prod" }],
      "reject": [{ "owner": "o", "repo": "r" }, { "owner": "o", "repo": "r", "environment": "prod" }, { "owner": "o", "repo": "r", "deploymentId": "42" }] },
    { "connector": "github", "operation": "discussions.comments.create",
      "accept": [{ "owner": "o", "repo": "r", "body": "b", "discussionNumber": 7 }, { "owner": "o", "repo": "r", "body": "b", "discussionId": "D_1" }],
      "reject": [{ "owner": "o", "repo": "r", "body": "b" }, { "owner": "o", "repo": "r", "discussionNumber": 7 }] },
    { "connector": "github", "operation": "discussions.comments.list",
      "accept": [{ "owner": "o", "repo": "r", "discussionNumber": 7, "first": 10 }, { "owner": "o", "repo": "r", "discussionId": "D_1" }],
      "reject": [{ "owner": "o", "repo": "r", "first": 10 }, { "owner": "o", "repo": "r", "discussionId": 7 }] },
    { "connector": "github", "operation": "discussions.comments.update",
      "accept": [{ "owner": "o", "repo": "r", "commentId": "C_1", "body": "b", "discussionNumber": 7 }],
      "reject": [{ "owner": "o", "repo": "r", "commentId": "C_1", "body": "b" }] },
    { "connector": "github", "operation": "discussions.get",
      "accept": [{ "owner": "o", "repo": "r", "discussionNumber": 7 }, { "owner": "o", "repo": "r", "discussionId": "D_1" }, { "owner": "o", "repo": "r", "title": "Welcome" }],
      "reject": [{ "owner": "o", "repo": "r", "categoryId": "C" }, { "owner": "o", "repo": "r" }] },
    { "connector": "github", "operation": "discussions.update",
      "accept": [{ "owner": "o", "repo": "r", "discussionNumber": 7, "title": "t" }, { "owner": "o", "repo": "r", "discussionId": "D_1", "body": "b", "categoryId": "C" }],
      "reject": [{ "owner": "o", "repo": "r", "discussionNumber": 7 }, { "owner": "o", "repo": "r", "title": "t" }, { "owner": "o", "repo": "r" }] },
    { "connector": "github", "operation": "environments.get",
      "accept": [{ "owner": "o", "repo": "r", "name": "prod" }, { "owner": "o", "repo": "r", "environment": "prod" }],
      "reject": [{ "owner": "o", "repo": "r" }, { "owner": "o", "repo": "r", "name": 1 }] },
    { "connector": "github", "operation": "releases.assets.get",
      "accept": [{ "owner": "o", "repo": "r", "assetId": 9 }, { "owner": "o", "repo": "r", "id": "9" }, { "owner": "o", "repo": "r", "releaseId": 3, "name": "app.zip" }],
      "reject": [{ "owner": "o", "repo": "r", "releaseId": 3 }, { "owner": "o", "repo": "r", "name": "app.zip" }, { "owner": "o", "repo": "r" }] }
  ],
  "schemas": [
    { "name": "types, required, closed object",
      "schema": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "n": { "type": "integer", "minimum": 1, "maximum": 10 }, "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "mode": { "enum": ["a", "b"] }, "opt": { "type": ["string", "null"] } } },
      "accept": [{ "id": "x" }, { "id": "x", "n": 1, "tags": ["t"], "mode": "b", "opt": null }, { "id": "x", "n": 10 }],
      "reject": [{}, { "id": "" }, { "id": 1 }, { "id": "x", "n": 0 }, { "id": "x", "n": 11 }, { "id": "x", "n": 1.5 }, { "id": "x", "tags": [] }, { "id": "x", "tags": [1] }, { "id": "x", "mode": "c" }, { "id": "x", "extra": true }, [], "x", null] },
    { "name": "nested additionalProperties schema",
      "schema": { "type": "object", "properties": { "meta": { "type": "object", "additionalProperties": { "type": "string" } } } },
      "accept": [{}, { "meta": {} }, { "meta": { "a": "1", "b": "2" } }, { "other": 5 }],
      "reject": [{ "meta": { "a": 1 } }, { "meta": "x" }] },
    { "name": "anyOf of required sets",
      "schema": { "type": "object", "properties": { "a": { "type": "string" }, "b": { "type": "number" } }, "anyOf": [{ "required": ["a"] }, { "required": ["b"] }] },
      "accept": [{ "a": "x" }, { "b": 1 }, { "a": "x", "b": 1 }],
      "reject": [{}, { "c": 1 }, { "a": 1 }] },
    { "name": "oneOf is exclusive",
      "schema": { "oneOf": [{ "type": "integer" }, { "type": "number", "minimum": 5 }] },
      "accept": [1, 2, 5.5],
      "reject": [5, 7, 3.5, "x"] },
    { "name": "oneOf of disjoint types",
      "schema": { "type": "object", "properties": { "p": { "oneOf": [{ "type": "object" }, { "type": "string" }] } } },
      "accept": [{}, { "p": {} }, { "p": "s" }],
      "reject": [{ "p": 1 }, { "p": null }, { "p": [] }] },
    { "name": "allOf conjunction with nested anyOf",
      "schema": { "type": "object", "allOf": [{ "anyOf": [{ "required": ["x"] }, { "required": ["y"] }] }, { "properties": { "x": { "type": "string" } } }, { "anyOf": [{ "required": ["z"] }, { "required": ["w"] }] }] },
      "accept": [{ "x": "1", "z": 1 }, { "y": 1, "w": 2 }],
      "reject": [{ "x": "1" }, { "x": 1, "z": 1 }, { "z": 1 }, {}] },
    { "name": "combinator branch constrains nested property",
      "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }] } } } },
      "accept": [{ "items": [] }, { "items": ["a", { "id": "b" }] }],
      "reject": [{ "items": [1] }, { "items": [{}] }, { "items": [{ "id": 2 }] }] },
    { "name": "annotations are ignored",
      "schema": { "type": "object", "$comment": "c", "properties": { "a": { "type": "string", "default": "x", "examples": ["y"], "x-ui": { "w": 1 } } } },
      "accept": [{}, { "a": "z" }],
      "reject": [{ "a": 1 }] }
  ],
  "unsupported": [
    { "name": "empty anyOf", "schema": { "anyOf": [] } },
    { "name": "anyOf not an array", "schema": { "anyOf": { "type": "string" } } },
    { "name": "oneOf branch not a schema", "schema": { "oneOf": ["string"] } },
    { "name": "allOf branch with unsupported keyword", "schema": { "allOf": [{ "pattern": "^a" }] } },
    { "name": "not is unsupported", "schema": { "not": { "type": "string" } } },
    { "name": "too many combinator branches", "generate": "wideAnyOf" },
    { "name": "combinator nesting beyond the depth limit", "generate": "deepAnyOf" }
  ]
}
